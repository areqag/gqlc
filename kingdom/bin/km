#!/usr/bin/env bash
# km — the machinery of the Թագաւորութիւն (kingdom/README.md).
#
# Path resolution: this script's own location names the kingdom/ tree it
# serves; the runtime state dir is derived from the git COMMON dir so every
# seat worktree resolves the same shared state (KM_STATE_DIR overrides, for
# tests). tmux may be absent (CI): every tmux-touching path degrades to a
# message or a state file, never a crash.
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
KM_SELF=$SCRIPT_DIR/${BASH_SOURCE[0]##*/}
KINGDOM_DIR=$(dirname "$SCRIPT_DIR")
# KM_CONFIG overrides for tests, as KM_STATE_DIR does for state; the town
# itself never sets it. Without it a test that exercises a tuning parameter has
# to assert the town's live value, so the parameter can no longer be tuned
# without editing the suite that guards it — Constitution V.6.1 says these
# numbers change by a config edit, and that is only true if nothing else pins
# them (gqlc-p5s8).
CONFIG="${KM_CONFIG:-$KINGDOM_DIR/kingdom.toml}"

die() { echo "km: $*" >&2; exit 1; }

# The verb a message advertises an operator run is free text at the print site;
# the verbs km HAS are case labels in the dispatch table at the foot of this
# file. Nothing joined the two, so `km halt` spent its life telling whoever had
# just stopped the town to run `km herratsayn`, which km has never dispatched
# (gqlc-cw7h). This reads the labels out of that table, so a print site is
# answered by km's own routing rather than by whatever the author typed.
#
# It warns and carries on rather than dying, and prints the name either way: the
# operator reaching for the emergency brake must not be stopped by a defect in
# the sentence that describes it. A caller that wants the refusal fatal assigns
# it (`v=$(verb resume)`), which `set -e` does abort on. So this does not make a
# phantom verb unwritable — it makes it announce itself on stderr the first time
# the path runs, to the developer who just edited it.
#
# It does not see past the first word. Flags and subcommands after it — the
# `send town -s ...` in `$(verb mail) send town` — are still free text. Nor does
# a matched label prove the arm behind it works: it proves km ROUTES the name,
# not that the route arrives.
verb() { # <name> — echoes "km <name>"; warns, rc 1, if km dispatches no <name>
    # Recomputed per call rather than cached in a global, because a global is a
    # name an inherited environment can preload — and so answer on km's behalf
    # about what km dispatches. Three awk passes over one file costs nothing.
    local v dispatched
    dispatched=$(
        awk '/^case "\$cmd" in$/{d=1;next} d&&/^esac$/{exit}
             d&&/^[[:space:]]*[-a-z"|[:space:]]+\)/{
                 sub(/\).*/,""); gsub(/[[:space:]"]/,"")
                 n=split($0,a,"|"); for(i=1;i<=n;i++) if(a[i]!="") print a[i]}' \
            "$KM_SELF"
    )
    printf 'km %s' "$1"
    for v in $dispatched; do
        [ "$v" != "$1" ] || return 0
    done
    echo "km: INTERNAL — '$1' was just advertised to an operator, but km's dispatch table has no such verb" >&2
    return 1
}

# The crown is not a default. `mail send`, the mail box selectors and `halt`
# each resolved their caller by defaulting an unset KINGDOM_SEAT to the crown —
# not spelled literally here, so a grep for the defect finds sites and not this
# account of it (bd gqlc-ujw7). Any session
# started outside km-seat — every ephemeral agent in the shared checkout, and
# anyone running km from a plain shell — sent letters headed by the king, read
# the king's inbox instead of its own, and stamped a Constitution VI.4 halt
# with his name. Measured 2026-08-29: three of four letters in Սեդրակ's inbox
# were misattributed this way, and only the human signature inside the body
# disagreed. The fallback names the one identity holding powers nobody else
# does, so it errs toward MORE authority than the caller has, never less.
#
# cmd_sleep and cmd_resume already refused this condition. These sites did not,
# and the refusal below is the shape cmd_resume uses — including the escape
# hatch, because the crown asserts itself the way anyone else does.
# CALL THIS BARE, never as "$(require_identity …)". It refuses by exiting, and
# `exit` inside a command substitution leaves only the subshell: the first cut
# of this fix echoed the seat, and `halt` went on to raise the town's brake with
# a blank actor while returning 0 — the same fail-open in the same reserved
# power, one layer down. `set -e` does not cover it either, because the status
# of a substitution used as an ARGUMENT is discarded outright. So the check runs
# in the caller's own shell and the caller reads $KINGDOM_SEAT itself.
require_identity() { # <command> — returns only if this session has an identity
    [ -n "${KINGDOM_SEAT:-}" ] && return 0
    echo "km $1: refused — this session has no identity (KINGDOM_SEAT is unset)." >&2
    echo "  Acting anyway would record this as Անդրանիկ, the crown." >&2
    echo "  If you are the crown, say so: KINGDOM_SEAT=andranik km $1" >&2
    exit 1
}

usage() {
    cat <<'EOF'
km — the machinery of the Թագաւորութիւն

  km status                      the town's mechanical readout (open `herdr` for the pane view)
  km up | down                   raise / close the town's herdr workspace and its per-seat agents
  km wake <seat> [--bead ID] [--reason TEXT]
  km sleep [--seat NAME]         end the current seat's workday
  km mail send <to> -s SUBJ [-m BODY]   (body on stdin if no -m)
  km mail inbox [--seat NAME] | read <id> | sent
  km dispatch                    route ready beads to free seats (timer)
  km hold-verdict                ROUTE/HOLD per candidate bead, docs on stdin
  km reconcile                   match seat status to the sessions that exist
  km seat-live <seat>            exit 0 if a claude session exists there (herdr reports it)
  km seat-runner <seat>          exit 0 if the seat has an active herdr agent
  km seat-idle <seat>            exit 0 if the seat's agent_status is `idle`
  km guard-sweep                 wake Րաֆֆի for a round (timer)
  km halt [reason] | halt --status | halt --history [N] | resume
                                 raise / ask about / replay / lower the town halt
  km install-units | uninstall-units
  km deploy                      fast-forward the checkout the timers run from
  km doctor                      health checks
  km seat-refresh <s>|--all [--check]
                                 bring a parked seat's worktree (and its hooks) up to master
                                 --all sweeps the roster; it moves ONLY parked seats and
                                 refuses a dirty tree, a branch, or commits of its own
                                 --check reports and moves nothing (status/doctor read it)
  km state-dir | capped-seats | seat-info <s> | seat-worktree <s>
EOF
}

# The dispatcher hands every verb the rest of argv, and a verb that never reads
# it acts for ANY argument — including the one a careful person types FIRST.
# Measured 2026-08-29 (bd gqlc-akp4w): `km deploy --help` fast-forwarded the
# deployed checkout and printed no help, and `km resume --help` reached the
# Constitution VI.4 identity refusal rather than the help it asked for. Ten
# dispatched verbs read no argv at all, so --help was the one spelling
# guaranteed to perform the action instead of explaining it. `km down --help`
# closes the town; that row is a static reading, not a first-party run.
#
# The refusal is `die`, not a silent skip. A verb that quietly ignored the
# argument would still leave whoever typed it believing km had understood it —
# which is the sibling defect (bd gqlc-wguoq), where a message reported the
# state instead of the act and its own raiser read his halt as someone else's.
no_args() { # <verb> "$@" — for a verb that takes none; --help prints usage
    local na_verb=$1
    shift
    [ "$#" -gt 0 ] || return 0
    case "$1" in
    -h | --help | help)
        usage
        exit 0
        ;;
    esac
    die "$na_verb takes no arguments, and it did NOT run — got: $*
  to ask what it does:  $(verb "$na_verb") --help
  to run it:            $(verb "$na_verb")"
}

# ---------- config ----------

cfg() { # cfg <section> <key> -> value with quotes and inline comment stripped
    awk -F' *= *' -v sec="[$1]" -v key="$2" '
        /^\[/ { insec = ($0 == sec); next }
        insec && $1 == key {
            v = $2
            sub(/[ \t]+#.*$/, "", v)
            gsub(/^"|"$/, "", v)
            print v
            exit
        }
    ' "$CONFIG"
}

# The bare keys of every entry under one section header. There are two rosters
# now — [seats] and [humans] — and they are read by the same reader on purpose:
# a second copy of this awk would let the two disagree about what counts as an
# entry, and the whole value of the second roster is that a name found in
# neither is a real finding rather than a parsing difference (gqlc-t4zx).
roster_names() { # <section> -> one name per line
    awk -F' *= *' -v sec="[$1]" '
        index($0, sec) == 1 { s = 1; next }
        /^\[/               { s = 0 }
        s && NF >= 2 && $1 !~ /^#/ { print $1 }
    ' "$CONFIG"
}

seats_all() { roster_names seats; }

# The people who legitimately hold beads. They are not seats and nothing routes
# to them; the list exists so that an assignee in NEITHER roster can be told
# apart from a person's name. See the [humans] comment in kingdom.toml.
humans_all() { roster_names humans; }

seat_raw() {
    local raw
    raw=$(cfg seats "$1")
    [ -n "$raw" ] || die "unknown seat: $1"
    echo "$raw"
}

seat_class()   { seat_raw "$1" | cut -d: -f1; }
seat_model()   { seat_raw "$1" | cut -d: -f2; }
seat_display() { seat_raw "$1" | cut -d: -f3; }

is_seat()  { seats_all  | grep -qx "$1"; }
is_human() { humans_all | grep -qx "$1"; }

# ---------- paths ----------

# git exports GIT_DIR and friends into every hook environment, and with GIT_DIR
# set `git -C <path>` resolves the repo from GIT_DIR rather than from <path>. km
# is reachable from a hook (bd delegates mail to it), and a deploy that merged
# into whichever repo invoked the hook would be the same class of accident the
# deploy command exists to end — so every git call that names a repo by path
# scrubs the inheritance first.
#
# Drop the whole GIT_* namespace and re-export an allowlist, rather than
# enumerating what to remove. The asymmetry decides it: a git release that adds
# an auth variable breaks LOUDLY here — at the deploy that needed it, naming
# itself — while one that adds a repo-selecting variable would break SILENTLY,
# later, in someone else's repo. Default-deny puts the new unknown on the safe
# side. The allowlist is transport only: GIT_CONFIG_* is deliberately absent,
# since it can inject core.hooksPath and aliases.
#
# KM_GIT_TIMEOUT bounds the call when a caller declares one. It is read here
# rather than wrapped per call site because a caller sets it with `local` and
# every git the callee reaches is then bounded, which is the property a timer
# needs: deploy now runs from inside the dispatch and guard ticks (gqlc-nm7w),
# and OnUnitActiveSec means the next tick cannot begin until this one ends, so
# one hung fetch is a stopped town.
git_at() { # git_at <dir> <args...>
    local dir=$1
    shift
    local -a scrub=() keep=() bound=()
    local v
    for v in "${!GIT_@}"; do
        case $v in
            GIT_SSH | GIT_SSH_COMMAND | GIT_ASKPASS | GIT_TERMINAL_PROMPT)
                keep+=("$v=${!v}") ;;
            *) scrub+=(-u "$v") ;;
        esac
    done
    [ -n "${KM_GIT_TIMEOUT:-}" ] && bound=(timeout "$KM_GIT_TIMEOUT")
    env "${scrub[@]}" "${keep[@]}" "${bound[@]}" git -C "$dir" "$@"
}

# Scrubbed like the rest: an exported GIT_DIR would otherwise name the repo that
# invoked the hook, and deploy_root() below is the first caller that WRITES to
# whatever this returns.
main_root() {
    local common
    common=$(git_at . rev-parse --path-format=absolute --git-common-dir)
    dirname "$common"
}

state_dir() {
    if [ -n "${KM_STATE_DIR:-}" ]; then
        echo "$KM_STATE_DIR"
    else
        echo "$(dirname "$(main_root)")/$(cfg kingdom state_dirname)"
    fi
}

seat_worktree() {
    local mr
    mr=$(main_root)
    echo "$(dirname "$mr")/$(basename "$mr")-seat-$1"
}

# The runner script each seat's tmux window executes, from kingdom/bin/. Only
# km-seat is in-tree today; the config knob is kept so a future alternative can
# be swapped in without touching every call site here. Whatever it names must
# honour the km-seat contract: park on the wake file, keep $home/status
# asleep/awake.
seat_runner() {
    local v
    v=$(cfg kingdom seat_runner)
    echo "${v:-km-seat}"
}

# ---------- deploy ----------

# The systemd units execute kingdom/ out of the main checkout, never out of the
# seat worktree a fix was written in, and nothing advances that checkout — so a
# merged fix ran for hours while the town believed it was live (bd gqlc-ed2u).
# KM_DEPLOY_ROOT overrides, for tests, as KM_STATE_DIR does for state.
deploy_root() { echo "${KM_DEPLOY_ROOT:-$(main_root)}"; }

# The paths whose content IS a gate. One definition, read by kingdom_drift for
# the deployed root and by seat_freshness for each seat worktree, so the two
# cannot come to disagree about what counts as a gate.
#
# kingdom/ is the machinery the systemd units execute. .githooks/ is what
# core.hooksPath resolves to AND where Claude Code's PreToolUse hook
# (claude-pre-bash) lives. .claude/ carries the registration that makes that
# hook run at all — a checkout holding the hook file but not the settings runs
# neither, so the two travel together.
KM_GATE_PATHS=(kingdom/ .githooks/ .claude/)

# Names why the deployed root could not be fast-forwarded; silence means it can.
#
# CAPABILITY, which is a different question from kingdom_drift's CONTENT, and
# the reason both are asked: a root parked off master has zero drift for as long
# as master does not move, so the content row reads ok while the deploy path is
# already refusing. Measured 2026-08-29 (bd gqlc-ssfqj): the deploy root sat on
# a detached HEAD at exactly master's tip, `km doctor` printed "ok: ... match
# origin/master", and `km deploy` on the same root died "parked on 'a detached
# HEAD'". Two verdicts from one tree. The defect is invisible until master
# moves, and what master moving does is start the town running stale machinery.
#
# cmd_deploy refuses on this and doctor reports it, from here, so the two cannot
# come to disagree about which roots are deployable.
#
# The git-dir probe is not redundant with symbolic-ref: on a directory that is
# not a repository at all, symbolic-ref also exits non-zero with empty stdout,
# so without it every non-repo root is reported as "a detached HEAD" — a
# measured-sounding sentence about a measurement that never happened.
# Names the worktree that holds the local `master` branch, if one does;
# silence means the ref is free. Read only when the deploy root is NOT on
# master, so the root can never be its own answer.
master_holder() { # <root>
    git_at "$1" worktree list --porcelain 2>/dev/null |
        awk '/^worktree /{wt=substr($0, 10)} /^branch refs\/heads\/master$/{print wt; exit}'
}

deploy_blocker() {
    local root branch holder msg
    root=$(deploy_root)
    git_at "$root" rev-parse --git-dir >/dev/null 2>&1 \
        || { echo "$root is not a git checkout, so nothing can be deployed into it"; return 0; }
    branch=$(git_at "$root" symbolic-ref --quiet --short HEAD || true)
    if [ "$branch" != master ]; then
        msg="$root is parked on '${branch:-a detached HEAD}', not master"
        # Git checks a branch ref out in at most one worktree, and the town
        # shares one repo across many (33 of them, measured 2026-08-29). So a
        # seat that ran `git checkout master` to read master takes the ref the
        # deploy root needs, and the operator's obvious repair dies
        # "fatal: 'master' is already used by worktree at ...". That refusal is
        # knowable HERE; making them find it by hand is the avoidable half of
        # the diagnosis, and it is the half that reads as "the repair is a
        # one-liner" right up until it is not (bd gqlc-59n70). Measured
        # 2026-08-29 on gqlc-ssfqj: Աստղիկ hit exactly that refusal and could
        # only conclude "something in the town does contend for it".
        holder=$(master_holder "$root")
        [ -z "$holder" ] || msg="$msg, and 'git checkout master' there will refuse because $holder holds that branch"
        echo "$msg"
    fi
}

# Names the deployed paths where the tree differs from origin/master; silence
# means no drift. It diffs the WORKING TREE, not HEAD, because that is what the
# units execute: a file edited or staged in place is drift at the right commit.
#
# gqlc-d20c widened this from kingdom/ alone. The hooks are executed out of the
# main checkout exactly as the units are, and nothing advanced that checkout:
# measured 2026-08-23, it sat 34 commits back while PR #1333's hook fix was
# already merged, so `bd close` from a sibling worktree was refused by the
# pre-fix copy and allowed by the merged one — same input, same file, two
# verdicts. `git status` there was clean apart from two .beads exports, so the
# condition had no tell at all and was found by comparing shas by hand.
kingdom_drift() {
    local root out rc=0
    root=$(deploy_root)
    # Refresh the ref this is about to read, because otherwise the measurement
    # is circular. The only fetch in a dispatch tick lives in cmd_deploy, and
    # cmd_deploy is reached only once drift is already non-empty — so while the
    # town is halted or down, and hold_fetch_master / cmd_seat_refresh /
    # guard-sweep are therefore not running either, nothing moves
    # refs/remotes/origin/master, drift measures empty, and the detector is
    # blind for exactly the outage across which merges accumulate. Measured
    # 2026-08-23 (bd gqlc-iom4): the checkout sat at 43b1fbe9 while
    # origin/master was cd7ee956, two of the three commits between them
    # touching kingdom/; eight consecutive ticks logged only "the town is down"
    # and never DRIFT. One hand-run `git fetch origin master`, nothing else,
    # and the next tick logged DRIFT and fast-forwarded.
    #
    # Bounded and NON-FATAL. A hung fetch is a stopped town (see git_at), and a
    # refusal here would stop it too — so a failure degrades to the older
    # behaviour of judging against whatever ref is on disk. It says so on
    # stderr, because rendering an unmeasured state as a measured one is the
    # defect this fixes, one level up. Narrow (origin master), not --all: the
    # ref this reads is the only one it needs.
    local KM_GIT_TIMEOUT="${KM_FETCH_TIMEOUT:-30}"
    git_at "$root" fetch --quiet origin master 2>/dev/null \
        || echo "drift: could not fetch origin/master in $root; measuring against a possibly-stale ref" >&2
    if ! git_at "$root" rev-parse --verify -q origin/master >/dev/null 2>&1; then
        echo "origin/master is unknown in $root"
        return 0
    fi
    # A diff that could not run is not a clean tree. On a root git cannot use as
    # a checkout at all, `git diff` exits non-zero with EMPTY stdout — and empty
    # is this function's word for "no drift", so the gate would open widest
    # where it knows least. Measured shape: core.bare=true in the config, which
    # clears the rev-parse guard above and then fails here (bd gqlc-ed2u).
    # Carry the failure as drift, like the missing ref above.
    out=$(git_at "$root" diff --name-only origin/master -- "${KM_GATE_PATHS[@]}" 2>&1) || rc=$?
    if [ "$rc" -ne 0 ]; then
        echo "cannot measure drift in $root (git exited $rc): ${out//$'\n'/ }"
        return 0
    fi
    echo "$out"
}

deployed_ok() { [ -z "$(kingdom_drift)" ]; }

# Fail OPEN, after trying to fix it. This used to be assert_deployed, which
# refused, and the refusal is what stopped the town (gqlc-nm7w): nothing in the
# Թագաւորութիւն ever ran `km deploy` on its own — no systemd unit, no km-seat,
# no justfile recipe, no line of citizen-protocol.md — while origin/master DOES
# move under the timers, because hold_fetch_master and cmd_seat_refresh both
# fetch. So any merged PR touching a gate path made every dispatch tick and
# every guard tick exit non-zero into the journal, and the town routed nobody
# until a human typed `just kingdom-deploy`. Measured 2026-08-23:
# kingdom-guard.service exit 1 at 03:25:43, naming twenty-odd kingdom/ paths.
#
# Both arms of the trade have now been observed here, which is what decides it.
# gqlc-ed2u is stale code running behind a healthy indicator; gqlc-nm7w is NO
# code running behind a healthy indicator. Routing from a tree one merge behind
# is recoverable and self-corrects on the next tick; a halted town needs a
# human at 3am and gets one at 9am. So the timers heal themselves and then
# continue either way — but never silently, and `km doctor` and the `km status`
# board still FAIL and still say DRIFT, because those are read by someone who
# can act.
#
# KM_SELF_DEPLOYED bounds the hand-off below to one hop.
ensure_deployed() { # <command name for the message> [the args to hand on]
    local name=$1 drift out km
    shift
    drift=$(kingdom_drift)
    [ -n "$drift" ] || return 0
    if [ -z "${KM_SELF_DEPLOYED:-}" ]; then
        echo "$name: DRIFT — deploying $(deploy_root) before it runs" >&2
        if out=$(cmd_deploy 2>&1); then
            printf '%s: %s\n' "$name" "${out//$'\n'/ }" >&2
            # The km executing this line is the copy the fast-forward just
            # replaced, so finishing the tick here runs exactly the stale code
            # the deploy retired — gqlc-ed2u, one level down. Hand the command
            # to the deployed copy instead.
            km="$(deploy_root)/kingdom/bin/km"
            if [ -x "$km" ]; then
                export KM_SELF_DEPLOYED=1
                exec "$km" "$name" "$@"
            fi
            return 0
        fi
        drift=$(kingdom_drift)
        [ -n "$drift" ] || return 0
        printf '%s: deploy failed: %s\n' "$name" "${out//$'\n'/ }" >&2
    fi
    {
        echo "$name: WARNING — $(deploy_root) is not origin/master and could not be deployed; running from this tree anyway:"
        echo "  ${drift//$'\n'/$'\n  '}"
        echo "$name: run 'km deploy' (just kingdom-deploy) by hand — km status and km doctor carry this too"
    } >&2
    return 0
}

# The one class of local dirt a deploy may resolve by itself, and the reason
# --ff-only alone was a permanent stop (gqlc-n8h3). bd re-exports
# .beads/issues.jsonl into the deploy root continuously, so a modified export
# is that tree's STEADY STATE rather than a leftover — measured 2026-08-23 in
# the shared checkout: staged-modified, 125 insertions against 92 deletions.
# Nearly every commit in this repo touches that file, because every bd write is
# exported and committed, so git refuses the fast-forward with "Your local
# changes to the following files would be overwritten by merge" at the first
# attempt where HEAD is genuinely behind. Since deploy is the remedy that
# dispatch and guard both name, that is a loop with no exit.
#
# Discarding the local export is lossless, and it was measured rather than
# assumed. The Dolt DB under .beads/embeddeddolt is bd's source of truth and
# the jsonl is a passive export: a fresh `bd export` of the live ledger came
# back with the same 790 lines as the dirty working-tree copy and an empty
# sorted diff, and every id in the COMMITTED copy was present in the export
# too. The DIRECTION is the whole argument — taking the incoming version drops
# nothing the DB cannot re-emit, whereas restoring the local copy over the
# merged one would revert whatever bead rows other citizens pushed while this
# tree stood still. The bytes are copied aside anyway, because "the database
# can regenerate it" is a claim about bd, and this function should not be the
# only thing standing between an operator and a file.
#
# Scope is exactly .beads/. Everything else dirty in that tree is a human's
# uncommitted work — the shared checkout is where Անդրանիկ works — so if
# anything else is in the way the merge is left to refuse, naming it, and
# nothing at all is set aside, not even the exports: a partial one would leave
# him resolving a tree km had already edited under him.
merge_blockers() { # <root> : tracked files that are both dirty and incoming
    local root=$1 incoming dirty
    incoming=$(git_at "$root" diff --name-only HEAD origin/master 2>/dev/null) || return 1
    dirty=$(git_at "$root" diff --name-only HEAD 2>/dev/null) || return 1
    [ -n "$incoming" ] && [ -n "$dirty" ] || return 0
    comm -12 <(printf '%s\n' "$incoming" | sort -u) <(printf '%s\n' "$dirty" | sort -u)
}

set_aside_bd_exports() { # <root>
    local root=$1 blockers aside f
    blockers=$(merge_blockers "$root") || return 0
    [ -n "$blockers" ] || return 0
    printf '%s\n' "$blockers" | grep -qv '^\.beads/' && return 0
    aside="$(state_dir)/deploy-set-aside/$(date -u +%Y%m%dT%H%M%SZ)-$$"
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        mkdir -p "$aside/$(dirname "$f")"
        cp -p "$root/$f" "$aside/$f" 2>/dev/null || true
        git_at "$root" checkout HEAD -- "$f" \
            || die "deploy: could not set aside $f in $root; nothing was moved"
    done <<<"$blockers"
    echo "deploy: set aside bd's export so the fast-forward could pass: ${blockers//$'\n'/ } (copy: $aside)"
}

cmd_deploy() {
    no_args deploy "$@"
    local root blocker drift
    # The fetch and the merge reach the network and the disk from inside a
    # systemd tick; see git_at. A caller may raise or lower it.
    local KM_GIT_TIMEOUT="${KM_FETCH_TIMEOUT:-60}"
    root=$(deploy_root)
    blocker=$(deploy_blocker)
    [ -z "$blocker" ] || die "deploy: $blocker"
    git_at "$root" fetch --quiet origin master || die "deploy: cannot reach origin from $root"
    set_aside_bd_exports "$root"
    # --ff-only is still the safety argument for everything except bd's own
    # exports: git refuses to overwrite a dirty file the incoming commits
    # touch, and refuses a divergence, so no stash-and-reset dance can clobber
    # a human's uncommitted work in that tree.
    git_at "$root" merge --ff-only origin/master || die "deploy: refused to move $root; resolve the above by hand"
    drift=$(kingdom_drift)
    if [ -n "$drift" ]; then
        {
            echo "deploy: incomplete — kingdom/ still differs from origin/master:"
            echo "  ${drift//$'\n'/$'\n  '}"
        } >&2
        return 1
    fi
    echo "deployed: $root at $(git_at "$root" rev-parse --short HEAD)"
}

seat_home()   { echo "$(state_dir)/seats/$1"; }
seat_status() {
    local f
    f="$(seat_home "$1")/status"
    if [ -f "$f" ]; then cat "$f"; else echo asleep; fi
}

# ---------- herdr ----------

# Herdr owns the pane lifecycle: one workspace per town, one agent per seat.
# The socket API answers every question km used to derive from tmux + pgrep +
# pane grepping, so this section is thin wrappers, not a state machine.
# Kingdom-state (heartbeats, wake queues, mail) stays on disk as before.
#
# WORKSPACE is the herdr workspace name; the seats are agents inside it named
# by their seat id (sedrak, artur, ...). The env override is for tests.
WORKSPACE="${KM_HERDR_WORKSPACE:-$(cfg kingdom tmux_session)}"

have_herdr() { command -v herdr >/dev/null 2>&1; }
have_just()  { command -v just >/dev/null 2>&1; }

# The herdr server is the successor to `tmux has-session` here: if it is not
# running there is no town to reach.
#
# This collapsed a three-valued world into a two-valued rc, and every caller
# below turned the 1 into the positive claim "the town is down" — the same
# defect gqlc-ygcfi fixed one level up at the workspace-list read (gqlc-pgbfp).
# herdr already separates the three, on the exit status. Measured first-party
# 2026-08-30 against herdr 0.6.10, via HERDR_SOCKET_PATH — an env lever present
# in the binary and absent from `herdr --help` — so the down case could be
# reproduced without stopping the town's own server:
#
#   running      rc 0, stdout `status: running` + version/protocol/socket
#   not running  rc 0, stdout `status: not running` + `socket: <path>`
#   cannot ask   rc 1, stdout empty, stderr herdr's own Error object
#
# Both routine answers write 0 bytes of stderr — reproduced for an absent
# socket, a regular file and a directory — so the `2>/dev/null` that stood here
# was inert on every path except the one whose reason it was discarding.
herdr_server_up() { # 0 running, 1 not running, 2 km could not ask
    # No herdr is a READABLE answer: there is no server. It stays on the rc-1
    # side for the same reason workspace_id keeps it on its rc-0 side — a
    # machine that simply has no herdr, CI among them, must not read `cannot
    # ask` and must not make km's callers hedge.
    have_herdr || return 1
    local out
    out=$(herdr status server 2>&1) || {
        echo "km: cannot ask herdr whether its server is running: ${out:-herdr gave no diagnosis on either stream}. Not answering 'not running', because that is a positive claim about the town this failure does not support." >&2
        return 2
    }
    printf '%s\n' "$out" | grep -q '^status: running$'
}

# The three id lookups below all answer EMPTY for "not there", and all three
# feed a caller that reads "not there" as permission to create it. So the
# `unreadable` direction seat_agent_status was given (above) is owed here too,
# and it is carried by the EXIT STATUS rather than by a sentinel string,
# because these values are passed back to herdr as ids: rc 0 with empty stdout
# is a payload we read that does not hold the thing, rc 1 is a payload we could
# not read. A caller that collapses the two by testing only for emptiness —
# `[ -z "$(seat_tab_id ...)" ]` — re-arms the defect, because a herdr shape
# change then mints one tab per seat per wake and reconcile pass, unbounded.
# Verified against live herdr 0.6.10 / protocol 13 on 2026-08-29 (bd
# gqlc-jvlu): every key read here is present today, so the rc is about the
# NEXT shape change, not this one.
#
# The diagnosis is on stderr because nothing else carries it. Two redirects
# stood on each of these reads and only one of them belonged: python's, which
# keeps a stack trace out of an operator's console, and herdr's, which threw
# away the sole account of the failure that exists (gqlc-v152q). Herdr's is
# gone, so the four messages below can name which of their two hypotheses it
# was instead of listing both: measured 2026-08-30 against herdr 0.6.10,
# `workspace list`, `tab list`, `pane list` and `pane get` each write 0 bytes
# of stderr when they succeed and a JSON error object with a `code` and a
# `message` when they fail, so herdr's silence above such a message is itself
# the evidence that herdr answered and the PAYLOAD is what km could not read.
# `$( )` captures stdout only, so herdr's stderr cannot reach the parse.

# The workspace exists as long as the town has been raised at least once and
# not torn down. Lookup by label; herdr assigns numeric IDs we don't hold.
workspace_id() { # -> id on stdout; rc 0 + empty = absent, rc 1 = unreadable
    # No herdr is a readable answer, not an unreadable one — there is no
    # workspace. It has to stay on the rc-0 side or every seat reads
    # `unreadable` (below) on a machine that simply has no herdr, such as CI.
    have_herdr || { echo ""; return 0; }
    local out
    out=$(herdr workspace list |
        python3 -c "import json,sys; d=json.load(sys.stdin); print(next((w['workspace_id'] for w in d['result']['workspaces'] if w['label']==sys.argv[1]),''))" "$WORKSPACE" 2>/dev/null) || {
        echo "km: cannot read the workspace list from herdr. If herdr wrote a reason above this line, that is the cause. If it wrote nothing, herdr answered and its payload no longer carries result.workspaces[].workspace_id/label. Not answering 'absent', because absent authorizes creating a second workspace under this label." >&2
        return 1
    }
    printf '%s\n' "$out"
}

# The two "cannot tell" answers are kept apart rather than merged into one,
# because the sentence a caller prints names which read failed, and pointing an
# operator at the workspace list when it was the server socket sends them to the
# wrong place. Callers pass this rc straight to town_absent_reason.
session_up() { # 0 up; 1 down; 2 the list did not parse; 3 could not ask herdr
    local srv=0
    herdr_server_up || srv=$?
    # `if` blocks rather than `[ ... ] && return`: an AND-OR list whose test
    # fails is a failing statement, and km runs `set -e`.
    if [ "$srv" -eq 2 ]; then return 3; fi
    if [ "$srv" -ne 0 ]; then return 1; fi
    local ws
    # The rc, not the emptiness. `[ -n "$(workspace_id)" ]` stood here and read
    # an unreadable workspace list as "no workspace", so every caller below
    # printed "the town is down" — a positive claim km cannot support — and
    # cmd_reconcile skipped a whole pass while the town was in fact up
    # (gqlc-ygcfi, residue of gqlc-cp40).
    ws=$(workspace_id) || return 2
    [ -n "$ws" ]
}

# The sentence a caller prints when session_up said no. Neither 2 nor 3 is
# "down": one is a workspace list that did not parse, the other a server km
# could not ask, and in both cases km does not know which it is. The failing
# read has already put its own diagnosis on stderr immediately above, which is
# why these point at it rather than restating it.
town_absent_reason() { # <session_up rc> [wording for the plain down case]
    case "${1:-1}" in
        2) printf '%s' "km cannot tell whether the town is up — the herdr workspace list did not parse (diagnosis above)" ;;
        3) printf '%s' "km cannot tell whether the town is up — it could not ask herdr whether its server is running (diagnosis above)" ;;
        *) printf '%s' "${2:-the town is down}" ;;
    esac
}

# The seat's tab exists inside the workspace. Herdr tabs carry a label; the
# label IS the seat name. Returns tab_id on stdout.
seat_tab_id() { # <seat> -> tab_id on stdout; rc 0 + empty = absent, rc 1 = unreadable
    local ws out
    ws=$(workspace_id) || return 1
    # A readably-absent workspace holds no tabs, so this is an absent tab and
    # not an unreadable one. `km up` creates the workspace and the tabs in one
    # pass, and seat_runner_start's caller has already refused on the empty ws.
    [ -n "$ws" ] || { echo ""; return 0; }
    out=$(herdr tab list --workspace "$ws" |
        python3 -c "import json,sys; d=json.load(sys.stdin); print(next((t['tab_id'] for t in d['result']['tabs'] if t.get('label','')==sys.argv[1]),''))" "$1" 2>/dev/null) || {
        echo "km: seat $1: cannot read the tab list from herdr (workspace $ws). If herdr wrote a reason above this line, that is the cause. If it wrote nothing, herdr answered and its payload no longer carries result.tabs[].tab_id/label. Not answering 'absent', because absent authorizes creating a tab." >&2
        return 1
    }
    printf '%s\n' "$out"
}

# The seat's primary pane inside its tab. One pane per tab in this town; if
# splits ever get introduced, this returns the first.
seat_pane_id() { # <seat> -> pane_id on stdout; rc 0 + empty = absent, rc 1 = unreadable
    local tab ws out
    tab=$(seat_tab_id "$1") || return 1
    # No tab is an absent pane, which is the state seat_runner_start is about
    # to fix by creating the tab — not a read that failed.
    [ -n "$tab" ] || { echo ""; return 0; }
    ws=$(workspace_id) || return 1
    out=$(herdr pane list --workspace "$ws" |
        python3 -c "import json,sys; d=json.load(sys.stdin); print(next((p['pane_id'] for p in d['result']['panes'] if p.get('tab_id')==sys.argv[1]),''))" "$tab" 2>/dev/null) || {
        echo "km: seat $1: cannot read the pane list from herdr (workspace $ws, tab $tab). If herdr wrote a reason above this line, that is the cause. If it wrote nothing, herdr answered and its payload no longer carries result.panes[].pane_id/tab_id." >&2
        return 1
    }
    printf '%s\n' "$out"
}

window_up() { # kept as a name for callers; asks "does the seat's tab exist?"
    [ -n "$(seat_tab_id "$1")" ]
}

# Herdr's agent_status is the answer km used to derive from pgrep + pane
# grep. Values: idle | working | blocked | done | unknown. A pane with no
# agent reporting carries the literal string `unknown`.
#
# It lives at result.pane.agent_status. This read was one level too shallow,
# at result.agent_status, from the herdr migration until 2026-08-29 — and a
# missing key is not a parse error, so the `.get(...,'unknown')` default that
# stood here answered `unknown` for every pane in the town and never once
# said so. Measured on the live workspace that day (bd gqlc-jvlu): km read
# `unknown` for all 16 seats while herdr reported idle, working or done for
# all 16. seat_session_live therefore never returned true in its life, and
# seat_runner_start's trample guard never fired, so `herdr pane run` typed
# km-seat's command line into working citizens' prompt boxes and they obeyed
# it. So there is no default here any more: a payload this does not
# understand is `unreadable`.
#
# `unreadable` is not `unknown`, and the gap between them is a safety
# direction. `unknown` is a positive report that no agent is running, which
# seat_runner_start reads as permission to launch on top of the pane.
# Answering that for a payload we failed to read is exactly how the next
# herdr shape change re-arms this defect silently.
seat_agent_status() { # <seat> -> idle|working|blocked|done|unknown|unreadable
    local pane status
    # The same direction as the pane-get read below, for the same reason: a
    # pane id we could not look up is not a seat with no session. This arm
    # answered `unknown` until 2026-08-29, so the paragraph above ("unreadable
    # reads live") held only when the unreadable payload was pane-get's — an
    # unreadable tab or pane LIST reached the callers as a false dead, which is
    # the error that ends a citizen's session under her (bd gqlc-cp40).
    pane=$(seat_pane_id "$1") || {
        echo "km: seat $1: no pane id could be resolved, so km cannot tell whether a session is running. Treating the seat as occupied." >&2
        echo unreadable
        return 0
    }
    # An absent pane is not an unreadable one: there is no session because
    # there is nowhere for one to be, and seat_runner_start makes the pane.
    [ -n "$pane" ] || { echo unknown; return 0; }
    status=$(herdr pane get "$pane" |
        python3 -c "import json,sys; print(json.load(sys.stdin)['result']['pane']['agent_status'])" 2>/dev/null) || {
        echo "km: seat $1: cannot read agent_status from herdr (pane $pane). If herdr wrote a reason above this line, that is the cause. If it wrote nothing, herdr answered and its payload no longer carries result.pane.agent_status. Treating the seat as occupied." >&2
        echo unreadable
        return 0
    }
    echo "$status"
}

# A live SESSION is claude actually running in the pane. The status is set BY
# claude's hook, so any status at all means claude is up; `done` means the
# last turn finished with the process still around for more input.
#
# Written as "everything but the one value that positively denies a session"
# rather than as a list of the four live states, because this predicate's two
# errors do not cost the same. A false live holds a respawn or a worktree
# refresh, which the next pass retries and a human can see. A false dead ends
# a citizen's session under her. So `unreadable` reads live, and so does any
# status herdr adds after this was written.
seat_session_live() {
    case "$(seat_agent_status "$1")" in
        unknown) return 1 ;;
        *) return 0 ;;
    esac
}

# Under tmux the runner check was `pgrep km-seat` on the pane's tty. Under
# herdr, agent_status is `unknown` when claude isn't running — including when
# km-seat is parked between wakes, which is the HEALTHY asleep state, not a
# dead runner. So the coarser check WAS the right one for a while, and it is
# not any more. A pane outlives its command: herdr keeps the pane after any
# child exits, so once km-seat exits (crash, `exec` under a stale hooks path,
# or a stray fish command completing while nobody parked afterwards) the
# pane stays and this check reads alive against nothing. Measured 2026-08-29
# (gqlc-2vxs): 14 of 16 seats' panes existed with NO km-seat process behind
# them, dispatch skipped them all as "wake queued already", cmd_wake and
# cmd_reconcile refused to respawn because both gate on this predicate, and
# `km reconcile` printed "0 runner(s) respawned" with the corpses in front of
# it — the town's characteristic 0-over-a-dead-query shape a third time.
#
# So we ask what actually distinguishes dead from parked: whether a km-seat
# process for THIS seat exists at all. `bash km-seat <seat>` sleeping in its
# `until [ -s wake ]` loop still shows in the process table, so a parked seat
# still reads alive. Only a seat with no km-seat anywhere in ps reads dead —
# which is the population cmd_up's respawn was written for. The trailing
# boundary `([[:space:]]|$)` stops `km-seat ar` from matching `km-seat
# aramazd`; the leading `/km-seat` stops the pattern from matching
# `km-seat-ox` or `km-overlap` if either is ever a seat name.
#
# `agent_status = unknown` still means "claude is not running", including for
# a healthily parked seat, so it is not the tell — the tell is process
# presence, exactly as the tmux era had it. What the herdr migration bought
# us is that the pane persists across a crashed km-seat, which is the whole
# reason we need to distinguish presence at all.
seat_runner_live() { # <seat>
    pgrep -f "/km-seat[[:space:]]+$1([[:space:]]|\$)" >/dev/null 2>&1
}

# Age in seconds of a seat's wake file, empty if none. This is the town's
# fallback tell for the case seat_runner_live gets wrong — a healthy km-seat's
# `until [ -s wake ]; sleep 5` drains its file within ten seconds, so a wake
# older than that is evidence something is not reading, and the age keeps
# climbing until someone acts. Deliberately not gated on the predicate above:
# the whole point of gqlc-2vxs's second finding is that whatever replaces
# seat_runner_live will grow its OWN blind spot, and this cell is what catches
# it. Named at the seat helpers rather than inline in cmd_status because
# cmd_reconcile is the second natural caller once this bead has a partner —
# leaving that partner unwritten now, but not putting the helper somewhere it
# would have to be lifted.
seat_wake_queue_age() { # <seat> -> seconds since mtime, or empty
    local f
    f="$(seat_home "$1")/wake"
    [ -f "$f" ] || return 0
    printf '%d' $(( $(date +%s) - $(stat -c %Y "$f") ))
}

# ---------- seat launch conformance ----------
#
# Every instrument this town had reported on INTENT. `km cfg claude
# permission_mode` answered `bypassPermissions` and was telling the truth about
# kingdom.toml while fifteen of sixteen running sessions contradicted it: bare
# `claude --resume <uuid>`, no --permission-mode, no --append-system-prompt, no
# --model. So they froze on modals nobody was there to answer, ran without their
# souls, and ran as the wrong model — three Ճարտարապետներ and three Դատաւորներ
# configured as claude-fable-5 were all on the default. `km status` called them
# awake and healthy for a whole day (bd gqlc-8dsa; the restart that fixed them
# was ordered by Անդրանիկ).
#
# So this reads the PROCESS. It is the only check here that does, and that is
# the entire point of it: nothing else in km can tell a seat launched by km-seat
# from one somebody resumed by hand.
#
# REPORT ONLY, never remediate. Fixing a mis-launched session means ending it,
# and a citizen's session is not km's to end on a timer (Constitution VI.2).
#
# The seat's claude is FOUND by cwd. km-seat cds to the worktree before exec'ing
# claude, so the seat's tree is the process's cwd — and, unlike a walk down from
# the km-seat pid, that still finds a session somebody started by hand in the
# pane, which IS the population this exists for. herdr knows the pane but
# reports no pid, so it cannot answer this.
#
# Ancestry then does one job only: a claude descended from another claude in the
# same worktree is that session's own child, not a second session. Claude Code
# forks before exec'ing its tools, and inside the fork/exec window the child
# still reads exe=claude and cwd=the worktree while carrying a COPY of the
# parent's argv — conforming, not merely indistinguishable. Measured over 300s
# of the live sixteen-seat town on 2026-08-29: 33 such extras across 9 seats (32
# caught mid-fork on their way to becoming a grep, one a citizen's own
# `claude --help`), 23510 sightings, every one of them descended from that
# seat's own session and not one ambiguous. Without this filter km doctor went
# red at random on a healthy town, and a permanently red gate is one nobody
# reads. Two INDEPENDENT claudes in one worktree still say '?': that is the
# two-live-turns-on-one-tree hazard, and it is worth the alarm.
seat_launch_probe() { # <worktree> <want-model> <want-effort> <want-permission-mode> -> "<code>\t<detail>"
    KM_LAUNCH_WT=$1 KM_LAUNCH_MODEL=$2 KM_LAUNCH_EFFORT=$3 KM_LAUNCH_PM=$4 python3 -c '
import os, sys

wt      = os.path.realpath(os.environ["KM_LAUNCH_WT"])
model   = os.environ["KM_LAUNCH_MODEL"]
effort  = os.environ["KM_LAUNCH_EFFORT"]
pm      = os.environ["KM_LAUNCH_PM"]
LEVELS  = ("low", "medium", "high", "xhigh", "max")

def argv_of(pid):
    with open("/proc/%s/cmdline" % pid, "rb") as f:
        raw = f.read()
    parts = raw.split(b"\0")
    if parts and parts[-1] == b"":
        parts.pop()
    return [p.decode("utf-8", "replace") for p in parts]

def ppid_of(pid):
    # Field 4 of stat. comm sits in parens and may itself contain one, so the
    # split starts after the LAST close paren.
    with open("/proc/%s/stat" % pid) as f:
        return f.read().rpartition(")")[2].split()[1]

found = []
try:
    pids = [d for d in os.listdir("/proc") if d.isdigit()]
except OSError as e:
    print("?\tthe process table could not be read (%s), so no seat could be judged" % e)
    sys.exit(0)
for pid in pids:
    try:
        exe = os.path.basename(os.readlink("/proc/%s/exe" % pid))
        argv = argv_of(pid)
        if exe != "claude" and (not argv or os.path.basename(argv[0]) != "claude"):
            continue
        if os.path.realpath(os.readlink("/proc/%s/cwd" % pid)) != wt:
            continue
        ppid = ppid_of(pid)
    except OSError:
        continue          # it exited, or is not ours to read; not this seat s answer
    found.append((pid, ppid, argv))

if not found:
    # FAIL LOUD. gqlc-jvlu is one line long: a lookup that cannot read its input
    # must not answer with the value that means fine. The caller has already
    # established that herdr reports a live agent in this pane, so an absent
    # process is a contradiction, not an idle seat.
    print("?\therdr reports a live agent in this pane but no claude process runs in %s, so nothing could be compared" % wt)
    sys.exit(0)
cand = set(pid for pid, _, _ in found)
roots = []
for pid, ppid, argv in found:
    cur, descends = ppid, False
    for _ in range(64):
        if cur in cand:
            descends = True
            break
        if cur in ("0", "1"):
            break
        try:
            cur = ppid_of(cur)
        except OSError:
            break     # the parent exited mid-walk; this one stays a root
    if not descends:
        roots.append((pid, argv))

if len(roots) != 1:
    # Named rather than resolved by picking one. Two INDEPENDENT claudes in one
    # worktree is the two-live-turns-on-one-tree hazard and deserves the alarm;
    # guessing between them would let a conforming stray vouch for a
    # mis-launched citizen.
    print("?\t%d claude processes run in %s, %d of them descended from no other (pids %s); which one is the seat is not something this can decide"
          % (len(found), wt, len(roots), ", ".join(p for p, _ in roots) or "none"))
    sys.exit(0)

argv = roots[0][1]

def flag(name):
    """The value of --name, as a space pair or --name=value. None if absent."""
    for i, a in enumerate(argv):
        if a == name:
            return argv[i + 1] if i + 1 < len(argv) else ""
        if a.startswith(name + "="):
            return a[len(name) + 1:]
    return None

codes, says = [], []

got = flag("--permission-mode")
if got is None:
    codes.append("P"); says.append("no --permission-mode (want %s), so it prompts and waits for somebody at the pane" % pm)
elif got != pm:
    codes.append("P"); says.append("--permission-mode %s, want %s" % (got or "<empty>", pm))

got = flag("--append-system-prompt")
if got is None:
    codes.append("S"); says.append("no --append-system-prompt, so this citizen is running with no soul")
elif not got.strip():
    codes.append("S"); says.append("--append-system-prompt is empty, so this citizen is running with no soul")

got = flag("--model")
if got is None:
    codes.append("M"); says.append("no --model (want %s), so it runs on whatever claude defaults to" % model)
elif got != model:
    codes.append("M"); says.append("--model %s, want %s" % (got or "<empty>", model))

# --effort is the one axis where DIFFERENT is legal. A bead carrying an
# effort:<level> label wakes its seat at that level instead of the class
# default, and Constitution V.6.2 lets any citizen write one without asking
# (km-seat honours it; bd gqlc-jmwh). So equality with the class default would
# go red for a seat launched exactly as the town intends, and a permanently red
# gate is one nobody reads. What is asserted is what nobody may legitimately
# do: launch with no level at all, or with one claude does not take. A level
# that merely DIFFERS from the class default is not reported at all — it is
# what a legitimate escalation looks like, and V.6.6 records depth on the bead.
#
# When the class has no valid level configured, km-seat launches with no
# --effort by design (valid_effort drops it), so absent is correct there and
# the whole axis is skipped rather than inverted.
got = flag("--effort")
if effort in LEVELS:
    if got is None:
        codes.append("E"); says.append("no --effort (the class default is %s)" % effort)
    elif got not in LEVELS:
        codes.append("E"); says.append("--effort %s is not a level claude takes" % (got or "<empty>"))

print("%s\t%s" % ("".join(codes) if codes else "ok", "; ".join(says)))
'
}

# The per-seat verdict, with the expectations resolved from kingdom.toml — the
# same file km-seat reads at launch, so this compares the process against the
# town s own configuration and not against a value spelled twice.
#
# A seat with NO live agent is `-` and never a failure: it is asleep, which is
# legal, and conflating absent with wrong is exactly what gqlc-jvlu was.
seat_launch_state() { # <seat> -> "<code>\t<detail>"
    local pm
    seat_session_live "$1" || { printf -- '-\t\n'; return 0; }
    pm=$(cfg claude permission_mode)
    # km-seat's own default when the key is missing, read here rather than
    # spelled a second time to differ from it later (km-seat:24-25).
    : "${pm:=bypassPermissions}"
    seat_launch_probe "$(seat_worktree "$1")" "$(seat_model "$1")" "$(cfg effort "$(seat_class "$1")")" "$pm"
}

# Bring a fresh km-seat back for a seat. Uses `herdr pane run` to launch the
# runner as a CHILD of the pane's shell (fish per herdr config) rather than
# `exec`ing over the shell — if km-seat exits unexpectedly under `exec`, the
# pane closes with it, and herdr reaps the workspace when its last pane is
# gone. As a child, a failure leaves the shell at its prompt, with the error
# visible, and the pane still exists to be repaired.
#
# `herdr agent start` was tempting but creates a NEW pane in the tab even
# when one exists, so each cmd_up left two panes per tab (measured
# 2026-08-29). Reusing the pane herdr already made for the tab is what keeps
# the "one pane per seat" invariant this town's roster and status expect.
#
# THE RETURN IS WITNESSED, not acked. `herdr pane run` TYPES a command line at
# the pane and reports on the typing; it cannot report on what ran, because
# whatever has the pane's foreground reads those bytes. So its exit status was
# the wrong thing to return, and returning it made a repair that had done
# nothing indistinguishable from one that worked. Measured 2026-08-29 (bd
# gqlc-c48e): 14 seats had been resumed by hand with `claude --resume` typed at
# their panes, so the pane's foreground was claude, and every respawn's command
# line went into claude's prompt box. cmd_reconcile printed "14 runner(s)
# respawned" and did so again two minutes later, and again, across 77 dispatch
# runs over 2h48m, while nothing was parked on any wake file. The town's
# 0-over-a-dead-query shape inverted: 14 over a dead repair, which is worse,
# because a counter climbing is read as recovery in progress.
#
# The trample guard above cannot cover that population and is not being asked
# to. A hand-run claude carries no herdr agent record, so agent_status reads
# `unknown` and seat_session_live reads that as "no session" — the guard is
# blind to exactly the case that creates the hazard. The witness below is what
# holds regardless of why the command line failed to become a process.
#
# THREE outcomes, because two callers report the refusal in words: 0 the runner
# is there, 1 declined without trying (a live session, VI.2), 2 tried and no
# runner appeared. Collapsing 2 into 1 is what would put "$s has a live
# session" in front of an operator whose seat has none.
#
# 3 seconds is a witness budget, not a timeout to tune: on 2026-08-29T15:52Z
# fifteen runners went from `herdr pane run` to visible in ps within 2 seconds
# of each other (sequential pids, `ps -o lstart`), so a runner that is coming
# is here at once. The cost of the budget is paid only when the respawn has
# already failed.
seat_runner_start() { # <seat> -> 0 started, 1 declined (live session), 2 no runner appeared
    seat_session_live "$1" && return 1
    local ws pane tab wt sd waited
    ws=$(workspace_id); [ -n "$ws" ] || return 2
    wt=$(seat_worktree "$1")
    # The rc, not the emptiness. `[ -z "$(seat_tab_id "$1")" ]` stood here and
    # read an unreadable tab list as "this seat has no tab", so a herdr shape
    # change would have minted one tab per seat on every wake, reconcile and
    # dispatch pass, unbounded, with the parse's diagnosis eaten (gqlc-cp40).
    tab=$(seat_tab_id "$1") || return 2
    if [ -z "$tab" ]; then
        herdr tab create --workspace "$ws" --label "$1" --cwd "$wt" --no-focus >/dev/null 2>&1 || return 2
    fi
    pane=$(seat_pane_id "$1"); [ -n "$pane" ] || return 2
    # Thread km's KM_STATE_DIR into the pane's env so km-seat agrees with km
    # about which state to work with. Without this, km-seat re-derives it from
    # the pane's cwd (a seat worktree → main_root → the shared kingdom-state)
    # and diverges from a test override, which reproduces the 2026-08-29
    # incident where a test workspace's km-seats claimed real wakes.
    sd=$(state_dir)
    herdr pane run "$pane" "KM_STATE_DIR=$sd $SCRIPT_DIR/km-seat $1" >/dev/null 2>&1 || return 2
    waited=0
    while [ "$waited" -lt 15 ]; do
        seat_runner_live "$1" && return 0
        sleep 0.2
        waited=$((waited + 1))
    done
    echo "km: $1: herdr accepted the km-seat command line for pane $pane, but no km-seat process appeared within 3s. The pane's foreground is something other than a shell, so it read those bytes instead — a claude started by hand is the known case, and it is invisible to agent_status, so the live-session guard could not decline. Read the pane and start the runner there (bd gqlc-c48e)." >&2
    return 2
}

# claude's TUI draws the input box between the last two horizontal rules of the
# visible buffer. Empty means what was typed has been submitted; anything else
# is text still sitting there. Measured 2026-08-29 on a scratch pane, and the
# render is the same shape while the agent is `working`, which send_line allows
# (bd gqlc-gh7xj).
#
# The bare prompt glyph is the empty box, not content. It is compared as a whole
# trimmed line rather than stripped by a regex so that the multibyte character
# never reaches one.
#
# Exit 1 means no box was found. That is not the same answer as an empty box and
# no caller may read it as one.
#
# It was also not the same answer as a pane that could not be read, and until
# gqlc-p7l0u those two shared it. The read sat inside the pipeline with its
# stderr dropped, so a failing `herdr pane read` gave awk nothing, n stayed 0,
# and awk exited 1 — byte-identical to "the pane rendered and had no box", with
# the reason that separates them discarded. The read is taken out of the
# pipeline so its own status is legible, and unreadable is a third answer.
# 2>&1 rather than dropping stderr: measured 2026-08-30 against herdr 0.6.10,
# `pane read <bad>` exits 1 with 0 bytes on stdout and its reason on stderr —
# and which stream carries a diagnosis is herdr's to change, so both are kept.
seat_box_text() { # <pane> -> 0 read it, 1 the buffer holds no box, 2 unreadable
    local buf
    buf=$(herdr pane read "$1" --source visible --lines 60 2>&1) || {
        echo "km: cannot read pane $1: ${buf:-herdr gave no diagnosis on either stream}" >&2
        return 2
    }
    # A rule is bare OR carries the tab label km writes in seat_runner_start,
    # which renders inside the box's TOP edge: `─── Աստղիկ ──`. Matching only
    # the bare form found one edge on every seat in the town and none of the
    # region between them (gqlc-6re91). The optional group is anchored at both
    # ends so a line that merely CONTAINS a rule run is not an edge: a spurious
    # edge shrinks the region, and a region that reads empty when it is not is
    # what makes send_line type onto a citizen's draft.
    printf '%s\n' "$buf" | awk '
        /^─+( .* ─+)?$/ { edge[++n] = NR }
        { line[NR] = $0 }
        END {
            if (n < 2) exit 1
            for (i = edge[n - 1] + 1; i < edge[n]; i++) {
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", line[i])
                if (line[i] != "" && line[i] != "❯" && line[i] != ">") print line[i]
            }
        }'
}

# Why a tool call has not come back, when the pane says so. MARK, never act:
# nothing downstream consumes this word, it goes into the WEDGED line so a
# citizen can decide whether the pane is worth twenty seconds (VI.2). The
# recovery ladder that may act on the same states is gqlc-3evsn's, not this.
#
# It reports what was on the screen at the moment of the read and nothing else.
# `visible` is the only source herdr 0.6.10 accepts — `scrollback`, `history`,
# `full`, `buffer`, `all` and `screen` are all refused with `invalid read
# source` (measured 2026-08-30) — so a modal answered a second before the read
# leaves no trace here at all.
#
# WHICH SAMPLES THIS WAS BUILT FROM, and the limits of that:
#   - the usage-limit wall, 14 first-hand captures across every other seat in
#     the town on 2026-08-30, all reading `You've hit your limit · resets
#     11:50pm (America/New_York)` over `/extra-usage to finish what you're
#     working on.` gqlc-3evsn's earlier capture of the same wall separates the
#     clause with a hyphen where these use `·`, which is exactly why the match
#     is on the two fixed fragments and not on either whole line.
#   - the consent modal, from the capture filed on gqlc-5ojel (Աստղիկ, frozen
#     1h54m): `Dangerous rm operation ...` over `Do you want to proceed?` over
#     `> 1. Yes  2. No`. That is one heuristic's wording; the harness's set of
#     modals is not enumerable from outside it, so the match is on the SHAPE
#     the dialog shares — an interrogative line plus a numbered option list —
#     and deliberately not on `Dangerous`. Both are required, because prose
#     asking a question is common and prose asking a question above a numbered
#     list is not.
#   - a tool genuinely in flight, first-hand from this seat's own pane during a
#     Bash call: a spinner line and `Running 1 shell command…`, carrying
#     neither marker. That is the `unknown` arm, and it is the arm that says km
#     cannot tell a slow command from a hung one.
# A modal nobody here has seen will read `unknown`. That is the honest answer
# and it is the answer km gives today for every state.
#
# Always exits 0, and the failures are words rather than statuses. km runs
# `set -e` and the caller interpolates this into an assignment at statement
# level, where a non-zero return ends cmd_status mid-table (bd gqlc-nvbd3).
seat_wedge_reason() { # <seat> -> consent | limit | unknown | unreadable | no-pane
    local pane buf
    pane=$(seat_pane_id "$1" 2>/dev/null) || { echo unreadable; return 0; }
    [ -n "$pane" ] || { echo no-pane; return 0; }
    buf=$(herdr pane read "$pane" --source visible --lines 60 2>/dev/null) || {
        echo unreadable
        return 0
    }
    # The LOWER marker wins, not the first one found. A pane holds the whole
    # visible screen, so a modal that was answered minutes ago is still up
    # there above whatever the seat is doing now; the state the operator is
    # being told about is the one nearest the prompt.
    # Two fragments for each state, both required, and the position of a state
    # is its lower fragment. Either fragment alone is prose a citizen could
    # plausibly write — `/extra-usage` and `Do you want to` both appear in this
    # repo's own bead descriptions — so one of them on its own buys a false
    # positive in exchange for nothing, `unknown` already meaning "look".
    printf '%s\n' "$buf" | awk '
        index($0, "hit your limit") { hit = NR }
        index($0, "/extra-usage") { xtr = NR }
        index($0, "Do you want to") { ask = NR }
        /^[[:space:]]*[>❯]?[[:space:]]*[0-9]+\.[[:space:]]/ { opt = NR }
        END {
            if (hit && xtr) lim = (hit > xtr ? hit : xtr)
            if (ask && opt) con = (ask > opt ? ask : opt)
            if (con && con > lim) { print "consent"; exit }
            if (lim) { print "limit"; exit }
            print "unknown"
        }'
}

# Both directions of this settle by the second read, 3 of 3 trials, so ten reads
# is roughly a tenfold margin (bd gqlc-gh7xj). The sleep is the poll interval.
# It is ordered first because typing takes those same two reads to appear, so a
# read taken immediately could find the box empty merely because nothing had
# rendered yet — but that is a cheap guard, not a measured necessity: deleting
# the sleep outright did not produce a false empty on the same rows, the pane
# read's own round trip being slower than the render.
seat_box_emptied() { # <pane> -> 0 emptied, 1 holds text, 2 no box, 3 unreadable
    local left=10 box rc=2
    while [ "$left" -gt 0 ]; do
        left=$((left - 1))
        sleep 0.2
        # `|| rc=$?` rather than a bare call and `rc=$?`. km runs `set -e`, and
        # -e is suspended only for the dynamic extent of a function evaluated in
        # a condition. A bare `box=$(...)` here is a statement, so a pane that
        # cannot be read ends the shell inside the first turn and the poll's
        # other nine never happen — the mechanism would work only for callers
        # who happened to write `if`. Same at the two reads in send_line and at
        # cmd_reconcile's session_up (bd gqlc-nvbd3).
        rc=0
        box=$(seat_box_text "$1") || rc=$?
        # An unreadable pane is not a state the poll can outwait, and every turn
        # would re-emit herdr's account of it. Nine more reads and two more
        # seconds buy nothing, so the first one ends the poll.
        if [ "$rc" -eq 2 ]; then return 3; fi
        [ "$rc" -eq 0 ] || continue
        [ -n "$box" ] || return 0
    done
    [ "$rc" -eq 0 ] && return 1
    return 2
}

# `herdr agent send` writes the text and `pane send-keys` writes the Enter, and
# both go down the pane's pty as ordinary bursts. There is no socket path that
# bypasses the tty — this comment claimed one until 2026-08-29 — and herdr emits
# no bracketed-paste markers even when the application has enabled DECSET 2004,
# so claude cannot tell either call from a human typing and falls back to
# guessing by burst size. Measured against herdr 0.6.10 with a raw-tty reader in
# a scratch pane (bd gqlc-bi7n): the two writes arrive as SEPARATE bursts while
# the far side is sitting in read(), and coalesce into ONE when it is not.
#
# That matters because claude takes a single burst of 64 characters or more as a
# paste and renders its trailing CR as a literal newline. So a coalesced pair
# carrying a long message is typed and never submitted, while both calls return
# rc=0. On a live pane, one burst of 63 characters submits and one of 64 strands,
# 6 of 6 trials. The nudge text every caller here sends is well over 64.
#
# The failure is therefore a race on the far side's read loop, not a property of
# a pane or a seat: 26 of 26 back-to-back sends submitted against a live claude,
# idle and busy alike, so the rate is low and is NOT characterised. That rate is
# why the acks are not merely incomplete but untestable by repetition — a run of
# uniform successes is what the defect looks like — so the send is witnessed
# rather than retried: seat_box_emptied reads the box back, and a box that still
# holds the text gets one lone Enter, which submitted it 3 of 3 (bd gqlc-gh7xj).
#
# The signature keeps the `<target>` shape
# callers used with `send_line "=$SESSION:$seat"`, but the target may just be
# the seat name; the wrapper accepts either.
#
# It is addressed by PANE, not by seat name. `herdr agent send <target>` takes
# terminal ids, unique agent names, agent labels and pane ids — and a seat name
# is none of those. km labels TABS with the seat name, in seat_runner_start,
# and never once calls `herdr agent rename`, so no agent in this town has ever
# carried a seat name. Measured 2026-08-29 (bd gqlc-nq78): all 16 agents are
# named the literal `claude`, `agent get aramazd` and `agent get sedrak` both answer
# agent_not_found, `agent get claude` answers agent_target_ambiguous, and the
# pane id for that same seat resolves. So this call failed for every seat, in
# every state, from the herdr migration until that date — and its three callers
# each reported success anyway.
#
# The diagnosis is no longer discarded. herdr signals the failure by exit
# status and puts WHICH failure in a JSON payload on STDERR — measured against
# the deployed binary 2026-08-29 with an unresolvable target: rc=1, stdout 0
# bytes, stderr the {"error":{"code":"agent_not_found",...}} object. A caller
# reading only the status can distinguish "not delivered" from "delivered" and
# nothing finer, and a dispatch tick that died on this call spent forty minutes
# saying nothing at all (bd gqlc-87al). Both streams are captured anyway and
# re-emitted on stderr: which stream carries a diagnosis is herdr's to change,
# and 2>&1 costs nothing to be wrong about.
#
# And `agent send` TYPES; it does not SUBMIT. It returns ok with the text left
# sitting in the agent's input box, where it stays until something presses
# Enter. Both halves witnessed first-party on this seat's own pane, 2026-08-29
# (bd gqlc-nq78, verdict-qo4s-r2): `agent send <pane> <marker>` answered
# {"type":"ok"} and a following `pane read` showed the marker after the prompt,
# unsubmitted; then `pane send-keys <pane> Enter` submitted it and it arrived
# as a message in this session. `agent send` takes no flags on the deployed
# binary, so there is no submit option to ask for instead. An ack is delivery
# of TEXT, and every caller here wants delivery of an EFFECT — a seat asked to
# /exit that does not leave is the account-vs-work defect a second time.
#
# The Enter is guarded, and the guard sits in the primitive rather than in the
# callers because the hazard belongs to the mechanism: Enter on a modal presses
# a button nobody consented to (Constitution VI.2), and cmd_reconcile — the one
# caller with no status check in front of it — sends to seats that may be
# sitting on a permission ask. seat_prompt_visible already draws the line the
# nudge path uses; one guard here covers every caller, including the next one.
#
# What it does not look at is what the box held BEFORE the send. Typing appends,
# so a citizen's half-written draft is silently prefixed to this text and
# submitted with it. seat_box_text would show that if it were called first, so
# the check is cheap and merely absent; it is bd gqlc-6bnkw, not this bead.
send_line() { # <target> <text> -> 0 delivered, 1 not
    local target=$1 text=$2 seat pane out witnessed
    seat=${target##*:}
    pane=$(seat_pane_id "$seat") || pane=
    if [ -z "$pane" ]; then
        echo "km: send to $seat: no pane in the workspace; nothing was sent" >&2
        return 1
    fi
    if ! seat_prompt_visible "$seat"; then
        echo "km: send to $seat: agent_status is $(seat_agent_status "$seat"), so the Enter would answer a modal nobody read; nothing was sent" >&2
        return 1
    fi
    out=$(herdr agent send "$pane" "$text" 2>&1) || {
        echo "km: send to $seat (pane $pane) failed: ${out:-herdr gave no diagnosis on either stream}" >&2
        return 1
    }
    out=$(herdr pane send-keys "$pane" Enter 2>&1) || {
        echo "km: send to $seat (pane $pane): the text was typed, but the Enter that submits it failed: ${out:-herdr gave no diagnosis on either stream}. It is sitting unsent in her prompt box" >&2
        return 1
    }
    witnessed=0
    seat_box_emptied "$pane" || witnessed=$?
    [ "$witnessed" -eq 0 ] && return 0
    if [ "$witnessed" -eq 2 ]; then
        echo "km: send to $seat (pane $pane): herdr acked the text and the Enter, but the pane renders no input box, so the submission was not witnessed and is being reported as delivered (bd gqlc-gh7xj)" >&2
        return 0
    fi
    # Unreadable is reported as delivered too, but it is a different sentence
    # because it is a different thing to have seen: above, a pane that rendered
    # with no box in it; here, no reading of the pane at all. Delivered rather
    # than not, on the same reasoning as the branch above and one more: `km
    # sleep` sends `/exit` and prints "the /exit was NOT delivered" on a
    # non-zero return, and a pane that has gone away between the Enter and the
    # read is most easily explained by that /exit having worked. That is a
    # judgement about which way to be wrong, not a measurement (gqlc-p7l0u).
    if [ "$witnessed" -eq 3 ]; then
        echo "km: send to $seat (pane $pane): herdr acked the text and the Enter, but the pane could not be read back (herdr's own account of it is above), so the submission was not witnessed and is being reported as delivered" >&2
        return 0
    fi
    herdr pane send-keys "$pane" Enter >/dev/null 2>&1
    witnessed=0
    seat_box_emptied "$pane" || witnessed=$?
    if [ "$witnessed" -eq 3 ]; then
        echo "km: send to $seat (pane $pane): herdr acked the text and both Enters, but the pane could not be read back (herdr's own account of it is above), so the submission was not witnessed and is being reported as delivered" >&2
        return 0
    fi
    [ "$witnessed" -eq 1 ] || return 0
    echo "km: send to $seat (pane $pane): herdr acked the text and both Enters, but the box still holds the message, so it was typed and never submitted — claude reads a single burst of 64 or more characters as a paste and renders its trailing CR as a literal newline (bd gqlc-gh7xj). Nothing was delivered" >&2
    return 1
}

# Kept as a query name for callers that want to render the pane to a human.
# Under herdr the pane's visible buffer is what the operator sees in the TUI.
seat_pane() { # <seat> -> the pane's visible buffer
    local pane
    pane=$(seat_pane_id "$1") || return 1
    [ -n "$pane" ] || return 1
    herdr pane read "$pane" --source visible --lines 40 2>/dev/null
}

# Idle == the agent's own report says so. No pane scraping, no reconciling
# "esc to interrupt" strings, no false-idle on a mid-tool-call — herdr's
# hook fires at the states claude passes through.
seat_pane_idle() { # <seat>
    [ "$(seat_agent_status "$1")" = idle ]
}

# Whether the agent is available to receive text. `blocked` means the agent
# is on a modal (permission ask, usage-limit); `unknown` means claude isn't
# reporting, which includes the "no agent at all" case. Both refuse the send.
seat_prompt_visible() { # <seat>
    case "$(seat_agent_status "$1")" in
        idle | working | done) return 0 ;;
        *) return 1 ;;
    esac
}

# Under tmux, "did the nudge land" required scraping the prompt buffer for the
# typed text, because a tty burst could strand it half-typed with nothing but
# the buffer to say so. send_line reports a stranded send itself now — by
# scraping that same buffer, its Enter half having been the thing that could
# strand one (bd gqlc-gh7xj) — so this is kept as an alias that always answers
# "no, nothing stranded", and callers whose logic was "if the nudge was
# stranded, requeue" take the delivered branch.
seat_prompt_holds_nudge() { return 1; }

# Send + confirm was the tty-workaround shape. The confirmation lives inside
# send_line now: it types, submits, and says which of the two failed. This is a
# naming wrapper over that and nothing more.
seat_nudge() { # <seat> <text> -> 0 delivered, 1 refused
    send_line "$1" "$2"
}

# Minutes from the config, in seconds, with a default that survives a missing or
# malformed value. Fail-open and quiet is right for these two: both govern a
# REPORT and neither ends a session, so the worst a wrong value does is print a
# marker early or late, and a config typo that stopped the dispatcher would be
# the larger failure by far.
cfg_minutes() { # <section> <key> <default minutes> -> seconds
    local v
    v=$(cfg "$1" "$2")
    case "$v" in '' | *[!0-9]*) v=$3 ;; esac
    echo $((v * 60))
}

# How many times the idle pass asks ONE seat in a single episode before it stops
# typing and mails sedrak instead. Fail-open to 3 for the same reason cfg_minutes
# does. A cap of 0 escalates before ever asking, and the digit guard does not
# refuse it: `00` is all digits, so it reaches the comparison below, which is what
# catches it.
recover_cap() {
    local v
    v=$(cfg welfare recover_attempts)
    case "$v" in '' | *[!0-9]*) v=3 ;; esac
    [ "$v" -gt 0 ] || v=3
    echo "$v"
}

# Seconds since the statusLine hook last wrote this seat's heartbeat, from the
# file's own `updated` field rather than its mtime — the field is what the
# writer states, and a copied or restored state dir would give an mtime that
# means nothing. rc 1 for "unknown", which every caller must render as unknown
# and not as zero.
# Can this seat report at all? heartbeat.json is written by no heartbeat script:
# it is a side effect of kingdom/bin/km-statusline, which runs only because
# .claude/settings.json names it as the statusLine command. BOTH are TRACKED
# files, so whether a seat can report its liveness is a property of the COMMIT
# its worktree is parked on — not of the seat, the machine, or the session. A
# worktree on a branch that forked before the kingdom landed has neither file
# and goes silent while working (measured 2026-08-22 on Վահագն, who had worked
# all night: fifteen seat worktrees, one of them without the key, and the
# welfare round could not read the one seat it most wanted to).
#
# That matters because an absent heartbeat is otherwise overloaded three ways —
# idle (no action), misconfigured (the instrument is blind), and WEDGED, which
# is the case the welfare round exists to catch — and the board resolved all
# three as the first. A detector whose failure mode is indistinguishable from
# its all-clear is not a detector. This separates the second arm out so it can
# be named.
#
# Fail-closed: a worktree that is absent, or that cannot be read, is not
# evidence that the wiring is there.
seat_can_report() { # <seat> -> 1 if its checkout cannot write a heartbeat
    local wt
    wt=$(seat_worktree "$1")
    [ -d "$wt" ] || return 1
    [ -f "$wt/kingdom/bin/km-statusline" ] || return 1
    grep -qs '"statusLine"' "$wt/.claude/settings.json" "$wt/.claude/settings.local.json"
}

heartbeat_age() { # <seat> -> seconds
    local f t now
    f="$(seat_home "$1")/heartbeat.json"
    [ -f "$f" ] || return 1
    t=$(jq -r '.updated // empty' "$f" 2>/dev/null) || return 1
    [ -n "$t" ] || return 1
    t=$(date -u -d "$t" +%s 2>/dev/null) || return 1
    now=$(date +%s)
    echo $((now - t))
}

# ---------- the progress witness ----------
#
# The heartbeat above answers "is a process alive". It CANNOT answer "is this
# seat doing anything", and the comment at status_unresponsive_after is careful
# about why: km-statusline goes on writing all through a wedged turn, so a seat
# frozen on a modal inside a tool call has a heartbeat as fresh as a seat doing
# real work (gqlc-n97e, 13+ minutes measured; gqlc-eier, 80 and 152).
#
# progress.json is the other half. It is written by .githooks/claude-tool-witness
# on PreToolUse and PostToolUse and by nothing else — no timer, no statusline, no
# daemon — so its `last_progress` field advances only when a tool call actually
# FINISHED. That is the whole design: an instrument that ticks on a schedule
# vouches for the schedule, and this town has been burned by that shape four
# times in one night.
progress_field() { # <seat> <jq field> -> value on stdout, rc 1 if unreadable
    local f v
    f="$(seat_home "$1")/progress.json"
    [ -f "$f" ] || return 1
    v=$(jq -r "$2 // empty" "$f" 2>/dev/null) || return 1
    [ -n "$v" ] || return 1
    printf '%s\n' "$v"
}

# Seconds since a stamp field in progress.json. rc 1 for unknown, never 0 — a
# zero would be the most reassuring possible rendering of a file nobody can read,
# which is the lesson the HB column already had to be taught (gqlc-eier).
progress_age() { # <seat> <.last_start|.last_progress> -> seconds
    local t now
    t=$(progress_field "$1" "$2") || return 1
    t=$(date -u -d "$t" +%s 2>/dev/null) || return 1
    now=$(date +%s)
    echo $((now - t))
}

# Is a tool call in flight? Timestamps decide it, not the started/completed
# counters the witness also keeps: a start strictly LATER than the newest finish
# is exactly "something began and has not come back". The counters are there for
# a human reading the file and are deliberately not the test — a lost increment
# (a killed hook, a hand edit) would wedge the reading permanently, where a stamp
# comparison self-heals at the seat's next tool call.
seat_tool_in_flight() { # <seat> -> 0 if a tool call started and has not finished
    local s p
    s=$(progress_age "$1" .last_start) || return 1
    p=$(progress_age "$1" .last_progress) || return 0 # started, never finished
    [ "$s" -lt "$p" ]
}

# Can this seat witness its own progress at all? The same question seat_can_report
# asks of the heartbeat, with the same answer shape and the same reason for
# existing: .githooks/claude-tool-witness and the PostToolUse wiring in
# .claude/settings.json are TRACKED files, so a worktree parked on a commit older
# than this one writes no progress.json — and a silent instrument renders exactly
# like a seat that has completed no tool call, which is the stall this whole path
# exists to name. Fail-closed: a worktree that is absent, or cannot be read, is
# not evidence that the wiring is there.
seat_can_witness() { # <seat> -> 1 if its checkout cannot write a progress witness
    local wt
    wt=$(seat_worktree "$1")
    [ -d "$wt" ] || return 1
    [ -f "$wt/.githooks/claude-tool-witness" ] || return 1
    grep -qs 'claude-tool-witness' "$wt/.claude/settings.json" "$wt/.claude/settings.local.json"
}

# ---------- mail ----------

# mail_box_count <seat> <inbox|read|sent>
#
# The directory guard is load-bearing under `set -o pipefail`: find exits 1 on a
# directory that does not exist, and the whole km run dies mid-table for a box
# nobody has written to yet (gqlc-6wqw). `read/` is missing far more often than
# `inbox/` is, so the counter below would hit it constantly.
#
# That guard answers the cause that was hitting us, not the whole failure. find
# still exits 1 on a directory that EXISTS and cannot be walked — an unreadable
# entry inside it, or the box removed between the test and the walk — and with
# its stderr discarded under `set -o pipefail` that killed the dispatch tick
# with nothing in the journal to read. This is the last instance on a tick path
# of the shape that caused gqlc-w3wb and gqlc-5ybu (gqlc-w375); it is repaired
# here in the fail-loud form km:113 argues for, rather than left as the one the
# third outage comes from.
#
# The partial count is kept rather than replaced with 0. `wc -l` has already
# counted whatever find reached before it stopped, and that number is a FLOOR.
# Zero is the one answer that must not be invented here: "0 unread" is how a
# seat's waiting mail disappears from every board that reads this.
mail_box_count() {
    local d n
    d="$(state_dir)/mail/$1/$2"
    [ -d "$d" ] || { echo 0; return 0; }
    if ! n=$(find "$d" -type f -name '*.md' 2>/dev/null | wc -l); then
        echo "km: WARNING — $d could not be walked in full, so $n is a floor and not a total" >&2
    fi
    echo "$n"
}

# A letter leaves inbox/ in exactly ONE way: mail_read's final `mv`. So this
# number means "unread" only for a reader who drains the box with `km mail read`
# — which every SEAT does, because a seat is a process running that subcommand.
# It means nothing of the kind for the king, and cmd_status says so rather than
# printing the same word over both (gqlc-2abx).
unread_count() {
    mail_box_count "$1" inbox
}

# How many of <sender>'s letters are still sitting in <recipient>'s inbox.
# mail_send writes "<ts>--<from>--<slug>.md", so the sender is in the name and
# no body is read. The caveat on unread_count above applies with full force
# here: for a SEAT this counts letters that outlived at least one of the
# recipient's wakes, and for the king it counts deliveries to a box nobody
# drains (gqlc-2abx). Neither caller passes him as the RECIPIENT: one walks
# seats_all, which excludes him, and the idle escalation names the seat sedrak.
# That pass compares two counts inside a single tick, so the staleness above
# cannot reach it — only a letter arriving in the window can, which is the
# point.
mail_unread_from() { # <recipient> <sender> -> count
    local d
    d="$(state_dir)/mail/$1/inbox"
    [ -d "$d" ] || { echo 0; return 0; }
    find "$d" -maxdepth 1 -type f -name "*--$2--*.md" 2>/dev/null | wc -l
}

mail_deliver() { # write one message file into a recipient's box dir
    local dir=$1 fname=$2 content=$3 tmp
    mkdir -p "$dir"
    tmp=$(mktemp "$dir/.tmp.XXXXXX")
    printf '%s' "$content" >"$tmp"
    if [ -e "$dir/$fname" ]; then
        fname="${fname%.md}-$RANDOM.md"
    fi
    mv "$tmp" "$dir/$fname"
}

mail_send() {
    local to="" subj="" body="" from=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -s) subj=$2; shift 2 ;;
            -m) body=$2; shift 2 ;;
            --from) from=$2; shift 2 ;;
            -*) die "mail send: unknown flag $1" ;;
            *) [ -z "$to" ] || die "mail send: one recipient per message (use 'town' to broadcast)"
               to=${1%/}; shift ;;
        esac
    done
    [ -n "$from" ] || { require_identity "mail send"; from=$KINGDOM_SEAT; }
    [ -n "$to" ] || die "mail send: no recipient"
    [ -n "$subj" ] || die "mail send: -s SUBJECT is required"
    case "$from" in andranik) ;; *) is_seat "$from" || die "mail send: unknown sender $from" ;; esac
    case "$to" in town | andranik) ;; *) is_seat "$to" || die "mail send: unknown recipient $to" ;; esac
    if [ -z "$body" ]; then
        [ ! -t 0 ] || die "mail send: body via -m or stdin"
        body=$(cat)
    fi

    local ts slug fname content sd
    ts=$(date -u +%Y%m%dT%H%M%SZ)
    slug=$(printf '%s' "$subj" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')
    slug=$(printf '%s' "$slug" | sed 's/^-*//; s/-*$//' | cut -c1-40)
    [ -n "$slug" ] || slug=msg
    fname="$ts--$from--$slug.md"
    content=$(printf -- '---\nfrom: %s\nto: %s\ndate: %s\nsubject: %s\n---\n%s\n' \
        "$from" "$to" "$(date -u -Iseconds)" "$subj" "$body")
    sd=$(state_dir)

    local delivered=0 r
    if [ "$to" = town ]; then
        for r in $(seats_all) andranik; do
            [ "$r" = "$from" ] && continue
            mail_deliver "$sd/mail/$r/inbox" "$fname" "$content"
            delivered=$((delivered + 1))
        done
    else
        mail_deliver "$sd/mail/$to/inbox" "$fname" "$content"
        delivered=1
    fi
    mail_deliver "$sd/mail/$from/sent" "$fname" "$content"
    echo "mail: $from → $to ($delivered box(es)): $subj"
}

# The --seat override, or empty for "this session's own box". Resolving the
# empty case is the CALLER's job: this runs inside a command substitution, where
# require_identity's exit would be swallowed.
mail_box_owner() {
    local seat=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --seat) seat=$2; shift 2 ;;
            *) shift ;;
        esac
    done
    echo "$seat"
}

mail_inbox() {
    local seat sd n f
    seat=$(mail_box_owner "$@")
    [ -n "$seat" ] || { require_identity "mail inbox"; seat=$KINGDOM_SEAT; }
    sd=$(state_dir)
    n=$(unread_count "$seat")
    echo "inbox of $seat — $n unread"
    [ "$n" -gt 0 ] || return 0
    for f in "$sd/mail/$seat/inbox/"*.md; do
        printf '  %s\n    %s\n' "$(basename "$f")" "$(grep -m1 '^subject:' "$f" || true)"
    done
}

mail_read() {
    local id="" seat="" sd inbox readdir matches
    while [ $# -gt 0 ]; do
        case "$1" in
            --seat) seat=$2; shift 2 ;;
            *) id=$1; shift ;;
        esac
    done
    [ -n "$seat" ] || { require_identity "mail read"; seat=$KINGDOM_SEAT; }
    [ -n "$id" ] || die "mail read: which message? (filename or unique prefix)"
    sd=$(state_dir)
    inbox="$sd/mail/$seat/inbox"
    readdir="$sd/mail/$seat/read"
    matches=$(find "$inbox" -maxdepth 1 -type f -name "$id*" 2>/dev/null | sort)
    if [ -z "$matches" ]; then
        matches=$(find "$readdir" -maxdepth 1 -type f -name "$id*" 2>/dev/null | sort)
        [ -n "$matches" ] || die "mail read: no message matching '$id' for $seat"
        [ "$(echo "$matches" | wc -l)" -eq 1 ] || die "mail read: ambiguous prefix '$id'"
        echo "(already read)"
        cat "$matches"
        return 0
    fi
    [ "$(echo "$matches" | wc -l)" -eq 1 ] || die "mail read: ambiguous prefix '$id'"
    cat "$matches"
    mkdir -p "$readdir"
    mv "$matches" "$readdir/"
}

mail_sent() {
    local seat sd f
    seat=$(mail_box_owner "$@")
    [ -n "$seat" ] || { require_identity "mail sent"; seat=$KINGDOM_SEAT; }
    sd=$(state_dir)
    echo "sent by $seat:"
    for f in "$sd/mail/$seat/sent/"*.md; do
        [ -e "$f" ] || { echo "  (none)"; break; }
        printf '  %s\n' "$(basename "$f")"
    done
}

cmd_mail() {
    local sub=${1:-}
    shift || true
    case "$sub" in
        send)  mail_send "$@" ;;
        inbox) mail_inbox "$@" ;;
        read)  mail_read "$@" ;;
        sent)  mail_sent "$@" ;;
        *) die "mail: send|inbox|read|sent" ;;
    esac
}

# ---------- wake / sleep ----------

# The queue is a SET of unread reasons, not a log of attempts. A stuck queue is
# re-derived by every dispatcher tick, and km-seat cats the whole file as ONE
# wake, so N identical lines reach the seat as a batch dispatch never sent —
# during the gqlc-2vxs outage Րաֆֆի's file held the guard-round reason six times
# over. The other thirteen orphaned queues held one line each only because
# dispatch happened to skip a seat it had already queued for; that bounding was
# accidental, and this is the one that is not (gqlc-t37m).
#
# Distinct reasons still accumulate: one wake can legitimately name several
# beads, and km-seat walks all of them. So the match is exact — -F and -x, since
# reasons carry regex metacharacters and one reason is often a prefix of
# another, and `--` because a reason may begin with a dash. Absent file is a
# miss, which is the append case.
wake_queue_add() { # <seat> <reason>
    local f
    f="$(seat_home "$1")/wake"
    grep -Fxq -- "$2" "$f" 2>/dev/null || printf '%s\n' "$2" >>"$f"
}

cmd_wake() {
    local seat=${1:-} rc
    shift || true
    is_seat "$seat" || die "wake: unknown seat ${seat:-<none>}"
    local reason=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --bead) reason="bead:$2 $reason"; shift 2 ;;
            --reason) reason="$reason$2"; shift 2 ;;
            *) die "wake: unknown flag $1" ;;
        esac
    done
    [ -n "$reason" ] || reason="a new day"
    mkdir -p "$(seat_home "$seat")"
    if [ "$(seat_status "$seat")" = awake ] && window_up "$seat"; then
        # Through seat_nudge, never bare send_line — the wrapper is the name
        # this path's queue-on-refusal logic is written against. Under tmux the
        # send was a clear/text/Enter tty burst that could re-coalesce and
        # strand itself, and this path had the split without the confirmation,
        # so it printed its cheerful success line while six nudges in a row sat
        # typed and unsent (gqlc-01ev). send_line now types AND presses Enter
        # and returns non-zero if either call fails, which is not the same as
        # delivery. Characterised 2026-08-29 on a consenting pane (bd gqlc-bi7n,
        # and see send_line's own comment): the two writes coalesce into one pty
        # burst whenever the far side is not sitting in read(), and a single
        # burst of 64 characters or more is taken as a paste, so its trailing CR
        # types a newline instead of submitting. Dispatch wake text is not short,
        # so this path can still report a nudge it did not deliver — the
        # gqlc-01ev shape one layer down — while both calls return rc=0. Reading
        # the box back is the answer; it is gqlc-gh7xj and is not done here.
        #
        # Reported, never fatal: route_owners and the mayor's wake both call
        # this from inside cmd_dispatch under `set -e`, so a non-zero return
        # here would take the whole routing run down with it.
        if ! seat_prompt_visible "$seat"; then
            # A nudge ends in Enter, and on a modal Enter presses a button
            # nobody consented to (VI.2). Queued rather than dropped: km-seat
            # reads that queue when the session ends, so declining to type now
            # costs a delay and not the message.
            wake_queue_add "$seat" "$reason"
            echo "wake: $seat is awake but its pane shows no prompt to type at — a modal covers the input box, or the pane cannot be read. NOT nudged: Enter there would choose whichever option is highlighted, and a modal is not consent (VI.2). Queued instead — $reason"
        elif seat_nudge "$seat" "[km] $reason — check bd mail inbox when convenient"; then
            echo "wake: $seat is already awake; nudged instead — typed and submitted"
        else
            wake_queue_add "$seat" "$reason"
            echo "wake: NUDGE UNDELIVERED to $seat — see the diagnosis above for which half failed, and read the pane by hand. Queued to the wake file so the reason outlives the failed send — $reason"
        fi
    else
        wake_queue_add "$seat" "$reason"
        # "queued" was a statement about the QUEUE, and it stayed true while
        # being false about the world: for four hours nothing was parked on
        # Անահիտ's queue to read it (gqlc-6ha4, Article IV.1). So the report is
        # now conditioned on a reader existing, and where one does not, this is
        # the moment to put it back — a wake is exactly when a missing runner
        # starts costing the town something.
        if seat_runner_live "$seat" || ! session_up; then
            # Town down is not a defect: `km up` raises every runner and the
            # queue is read then. Saying so keeps the operator from reading the
            # line below as an incident.
            echo "wake: queued for $seat — $reason"
        else
            seat_runner_start "$seat" && rc=0 || rc=$?
            case "$rc" in
                0) echo "wake: queued for $seat — $reason (nothing was parked on that queue to read it; km-seat respawned — gqlc-6ha4)" ;;
                1) echo "wake: QUEUED UNREAD for $seat — $reason: no km-seat is parked on that queue and the respawn was declined because herdr reports a live session in the window, which cannot be replaced without ending one — or because herdr could not be read, which is declined the same way (see stderr); nobody will read this until that is resolved" ;;
                *) echo "wake: QUEUED UNREAD for $seat — $reason: no km-seat is parked on that queue and the respawn did not take — the command line was accepted and no runner appeared, so nobody will read this until that pane is repaired by hand (gqlc-c48e)" ;;
            esac
        fi
    fi
}

cmd_sleep() {
    local seat="${KINGDOM_SEAT:-}"
    while [ $# -gt 0 ]; do
        case "$1" in
            --seat) seat=$2; shift 2 ;;
            *) die "sleep: unknown flag $1" ;;
        esac
    done
    if [ -z "$seat" ]; then
        echo "sleep: not a seat session (KINGDOM_SEAT unset) — end your session normally"
        return 0
    fi
    is_seat "$seat" || die "sleep: unknown seat $seat"
    mkdir -p "$(seat_home "$seat")"
    # asleep-pending is a request, not a departure, and it stays one until the
    # session actually ends — km-seat writes `asleep` itself when claude exits.
    # `km sleep` cannot confirm its own exit: it runs as a child of the very
    # claude it is asking to leave, so the /exit is not acted on until this
    # command has already returned. Confirmation therefore belongs to
    # `km reconcile`, which is what makes an undelivered request recoverable.
    echo asleep-pending >"$(seat_home "$seat")/status"
    # The guard was `window_up`, which asks whether the seat's TAB exists, while
    # the action it guards needs an agent the send can reach. Different objects:
    # the guard passed, the send failed, and `set -e` took the success echo on
    # the next line with it — exit 1 and a blank screen, with the accurate
    # message unreachable in the else branch (bd gqlc-7bps). The send's own
    # status is the only thing that knows.
    if send_line "$seat" "/exit"; then
        echo "sleep: good night, $(seat_display "$seat") — the session ends when this turn does"
    else
        echo "sleep: $(seat_display "$seat") is recorded asleep-pending, but the /exit was NOT delivered (diagnosis above) — end your session normally; km reconcile settles the ledger"
    fi
}

# ---------- town lifecycle ----------

ensure_state_tree() {
    local sd s
    sd=$(state_dir)
    for s in $(seats_all) andranik; do
        mkdir -p "$sd/mail/$s/inbox" "$sd/mail/$s/read" "$sd/mail/$s/sent"
    done
    for s in $(seats_all); do
        mkdir -p "$sd/seats/$s/handoff/archive"
    done
    mkdir -p "$sd/seats/andranik/handoff/archive"
}

# The raise's own tally, and the sentence that reports it. seat_runner_start is
# three-valued — 0 started, 1 declined because a live session already holds the
# seat, 2 no runner appeared — and both of cmd_up's seat loops folded all three
# into `|| true`. The closing line then counted `seats_all | wc -l`, the ROSTER,
# so `km up` printed the same sentence whether sixteen seats came up, sixteen
# were declined or sixteen failed (gqlc-mit2u).
raise_seats() { # -> "<started> <declined> <failed>" on stdout
    local s rc started=0 declined=0 failed=0
    for s in $(seats_all); do
        # stdout only. These were the town's only two call sites that also
        # dropped stderr, so `km up` printed "the town is up: 16 seats" while
        # every runner spawn was silently refused; the recurring paths (wake,
        # reconcile, dispatch) have always passed it through.
        seat_runner_start "$s" >/dev/null && rc=0 || rc=$?
        case "$rc" in
            0) started=$((started + 1)) ;;
            1) declined=$((declined + 1)) ;;
            *) failed=$((failed + 1)) ;;
        esac
    done
    printf '%s %s %s\n' "$started" "$declined" "$failed"
}

# Declined is not a failure: it means the seat was already live, which is the
# ordinary answer to `km up` on a town that is already up. So the raise is
# empty only when nothing started AND nothing was already there.
raise_report() { # <started> <declined> <failed> -> 0 reported a town, 1 reported none
    local said="$1 started"
    if [ "$2" -gt 0 ]; then said="$said, $2 already live"; fi
    if [ "$3" -gt 0 ]; then said="$said, $3 could not be started (each one's reason is on stderr above)"; fi
    if [ "$1" -eq 0 ] && [ "$2" -eq 0 ]; then
        echo "km: no seat came up: $said. There is a '$WORKSPACE' workspace but no town in it." >&2
        return 1
    fi
    echo "the town is up: $said, all asleep until woken."
}

cmd_up() {
    no_args up "$@"
    have_herdr || die "herdr is not installed, so there is no town to raise (https://herdr.dev)"
    local srv_rc=0
    herdr_server_up || srv_rc=$?
    case "$srv_rc" in
        1) die "herdr server is not running — start it and retry (herdr status server)" ;;
        # Refused either way, but not under a claim km cannot support: raising a
        # town over a server km could not reach would create a second workspace
        # if the first one is in fact there.
        2) die "km could not ask herdr whether its server is running (its own account is above), so it will not raise the town — that could mint a second '$WORKSPACE' workspace over a town already up." ;;
    esac
    ensure_state_tree
    local mr s wt ws tally
    mr=$(main_root)
    for s in $(seats_all); do
        wt=$(seat_worktree "$s")
        if [ ! -d "$wt" ]; then
            git -C "$mr" worktree add --detach "$wt" origin/master
        fi
    done
    # The tab-level hazard's workspace-level twin: an unreadable list reads as
    # "no workspace", and this arm answers that by creating a SECOND workspace
    # under the same label, with sixteen tabs in it. Refuse instead.
    ws=$(workspace_id) || die "cannot read the herdr workspace list, so km cannot tell whether the town is already up — refusing to raise it rather than create a second '$WORKSPACE' workspace on top of the first. The parse's diagnosis is on stderr above."
    if [ -z "$ws" ]; then
        # herdr workspace create returns a workspace with a default root tab
        # whose pane has herdr's own cwd (typically $HOME). The seat loop
        # below wants each tab's pane to start in the SEAT's worktree, so
        # the auto-tab is not reused — the loop creates one tab per seat
        # with --cwd correct. The auto-tab is closed after the loop so the
        # roster does not carry an unlabelled placeholder.
        local created
        # The create is the one step here that must STOP the raise: unlike the
        # two reads below, a failure means there is no workspace to put seats
        # in. It used to stop anyway, on `set -e`, but with the `2>/dev/null`
        # eating herdr's account and no sentence of km's own — so `km up` ended
        # in silence after the worktree output above (gqlc-3pks4). Dropping the
        # redirect costs nothing on the success path: stderr never reaches
        # `created`, which captures stdout only. Measured 2026-08-30, herdr
        # 0.6.10 — a failing create exits 2 with the reason on stderr and stdout
        # empty, and `workspace list`, `tab list` and `status server` each
        # succeed writing no stderr at all. A successful CREATE was not
        # measured: it would have raised a second workspace on the live town.
        created=$(herdr workspace create --label "$WORKSPACE" --no-focus) \
            || die "herdr could not create the '$WORKSPACE' workspace, so there is no town to raise and no seat was started. herdr's own account of it is on stderr above."
        # Neither read below may abort. km is between creating the workspace and
        # creating anything to put in it, and `set -e` on a bare `x=$(... python3
        # ...)` ends the raise right there — workspace up, unlabelled auto-tab,
        # zero seat tabs, and a python traceback instead of a sentence. What the
        # seat loop needs is not either of these ids: seat_runner_start derives
        # the workspace itself. So both reads report and continue (gqlc-be8t6).
        ws=$(printf '%s' "$created" | python3 -c "import json,sys; print(json.load(sys.stdin)['result']['workspace']['workspace_id'])" 2>/dev/null) || ws=
        [ -n "$ws" ] || echo "km: herdr created the '$WORKSPACE' workspace but km could not read its id back out of the reply. Raising the seats anyway — each looks the workspace up for itself, so the raise completes normally if the workspace is really there. If it is not, no seat tab is created, and the closing line below reports that no seat came up and exits non-zero." >&2
        local auto_tab
        auto_tab=$(printf '%s' "$created" | python3 -c "import json,sys; print(json.load(sys.stdin)['result']['tab']['tab_id'])" 2>/dev/null) || auto_tab=
        tally=$(raise_seats)
        # Close the placeholder AFTER the seats are up, so herdr doesn't
        # reap the workspace between "no seats yet" and "seats added".
        if [ -n "$auto_tab" ]; then
            herdr tab close "$auto_tab" >/dev/null 2>&1 || true
        else
            echo "km: could not read the auto-tab's id out of herdr's reply, so the workspace's unlabelled placeholder tab was not closed and is still in the roster. Harmless — close it by hand in herdr, or 'km down' and raise the town again." >&2
        fi
    else
        tally=$(raise_seats)
    fi
    # shellcheck disable=SC2086 # the tally is three integers, split on purpose
    raise_report $tally || return 1
    echo "  herdr              — open the town's TUI (every citizen is a tab in the '$WORKSPACE' workspace)"
}

cmd_down() {
    no_args down "$@"
    # town_absent_reason writes no newline — the other callers embed it in a
    # larger sentence — so this lone caller supplies one.
    session_up || { town_absent_reason $? "the town is already down"; echo; return 0; }
    # Declared, not inherited. This is a machine notice with no citizen behind
    # it — `km down` is an operator command — and require_identity would
    # otherwise refuse it from the plain shell it is normally run in, losing the
    # broadcast to the `|| true`. Naming the sender here keeps the fallback out
    # of mail_send, where it applied to every letter in the town.
    mail_send town --from andranik -s "town going down" -m "The herdr workspace is being closed. Sessions end; seats, mail, and handoffs persist." || true
    local ws
    ws=$(workspace_id)
    if [ -n "$ws" ]; then
        herdr workspace close "$ws" >/dev/null 2>&1 || true
    fi
    echo "the town is down. State, mail, and handoffs persist in $(state_dir)"
}

# ---------- halt ----------

# The flag file answers "is the town stopped now"; this answers "was it ever,
# and by whom". They are two files because the flag's ABSENCE is the lowered
# state, so a log that doubled as the flag would have to be deleted to lower a
# halt — which is the erasure this exists to stop (bd gqlc-nlc1). VI.4 reserves
# lowering to two citizens, and until this file existed a halt that was raised
# and lowered left nothing behind at all.
#
# The detail field is last because it is free text from argv. Newlines and tabs
# are squashed out of EVERY interpolated field, not only that one: any field
# that keeps them appends a second, fully-formed event that nobody performed.
# The actor is the field that makes this matter rather than merely untidy. It
# came from $KINGDOM_SEAT unsquashed until gqlc-tq83, so one `km halt` could
# write a backdated `lower` by `andranik` beneath its own raise — and VI.4
# reserves lowering to two citizens, which is the reservation this file exists
# to make auditable. That is accident-resistance, not a security boundary: the
# file has none, and anyone who can set KINGDOM_SEAT can also append directly.
halt_log() { # <raise|lower> <actor> <detail> — appends one event
    local f verb actor detail
    f="$(state_dir)/halt-history"
    verb=$(printf '%s' "$1" | tr '\n\t' '  ')
    actor=$(printf '%s' "$2" | tr '\n\t' '  ')
    detail=$(printf '%s' "$3" | tr '\n\t' '  ')
    # Never abort the act being recorded. Under `set -e` a failed append would
    # exit cmd_resume BEFORE the rm, wedging the town halted because a log file
    # could not be written — the record is worth less than the brake. Losing the
    # line SILENTLY is this bead's defect, so the failure is loud instead.
    if ! printf '%s\t%s\t%s\t%s\n' \
        "$(date -u -Iseconds)" "$verb" "$actor" "$detail" \
        >>"$f"; then
        echo "km: WARNING — could not append to $f; this $verb goes unrecorded" >&2
    fi
}

cmd_halt() {
    ensure_state_tree
    local sd
    sd="$(state_dir)"
    # The reason is free text, so only a LEADING dash is read as a flag: dashes
    # live inside ordinary words and a reason has to be able to carry them.
    # Everything after the first word is reason, whatever it looks like.
    case "${1:-}" in
        -h | --help)
            # The one spelling in this family a careful person types on purpose,
            # before running a write verb, to find out what it will do. On
            # 2026-08-24 a seven-hour outage sat on the board with `--help`
            # recorded as its cause.
            usage
            return 0
            ;;
        --status | --show)
            if [ -f "$sd/halt" ]; then
                echo "halt is UP: $(head -1 "$sd/halt")"
                echo "  the dispatcher and the guard sweep wake nobody until it is lowered ($(verb resume))."
            else
                echo "no halt is raised: the dispatcher and the guard sweep are routing normally."
            fi
            return 0
            ;;
        --history)
            shift
            local n="${1:-10}" hist total shown
            hist="$sd/halt-history"
            case "$n" in
                '' | *[!0-9]*) die "halt --history: count must be a number, got '$n'" ;;
            esac
            # Force base 10 before the count is used twice. `$((...))` reads a
            # leading zero as octal and `tail -n` does not, so `--history 010`
            # printed a header saying 8 above a body of 10 rows — the record
            # disagreeing with its own count (gqlc-tq83, from Միհր's F3).
            n=$((10#$n))
            if [ ! -s "$hist" ]; then
                echo "halt history is empty: no halt has been raised or lowered since $hist was first written"
                return 0
            fi
            total=$(wc -l <"$hist")
            shown=$((total < n ? total : n))
            echo "halt history — last $shown of $total events ($hist)"
            tail -n "$n" "$hist" | awk -F'\t' '{ printf "  %s  %-5s  %-10s  %s\n", $1, $2, $3, $4 }'
            return 0
            ;;
        -*)
            # This verb used to take its whole argv as the reason, so a flag it
            # did not know became one and stopped the town — exit 0, and the same
            # success line a deliberate halt prints. Twice in fourteen minutes by
            # two citizens asking a question (bd gqlc-jqwf).
            die "halt: unknown flag $1 — to ask whether a halt is up, $(verb halt) --status; a reason may not begin with '-'"
            ;;
    esac
    # VI.4 lets two citizens lower a halt; for everyone else the recorded
    # reason is the whole of what they get, and a blank one forces that read to
    # be a guess between "stopped on purpose" and "fat-fingered". Whitespace
    # counts as blank — it is written to the file and reads on the board as
    # nothing at all (bd gqlc-jqwf).
    local reason="${*:-}"
    if [ -z "${reason//[[:space:]]/}" ]; then
        die "halt: a reason is required — say why the town must stop, so whoever finds it can tell deliberate from accidental"
    fi
    # Every accidental halt this town has recorded was a citizen asking a
    # question with the write verb. The `-*` arm above closed the flag
    # spellings; `km halt show` carries no dash, so it is well-formed reason
    # text, reaches here legitimately, and stopped the town for 46 minutes on
    # 2026-08-29 (bd gqlc-wguoq). A read-word opens the question; what may
    # follow it is a COUNT, because `--history N` is the family's only read
    # form taking an argument and its dash-less spelling is two tokens. Counting
    # tokens instead of reading them let `km halt history 20` through the guard
    # written for this very accident (bd gqlc-cwic0, Միհրի F1). Prose that opens
    # with a read-word still passes: `show stopper in CI` has a tail that is not
    # a number.
    local -a reason_words=()
    # -d '' consumes the whole reason rather than its first line, and finds no
    # delimiter, hence the `|| true`. Reading one line counted `show` alone in a
    # multi-line reason whose remainder was prose, and refused it (F2).
    read -r -d '' -a reason_words <<<"$reason" || true
    local reason_is_question=0 reason_word
    case "$(printf '%s' "${reason_words[0]}" | tr '[:upper:]' '[:lower:]')" in
    show | status | history | help | state | info | list) reason_is_question=1 ;;
    esac
    for reason_word in "${reason_words[@]:1}"; do
        case "$reason_word" in
        *[!0-9]*) reason_is_question=0 ;;
        esac
    done
    if [ "$reason_is_question" -eq 1 ]; then
        die "halt: '$reason' reads as a question, not a reason — refusing to stop the town on a word that names a read.
  is a halt up?          $(verb halt) --status
  who raised or lowered? $(verb halt) --history [N]
  the dash is what separates the two: without it, km reads the rest as your reason.
  if you did mean to halt the town, say why in a sentence: $(verb halt) '<reason>'"
    fi
    # Read BEFORE the truncating write below, because afterwards nothing can
    # tell the two cases apart. A raise over a standing halt replaces another
    # citizen's reason, and until this was captured both printed the same line.
    local was_up=''
    if [ -f "$sd/halt" ]; then
        was_up=$(head -1 "$sd/halt")
    fi
    require_identity halt
    printf 'raised by %s at %s: %s\n' "$KINGDOM_SEAT" "$(date -u -Iseconds)" "$reason" \
        >"$sd/halt"
    # After the flag, not before: if the truncating write above fails, `set -e`
    # stops here and the history does not claim a halt that was never raised.
    halt_log raise "$KINGDOM_SEAT" "$reason"
    # Reports the ACT and its actor, not the resulting state. "halt raised" was
    # a true sentence about the world and said nothing about what the command
    # had just done, so on 2026-08-29 the guard raised a halt by typing
    # `km halt show`, read this line, concluded it described a standing halt
    # someone else was tracking, mailed the mayor "town healthy under the halt,
    # nothing new", and slept. The town stayed stopped 46 minutes (bd
    # gqlc-wguoq). The three earlier accidental halts were each caught by a
    # human who knew what they had just typed; an agent on a sweep does not,
    # and is now a routine reader of this line.
    if [ -n "$was_up" ]; then
        # Raising over a standing halt is a truncating overwrite, so someone
        # else's recorded reason is gone. Both cases used to print one line.
        echo "halt RE-RAISED by you ($KINGDOM_SEAT) just now — this REPLACED a halt that was already up:"
        echo "    was: $was_up"
        echo "    now: $reason"
    else
        echo "halt RAISED by you ($KINGDOM_SEAT) just now — reason: $reason"
        echo "  the town was NOT halted before this command."
    fi
    # Names both timers, and says which paths it does NOT bind. The line used to
    # promise a quiet town while naming only the dispatcher, so an operator had
    # no reason to suspect the guard sweep was still launching sessions behind
    # the flag — and this line is the whole report he gets (gqlc-6dzi).
    echo "  the dispatcher and the guard sweep will wake nobody until it is lowered ($(verb resume))"
    # Spell the broadcast in full. This line is read at one moment — by whoever
    # has just stopped the town and now has to say why — and it used to name
    # `km herratsayn`, which km has never dispatched (bd gqlc-cw7h). The reader
    # in a hurry runs it, gets the usage dump, and concludes a halted town has
    # no way to talk to itself.
    echo "  to tell the town why: $(verb mail) send town -s '<subject>' -m '<body>'"
    echo "  $(verb wake) <seat> still reaches one seat; neither is bound by the halt."
}

# Constitution VI.4, in full: "A halt (kingdom-state/halt) stops new wakes;
# running sessions finish their day. Anyone may raise a halt for cause; only
# Սեդրակ or Անդրանիկ lowers it." Raising stays open to everyone above; this list
# is the whole of the restriction, and it is two names because the clause names
# two. Widening it is a constitutional amendment (Article VII), not a patch.
HALT_LOWERERS="sedrak andranik"

cmd_resume() {
    no_args resume "$@"
    local seat="${KINGDOM_SEAT:-}"
    # Fail closed on an absent identity rather than defaulting to andranik the
    # way the rest of km does. Everywhere else that default is a convenience for
    # the operator at a terminal; here it is the hole, because every ephemeral
    # agent session in the shared checkout also runs with KINGDOM_SEAT unset and
    # would inherit the crown's authority over the town's only emergency brake.
    if [ -z "$seat" ]; then
        echo "resume: refused — this session has no identity (KINGDOM_SEAT is unset)." >&2
        echo "  Constitution VI.4 reserves lowering a halt to Սեդրակ or Անդրանիկ." >&2
        echo "  If you are the crown, say so: KINGDOM_SEAT=andranik $(verb resume)" >&2
        return 1
    fi
    case " $HALT_LOWERERS " in
        *" $seat "*) ;;
        *)
            echo "resume: refused — $seat may not lower a halt." >&2
            echo "  Constitution VI.4 reserves that to Սեդրակ (sedrak) or Անդրանիկ (andranik);" >&2
            echo "  anyone may RAISE one. Ask sedrak to lower it: $(verb mail) send sedrak -s ..." >&2
            return 1
            ;;
    esac
    if [ -f "$(state_dir)/halt" ]; then
        # The detail is the raise line verbatim, so a lower event is readable on
        # its own without scanning backwards for the raise it answers — and so
        # that nothing here has to parse the flag's prose for a reason.
        halt_log lower "$seat" "$(head -1 "$(state_dir)/halt")"
        rm -f "$(state_dir)/halt"
        echo "halt lowered by $seat: the dispatcher may wake seats again"
    else
        # Recorded nowhere: nothing came down, so no reserved power was
        # exercised. The history is a log of state changes, not of attempts.
        echo "no halt was raised"
    fi
}

# ---------- dispatcher ----------

worker_seats() {
    local s c
    for s in $(seats_all); do
        c=$(seat_class "$s")
        case "$c" in architect | warrior | judge) echo "$s" ;; esac
    done
}

# Judges are exempt from concurrency.max_active alongside the mayor and the
# guard: the bench is the town's merge gate, so a cap that can close it is a
# merge freeze rather than a throttle, and it competes with the very seats
# producing its queue (gqlc-dz85). Judges are still worker seats above —
# dropping them there would leave free_worker_of_class unable to find them and
# route them nothing at all.
#
# Named, because it used to exist only as the difference between two case
# statements twelve lines apart: worker_seats listing three classes and
# capped_seats listing two. A reader had to diff them to find the exemption,
# and a fourth class added to one and not the other would have been silently
# capped or silently exempt (gqlc-a4tu, Ծովինար).
cap_exempt_class() { [ "$1" = judge ]; }

# The seats that spend a slot. The exemption lets the awake count exceed
# max_active by the number of judge seats the roster holds.
capped_seats() {
    local s
    for s in $(worker_seats); do
        cap_exempt_class "$(seat_class "$s")" || echo "$s"
    done
}

# Bring the ledger back into agreement with the world before anything reads it.
#
# Four repairs. The difference between them is consent, and the order they run
# in is not arbitrary — the runner check comes first because it is the only one
# whose failure makes the seat unreachable by every later mechanism, including
# this function's own.
#
#   runner gone     — km-seat is the pane's command and the ONLY reader of a
#                     wake file. Its absence is a defect at ANY status, which is
#                     what the status arms below could not see: for the whole
#                     life of this function the case statement skipped exactly
#                     the `asleep` seats where a dead runner lives, and an asleep
#                     seat with no session is what a resting citizen looks like
#                     (III.5). Recovery is cmd_up's own idempotent respawn.
#   awake/pending, no session   — a stale record. Correcting it frees the slot
#                     and, because free_worker_of_class only picks an `asleep`
#                     seat, hands the seat back to the town.
#   pending, session alive      — the citizen asked to leave and the /exit never
#                     landed, so it is re-delivered. That needs no asking:
#                     `km sleep` was the asking.
#   asleep, session alive       — the OTHER direction of the same lie, and it
#                     strands nobody: it INTERRUPTS. Both dispatch passes wake
#                     asleep seats, so a working citizen recorded asleep gets
#                     handed a second bead on top of the one she holds. Sighted
#                     2026-08-22T14:23Z on Նուարդ, mid-generation on PR #1122
#                     while the board read her asleep (gqlc-5vp7). Recording
#                     `awake` takes nothing from her and costs no slot: the cap
#                     counts sessions, not status strings.
#
# What is NOT here: ending a seat that is alive and idle. From outside, idle and
# thinking are told apart only by evidence this function does not gather, and
# ending a session against a citizen's will is VI.2. The dispatcher NUDGES such
# a seat instead (seat_idle), which asks rather than forces.
cmd_reconcile() {
    no_args reconcile "$@"
    # main's case arm calls this as a statement (km:5133), so -e is live here.
    # `session_up; up_rc=$?` therefore ended the shell on every non-zero and the
    # whole block below was dead: `km reconcile` against a down town printed zero
    # bytes and exited 1, while dispatch, guard-sweep and status — which all use
    # an AND-OR or an `if` — spoke correctly (bd gqlc-nvbd3).
    local up_rc=0
    session_up || up_rc=$?
    if [ "$up_rc" != 0 ]; then
        echo "reconcile: $(town_absent_reason "$up_rc"); nothing to reconcile"
        # Exit non-zero when km could not tell. A scheduled pass that did not
        # run must not report success — reporting 0 over a dead query is the
        # shape this bead is an instance of. Both cannot-tell answers count: 2
        # is a workspace list that did not parse, 3 a server km could not ask,
        # and neither is evidence there was nothing to reconcile.
        case "$up_rc" in 2 | 3) return 1 ;; esac
        return 0
    fi
    local s st suspect rc repaired=0 redelivered=0 suspected=0 respawned=0 corrected=0
    for s in $(seats_all); do
        st=$(seat_status "$s")
        suspect="$(seat_home "$s")/suspect"
        # Before the status arms, and unconditional on status: this is the
        # polarity that was missing (gqlc-6ha4).
        if ! seat_runner_live "$s"; then
            seat_runner_start "$s" && rc=0 || rc=$?
            case "$rc" in
                0)
                    echo "reconcile: $s had no km-seat parked on its wake file, so no wake could ever have reached it; runner respawned"
                    respawned=$((respawned + 1)) ;;
                1)
                    # Refused because a session is live in that window. Reported and
                    # not acted on: replacing the window would end it (VI.2). It
                    # heals itself when the session does end — the next pass finds
                    # an empty window and replaces it then.
                    echo "reconcile: $s has no km-seat runner behind it and herdr reports a live session — or could not be read, which is declined the same way (see stderr). Nothing was replaced under what may be a live citizen; if the session is real it will not park again when that session ends" ;;
                *)
                    # Counted nowhere on purpose. This pass repaired nothing, and
                    # the whole defect being fixed here was a repair counter that
                    # climbed while the town stayed down (gqlc-c48e).
                    echo "reconcile: $s had no km-seat parked on its wake file and the respawn DID NOT TAKE — the command line was accepted and no runner appeared. Nothing here will repair it and every pass will say this again until someone reads that pane; km's own diagnosis is on stderr above" ;;
            esac
        fi
        case "$st" in
            awake | asleep-pending) ;;
            asleep)
                if seat_session_live "$s"; then
                    echo awake >"$(seat_home "$s")/status"
                    echo "reconcile: $s is recorded asleep and herdr reports a live session (or could not be read, which is treated as live); recorded awake so no pass hands her a second bead on top of the one she is working"
                    corrected=$((corrected + 1))
                fi
                rm -f "$suspect"; continue ;;
            *) rm -f "$suspect"; continue ;;
        esac
        if seat_session_live "$s"; then
            rm -f "$suspect"
            if [ "$st" = asleep-pending ]; then
                # Reported, never fatal, and never tallied without the send
                # saying so. This ran bare under `set -euo pipefail`, so a
                # refused send aborted the whole reconcile pass HERE, at the
                # first asleep-pending seat, and every seat after it went
                # unexamined — while the next line announced a re-send that had
                # not happened and the tally counted it. Since cmd_dispatch
                # calls this pass before it routes anything, that killed the
                # tick outright: 19 consecutive ticks routed nothing, silently,
                # because one citizen ran `km sleep` (bd gqlc-87al).
                if send_line "$s" "/exit"; then
                    echo "reconcile: $s asked to leave and is still here; /exit re-sent"
                    redelivered=$((redelivered + 1))
                else
                    echo "reconcile: $s asked to leave and is still here, but the /exit could NOT be delivered (diagnosis above); the seat stays asleep-pending"
                fi
            fi
            continue
        fi
        # Confirmed over elapsed time, not over a count of passes. km-seat
        # writes `awake` BEFORE it execs claude, so there is a brief moment when
        # a seat that is starting up is indistinguishable from one that has died
        # — and rewriting the ledger there would hand a running seat's name back
        # to the dispatcher, against a session that is by then alive. Nothing
        # repairs that: `asleep` is not a state this function revisits.
        #
        # A sighting COUNT does not close the gap, because nothing separates two
        # passes: reconcile is a public subcommand, and a manual `km dispatch`
        # landing seconds before a cron tick makes a pair with no time in it.
        # The marker's age is the signal instead. 60s clears any exec window and
        # sits well under the 120s cadence, so a genuinely dead seat is still
        # freed on the next tick. The cap stopped counting it on the first pass
        # either way, so the throughput that matters is already recovered.
        if [ ! -f "$suspect" ]; then
            : >"$suspect"
            echo "reconcile: $s is recorded $st with no session; confirming next pass"
            suspected=$((suspected + 1))
            continue
        fi
        if [ "$(($(date +%s) - $(stat -c %Y "$suspect")))" -lt 60 ]; then
            echo "reconcile: $s is recorded $st with no session, but that sighting is too recent to tell a dead seat from a starting one; still confirming"
            suspected=$((suspected + 1))
            continue
        fi
        echo asleep >"$(seat_home "$s")/status"
        rm -f "$suspect" "$(seat_home "$s")/heartbeat.json"
        echo "reconcile: $s was recorded $st with no session for a full cycle; freed"
        repaired=$((repaired + 1))
    done
    echo "reconcile: done ($repaired freed, $suspected suspected, $redelivered re-sent, $respawned runner(s) respawned, $corrected status(es) corrected)"
}

free_worker_of_class() { # asleep, no queued wake
    local class=$1 s
    for s in $(worker_seats); do
        [ "$(seat_class "$s")" = "$class" ] || continue
        [ "$(seat_status "$s")" = asleep ] || continue
        [ ! -f "$(seat_home "$s")/wake" ] || continue
        echo "$s"
        return 0
    done
    return 1
}

# Why no seat of <class> could be given a bead, as a sentence an operator can
# act on. The lookup above returns 1 for four conditions with four different
# remedies, and until gqlc-2ve4 all four produced the same output: none. The
# call site was an `if` with no `else`, one layer below the `elif .cls == null
# then empty` arm that used to drop unlabelled beads — the same defect twice in
# one function, a decision taken and not spoken. OBSERVED 2026-08-22T13:12Z: a
# P0 class:architect bead sat unrouted with all three architect seats occupied,
# and nothing in the run, the summary or the board said so. Every indicator was
# green, because every seat was either working or legitimately resting.
#
# The CAP is not answered here. It belongs to cmd_dispatch, which is the only
# scope holding the slot count and the judge exemption, and conflating the two
# would send an operator to the roster for a throttle or to the throttle for a
# roster.
class_roster_reason() { # <class> -> a sentence
    local class=$1 s total=0 awake=0 queued=0 leaving=0 free=0 parts=""
    for s in $(worker_seats); do
        [ "$(seat_class "$s")" = "$class" ] || continue
        total=$((total + 1))
        case "$(seat_status "$s")" in
            asleep-pending) leaving=$((leaving + 1)) ;;
            asleep) if [ -f "$(seat_home "$s")/wake" ]; then
                        queued=$((queued + 1))
                    else
                        # Unreachable from the call site — the lookup takes
                        # exactly this seat — so it is counted rather than
                        # dropped: an enumeration that does not sum to the
                        # total is how a reader learns to stop trusting it.
                        free=$((free + 1))
                    fi ;;
            *) awake=$((awake + 1)) ;;
        esac
    done
    # The one condition that never self-heals. A retired or never-seated class
    # swallows its whole queue for as long as the roster stands, so the remedy
    # is an edit and not a wait, and describing seats that do not exist would
    # send the operator to watch for a sleep that can never come.
    if [ "$total" -eq 0 ]; then
        echo "the roster seats no $class at all, so no $class bead can route until one is seated in kingdom.toml [seats]"
        return 0
    fi
    # Transient by construction: those wakes are already queued, so the next
    # run has somewhere to put this bead. Named apart from occupancy because
    # the correct response is to do nothing, and the occupancy response is not.
    if [ "$queued" -eq "$total" ]; then
        echo "all $total $class seat(s) are asleep with a wake queued already, so this one waits for a later run"
        return 0
    fi
    [ "$awake" -eq 0 ] || parts="$parts, $awake awake"
    [ "$queued" -eq 0 ] || parts="$parts, $queued asleep with a wake queued"
    [ "$leaving" -eq 0 ] || parts="$parts, $leaving asked to sleep and still leaving"
    [ "$free" -eq 0 ] || parts="$parts, $free free (which contradicts the lookup that just failed)"
    echo "all $total $class seat(s) are unavailable (${parts#, }); nothing here schedules a wake in response, so it waits for a citizen to sleep"
}

# The priority at or below which an unroutable bead is named ONE AT A TIME.
# Above it they are counted instead. Both halves are load-bearing and they fail
# in opposite directions: a P0 nobody can take is the town's highest work
# standing still and has to be greppable by id, while the routable queue holds
# 197 beads and a per-bead line for each of them every two minutes is the
# volume at which an operator stops reading the journal — which is the same
# outcome as silence, reached from the other side. A number, not a config key:
# it tunes how loud a report is, not what the town does.
DISPATCH_LOUD_PRIORITY=1

# Names a bead the fresh pass could not route, at a volume set by its priority.
# Reads and updates cmd_dispatch's `unroutable`, `stalled` and `quiet` through
# bash's dynamic scope, the same way route_owners reads `slots` and `wakes`,
# and for the same reason: the counting must not exist in two copies. It is
# only ever called from there.
report_unroutable() { # <id> <class> <priority> <reason>
    local rid=$1 rcls=$2 rprio=$3 rwhy=$4
    # A priority that is not a number sorts with the backlog rather than
    # aborting the run: this is a report, and a diagnostic that can stop
    # routing is a worse failure than the one it describes.
    case "$rprio" in '' | *[!0-9]*) rprio=99 ;; esac
    unroutable=$((unroutable + 1))
    if [ "$rprio" -eq 0 ]; then
        stalled=$((stalled + 1))
        echo "dispatch: STALLED $rid — P0 $rcls work, ready and unassigned, and no seat can take it: $rwhy"
        # And durably, because the line above is write-only (gqlc-tz95): see
        # record_stalled_p0, which is handed this list at the end of the run.
        stalled_beads="$stalled_beads$rid|$rcls|$rwhy
"
    elif [ "$rprio" -le "$DISPATCH_LOUD_PRIORITY" ]; then
        echo "dispatch: unroutable $rid — P$rprio $rcls work and no seat can take it: $rwhy"
    else
        quiet="$quiet$rcls|$rwhy
"
    fi
}

# ---------- the stalled-P0 marker ----------
#
# gqlc-2ve4 gave a P0 that no seat could take a line of its own in the run's
# output. gqlc-tz95 is that line's own limitation: the dispatcher's output is a
# journal, which exists for whoever runs journalctl with the right filter inside
# the right two-minute window. gqlc-2ve4's complaint was "a number in a queue
# nobody is watching", and a better line in the same queue does not answer it.
#
# So the run leaves DURABLE state — one file — and the two surfaces a human
# already reads carry it: `km status`, the one glance at the town, and
# `km doctor`, which FAILS. That is the whole choice, and the alternatives were
# rejected for reasons worth keeping. MAIL to Սեդրակ makes the mayor a required
# actor in a hot path, which is the opposite of the direction his role is being
# taken in, and the king's own box has been measured at 30 delivered / 0 read
# (gqlc-2abx) — a second write-only carrier. An AUTO-WAKE acts on a citizen,
# which is Constitution VI.2 for an awake seat and is coercion for a condition
# that is often two minutes from healing on its own.
#
# The file is a marker and NOT a queue of events, which is what bounds the
# repetition. A stall that persists for an hour is 30 dispatch runs; 30 letters,
# or 30 anything, is the volume at which the report becomes the silence it was
# written to end (this town has 48 unread nudges on record). Writing the same
# marker 30 times says the same thing once.
#
# Format, one line per stalled bead:  <first-seen epoch> <id> <class> <reason>
# The first-seen stamp is per BEAD, so a second P0 joining the stall does not
# restart the first one's clock, and it is what lets doctor separate a stall two
# minutes old — which the next tick may route — from one that has held all night.
#
# A run that never reaches here — the town is halted, or the ready query failed
# and dispatch refused — leaves the marker exactly as it was, and that is the
# direction to fail in: a stall stands until a run PROVES it has cleared, rather
# than being cleared by a run that could not look. Both read surfaces say the
# marker is the dispatcher's record and is only as fresh as its last run.
stalled_marker_path() { echo "$(state_dir)/stalled-p0"; }

record_stalled_p0() { # <newline-separated "<id>|<class>|<reason>">
    local pending=$1 marker prev="" now id cls why seen out="" ids="" previds=""
    marker=$(stalled_marker_path)
    if [ -f "$marker" ]; then prev=$(cat "$marker" 2>/dev/null || true); fi
    previds=$(printf '%s' "$prev" | awk 'NF { print $2 }' | sort | tr '\n' ' ')
    if [ -z "$pending" ]; then
        # The clearing run, and it must happen: a marker nothing removes is a
        # doctor that fails forever, which is a gate that gets ignored.
        if [ -e "$marker" ]; then
            if rm -f "$marker" 2>/dev/null; then
                echo "dispatch: cleared the stalled-P0 marker — no P0 was unroutable this run, so km status and km doctor are clean again (was:${previds:- unreadable})"
            else
                echo "dispatch: the stalled-P0 marker at $marker could not be removed, so km status and km doctor will keep reporting a stall that has cleared" >&2
            fi
        fi
        return 0
    fi
    now=$(date +%s)
    while IFS='|' read -r id cls why; do
        [ -n "$id" ] || continue
        seen=$(printf '%s' "$prev" | awk -v i="$id" '$2 == i { print $1; exit }')
        case "$seen" in '' | *[!0-9]*) seen=$now ;; esac
        out="$out$seen $id $cls $why
"
        ids="$ids$id "
    done <<<"$pending"
    ids=$(printf '%s' "$ids" | tr ' ' '\n' | awk 'NF' | sort | tr '\n' ' ')
    # NON-FATAL, in the shape km:113 argues for: routing is the town's work and
    # a report about it must never be able to stop it. Said out loud on stderr,
    # because a failure to escalate that escalates nothing leaves both read
    # surfaces silently blind, which is this bead's own defect one layer down.
    if ! printf '%s' "$out" >"$marker" 2>/dev/null; then
        echo "dispatch: the stalled-P0 marker at $marker could not be written, so km status and km doctor cannot report this stall; the STALLED line(s) above are all there is" >&2
        return 0
    fi
    # ON CHANGE, never on a tick — and keyed on the ID SET rather than on the
    # file's bytes. The REASON for a stall flips between "awake" and "wake
    # queued" as seats move, and re-announcing on that would restore the
    # per-tick repetition through the back door.
    if [ "$ids" != "$previds" ]; then
        echo "dispatch: escalated — the stalled-P0 marker now names $ids and km status and km doctor carry it until it clears"
    fi
}

# What the two read surfaces say about the marker, in ONE place. They differ in
# severity and in nothing else; two copies of this loop would be two accounts of
# the same stall, free to disagree about which beads and how long.
#
# rc 1 for "no stall recorded". A marker that is not a readable file (the path
# taken over by a directory, say) reads the same way rather than aborting: this
# is an instrument on a status command, and status commands that die are status
# commands nobody runs.
stalled_p0_render() { # -> "<oldest age in seconds><TAB><summary>", rc 1 if none
    local marker seen id cls why now age oldest="" list=""
    marker=$(stalled_marker_path)
    [ -f "$marker" ] || return 1
    now=$(date +%s)
    while read -r seen id cls why || [ -n "$id" ]; do
        [ -n "$id" ] || continue
        case "$seen" in '' | *[!0-9]*) seen=$now ;; esac
        age=$((now - seen))
        [ "$age" -ge 0 ] || age=0
        if [ -z "$oldest" ] || [ "$age" -gt "$oldest" ]; then oldest=$age; fi
        list="$list $id (P0 ${cls:-?}, stalled $(fmt_age "$age") — ${why:-no reason recorded});"
        id=""
    done <"$marker"
    [ -n "$list" ] || return 1
    printf '%s\t%s\n' "$oldest" "${list# }"
}

# How long a P0 may be unroutable before doctor stops calling it a warning.
# 15 minutes is seven dispatch ticks. Below it the commonest cause is a class
# whose wakes are already queued, which routes on the next run with nobody
# acting at all; a hard failure on a condition that heals itself in two minutes
# is how a gate teaches its reader to skip it. A config key and not a constant,
# per Constitution V.6.1: it is a threshold on a report.
stalled_p0_after() { cfg_minutes dispatch stalled_p0_after_minutes 15; }

# A JSON payload belongs on a descriptor, never in argv. `--argjson` puts the
# whole document in ONE command-line argument, and Linux caps a single argument
# at MAX_ARG_STRLEN — 32 pages, 131072 bytes on a 4 KiB-page machine. That is a
# hard kernel ceiling in the binfmt loader: it is not ARG_MAX, it does not move
# with `ulimit -s`, and no amount of free memory raises it.
#
# The reason this is a rule here and not a note on one call site: the payload is
# `bd ready`, so its size is the length of the BACKLOG. The failure is monotonic
# in the queue — once crossed it cannot self-heal, and the fuller the queue, the
# more certainly the dispatcher that drains it is switched off. It is an outage
# that arrives on the worst day, by construction.
#
# MEASURED 2026-08-22 (gqlc-fo48): `bd ready --json -n 0` was 1222148 bytes,
# 9.3x the ceiling, and the fresh pass had been dead 63 consecutive runs over
# two hours. --slurpfile reads the document from a file descriptor and wraps it
# in an array, hence the [0] on each binding.
dispatch_candidate_docs() { # ready deps parents ids -> candidate documents
    jq -c -n \
        --slurpfile ready <(printf '%s' "$1") \
        --slurpfile deps <(printf '%s' "$2") \
        --slurpfile parents <(printf '%s' "$3") \
        --rawfile ids <(printf '%s' "$4") '
        ($ready[0] | map({key: .id, value: .}) | from_entries) as $byId
        | ($parents[0] | map({key: .id, value: .status}) | from_entries) as $status
        | [ ($ids | split("\n") | .[] | select(length > 0)) as $i
            | { id: $i,
                labels: ($byId[$i].labels // []),
                deps: [ $deps[0][]? | select(.issue_id == $i)
                        | {depends_on_id, type, status: ($status[.depends_on_id] // "unknown")} ] } ]'
}

# Wakes every sleeping seat that owns work in <list> (lines of "seat id"), with
# <prefix> naming what those ids are to it. Both routing passes that hand a seat
# its OWN bead go through here: the cap arithmetic is the part that must not
# exist in two copies, because a divergence between them overspends the cap
# silently, and the cap is what keeps the town inside its quota.
#
# It reads and updates cmd_dispatch's `slots`, `wakes` and `withheld` through
# bash's dynamic scope, and reads its `active` and `max` for the cap's reason
# string, which is why it is only ever called from there.
route_owners() { # <"seat id" lines> <reason prefix>
    local list=$1 prefix=$2 s capped mine st why b
    for s in $(worker_seats); do
        # Asked FIRST, and it is the one withholding here that stays silent: a
        # seat owning nothing in this list is the overwhelmingly common case and
        # says nothing about the town. Every other skip below now names the bead
        # it withheld, which is only possible in this order — the seat-state
        # tests used to run before `mine` existed, so there was nothing to name
        # (gqlc-wq9x).
        mine=$(echo "$list" | awk -v s="$s" '$1 == s { print $2 }')
        [ -n "$mine" ] || continue
        why=""
        st=$(seat_status "$s")
        if [ "$st" != asleep ]; then
            why="$s, who is $st rather than asleep — every dispatch pass wakes asleep seats only, so this routes when they next sleep"
        # A seat with a wake already queued is skipped rather than woken twice.
        # A seat holding in-progress work AND assigned an unclaimed bead is
        # therefore told about the in-progress half only, and hears about the
        # other when it next sleeps — a delay, not a strand, and the order
        # Constitution III.3 asks for.
        elif [ -f "$(seat_home "$s")/wake" ]; then
            why="$s, who already has a wake queued and is told one thing at a time — this routes on the next run (Constitution III.3)"
        fi
        capped=1
        if [ "$(seat_class "$s")" = judge ]; then capped=0; fi
        if [ -z "$why" ] && [ "$capped" -eq 1 ] && [ "$slots" -le 0 ]; then
            why="$s, who is asleep but every capped slot is spent ($active/$max awake) and only judge work is exempt from the cap"
        fi
        if [ -n "$why" ]; then
            # One line per bead, like every other arm, because the operator's
            # question is about a bead. The cap case is the one that made this
            # a bead: it is a normal steady state, so the dispatcher's own
            # advice — "assign it to a Ճարտարապետ and it routes" — moved beads
            # off the loudly-reported epic arm onto this silent one, and the
            # withheld line going away read as the assignment having worked.
            while IFS= read -r b; do
                [ -n "$b" ] || continue
                echo "dispatch: owner-withheld $b — assigned to $why"
                withheld=$((withheld + 1))
            done <<<"$mine"
            continue
        fi
        cmd_wake "$s" --reason "$prefix: $(echo "$mine" | tr '\n' ' ')"
        wakes=$((wakes + 1))
        if [ "$capped" -eq 1 ]; then slots=$((slots - 1)); fi
    done
}

# The state no dispatch pass can reach. The resume pass takes in_progress beads
# that name a seat, the owned and fresh passes take ready ones — and `bd ready`
# returns beads whose status is open only, so an in_progress bead with no
# assignee is in no pass and cannot re-enter one. It reads as work underway and
# no wake will ever come for it. Unassigning a bead a seat had already claimed
# produces exactly this state, and did on gqlc-gwf0 (recorded in gqlc-mro7),
# done by someone trying to make the bead more routable.
#
# NOT counted here: a bead assigned to a name that is not a seat. That is the
# SECOND unreachable shape and it has its own predicate below,
# unreachable_owner_rows, because the two want different treatment — this one is
# always a defect and fails `km doctor`, that one is usually a person holding
# their own work and must not.
stranded_ids() {
    bd list --status in_progress -n 0 --json 2>/dev/null |
        jq -r '[ .[] | select(.assignee == null) | .id ] | join(" ")'
}

# The other unreachable shape. Every dispatch pass matches an assignee against
# the SEAT roster — the resume pass over in-progress beads, the owned pass over
# ready ones — so a bead assigned to a name that is not a seat is routed by
# nobody. Unlike a stranded bead it does not even look unrouted: it looks like
# somebody is working on it, which is why nothing has ever found one.
#
# Three cases, and conflating them is the actual defect (gqlc-t4zx):
#
#   a live seat   — routed normally, nothing to report.
#   a person      — [humans] in kingdom.toml. Held deliberately. Reporting these
#                   would put a line on the board every time a human takes a
#                   bead, and an operator learns to ignore a channel that is
#                   always noisy; the reachability gate was nearly not written
#                   at all for this reason.
#   neither       — the only defect. A retired seat's name lands here, and so
#                   does a typo'd assignee and a person nobody has added to the
#                   roster yet.
#
# NOT CLOSED, not `--status open`: bd's `--status open` is the literal status
# and excludes in_progress and blocked, so a claimed bead held by a name the
# town cannot resolve — the exact state this exists to find — would read as
# absent. Any status this code does not recognise counts too, which is the safe
# side for a report.
#
# It reports and does not act. Repointing another citizen's claimed work is a
# confident sweep over evidence this function does not have: it cannot tell a
# retired seat from a person the roster has not caught up with, and both look
# identical here. Naming them is the whole job; the decision is a human's.
unreachable_owner_rows() { # -> lines of "<assignee> <id> <id> ..."
    local board rows name ids
    board=$(bd list --status all -n 0 --json 2>/dev/null) || return 1
    jq -e 'type == "array"' >/dev/null 2>&1 <<<"$board" || return 1
    # Grouped in jq, resolved in bash: each distinct assignee is tested against
    # the rosters ONCE, rather than once per bead it holds.
    rows=$(jq -r '[ .[]
                    | select(.status != "closed")
                    | select(.assignee != null and .assignee != "") ]
                  | group_by(.assignee)[]
                  | "\(.[0].assignee) \([ .[].id ] | sort | join(" "))"' <<<"$board") || return 1
    while IFS=' ' read -r name ids; do
        [ -n "$name" ] || continue
        if is_seat "$name"; then continue; fi
        if is_human "$name"; then continue; fi
        echo "$name $ids"
    done <<<"$rows"
}

# ADR 0009: a verdict is PASS or FAIL, and a PASS is unconditional. A condition
# written into a close reason reaches no dispatch pass and no assignee. Other
# things do read `close_reason` — bdguard parses it for a cited sha, bd-gh-sync
# takes its first line as a mirror tag — but neither can route an obligation,
# and nor can this row: it names ids and assigns nobody, which is why it warns
# rather than fails. The match can be this blunt because ruling 2
# leaves a compliant close reason no reason to contain the word at all, down to
# forbidding "no conditions" as a disclaimer.
#
# The cutoff is the ADR's own merge (3c5a9988), to the SECOND and not to the
# day. Fifteen close reasons already on the ledger carry the word, and seven of
# them closed on the ADR's own date — a bare `2026-08-29` would have shipped
# this row ringing on all seven from its first run, which is how a warn row
# teaches the town to scroll past it.
conditioned_verdict_ids() { # -> ids of judge beads closed with a condition in prose since ADR 0009
    local cutoff=2026-08-29T18:31:01Z board
    board=$(bd list --all --json -n 0 2>/dev/null) || return 1
    # A `bd` that exits 0 having printed a non-array is the one shape the
    # pipeline's own errors cannot catch: `{}` is valid JSON and `.[]` over it
    # iterates nothing rather than failing, so the row certifies every verdict
    # unconditional over a query that returned no beads at all. Same feed, same
    # idiom, as unreachable_owner_rows forty lines up — which guarded it and
    # this one did not.
    jq -e 'type == "array"' >/dev/null 2>&1 <<<"$board" || return 1
    jq -r --arg cutoff "$cutoff" \
        '[ .[]
           | select((.labels // []) | index("class:judge"))
           | select(.status == "closed")
           | select((.closed_at // "") > $cutoff)
           | select((.close_reason // "") | test("conditio"; "i"))
           | .id ] | join(" ")' <<<"$board"
}

cmd_dispatch() {
    ensure_deployed dispatch "$@" || return 1
    session_up || { echo "dispatch: $(town_absent_reason $?); nothing to do"; return 0; }
    local sd wakes=0 withheld=0
    sd=$(state_dir)

    # Սեդրակ answers his mail regardless of the cap — and regardless of the
    # halt (bd gqlc-ozfr): the halt's cause being over is exactly the kind of
    # news that travels by mail, so a halt that suppressed this wake could
    # never hear that it had outlived its purpose (one such halt held ~6.5h).
    # VI.4 is untouched — this hands Sedrak the DECISION about lowering; it
    # lowers nothing.
    if [ "$(seat_status sedrak)" != awake ] && [ ! -f "$(seat_home sedrak)/wake" ] \
        && [ "$(unread_count sedrak)" -gt 0 ]; then
        cmd_wake sedrak --reason "you have unread mail"
        wakes=$((wakes + 1))
    fi

    if [ -f "$sd/halt" ]; then
        echo "dispatch: halted — $(head -1 "$sd/halt")"
        return 0
    fi

    # Before anything is counted or chosen. Every decision below reads the
    # status files, and a stale one both spends a slot and hides the seat from
    # free_worker_of_class, so the same record costs the town twice.
    # Hygiene must not cost the town its routing. This ran bare, and km sets
    # `pipefail`, so ANY failure anywhere in the reconcile pass became the exit
    # status of the pipeline and aborted cmd_dispatch before a single bead was
    # considered. That is how one refused `herdr agent send` stopped the whole
    # factory for forty minutes (bd gqlc-87al).
    #
    # The specific refusal underneath is fixed above, but the containment is the
    # part that generalises: reconcile is a pre-pass that repairs the ledger, and
    # a repair that cannot be made is a reason to route on a slightly stale
    # ledger, never a reason to route nothing at all.
    if ! cmd_reconcile | sed 's/^reconcile: /dispatch: reconcile: /'; then
        echo "dispatch: the reconcile pass failed (diagnosis above); routing continues on a possibly stale ledger, because a failed repair must not cost the town its routing" >&2
    fi

    # And so does everyone else, once they are idle. Until now this dispatcher's
    # ONLY mail-driven wake was the four lines above, for one seat: every other
    # citizen was reachable only through the asleep passes below. On 2026-08-22
    # six seats finished their work, wrote handoffs, never ran `km sleep`, and
    # sat at empty prompts for ELEVEN HOURS holding all five slots — unroutable
    # by every automatic mechanism the town had, while the board called them
    # awake and the merge gate stayed shut (gqlc-5vp7).
    #
    # This is the ASK, not the force. It types a line at a citizen who is
    # demonstrably between turns; it does not end anyone's session, and the
    # idle test is what keeps it away from a seat mid-work or frozen on a modal
    # (see seat_pane_idle, and VI.2).
    #
    # Confirmed over two passes, for the same reason cmd_reconcile confirms its
    # own: a single capture is one photograph of a TUI, and the marker's age is
    # what makes the second sighting a different moment rather than the same
    # one. The marker is cleared by a nudge as well as by any sign of life, so
    # the floor between two nudges is two full passes rather than every tick.
    local s idle_marker nudged_marker attempts_file escalated_marker pending ask floor since cap tries before_unread
    floor=$(cfg_minutes welfare renudge_after_minutes 30)
    cap=$(recover_cap)
    for s in $(seats_all); do
        idle_marker="$(seat_home "$s")/idle"
        nudged_marker="$(seat_home "$s")/idle-nudged"
        attempts_file="$(seat_home "$s")/idle-attempts"
        escalated_marker="$(seat_home "$s")/idle-escalated"
        # Any sign of life ends the episode, and ALL of its markers go with it.
        # The floor below is per episode and not per seat: keyed to the seat it
        # would silence the town's only channel to a citizen who came back,
        # worked, and went idle again, for its whole window.
        #
        # Going to sleep ends the episode too, which is why the awake test is
        # folded in here rather than sitting above as an early `continue`.
        # Neither `km sleep` nor reconcile's freed arm removes any of these four
        # files, so a seat that was escalated, slept, and woke again met a pass
        # that read a stale idle-escalated and reported ESCALATED against an
        # episode in which nobody had asked her anything — permanent silence on
        # the town's only automatic channel to her, which is the worst failure
        # this ladder can have. `||` short-circuits, so seat_pane_idle is still
        # not called for a seat that is not awake.
        if [ "$(seat_status "$s")" != awake ] || ! seat_pane_idle "$s"; then
            rm -f "$idle_marker" "$nudged_marker" "$attempts_file" "$escalated_marker"
            continue
        fi
        # Escalated: the mayor has been told, so this pass says nothing further
        # INTO the seat for the rest of the episode. It keeps reporting, because
        # the slot is still held and going quiet here is how eleven hours passed
        # with every board reading healthy. Only witnessed work clears it — the
        # branch above, which needs the agent to leave `idle`, not merely for the
        # pane to look different.
        if [ -f "$escalated_marker" ]; then
            echo "dispatch: $s is awake and idle, ESCALATED to sedrak $(fmt_age "$(($(date +%s) - $(stat -c %Y "$escalated_marker")))") ago after $cap unanswered asks; not typing at her again this episode — read the pane"
            continue
        fi
        pending=$(unread_count "$s")
        # An empty inbox is no longer a reason to say nothing, and that was the
        # residual hole rather than a corner of one. The six seats of gqlc-5vp7
        # had FINISHED — pushed, handoffs written — and a citizen who has
        # finished has usually just drained her inbox, so `pending -gt 0` was
        # false for exactly the seats this pass was written to reach. The unread
        # count now chooses the WORDS; being awake and idle is the trigger.
        if [ "$pending" -gt 0 ]; then
            ask="[km] you have $pending unread letter(s) — bd mail inbox, and km sleep when you are done for the day (it is what makes you reachable)"
        else
            ask="[km] you are awake at an empty prompt with no unread mail: that holds one of the town's slots AND makes you unroutable, because every dispatch pass wakes asleep seats only. Pick up work, or run km sleep if you are done for the day"
        fi
        if [ ! -f "$idle_marker" ]; then
            : >"$idle_marker"
            echo "dispatch: $s is awake at an empty prompt with $pending unread; confirming next pass before nudging"
            continue
        fi
        [ "$(($(date +%s) - $(stat -c %Y "$idle_marker")))" -ge 60 ] || continue
        rm -f "$idle_marker"
        # A nudge is not free: it STARTS A TURN in the citizen's session and
        # spends her quota. Without a floor, a seat that does not act on one is
        # typed at every two passes — 165 times over the eleven hours this pass
        # exists to end — and the town's one channel to an awake seat becomes a
        # metronome nobody reads (the same shape as the repeated welfare
        # check-ins, 48 unread). Reported and never silent: a slot is still held.
        if [ -f "$nudged_marker" ]; then
            since=$(($(date +%s) - $(stat -c %Y "$nudged_marker")))
            if [ "$since" -lt "$floor" ]; then
                echo "dispatch: $s is still awake and idle $(fmt_age "$since") after a nudge that changed nothing; holding off another for $(fmt_age "$floor") rather than spending her quota on a repeat — read the pane"
                continue
            fi
        fi
        # The ladder ends. Without a cap the floor above only slows the
        # metronome: a seat that answers nothing is asked every half hour for as
        # long as it stays awake and idle, and nobody is ever told — the shape
        # the welfare check-ins already reached at 48 unread. At the cap the pass
        # stops typing and says it once, to the one seat whose job is deciding.
        # `|| true` is load-bearing under `set -e`: the file is created below,
        # after the first successful nudge, and removed on any sign of life, so
        # it is ABSENT on ask one of every episode. Without it the failing
        # substitution takes the whole dispatch tick down before the routing
        # passes run — the ladder died on its own first rung (gqlc-w3wb).
        tries=$(cat "$attempts_file" 2>/dev/null || true)
        case "$tries" in '' | *[!0-9]*) tries=0 ;; esac
        if [ "$tries" -ge "$cap" ]; then
            # The marker records a DELIVERY, not an attempt. Set before the send
            # with the send's failure swallowed, a mail that never arrived still
            # suppresses every later retry: the mayor is never told and this pass
            # reports ESCALATED for the rest of the episode, which fails more
            # quietly than doing nothing at all. ENOSPC has emptied this town's
            # scratch before (gqlc-vze6), so a failing send is not hypothetical.
            #
            # mail_send's own return code will not carry it either: its last
            # statement writes the SENDER's sent box, so a delivery that failed
            # to reach the inbox still returns 0. So the inbox is counted before
            # and after, with km's own reader.
            #
            # Counted from andranik alone, not over the whole box: any letter
            # landing in that window — another seat's, a concurrent km's —
            # confirms a delivery that failed, and a false confirm writes the
            # marker and restores the permanent silence this code exists to end.
            #
            # A read by Սեդրակ racing between the two counts reports UNDELIVERED
            # for a mail that did land; the cost is one retried escalation on the
            # next pass, which is the direction to be wrong in.
            before_unread=$(mail_unread_from sedrak andranik)
            if mail_send sedrak --from andranik \
                -s "$s is awake and idle after $cap unanswered asks" \
                -m "km dispatch asked $s to pick up work or run 'km sleep' $cap times in one idle episode. Nothing changed, so it has stopped typing at her and is telling you instead. It will not mail you about this episode again.

She is awake, her agent reports idle, and she is holding one of $(cfg concurrency max_active) slots while answering no dispatch pass — every pass wakes ASLEEP seats only.

Unread mail: $pending
Last ask: $(fmt_age "$(($(date +%s) - $(stat -c %Y "$nudged_marker" 2>/dev/null || date +%s)))") ago

Nothing here ends a session and nothing should: a seat that has not asked to leave has not consented (VI.2). Read her pane before deciding. 'km sleep --seat $s' frees the slot if she is genuinely done; if her turn died mid-work, she needs a person, not another line of text.

This counter clears by itself the moment her agent leaves 'idle' — witnessed work, not a pane that merely looks different." \
                && [ "$(mail_unread_from sedrak andranik)" -gt "$before_unread" ]; then
                : >"$escalated_marker"
                echo "dispatch: ESCALATED $s to sedrak — $cap asks in this episode changed nothing; not typing at her again this episode"
            else
                echo "dispatch: ESCALATION UNDELIVERED for $s — no new letter from andranik reached sedrak's inbox, so nothing was recorded and the next pass will try again; $s is at her $cap-ask cap and is not being typed at meanwhile"
            fi
            continue
        fi
        if seat_nudge "$s" "$ask"; then
            tries=$((tries + 1))
            echo "$tries" >"$attempts_file"
            : >"$nudged_marker"
            echo "dispatch: nudged $s (ask $tries of $cap) — awake, idle, $pending unread; the ask was typed and submitted"
            wakes=$((wakes + 1))
        else
            # Reported, not counted, and no floor set. km's own success message
            # was what let an operator believe the town unblocked while nothing
            # moved. A failed send means she has not been asked — or, in the
            # one case where the text was typed and the Enter failed, has not
            # been asked YET — so it neither spends her escalation budget nor
            # earns the half-hour silence: the next pass tries again after one
            # more confirm cycle.
            echo "dispatch: NUDGE UNDELIVERED to $s — the diagnosis above says which half failed. The slot is still held; retrying next confirm rather than counting it against her $cap asks"
        fi
    done

    # A full cap no longer returns early. It used to, which put the whole
    # routing decision behind the cap check: at 5/5 nothing was considered at
    # all, at any priority, so a P0 judge bead did not outrank a running P3 and
    # the town's only merge gate could be held shut by its own throughput
    # (gqlc-dz85). Zeroing the slots instead lets both passes below run and
    # decline capped work on their own, which is what leaves the judge reachable.
    # A slot is spent by a session that EXISTS, not by a file that says one
    # does. Reading the status string here is what let a finished session hold
    # a slot forever, and what let a live one under asleep-pending hold none at
    # all so the cap could overcommit (gqlc-s16s, gqlc-0gjt).
    local max active=0 s slots
    max=$(cfg concurrency max_active)
    for s in $(capped_seats); do
        seat_session_live "$s" && active=$((active + 1))
    done
    slots=$((max - active))
    if [ "$slots" -le 0 ]; then
        slots=0
        echo "dispatch: $active/$max capped seats awake; no free slot"
    fi

    # Resume pass: a seat with in-progress beads gets its own work back first
    # (Constitution III.3) before any fresh bead is routed anywhere.
    #
    # Both queries below are fail-closed. A query that FAILS is not a queue with
    # nothing in it: swallowing the status with `|| x=""` is what let a total
    # routing failure print "done (0 wake(s) this run)" and exit 0 for the whole
    # life of the kingdom, with no seat ever woken and nothing to see (gqlc-z1qw).
    # `-n 0` is unlimited and is load-bearing on every bd query here. The JSON
    # renderers cap silently — `ready` at 100, `list` at 50 — while the plain
    # renderers disclose it ("Showing 100 of 234 ready issues"), so the caller
    # that cannot read prose is the only one not told. A bead past the window
    # is not a bead nobody claimed, it is a bead nobody was shown, and the two
    # are indistinguishable from the board (gqlc-mlca).
    #
    # ACTIONABLE, not merely in progress. Post-#1116 law is that a warrior's
    # implementation bead STAYS in_progress while its class:judge review bead
    # awaits a verdict, so a resume pass that woke every in-progress holder woke
    # review-blocked warriors on every two-minute cycle — each burning a slot
    # from concurrency.max_active to check mail and sleep again, with the judge
    # who would unblock them competing for the slots they ate (gqlc-3jmx). A
    # bead is actionable here iff it carries no OPEN blocks-type dependency;
    # the warrior files the review bead with `--deps blocks:<impl-bead>`, and
    # the judge's close of it is what makes the impl bead actionable again.
    # `bd ready` returns status open ONLY, so an in_progress bead never
    # re-enters it and this pass is the only wake path back — which is why the
    # predicate has to live here and nowhere else.
    #
    # The blocker join is a second, EXPLICIT-ID `bd show`, and the two
    # alternatives were rejected on measurement rather than taste:
    #   `bd blocked --json` has no -n flag at all, so its cap behaviour cannot
    #     be measured; an overflow bead would read as unblocked. Fail-open and
    #     silent, in the very function gqlc-z1qw burned.
    #   list's `dependency_count` reads 0 beside an open blocker (measured
    #     2026-08-21). Unusable.
    # An explicit-id query has no renderer window at all, so it is complete by
    # construction. The `[ -n "$ids" ]` guard is load-bearing and not a tidiness
    # check: `bd show --json` with ZERO ids prints an error OBJECT on stdout, so
    # that failure arrives as data and not only as a status. (Re-measured
    # 2026-08-23: real bd also exits 1, so pipefail would catch this one too —
    # an earlier note here said exit 0. The guard does not rest on either: the
    # data half is what is certain across bd versions.)
    # `.[]` is deliberately not wrapped in an array coercion for the same
    # reason — on that object jq aborts, and the die below is what the town
    # sees instead of a silent all-clear.
    local inprog ids
    if ! ids=$(bd list --status in_progress -n 0 --json 2>/dev/null |
        jq -r '.[] | select(.assignee != null) | .id'); then
        die "dispatch: the in-progress query failed; nothing routed this run"
    fi
    inprog=""
    if [ -n "$ids" ]; then
        # One call, all ids: the argv is bounded by the count of ASSIGNED
        # in-progress beads (≲20 here), not by the backlog, so it is nowhere
        # near the E2BIG ceiling that killed the ready query (gqlc-fo48).
        # shellcheck disable=SC2086 # deliberate word splitting: ids are [a-z0-9-]
        if ! inprog=$(bd show $ids --json 2>/dev/null | jq -r '
            .[]
            | select(.assignee != null)
            | select([.dependencies // [] | .[]
                      | select(.dependency_type == "blocks" and .status != "closed")]
                     | length == 0)
            | "\(.assignee) \(.id)"' | sort); then
            die "dispatch: the blocker query failed; nothing routed this run"
        fi
    fi
    # `mine` is now the actionable subset, so the wake reason names only
    # actionable beads — behaviour, pinned by a row, not an accident. A seat
    # whose every in-progress bead is blocked matches nothing, is not woken, and
    # its slot flows to the passes below, which is where the judge is routed.
    route_owners "$inprog" "resume your in-progress work"

    # The ready queue serves the two passes below. Its rows split by whether the
    # bead names an owner:
    #
    #   owned — assigned to a seat. It goes to that seat and to nobody else, at
    #           any status. Before this split, a bead that was assigned but
    #           still OPEN was in neither pass — not null-assignee for the fresh
    #           one, not in_progress for the resume one — so it sat on the board
    #           looking owned and routed to nobody, at any priority, with
    #           nothing reporting the omission (gqlc-xq8a, gqlc-g10n).
    #   fresh — unassigned, routed to a free seat of its class. A class label
    #           names that class; an absent one INFERS warrior (gqlc-38ye).
    #
    # A class label decides nothing for an owned bead: the assignee already
    # names the seat, which is the rule the resume pass has always used. Hence
    # the class question arises on the fresh arm only, where a label is the sole
    # way to choose a seat at all.
    #
    # An unlabelled bead used to be DROPPED here, silently. That made labelling
    # a gate rather than a hint, and put one seat — the Քաղաքապետ, whose soul
    # carried it as a standing chore — in front of every bead in the town.
    # MEASURED 2026-08-23: of 208 unassigned open beads, 25 carried no `class:`
    # label, including one P0 and three P1; none of them was named in any
    # dispatch run, because the drop said nothing. Inferring warrior costs an
    # occasional escalation under Constitution III.1, which is cheap; a bead
    # nobody can see is not. Owner's decision, recorded on gqlc-38ye.
    #
    # Captured once rather than piped: the hold verdict below needs each
    # candidate's labels, and re-querying could read a different queue.
    local queue routed owned lowpri epics ready id cls prio seat
    if ! ready=$(bd ready -n 0 --json 2>/dev/null); then
        die "dispatch: the ready-queue query failed; nothing routed beyond the resume wakes above"
    fi

    # The floor the FRESH arm below applies, from [dispatch] max_priority.
    # Fail-OPEN and loud, deliberately: a config this pass cannot read must not
    # be able to stop the town, because "routed nothing, printed a healthy
    # summary" is the failure this file has been bitten by three times
    # (gqlc-z1qw, gqlc-fo48). An absent or malformed value routes everything and
    # says why, which an operator can see; the fail-closed alternative is silent.
    local maxprio
    maxprio=$(cfg dispatch max_priority)
    case "$maxprio" in
        '' | *[!0-9]*)
            echo "dispatch: [dispatch] max_priority = '${maxprio:-<unset>}' is not a number; every priority is routable this run"
            maxprio=99
            ;;
    esac
    # `. as $c` binds the class name before the pipe, and must stay bound: inside
    # `map(...)` the pipe in `($b.labels // []) | index(...)` rebinds `.` to the
    # labels array, so a bare `"class:" + .` is string + array — a type error that
    # aborts the whole program on any unassigned bead, labelled or not.
    #
    # The `lowpri` arm is the priority floor, and it sits on the FRESH branch
    # alone — after the `owned` test, so a bead that names a seat is never
    # withheld from it by a number (Constitution III.3, same reason the resume
    # pass runs first). It emits rather than drops, so the beads it withholds
    # can be named in the output below instead of vanishing.
    #
    # It sits AHEAD of the class test, so an unlabelled bead below the floor is
    # named by the floor rather than routed. Either order routes the same set;
    # this one reports the more specific reason, and the reason is the point.
    #
    # The `epic` arm is the third withholding arm and the newest (gqlc-calw). An
    # epic is a container for months of work under one id: a warrior woken on
    # one is told to claim it and begin, there is no honest way to do that, and
    # the slot it spends is one of six. The treatment is an architect
    # decomposing it into execution beads, which is why the arm sits AFTER the
    # owned test — an epic that names a seat is exactly the shape that should
    # route, and Constitution III.3 protects it there as it protects a bead
    # below the floor.
    #
    # It sits AHEAD of `lowpri` for the opposite reason `lowpri` sits ahead of
    # the class test: the reason printed should be the one an operator can act
    # on. "Below the floor" invites raising the floor, and raising it would not
    # make an epic workable. Being an epic is a property of the bead; the floor
    # is a config line that moved from 2 to 3 the night before this was written.
    #
    # `issue_type` and NOT a title convention or a label. MEASURED 2026-08-23
    # over the whole ledger (`bd list --all -n 0 --json`, 814 beads): 6 carry
    # `issue_type: epic`, of which 2 are not closed — gqlc-h9n at P1 and
    # gqlc-35yu at P2, both unassigned, both in `bd ready`, both at or above a
    # floor of 3, so both routable today. An `[EPIC]` title prefix is carried by
    # 2 of those 6, a minority convention in prose. An `epic` LABEL is carried
    # by 0 beads in the ledger. Only the type is bd's own field.
    #
    # Each fresh row carries a third field, `inferred` or `labelled`, saying
    # where its class came from. Without it a routed-by-default bead and a
    # deliberately-labelled one are indistinguishable at the wake, which is the
    # silence this change is here to end rather than to relocate.
    if ! queue=$(jq -r --argjson maxp "$maxprio" '
        [ .[]
          | . as $b
          | (["architect", "warrior", "judge"]
             | map(. as $c | select(($b.labels // []) | index("class:" + $c))))[0] as $cls
          | {id, priority, assignee, cls: $cls, itype: .issue_type}
        ] | sort_by(.priority) | .[]
          | if .assignee != null           then "owned \(.assignee) \(.id)"
            elif .itype == "epic"          then "epic \(.id)"
            elif (.priority // 0) > $maxp  then "lowpri \(.id) \(.priority // 0)"
            elif .cls == null              then "fresh \(.id) warrior inferred \(.priority // 0)"
            else "fresh \(.id) \(.cls) labelled \(.priority // 0)" end' <<<"$ready"); then
        # Not "nothing routed": the resume pass above may already have queued
        # wakes, and they stand. An operator reading this during an incident has
        # to be able to trust it.
        # The owned pass is downstream of this query, so nothing owned has been
        # routed yet — only the resume wakes stand here.
        die "dispatch: the ready-queue query failed; neither owned nor fresh beads routed (the resume wakes above stand)"
    fi
    owned=$(echo "$queue" | awk '$1 == "owned" { print $2, $3 }')
    # The fourth field is the bead's priority, carried through so the
    # unroutable report below can be proportionate to it (gqlc-2ve4). Every
    # `read` over this list takes it, including the ones that ignore it: with
    # `read -r id cls origin` the trailing field lands INSIDE `origin`, and the
    # inferred-class arm's `[ "$origin" = inferred ]` then never matches.
    routed=$(echo "$queue" | awk '$1 == "fresh" { print $2, $3, $4, $5 }')
    lowpri=$(echo "$queue" | awk '$1 == "lowpri" { print $2, $3 }')
    epics=$(echo "$queue" | awk '$1 == "epic" { print $2 }')

    # Said out loud, in the same shape as the hold verdicts below. A pass that
    # declines work silently and then prints a summary that reads healthy is
    # this dispatcher's oldest recurring defect, and a priority floor is a
    # machine for producing exactly that — 158 of the 319 open beads the morning
    # it was added.
    #
    # Named individually up to a cap, then counted (gqlc-s4zm). It used to name
    # every one, which was right at 5 beads and wrong at 165: the floor moved to
    # 2 for Constitution V.3.1, and P3 is now where machinery beads are FILED
    # rather than a backlog anyone means to drain, so the withheld set is
    # permanently large by design. A per-bead line for each of them on a
    # two-minute tick is the volume that makes an operator stop reading — the
    # same failure as silence, reached from the other side, which is the
    # argument the unroutable arm below already settled for the same reason.
    #
    # The cap is not silence and the difference is the count: every withheld
    # bead is in `bd ready`, the total is in the done line, and the line below
    # says how many it did not name and how to list them. What the cap costs is
    # the ability to spot ONE unexpected id in the tail by eye, which is why it
    # is a cap and not an aggregate — a run withholding a handful still names
    # them all, exactly as before.
    local skipped=0 floor_cap=10 floor_named=0
    while IFS=' ' read -r id prio; do
        [ -n "$id" ] || continue
        skipped=$((skipped + 1))
        if [ "$floor_named" -lt "$floor_cap" ]; then
            echo "dispatch: below the floor $id — priority $prio, and [dispatch] max_priority is $maxprio; filed and searchable, routed to nobody"
            floor_named=$((floor_named + 1))
        fi
    done <<<"$lowpri"
    if [ "$skipped" -gt "$floor_named" ]; then
        echo "dispatch: below the floor — and $((skipped - floor_named)) more, not named here (${skipped} withheld in all by [dispatch] max_priority $maxprio); 'bd ready -n 0' lists every one"
    fi

    # And the epics, said the same way and for the same reason. Withheld, NEVER
    # dropped: the arm this one sits beside used to drop unlabelled beads
    # silently, and that drop is why 25 beads including a P0 were absent from
    # every dispatch run the town ever made (gqlc-38ye). The line names the
    # remedy, because a refusal an operator cannot act on is only a quieter
    # version of the same silence.
    local epic_n=0
    while IFS=' ' read -r id; do
        [ -n "$id" ] || continue
        echo "dispatch: epic $id — its issue_type is epic, so it is a container for work rather than work; it needs a Ճարտարապետ to decompose it into execution beads (assign it to one and it routes), not a seat to claim it. Routed to nobody."
        epic_n=$((epic_n + 1))
    done <<<"$epics"

    # And the same courtesy for the beads whose class this pass GUESSED. Said
    # before routing rather than after, so a bead the hold verdict later
    # withholds is still on the record as unlabelled — the line reports where
    # the class came from, not that a wake happened.
    local origin prio inferred=0
    while IFS=' ' read -r id cls origin prio; do
        [ -n "$id" ] || continue
        [ "$origin" = inferred ] || continue
        echo "dispatch: class inferred $id — it carries no class: label, so it is routed as class:$cls by default; label it to send it somewhere else, or let the Ռազմիկ escalate it (Constitution III.1)"
        inferred=$((inferred + 1))
    done <<<"$routed"

    # Owned pass: an unclaimed bead that names a seat goes back to that seat,
    # ahead of any fresh routing, for the same reason the resume pass runs first
    # (Constitution III.3). An assignee that is not a seat — a person, most of
    # them — matches no seat here and is left alone.
    route_owners "$owned" "assigned work waiting — claim it before you begin"

    # Fresh pass: ready, unassigned, class-labelled beads, priority first. It
    # runs with no slots left too, because judge work does not need one.
    #
    # Before routing anything, ask whether each candidate's premise is actually
    # on master and out of every open PR's way (gqlc-pj4r). The edges come from
    # ONE multi-id `bd dep list` — the single-id form returns the parent issue
    # object instead of {issue_id, depends_on_id, type} rows, so a per-id loop
    # would parse a different shape and quietly find no edges — and the parent
    # statuses from ONE `bd show` over the discovered-from parents.
    local ids deps parents parent_ids docs verdicts="" held=0
    ids=$(awk 'NF { print $1 }' <<<"$routed")
    if [ -n "$ids" ]; then
        # shellcheck disable=SC2086 # deliberate word splitting: one call, all ids
        if ! deps=$(bd dep list $ids --json 2>/dev/null); then
            echo "dispatch: the dependency query failed; fresh pass skipped this run (the resume and owned wakes above stand)"
            return 0
        fi
        parent_ids=$(jq -r '[ .[]? | select(.type == "discovered-from") | .depends_on_id ] | unique | .[]' \
            <<<"$deps" 2>/dev/null) || parent_ids=""
        parents='[]'
        if [ -n "$parent_ids" ]; then
            # shellcheck disable=SC2086 # deliberate word splitting: one call, all ids
            if ! parents=$(bd show $parent_ids --json 2>/dev/null |
                jq -c 'if type == "array" then . else [.] end' 2>/dev/null); then
                echo "dispatch: the parent-status query failed; fresh pass skipped this run (the resume and owned wakes above stand)"
                return 0
            fi
        fi
        if ! docs=$(dispatch_candidate_docs "$ready" "$deps" "$parents" "$ids"); then
            echo "dispatch: the candidate documents could not be assembled; fresh pass skipped this run"
            return 0
        fi
        # Captured on the AND-OR rather than read from $? in the branch. Inside
        # the then-branch of an `if !`, $? is the status of the NEGATED test,
        # which is 0 exactly when the branch is taken — so this sentence spent
        # its life reporting every failure as rc=0.
        #
        # The number is worth carrying because it discriminates. Measured
        # 2026-08-30 against `km hold-verdict`: bad stdin exits 1, through
        # die (km:22) inside the substitution's subshell, and cmd_hold_verdict
        # ends in a jq program whose own status is the function's — a jq forced
        # to exit 5 there surfaced here as 5. Its earlier `jq -e` guards do NOT
        # surface: they are caught by an `if !` and collapse to die's 1. So 1
        # means "km refused the input or a guard fired" and anything else is
        # jq's own (bd gqlc-uethk).
        local hv_rc=0
        verdicts=$(cmd_hold_verdict <<<"$docs") || hv_rc=$?
        if [ "$hv_rc" != 0 ]; then
            # Never fall through to routing unchecked. The resume wakes taken
            # above stand, and an operator reading this during an incident must
            # be able to trust that sentence.
            echo "dispatch: hold-verdict failed (rc=$hv_rc); fresh pass skipped this run (the resume and owned wakes above stand)"
            return 0
        fi
    fi

    # report_unroutable's accumulators; see its comment where it is defined.
    local unroutable=0 stalled=0 quiet="" stalled_beads=""

    local verdict reason how
    while IFS=' ' read -r id cls origin prio; do
        [ -n "$id" ] || continue
        verdict=$(awk -v i="$id" '$2 == i { $1 = $1; print; exit }' <<<"$verdicts")
        # An explicit ROUTE is the only thing that routes. A hold and a bead the
        # verdict never mentioned take the same arm on purpose: the default for
        # anything we did not affirmatively clear is to leave it alone.
        if [ "$verdict" != "ROUTE $id" ]; then
            reason=${verdict#HOLD "$id" — }
            [ -n "$reason" ] || reason="no verdict returned for this bead"
            echo "dispatch: hold $id — $reason"
            held=$((held + 1))
            continue
        fi
        # `continue`, not `break`: the queue is sorted by priority, not by class,
        # so exhausted slots must skip past capped beads to reach judge work
        # sitting behind them rather than abandoning the rest of the queue.
        if [ "$cls" != judge ] && [ "$slots" -le 0 ]; then
            # Not silent any more. The aggregate `no free slot` line above
            # announces the condition but names nothing it held, so a P0 stuck
            # behind the cap was indistinguishable from a P0 nobody had filed.
            report_unroutable "$id" "$cls" "$prio" \
                "every capped slot is spent ($active/$max awake) and only judge work is exempt from the cap"
            continue
        fi
        # The seat is told too, not just the operator: a warrior who can see the
        # class was guessed knows escalation is on the table, and one who cannot
        # has to assume the bead was aimed at them deliberately.
        how=""
        [ "$origin" != inferred ] || how=" (class inferred — this bead carries no class: label; escalate if it is not warrior work)"
        # Both branches, and the losing one worded as ordinary. This bead is
        # ready and unassigned as THIS pass reads it, and a wake is composed
        # before it is delivered, so another seat may hold it by the time the
        # citizen reads the banner — twice on 2026-08-29 (gqlc-wguoq, 21s;
        # gqlc-96lf0). Naming only the claim left the loser with one
        # instruction, and it was the harmful one.
        #
        # Deliberately does NOT restate that the bead is held or that claiming
        # it is the damage: since gqlc-oqu5 km-seat re-derives every bead named
        # here at delivery and appends the assignee as fact, plus a STALE line
        # saying not to claim. Repeating that here would say it twice in four
        # lines, on facts this pass is too early to know. What no other line
        # carries is the second half of Սեդրակ's standing rule — take other
        # work rather than sleeping — so that is what this adds, with the
        # protocol named for the rest of it.
        if seat=$(free_worker_of_class "$cls"); then
            cmd_wake "$seat" --bead "$id" --reason "ready ${cls} work${how} — claim it once you have checked its assignee. If another seat already holds it that is an ordinary lost race, not a failure: take another ready bead rather than going back to sleep (citizen-protocol, Waking step 4)"
            wakes=$((wakes + 1))
            if [ "$cls" != judge ]; then slots=$((slots - 1)); fi
        else
            report_unroutable "$id" "$cls" "$prio" "$(class_roster_reason "$cls")"
        fi
    done <<<"$routed"

    # The counted arm, one line per (class, reason) rather than per bead. The
    # aggregate is what keeps ordinary backlog visible without drowning the P0
    # lines above it.
    if [ -n "$quiet" ]; then
        local qn qrest qcls qwhy
        while IFS=' ' read -r qn qrest; do
            [ -n "$qn" ] || continue
            qcls=${qrest%%|*}
            qwhy=${qrest#*|}
            echo "dispatch: unroutable — $qn $qcls bead(s) of priority $((DISPATCH_LOUD_PRIORITY + 1)) or worse found no seat: $qwhy"
        done < <(printf '%s' "$quiet" | sort | uniq -c | sed 's/^ *//')
    fi

    # The report the routing cannot make for itself. This run's passes are done;
    # a bead none of them could reach is named here rather than left to be found
    # by accident, which is how each of the previous three invisibility shapes
    # was found. It does not stop the run: routing is the job, and a diagnostic
    # that can abort it would be a worse failure than the one it reports. `km
    # doctor` is where the same fact is a gate that FAILS.
    local stranded
    if ! stranded=$(stranded_ids); then
        echo "dispatch: the reachability check could not run; the routing above stands"
    elif [ -n "$stranded" ]; then
        echo "dispatch: STRANDED — in progress and assigned to nobody, so no pass can wake anyone for them: $stranded"
    fi

    # And the second unreachable shape, one line per unresolvable NAME rather
    # than per bead, because the name is the thing an operator acts on: a
    # retired seat appears once with its whole holding behind it. Nothing is
    # reassigned or cleared here — see unreachable_owner_rows.
    local urows uname uids
    if ! urows=$(unreachable_owner_rows); then
        echo "dispatch: the assignee-resolution check could not run; the routing above stands"
    else
        while IFS=' ' read -r uname uids; do
            [ -n "$uname" ] || continue
            echo "dispatch: UNREACHABLE ASSIGNEE $uname — it is in neither [seats] nor [humans] in kingdom.toml, so every pass matching assignees against the seat roster skips this work and no wake will ever come for it; nothing has been reassigned: $uids"
        done <<<"$urows"
    fi

    # The escalation, after every pass has had its chance at the queue, so the
    # marker describes the run's final state and not an intermediate one.
    record_stalled_p0 "$stalled_beads"
    echo "dispatch: done ($wakes wake(s) this run, $held held, $epic_n epic, $skipped below max_priority $maxprio, $inferred class inferred, $withheld owner-withheld, $unroutable unroutable ($stalled at P0))"
}

# ---------- the routing hold ----------
#
# A bead filed against code that exists only on an unmerged PR branch reads
# `ready`, and a warrior routed to it branches from origin/master and finds
# nothing to fix. Until now the only guard was Սեդրակ declining to class-label
# such beads, from a list he carried in his handoff — a person remembering.
#
# HOLD a fresh-routing candidate if EITHER its declared subject path is absent
# from origin/master, OR an open PR modifies it. Release is automatic: merging
# or closing the PR changes the answer on the next run, so nobody has to
# remember anything. Holds gate FRESH routing only; work that already names a
# seat is never withheld, whether that seat has started it or merely been
# assigned it (Constitution III.3) — both owner-facing passes run upstream of
# the verdict, so no hold can reach them.
#
# The convention this reads is a bd label `subject:<path>`, repo-relative, file
# or directory. A title-prefix→path map was measured and rejected: it would live
# on master and be maintained reactively, so residue about a NEW subsystem — the
# premise-absent case exactly — hits it as an unknown prefix and fails open at
# the worst spot.

hold_fetch_master() {
    [ -z "${KM_HOLD_SKIP_FETCH:-}" ] || return 0
    timeout 30 git -C "$(main_root)" fetch --quiet origin master 2>/dev/null && return 0
    # Over-holding, and it self-heals next run: a stale origin/master can only
    # make a path look absent, never make an absent one look present.
    echo "hold-verdict: could not fetch; consulting a possibly-stale origin/master" >&2
}

hold_open_pr_files() { # -> [{number, files:[path], truncated}]; rc 1 if gh cannot answer
    local raw limit=100 got
    raw=$(timeout 30 gh pr list --state open --limit "$limit" --json number,changedFiles,files 2>/dev/null) || return 1
    # The LIST-level cap, one level up from the per-PR one below. gh offers no
    # list-level tell: asked for N it returns N whether N or 4N are open, so the
    # (N+1)th PR is indistinguishable from no PR — and every PR it DID return can
    # be individually complete, so the per-PR guard never fires. A full-length
    # list is an unknown list; degrade to the hold a gh outage already takes.
    got=$(printf '%s' "$raw" | jq 'length' 2>/dev/null) || return 1
    if [ "$got" = "$limit" ]; then
        # Named on stderr because the reason line downstream says "gh unavailable",
        # which is true of the answer but not of the cause; without this the
        # journal sends an operator looking for an outage that did not happen.
        echo "hold-verdict: gh returned $got open PRs against a limit of $limit — the list may be truncated, holding" >&2
        return 1
    fi
    # MEASURED 2026-08-22 on PR #742: changedFiles 102, files 100 — `--json files`
    # caps per PR and says nothing. A capped list is an UNKNOWN list, not a
    # complete one; reading it as complete fails OPEN on the largest PRs.
    # changedFiles is the cap-independent tell, so no threshold is guessed here.
    printf '%s' "$raw" | jq -c '[ .[] | {
        number,
        files: [ .files[]?.path ],
        listed: (.files | length),
        changed: .changedFiles,
        truncated: (.changedFiles > (.files | length))
    } ]' 2>/dev/null || return 1
}

# branch_pr_state <branch-name> -> open | finished | none | unanswered
#
# The one place seat_refresh_step asks GitHub what the branch's PR record says
# (0008). Fail-closed in the same shape as hold_open_pr_files above: a timeout
# and an exit-status check, with an empty answer distinct from no answer —
# jq-null over a failed query is the known trap (gqlc-z1qw), which is why the
# helper reports `unanswered` on non-zero exit rather than folding it into
# `none`. Two paths to one HOLD must stay tellable apart (0008 §3): the words
# `open` / `none` / `unanswered` name the reason so seat_refresh_step's verdict
# lines can carry it through to the journal.
#
# headRefOid is in the field list although this consumer ignores it: gqlc-guq3's
# consumer needs it, and the contract should not reshape under her.
branch_pr_state() {
    local name=$1 raw count open
    [ -n "$name" ] || { echo unanswered; return 0; }
    raw=$(timeout 30 gh pr list --head "$name" --state all \
        --json state,headRefOid --limit 50 2>/dev/null) || { echo unanswered; return 0; }
    count=$(printf '%s' "$raw" | jq 'length' 2>/dev/null) || { echo unanswered; return 0; }
    if [ "$count" -eq 0 ]; then
        echo none
        return 0
    fi
    open=$(printf '%s' "$raw" | jq '[.[] | select(.state=="OPEN")] | length' 2>/dev/null) || { echo unanswered; return 0; }
    if [ "$open" -gt 0 ]; then
        echo open
        return 0
    fi
    echo finished
}

hold_paths_on_master() { # subjects on stdin, one per line -> {"<path>": true|false}
    local mr s present out='{}'
    mr=$(main_root)
    while IFS= read -r s; do
        [ -n "$s" ] || continue
        if git -C "$mr" cat-file -e "origin/master:$s" 2>/dev/null; then present=true; else present=false; fi
        out=$(printf '%s' "$out" | jq -c --arg s "$s" --argjson p "$present" '.[$s] = $p')
    done
    printf '%s' "$out"
}

cmd_hold_verdict() {
    no_args hold-verdict "$@"
    local input
    input=$(cat)
    if ! printf '%s' "$input" | jq -e 'type == "array"' >/dev/null 2>&1; then
        die "hold-verdict: stdin is not a JSON array of candidate documents"
    fi

    local subjects
    subjects=$(printf '%s' "$input" | jq -r '
        [ .[]? | select(type == "object") | .labels
          | select(type == "array") | .[]
          | select(type == "string" and startswith("subject:"))
          | .[8:] | sub("/+$"; "") | select(length > 0) ] | unique | .[]')

    # gh and the fetch cost a network round trip each, so they are paid only
    # when some candidate actually declares a subject. That is also what keeps
    # the ordinary-bead path — the overwhelming majority — free, and the test
    # suite hermetic without stubbing anything for it.
    local prs='[]' pr_known=true present='{}'
    if [ -n "$subjects" ]; then
        hold_fetch_master
        if ! prs=$(hold_open_pr_files); then
            prs='[]'
            pr_known=false
        fi
        present=$(printf '%s\n' "$subjects" | hold_paths_on_master)
    fi

    # On descriptors for the same reason dispatch_candidate_docs is, and before
    # rather than after it fires: $prs carries every open PR's full file list, so
    # it grows with the PR queue exactly as the ready payload grows with the bead
    # queue. Measured 2026-08-22 at 26 open PRs it was already within ~30% of the
    # 131072-byte per-argument ceiling. $prKnown is a bare true/false and could
    # stay in argv; it moves anyway, so that no future reader has to work out
    # which of three adjacent bindings was the safe one.
    printf '%s' "$input" | jq -r \
        --slurpfile prs <(printf '%s' "$prs") \
        --slurpfile prKnown <(printf '%s' "$pr_known") \
        --slurpfile present <(printf '%s' "$present") '
        ($prs[0]) as $prs | ($prKnown[0]) as $prKnown | ($present[0]) as $present |
        # (.labels // []) at both sites, and it is the same normalisation the
        # rest of this file already applies at five others (km:601, 609, 650,
        # and the two ready-queue counters in cmd_status). bd serialises a bead
        # carrying no labels as `labels: null`, so a bare `.labels[]` aborts jq
        # on the COMMONEST candidate shape in the town.
        def subjects_of:
            [ (.labels // [])[] | select(type == "string" and startswith("subject:"))
              | .[8:] | sub("/+$"; "") | select(length > 0) ];

        def is_judge: any((.labels // [])[]; . == "class:judge");

        # Fail closed per candidate, never a silent drop: gqlc-z1qw was a jq
        # abort that read as a healthy zero, and one bad row must cost one line
        # rather than the whole run.
        #
        # `null` is EXCLUDED from this arm on purpose (gqlc-bcir). It used to be
        # caught, and it is not corruption: measured 2026-08-22 over the ready
        # queue, 293 beads had an array and 14 had null — every one of those 14
        # was reported to the operator as "malformed candidate", 14 of the 27
        # holds the town was issuing. A majority of the hold census was an
        # unlabelled bead described in the vocabulary of data corruption, and
        # the residue arm below — the code written for exactly that bead — was
        # unreachable for all of them.
        #
        # The type is NAMED rather than only the type that was wanted, because
        # "labels is not an array" sends a reader looking for a corrupt record
        # without telling them what to look for.
        def malformed:
            if type != "object" then "not an object"
            elif (.id | type) != "string" or (.id == "") then "no id"
            elif (.labels != null) and ((.labels | type) != "array")
                then "labels is \(.labels | type), not an array"
            else null end;

        # The slash boundary is the whole point of the second clause: a plain
        # substring test would hold internal/tools/tmpreaper for a PR touching
        # internal/tools/tmpreap, which are different subsystems.
        def touching($s): [ $prs[] | select(any(.files[]; . == $s or startswith($s + "/"))) ];

        # The premise of a review bead IS an open PR touching its subject, so
        # the three arms below that ask "might an open PR be touching this?"
        # are inverted for it: they hold the review for as long as it is wanted
        # and release it when the PR merges. The premise-absent arm above them
        # is NOT inverted — a review naming a path no branch has is a typo — so
        # the exemption is per-arm, never a pass for the class (gqlc-n4oe).
        #
        # No apostrophes in this jq program: it is a single-quoted shell string.
        def reason($s; $judge):
            if ($present[$s] // false) | not then
                "premise absent from origin/master: \($s)"
            elif $judge then null
            elif ($prKnown | not) then
                "gh unavailable — cannot rule out an open PR touching \($s)"
            elif (touching($s) | length) > 0 then
                # Before the truncation arm on purpose: a match in the VISIBLE
                # list of a truncated PR is still a definite match, and the
                # reason printed must be as strong as the evidence held.
                "open PR #\(touching($s)[0].number) touches \($s)"
            elif ([ $prs[] | select(.truncated) ] | length) > 0 then
                ([ $prs[] | select(.truncated) ][0]) as $t
                | "open PR #\($t.number) lists \($t.listed) of \($t.changed) files — cannot rule out \($s)"
            else null end;

        .[]
        | . as $c
        | (if (type == "object") and ((.id | type) == "string") then .id else "?" end) as $id
        | (malformed) as $bad
        | if $bad != null then "HOLD \($id) — malformed candidate: \($bad)"
          else
            (subjects_of) as $subs
            | if ($subs | length) == 0 then
                # Residue with no subject label yet. Only discovered-from carries
                # the "filed against that PR" meaning; until and related do not.
                [ ($c.deps // [])[] | select(type == "object")
                  | select(.type == "discovered-from")
                  # "not closed", never a whitelist of the states known today: a
                  # whitelist clears every state it has not met — including the
                  # empty subset bd returns for an id it cannot find — and that
                  # clearing is the fail-OPEN direction.
                  | select(.status != "closed") ] as $par
                # Exempt for a review: the printed remedy of this arm — add a
                # subject: label — is what trips the PR arm above, and the
                # parent cannot close until the PR merges, which needs this
                # review. Two doors, one deadlock (gqlc-n4oe).
                | if ($par | length) > 0 and (is_judge | not)
                  then "HOLD \($id) — unlabelled residue of open \($par[0].depends_on_id) — needs a subject: label"
                  else "ROUTE \($id)" end
              else
                (is_judge) as $judge
                | [ $subs[] | reason(.; $judge) | select(. != null) ] as $why
                | if ($why | length) > 0 then "HOLD \($id) — \($why[0])" else "ROUTE \($id)" end
              end
          end'
}

# The town's only unattended reclamation of the shared scratch filesystem
# (bd gqlc-u078). internal/tools/tmpreap has existed since PR #1057 and was
# wired to nothing: every reclamation to date was a person or an agent noticing,
# and the one time nobody noticed, /tmp hit 99% of its 1048576-inode cap and
# began refusing writes town-wide while `df -h` showed 5.9G free (bd gqlc-vze6).
#
# ADVISORY, in every direction. It cannot fail the sweep, because the sweep's
# job is the Պահակ's round and a filesystem tool that could stop it would be a
# second way for the town to go quiet. It cannot hang the sweep either: the
# guard unit is OnUnitActiveSec, so the next tick cannot begin until this one
# ends, and one wedged walk over a large /tmp would be a stopped cadence. The
# timeout is generous because the walk is genuinely large, and short of the
# 15-minute guard interval so two ticks cannot overlap.
#
# The threshold and the deletion policy live in the justfile recipe and in the
# tool, not here. This function decides only WHEN to ask.
reap_scratch() {
    local repo out rc=0
    if ! have_just; then
        # Named rather than skipped silently. On this host just is at
        # /usr/bin/just and is on the systemd user manager's PATH, so an absent
        # one means the environment changed underneath the unit — which is
        # exactly the shape of a cadence that stops firing without a symptom
        # until the filesystem fills months later.
        echo "guard-sweep: scratch not reaped — just is not on PATH, so nothing reclaims /tmp on a cadence" >&2
        return 0
    fi
    repo=$(deploy_root)
    if [ ! -f "$repo/justfile" ]; then
        echo "guard-sweep: scratch not reaped — no justfile in $repo" >&2
        return 0
    fi
    out=$(cd "$repo" && timeout "${KM_REAP_TIMEOUT:-600}" just tmp-reap-cadence 2>&1) || rc=$?
    if [ "$rc" -ne 0 ]; then
        echo "guard-sweep: scratch reap exited $rc — ${out//$'\n'/ }" >&2
        return 0
    fi
    # Reported on stdout on EVERY tick, including the quiet ones. The journal is
    # the only reader a timer has, and a line that appears only when something
    # was deleted cannot distinguish a healthy filesystem from a reaper that
    # stopped running (bd gqlc-vze6's own finding: the reaper nobody invokes).
    echo "guard-sweep: scratch — ${out//$'\n'/ }"
}

# Which seats are holding letters of Րաֆֆի's that they have not read, with how
# many and what state they are in.
#
# He wakes into a FRESH session every round — km-seat execs claude with no
# --continue — so nothing he wrote last round is in front of him unless
# something puts it there. On 2026-08-24 he wrote to the mayor five times
# between 04:05Z and 05:05Z about a heartbeat frozen at 03:44:54Z, and the fifth
# letter withdrew the first four ("just sitting rather than STUCK … You've done
# good work today") on no new evidence at all. That is not a guard overruling
# his own record; it is a guard who could not see it, and the last letter in a
# box is the one a reader trusts (bd gqlc-pff4).
#
# Two is the threshold: one letter is not yet a repetition. The seat's STATUS
# rides along because it is what distinguishes the two readings the count alone
# cannot — a seat that is asleep may simply not have been woken since, while an
# awake one has had the letter in front of it and left it there.
guard_unanswered() { # -> "seat(n, status) …", empty when nobody is holding two
    local s n out=""
    for s in $(seats_all); do
        [ "$s" = raffi ] && continue
        n=$(mail_unread_from "$s" raffi)
        [ "$n" -ge 2 ] || continue
        out="$out $s($n, $(seat_status "$s"))"
    done
    printf '%s' "${out# }"
}

cmd_guard_sweep() {
    ensure_deployed guard-sweep "$@" || return 1
    # ABOVE every early return below, and that placement is the design
    # (bd gqlc-u078). Scratch accumulates from AGENTS, not from the town's own
    # loop: a halted town, a town that is down, and a town whose Պահակ is
    # already awake each still have sixteen worktrees and whatever factory wave
    # is running writing into /tmp. Every one of those states returns before the
    # wake, so a reap placed beside the wake would be disarmed in precisely the
    # conditions that produced the incident — 2026-08-22 filled the inode table
    # while the town was HALTED and no seat was routing at all.
    #
    # The halt does not bind it, for the reason the halt binds the wake: this
    # starts no session, spends no tokens and touches no seat, so Article VI.4's
    # reservation of the halt to Սեդրակ and Անդրանիկ is not engaged by it. What
    # a halt promises is a quiet town, not a filling disk.
    reap_scratch
    session_up || { echo "guard-sweep: $(town_absent_reason $?)"; return 0; }
    # The halt binds every TIMER-driven wake, not just the dispatcher's. This is
    # the second one, and each wake here starts a real claude session, so a halt
    # that missed it went on spending tokens once per guard cadence — and since
    # Article VI.4 reserves lowering a halt to Սեդրակ or Անդրանիկ, whoever
    # raised it had no way to find that out (gqlc-6dzi). `km wake` and
    # `km mail` are deliberately NOT bound: a halted town still has to be
    # workable by the operator who is going to lower the halt. This named
    # `km herratsayn` until gqlc-cw7h; there has never been such a verb.
    local sd
    sd=$(state_dir)
    if [ -f "$sd/halt" ]; then
        echo "guard-sweep: halted — $(head -1 "$sd/halt")"
        return 0
    fi
    if [ "$(seat_status raffi)" = awake ]; then
        echo "guard-sweep: Րաֆֆի is already on his rounds"
        return 0
    fi
    file_patrol_bead
    tell_dirty_authors
    local reason="time for a round of the town (see your soul: rounds)" unanswered
    unanswered=$(guard_unanswered)
    if [ -n "$unanswered" ]; then
        reason="$reason. Letters of yours nobody has read: $unanswered. Unread is evidence of UNSEEN, not of declined, so do not write a gentler version of a letter that was never in front of anyone — escalate instead, and read kingdom/brain/playbooks/mail.md ('When a letter goes unanswered') for the ladder, including the case where the seat you would escalate TO is the seat you are writing ABOUT"
    fi
    cmd_wake raffi --reason "$reason"
}

# ADR 0004 §2, the execution half. ADR 0003 change 2 names the judges' PATROL
# duty as the compensating control on the whole unreviewed-merge regime — very
# nearly every PR now merges on green gates with the author as its only reader
# — and measured at c129a0a5 patrol was two sentences in the tree,
# kingdom/README.md line 77 and that clause of ADR 0003. It had no trigger, no
# target and no output shape. A seat runs only when woken; dispatch wakes a
# seat only for a bead; nothing filed one. So the compensating control on the
# town's central throughput trade could not begin at all.
#
# Filed by km rather than by Րաֆֆի during his round, because a step in a soul
# is a step an agent can forget and a line in cmd_guard_sweep is not. Called
# AFTER that command's early returns, which is the whole reason it sits at the
# bottom of the function: a halted town files no patrol bead (Article VI.4),
# and a tick that returns because Րաֆֆի is already awake files none either.
# Neither is a missed obligation — the next tick meets the same empty board.
#
# BOUNDED TO ONE, PERMANENTLY, and not configurable. Patrol's queue depth is
# one whatever the merge rate. That clause is what keeps ADR 0004 inside ADR
# 0003's constraint, and a later change making it a setting reintroduces
# exactly the queue ADR 0003 was written to drain.
#
# The bound is measured as NOT CLOSED, never as `--status open`. In bd,
# `--status open` is the literal status and excludes in_progress and blocked,
# so a patrol bead a judge had already claimed would read as absent and the
# next tick would file a second — the bound gone, silently, in precisely the
# state it exists for. That is not hypothetical: the same `--status open`
# reading made km doctor's identity arm miss a P0 (gqlc-18br, gqlc-c7b5). Any
# status this code does not recognise counts as open too, which is the safe
# side for a bound.
patrol_open_ids() { # <board json>
    jq -r '[ .[]
             | select(.status != "closed")
             | select((.labels // []) | index("patrol"))
             | .id ] | join(" ")' <<<"$1" 2>/dev/null
}

# The bound above measures the QUEUE and says nothing about whether there is
# anything to patrol, so a judge who closed an empty-window bead HONESTLY was
# handed another one four minutes later. Measured 2026-08-24 (bd gqlc-gsr9):
# gqlc-ot5u closed 03:15:11Z with master at 44ee6224, guard-sweep filed
# gqlc-z298 at 03:19:33Z, dispatch woke a judge, and at 03:21:30Z after a fetch
# `git log 44ee6224..origin/master` was EMPTY. The wake produced nothing and
# could produce nothing. At guard_minutes=15 the effective patrol cadence
# collapses to the guard interval — an arithmetic ceiling of four judge wakes
# an hour across any merge-free stretch, and the merge-free stretches are the
# overnight and quota-walled ones. That is the wake burn ADR 0003 exists to
# drain, restarted by its own compensating control.
#
# THE POSTURE HERE IS INVERTED FROM THE BOUND'S, deliberately. A bound that
# cannot be measured is not raised, because filing blind queues a bead every
# cadence for as long as bd is unwell. A WINDOW that cannot be measured is
# filed anyway, because a patrol that stops is coverage lost silently and one
# empty wake is the cheaper failure. So only a MEASURED emptiness is silent:
# an absent origin/master, a git that refuses, and a board with no closed
# patrol bead to start a window from all file.
#
# `--since` is INCLUSIVE at the second (measured, git 2.55.0), so a merge
# landing in the same second as the close is read by the next round rather
# than falling between the two.
patrol_window_is_empty() { # <root> <since> ; rc 0 ONLY when measured empty
    local root=$1 since=$2 out rc=0
    local KM_GIT_TIMEOUT="${KM_GIT_TIMEOUT:-30}"
    if ! git_at "$root" rev-parse --verify -q origin/master >/dev/null 2>&1; then
        echo "guard-sweep: patrol window could not be measured — origin/master is unknown in $root; filing rather than dropping a round" >&2
        return 1
    fi
    out=$(git_at "$root" log -1 --format=%H --since="$since" origin/master 2>/dev/null) || rc=$?
    if [ "$rc" -ne 0 ]; then
        echo "guard-sweep: patrol window could not be measured — git exited $rc in $root; filing rather than dropping a round" >&2
        return 1
    fi
    [ -z "$out" ]
}

file_patrol_bead() {
    local board open since window rc=0
    board=$(bd list --status all -n 0 --json 2>/dev/null) || rc=$?
    if [ "$rc" -ne 0 ] || ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"$board"; then
        # A bound that cannot be measured is not raised. Filing blind here
        # would add a patrol bead every cadence for as long as bd was unwell,
        # which is the queue this function exists to prevent.
        echo "guard-sweep: patrol not filed — the board query did not answer, so the one-open bound could not be measured" >&2
        return 0
    fi
    open=$(patrol_open_ids "$board")
    if [ -n "$open" ]; then
        echo "guard-sweep: patrol already open ($open) — the bound is one"
        return 0
    fi
    # The window is FRESH: it begins where the last patrol ended, because one
    # starting at the founding commit re-reads what has already been read.
    since=$(jq -r '[ .[]
                     | select((.labels // []) | index("patrol"))
                     | select(.status == "closed")
                     | .closed_at // empty ] | max // empty' <<<"$board" 2>/dev/null)
    if [ -n "$since" ]; then
        if patrol_window_is_empty "$(deploy_root)" "$since"; then
            echo "guard-sweep: patrol not filed — no merge to master since the previous patrol bead closed at $since, so the round would have nothing to read"
            return 0
        fi
        window="merges to master since the previous patrol bead closed, at $since"
    else
        window="merges to master in the recent window — no previous patrol bead exists to start from, and the founding commit would re-read what has already been read, so take a window you can read properly and name it in your close"
    fi
    if ! bd create "patrol: read merged work since the last patrol round" \
        -p 2 -l class:judge,patrol \
        -d "Filed by km guard-sweep. See kingdom/brain/decisions/0004-the-adversarial-read-after-the-gate.md section 2.

WINDOW: $window.

TARGET: merges whose PR was NOT reviewed. Under ADR 0003 a PR is read by a judge only if its bead was blocked by a design bead, if it amends the constitution, or if a citizen asked; everything else merged on green gates alone.

OUTPUT: defect beads, and a postmortem where something broke (Constitution V.4, Article III.4). Never a verdict — nothing in the window is open to one, the code has merged. A defect bead about already-merged code carries from-pr:<N>, the number of the PR that introduced it, and omits the label rather than guessing where no single PR can be identified (ADR 0004 section 3). That label is the only record Constitution V.2.0.4 will have when the town re-tunes its review gate.

DEPTH is yours. A round that reads one merge properly is a round. Closing this bead asserts NOTHING about the window being clean, and no citizen should read its closure that way.

BOUND: exactly one patrol bead is open at a time, permanently, whatever the merge rate (ADR 0004 section 2). This one was filed because none was open." >/dev/null 2>&1; then
        echo "guard-sweep: patrol bead could not be filed — bd create refused" >&2
        return 0
    fi
    echo "guard-sweep: filed a patrol bead — no open one was on the board"
}

# ADR 0006 §1, the execution half (bd gqlc-wz47). Nothing told an author their
# open PR had gone DIRTY. Every case on 2026-08-22 was found by a person
# happening to look, and Արամազդ's estimate was that three of seven affected
# authors did not know. A PR goes DIRTY through nothing its author did: a merge
# that appends to a shared registry invalidates every open PR appending to the
# same registry, and he found three live registries in one afternoon.
#
# The census rides the guard cadence rather than becoming an actor: km already
# runs on this timer and already carries mail. MAIL, NOT A WAKE — a DIRTY PR is
# routine, the census expects to find them often, and a wake per conflict would
# spend concurrency slots on the ordinary case.

# `gh pr view --json mergeable` is the WRONG instrument and its wrongness is
# part of the decision: GitHub recomputes mergeability lazily after any push
# and returns UNKNOWN meanwhile, which a naive check reads as "not
# conflicting". Արամազդ's first pass with it reported 2 DIRTY where there were
# 7. This asks git instead, locally, against a ref it has just fetched.
dirty_open_prs() { # -> TSV number, head oid, head branch; rc 1 if gh cannot answer
    local raw got limit="${KM_DIRTY_PR_LIMIT:-100}"
    raw=$(timeout 30 gh pr list --state open --limit "$limit" \
        --json number,headRefOid,headRefName 2>/dev/null) || return 1
    got=$(jq 'length' <<<"$raw" 2>/dev/null) || return 1
    # A full-length list is an UNKNOWN list: gh offers no list-level tell, so
    # the (N+1)th PR is indistinguishable from no PR. Same reasoning as
    # hold_open_pr_files, and the same degradation.
    [ "$got" != "$limit" ] || return 1
    jq -r '.[] | select(.headRefOid != null and .headRefName != null)
                 | [ (.number | tostring), .headRefOid, .headRefName ] | @tsv' \
        <<<"$raw" 2>/dev/null
}

# --name-only is the line to trust, and it is not a preference. Without it
# `git merge-tree --write-tree` prints `Auto-merging <path>` for files it merged
# SUCCESSFULLY, on lines adjacent to `CONFLICT (content): <other path>`; read as
# a block that says the first file conflicted, and it says the opposite.
# Արամազդ made this error first and caught it against his own count.
#
# The head is RESOLVED before it is merged, and that is not belt-and-braces.
# Measured 2026-08-23 with git 2.55.0: `git merge-tree --write-tree --name-only
# <base> <an oid this repo does not have>` exits **1** — the same status as a
# genuine conflict — writing `not something we can merge` to stderr and NOTHING
# to stdout. So rc is not the three-way answer it looks like: read on rc alone,
# a head whose branch someone deleted comes back with an empty conflict list
# and is reported as CLEAN. Unknown is neither clean nor dirty, and the caller
# says so out loud.
dirty_conflicted_paths() { # <root> <base ref> <head oid> -> paths; rc 1 = unknown
    local root=$1 base=$2 head=$3 out rc=0
    local KM_GIT_TIMEOUT="${KM_GIT_TIMEOUT:-30}"
    git_at "$root" rev-parse --verify --quiet "$head^{commit}" >/dev/null 2>&1 || return 1
    out=$(git_at "$root" merge-tree --write-tree --name-only "$base" "$head" 2>/dev/null) || rc=$?
    [ "$rc" -ne 0 ] || return 0
    # Line 1 is the written tree's oid; the conflicted names run to the first
    # blank line, after which merge-tree's informational messages begin.
    printf '%s\n' "$out" | awk 'NR == 1 { next } /^$/ { exit } { print }'
}

# Every PR here is pushed by one GitHub account, so `author.login` names the
# machine and not the citizen. The bead is what carries a seat, so the branch
# name is read for bead ids and the first one with a seat assignee is the
# author. A PR whose branch names no assigned bead is reported to Սեդրակ
# instead of being dropped: an unattributable DIRTY PR is exactly the case a
# human has to look at, and the suppression key below bounds it to one message.
dirty_author_of() { # <head branch> -> seat name
    local branch=$1 ids show who
    ids=$(grep -oE 'gqlc-[a-z0-9]+' <<<"$branch" | sort -u | tr '\n' ' ')
    if [ -n "${ids// /}" ]; then
        # shellcheck disable=SC2086 # deliberate word split: bd takes ids as separate args
        show=$(bd show $ids --json 2>/dev/null) || show=""
        if [ -n "$show" ]; then
            who=$(jq -r '[ .[]? | select(type == "object") | .assignee // empty ][0] // empty' \
                <<<"$show" 2>/dev/null)
            if [ -n "$who" ] && is_seat "$who"; then
                echo "$who"
                return 0
            fi
        fi
    fi
    echo sedrak
}

tell_dirty_authors() {
    local prs root sd told n oid branch paths who key
    if ! prs=$(dirty_open_prs); then
        echo "guard-sweep: DIRTY census skipped — gh could not answer for the open PRs" >&2
        return 0
    fi
    [ -n "$prs" ] || return 0
    root=$(main_root)
    # The census compares against origin/master and against heads it does not
    # own, so a stale remote would report conflicts that were resolved hours
    # ago. A failed fetch is NOT fatal — the same over-reporting the hold
    # verdict accepts — but it is said out loud, because a false DIRTY mail
    # costs the recipient a rebase they do not need.
    local KM_GIT_TIMEOUT="${KM_FETCH_TIMEOUT:-60}"
    git_at "$root" fetch --quiet origin 2>/dev/null \
        || echo "guard-sweep: DIRTY census could not fetch; reading a possibly-stale origin" >&2
    sd=$(state_dir)
    told="$sd/dirty-told"
    mkdir -p "$told"
    while IFS=$'\t' read -r n oid branch; do
        if [ -z "$n" ] || [ -z "$oid" ]; then continue; fi
        if ! paths=$(dirty_conflicted_paths "$root" origin/master "$oid"); then
            echo "guard-sweep: PR #$n — git could not merge-test $oid (a deleted branch?); not reported" >&2
            continue
        fi
        [ -n "$paths" ] || continue
        who=$(dirty_author_of "$branch")
        # Keyed on the HEAD, so a rebase or a new push earns a fresh message and
        # a head that has not moved earns silence. The cadence is minutes; a
        # tell that arrives every two minutes is a tell nobody reads.
        key="$told/$n-$oid-$who"
        [ -e "$key" ] && continue
        if mail_send "$who" --from sedrak \
            -s "PR #$n has gone DIRTY" \
            -m "Your open PR #$n ($branch, head $oid) no longer merges into origin/master.

Conflicted paths:
  ${paths//$'\n'/$'\n'  }

You almost certainly did not cause this. A merge that appends to a shared registry invalidates every open PR that appends to the same registry (ADR 0006, kingdom/brain/decisions/0006-a-head-that-moves-under-a-reader.md).

Rebase on origin/master, re-run the gates, and force-push. If a judge is reading this PR, warn them BEFORE you push, and state the delta as a merge-base comparison rather than a commit list — a rebase makes 'git log old..new' read as fix work (ADR 0006 section 3).

Measured by km guard-sweep with 'git merge-tree --write-tree --name-only', not with gh's mergeable field, which returns UNKNOWN while GitHub recomputes and reads as clean." 2>/dev/null; then
            : >"$key"
            echo "guard-sweep: PR #$n is DIRTY — told $who"
        else
            echo "guard-sweep: PR #$n is DIRTY but the message to $who could not be sent" >&2
        fi
    done <<<"$prs"
}

# ---------- unit health ----------

# systemd answers Result=success for a unit that has never fired AND for one
# that is not installed at all — measured 2026-08-22: LoadState=not-found came
# back with Result=success — so health cannot be read off Result alone.
unit_health() { # <unit> -> "ok …" | "FAILED …" | "NEVER RUN …" | "NOT INSTALLED …" | "UNKNOWN …"
    local props line load="" active="" last="" result="" code=""
    if ! props=$(systemctl --user show "$1" \
        -p LoadState -p ActiveState -p InactiveEnterTimestamp -p Result -p ExecMainStatus 2>/dev/null); then
        echo "UNKNOWN — systemctl could not answer (is there a user bus?)"
        return 0
    fi
    # By key, never by position: systemd returns the properties in its own
    # order, not the order they were asked for.
    while IFS= read -r line; do
        case "$line" in
            LoadState=*) load=${line#*=} ;;
            ActiveState=*) active=${line#*=} ;;
            InactiveEnterTimestamp=*) last=${line#*=} ;;
            Result=*) result=${line#*=} ;;
            ExecMainStatus=*) code=${line#*=} ;;
        esac
    done <<<"$props"
    if [ "$load" != loaded ]; then
        echo "NOT INSTALLED — $1 is ${load:-absent} (km install-units)"
    elif [ "$active" = activating ] || [ "$active" = active ]; then
        # gqlc-67ml. InactiveEnterTimestamp and Result describe the PREVIOUS
        # run, and while the timer is actually firing the unit they are
        # transiently inconsistent with each other: 'guard last run succeeded'
        # flapped warn then ok between two doctor runs a minute apart, with
        # Result=success ExecMainStatus=0 reported both times. So a unit systemd
        # says is running now gets no verdict on the run before it — the run
        # under way has not ended, and the record of the one before it is being
        # overwritten. A cadence of two minutes makes that a wolf cry, and a
        # verdict on an unfinished run is an unmeasured state rendered as a
        # measured one, which is the thing this file exists to refuse.
        echo "UNKNOWN — $1 is $active right now, so its last run was not measured"
    elif [ -z "$last" ]; then
        # gqlc-28ysg. An empty InactiveEnterTimestamp is not a history of never
        # having run, and this branch used to render it as one — "its timer has
        # never fired it", about a timer this function has never queried.
        # systemd garbage-collects an inactive service nothing references any
        # more and re-loads it from disk with empty runtime state; LoadState
        # stays `loaded`, so there is no tell. Measured 2026-08-30 with
        # throwaway units: a service that never started and one whose timer was
        # stopped three seconds ago agree on every property sampled here, and on
        # the TIMER's own LastTriggerUSec, which is erased with them. That
        # history survives only in the journal, so km cannot have it cheaply and
        # this says nothing about it.
        #
        # What it can measure is whether anything will fire the unit AGAIN, and
        # that is the half the operator acts on: the two states this used to
        # collapse want opposite responses — install the units, or find out who
        # stopped a healthy timer four minutes ago.
        local timer=${1%.service}.timer tprops="" tload="" tactive=""
        if ! tprops=$(systemctl --user show "$timer" -p LoadState -p ActiveState 2>/dev/null); then
            echo "UNKNOWN — $1 has no run on record and $timer could not be asked why (is there a user bus?)"
            return 0
        fi
        while IFS= read -r line; do
            case "$line" in
                LoadState=*) tload=${line#*=} ;;
                ActiveState=*) tactive=${line#*=} ;;
            esac
        done <<<"$tprops"
        if [ "$tload" != loaded ]; then
            echo "NOT SCHEDULED — $timer is ${tload:-absent}, so nothing will fire $1 (km install-units)"
        elif [ "$tactive" != active ] && [ "$tactive" != activating ]; then
            # An installed-but-inactive timer is also what one that was never
            # started looks like, so this sentence may not narrate a stop
            # (gqlc-rnndr) any more than the old one could narrate a never-run.
            echo "NOT SCHEDULED — $timer is $tactive, so nothing will fire $1; whether it ran before is not in systemd's memory ('systemctl --user enable --now $timer')"
        else
            echo "NO RUN ON RECORD — $timer is $tactive, but systemd holds no finished run of $1"
        fi
    elif [ "$result" != success ]; then
        echo "FAILED — last run $last ($result, exit ${code:-?}): journalctl --user -u $1"
    else
        echo "ok (last run $last)"
    fi
}

# ---------- status ----------

# How stale a heartbeat has to be before the board says UNRESPONSIVE.
#
# This does NOT contradict km:227-231, and a reader who hits both should be able
# to see why without guessing which one is a bug. That comment refuses to let
# seat_session_live REAP on the heartbeat, and its measurement is a 53-second
# tool call: over that span the age separates mid-turn from between-turns, not
# working from abandoned. Both claims survive here because this threshold is two
# orders of magnitude away from that measurement and because nothing acts on it.
# What is rendered is the AGE, always, which is a fact and not a judgement; the
# marker is a second line of text. Nobody is freed, nudged, or ended by it —
# gqlc-eier is explicit that a modal is not consent to be killed (VI.2), and the
# instrument's whole job is to let a human or the mayor decide.
#
# 30 minutes: 15x the 2-minute dispatch cadence, and 34x the longest tool call
# anyone here has measured. The two freezes that motivated this were 80 and 152
# minutes (Միհր on a usage-limit modal, Անահիտ on a shutdown modal, both while
# the merge gate sat shut and every board read healthy). A seat legitimately
# inside one turn for half an hour is possible and would be flagged; the cost of
# that is one line of text asking someone to look at a pane.
status_unresponsive_after() { cfg_minutes welfare unresponsive_after_minutes 30; }

# How long without a COMPLETED tool call before the board says a live seat is
# making no progress. Separate from the heartbeat threshold above and necessarily
# so: that one measures whether the instrument reported, this one measures
# whether anything happened, and the whole point of gqlc-r3ac is that the first
# stays green while the second runs dry.
#
# 20 minutes. The two freezes it is sized against were 80 and 152 (gqlc-eier),
# and the longest legitimate single tool call anyone here has a number for is the
# ~10-minute pre-push suite — so 20 is twice the longest known honest wait and a
# quarter of the shortest measured freeze. Long-running Agent spawns can exceed
# it and will be marked; that costs one line of text asking a human to look at a
# pane, which is the same trade UNRESPONSIVE already makes. There is deliberately
# NO per-tool allowance: a per-tool exemption is a list of names, and the wedge
# this exists to catch was a tool whose name nobody had written down.
status_stalled_after() { cfg_minutes welfare stalled_after_minutes 20; }

# Compact enough for a column: 45s, 12m, 3h20m.
fmt_age() { # <seconds>
    local s=$1
    if [ "$s" -lt 60 ]; then printf '%ds' "$s"
    elif [ "$s" -lt 3600 ]; then printf '%dm' "$((s / 60))"
    else printf '%dh%02dm' "$((s / 3600))" "$(((s % 3600) / 60))"
    fi
}

cmd_status() {
    local sd s disp class st stcol ctx hb beads unread age hbcol stale frozen="" blind="" idle=""
    local target tree fresh fstate fball fbgates fahead fdetail stalewt="" exposed="" unjudged=""
    local workcol wage sage dry wedged="" nowork="" unwitnessed=""
    local stall stall_age stall_list wake_age undrained=""
    local launch launchcol launchsay mislaunched=""
    sd=$(state_dir)
    echo "Թագաւորութիւն — $(date -u -Iseconds)"
    if session_up; then echo "town: UP (herdr workspace '$WORKSPACE')"
    else echo "town: $(case $? in 2) echo 'UNKNOWN — the herdr workspace list did not parse (diagnosis above)' ;; 3) echo 'UNKNOWN — km could not ask herdr whether its server is running (diagnosis above)' ;; *) echo DOWN ;; esac)"; fi
    if [ -f "$sd/halt" ]; then
        # The age rides the line because a transient halt outliving its cause
        # is invisible behind any timestamp subtraction (bd gqlc-ozfr: one ran
        # ~6.5h past its cause). mtime is the raise moment; km never edits it.
        local hage=$(( $(date +%s) - $(stat -c %Y "$sd/halt") )) htxt
        if [ "$hage" -ge 3600 ]; then
            htxt="$(printf '%dh%02dm' $((hage / 3600)) $(((hage % 3600) / 60)))"
        elif [ "$hage" -ge 60 ]; then
            htxt="$((hage / 60))m"
        else
            htxt="under a minute"
        fi
        echo "HALT: $(head -1 "$sd/halt") — up $htxt"
    fi
    # A dispatcher refusing on drift is otherwise visible only in the journal
    # (bd gqlc-vzpn), so the town's one glance carries it.
    if ! deployed_ok; then
        echo "DRIFT: $(deploy_root) is not origin/master in kingdom/, .githooks/ or .claude/ — the timers refuse, and the hooks that run there are the stale copies, until 'km deploy'"
    fi
    # In the HEADER and not among the trailing marks: this is the town's highest
    # work standing still, and it is invisible in every other cell of this board
    # by construction — each seat is legitimately working or legitimately
    # resting, and the bead reaching nobody is a property of the pair (gqlc-tz95).
    if stall=$(stalled_p0_render); then
        stall_age=${stall%%$'\t'*}
        stall_list=${stall#*$'\t'}
        echo "STALLED P0: $stall_list oldest $(fmt_age "$stall_age") — ready P0 work the last dispatch run could hand to no seat. Recorded by the dispatcher, so it is as old as its last run; it clears itself on the first run that can route it. Nothing here wakes anyone (VI.2): free a seat, or take it yourself."
    fi
    echo

    # MARKED, not swallowed and not fatal (gqlc-bn5r). `|| inprog=""` here made
    # an unanswerable question render identically to an answer of "nobody is
    # working": an em dash in all sixteen BEADS cells, which is also what a
    # genuinely idle town looks like. That equivalence is what hid gqlc-z1qw
    # for the kingdom's whole life — routing was dead and the board was the
    # only witness, and it was never contradicted.
    #
    # Not `die`, though dispatch does exactly that on the same query. Dispatch
    # is a timer job whose refusal belongs in the journal; this is the one
    # glance a human takes at the town, and a status command that dies is a
    # status command nobody runs. So it prints everything it CAN and names the
    # part it could not read.
    #
    # One capture over the whole pipeline, deliberately: bd failing and jq
    # aborting on what bd returned are two different faults with one remedy
    # here, and under `set -o pipefail` this catches both. Checking bd's rc
    # alone would leave the jq half fail-open — measured, that half renders the
    # ready line as "  architect,   warrior", a blank where a count should be.
    local inprog inprog_ok=1
    inprog=$(bd list --status in_progress -n 0 --json 2>/dev/null |
        jq -r '.[] | select(.assignee != null) | "\(.assignee) \(.id)"') || { inprog=""; inprog_ok=0; }

    stale=$(status_unresponsive_after)
    dry=$(status_stalled_after)
    # No fetch: see seat_freshness. An absent ref makes every TREE cell "?" and
    # prints the UNJUDGED line below, rather than letting sixteen unanswered
    # questions render as sixteen healthy seats.
    target=$(git_at "$(main_root)" rev-parse --verify --quiet origin/master 2>/dev/null || true)
    printf '%-10s %-10s %-9s %-6s %-7s %-8s %-7s %-6s %-6s %s\n' SEAT CLASS STATE CTX HB WORK TREE LAUNCH MAIL BEADS
    for s in $(seats_all); do
        disp=$(seat_display "$s")
        class=$(seat_class "$s")
        st=$(seat_status "$s")
        if [ "$st" = awake ] && ! window_up "$s"; then st="awake?"; fi
        # The state a citizen reaches by ordinary SUCCESS — finish, write the
        # handoff, forget `km sleep` — and the LEAST available one a seat has.
        # Every dispatch pass wakes ASLEEP seats only, so an awake seat is
        # unroutable, and its live session still spends a max_active slot: the
        # same record costs the town twice. Six of them held all five slots for
        # eleven hours while this table called each of them `awake`, which is
        # the same cell it prints for a citizen mid-work (gqlc-5vp7).
        #
        # The STATE cell and not a line alone, and unlike UNRESPONSIVE — which
        # deliberately leaves STATE saying what the status FILE says, because
        # the heartbeat is a separate instrument that must be able to disagree
        # in the open. This is not a second account of the same field; it is the
        # same kind of live probe as the `awake?` above it, refining the cell
        # from the pane rather than contradicting it.
        #
        # MARK, never act. cmd_reconcile cannot end this session: from outside,
        # idle and thinking are told apart only by one photograph of a TUI, and
        # ending a citizen's session on that is VI.2 (gqlc-971s). What this
        # buys is that an operator who can SEE the seat fixes it in one command,
        # and a marker costs nobody's uncommitted work when it is wrong.
        stcol="$st"
        if [ "$st" = awake ] && seat_pane_idle "$s"; then
            stcol="awake-idle"
            idle="$idle $s"
        fi
        ctx="-"
        hbcol="-"
        workcol="-"
        hb="$sd/seats/$s/heartbeat.json"
        # BOTH live statuses, not `awake` alone. Անահիտ was frozen under
        # asleep-pending — she had written her handoff and run `km sleep`, and
        # the shutdown modal ate the exit — so a column that only looked at
        # awake seats would have shown a dash for the worse of the two freezes
        # (gqlc-eier).
        case "$st" in
            awake | 'awake?' | asleep-pending)
                if [ -f "$hb" ]; then
                    ctx=$(jq -r 'if .context_pct == null then "-" else "\(.context_pct | floor)%" end' "$hb" 2>/dev/null || echo "-")
                    # The evidence was already on disk, in the file this table
                    # opens, and the table read context_pct and threw the
                    # timestamp away. That discard is the whole bug.
                    if age=$(heartbeat_age "$s"); then
                        hbcol=$(fmt_age "$age")
                        if [ "$age" -ge "$stale" ]; then
                            hbcol="$hbcol!"
                            frozen="$frozen $s($hbcol)"
                        fi
                    else
                        # Unknown, never zero: a heartbeat that cannot be parsed
                        # says nothing about the seat, and "0s" would say the
                        # most reassuring possible thing.
                        hbcol="?"
                    fi
                elif ! seat_can_report "$s"; then
                    # A live seat with no heartbeat file at all. Left as a dash
                    # this is the third reading of a blank the board already had
                    # two readings for, and the one that says the INSTRUMENT is
                    # out — so it is named rather than rendered as quiet
                    # (gqlc-h17n).
                    hbcol="blind"
                    blind="$blind $s"
                fi
                # The WORK column, and the reason it cannot be folded into HB:
                # the two columns answer different questions and the whole of
                # gqlc-r3ac is that they disagree. HB says the instrument
                # reported. WORK says a tool call FINISHED — the only event on
                # this seat that nothing on a timer produces. A seat wedged on a
                # modal keeps a fresh HB forever and its WORK age climbs from the
                # moment it froze.
                if ! sage=$(progress_age "$s" .last_start); then sage=""; fi
                if ! wage=$(progress_age "$s" .last_progress); then wage=""; fi
                if [ -z "$sage" ] && [ -z "$wage" ]; then
                    if [ -f "$sd/seats/$s/progress.json" ]; then
                        # Present and unreadable. Unknown, never an age: see the
                        # HB column's "?" above for the same argument.
                        workcol="?"
                    elif ! seat_can_witness "$s"; then
                        workcol="unwired"
                        unwitnessed="$unwitnessed $s"
                    fi
                    # A wired seat that has simply not run a tool yet keeps the
                    # dash. That blank was always the correct reading and the
                    # arm above exists so it stops being the ONLY reading.
                elif seat_tool_in_flight "$s"; then
                    # Leading * — a tool call that started and has not come back.
                    # The age is from the NEWEST start, so several calls in one
                    # block understate a wedge: late, never early.
                    workcol="*$(fmt_age "$sage")"
                    if [ "$sage" -ge "$dry" ]; then
                        workcol="$workcol!"
                        wedged="$wedged $s($workcol $(progress_field "$s" .last_tool || echo tool) $(seat_wedge_reason "$s"))"
                    fi
                else
                    workcol=$(fmt_age "$wage")
                    if [ "$wage" -ge "$dry" ]; then
                        workcol="$workcol!"
                        nowork="$nowork $s($workcol)"
                    fi
                fi
                ;;
        esac
        # The tree the seat is STANDING IN. Everything else in this table is
        # read out of the state dir, which is shared, so it is identical for
        # every seat and identically right — and a seat parked fifteen hours
        # back renders exactly like one at master (gqlc-d38n). Its own board is
        # not blank, it is WRONG AND PLAUSIBLE: Րաֆֆի the guard read a roster
        # with one judge in it, from a detached HEAD 14 commits behind, and
        # correctly concluded the roster was broken.
        fresh=$(seat_freshness "$s" "$target")
        read -r fstate fball fbgates fahead fdetail <<<"$fresh"
        : "$fahead $fdetail"
        case "$fstate" in
            current) tree="ok" ;;
            parked)
                tree="-$fball"
                if [ "$fbgates" -gt 0 ]; then tree="$tree!"; fi
                if [ "$fball" -gt 0 ]; then stalewt="$stalewt $s(-$fball)"; fi
                ;;
            working)
                if [ "$fball" -eq 0 ]; then tree="wip"; else tree="wip-$fball"; fi
                if [ "$fbgates" -gt 0 ]; then tree="$tree!"; fi
                ;;
            published)
                # Reported in working's shape rather than parked's — a
                # published branch is legitimately behind, not stale. The
                # finished-ness question is not asked here: 0008 keeps the
                # board offline; seat_refresh_step consults gh in the acting
                # path and prints its verdict there.
                if [ "$fball" -eq 0 ]; then tree="pub"; else tree="pub-$fball"; fi
                if [ "$fbgates" -gt 0 ]; then tree="$tree!"; fi
                ;;
            *) tree="?"; unjudged="$unjudged $s" ;;
        esac
        if [ "$fbgates" -gt 0 ]; then exposed="$exposed $s($fbgates)"; fi
        # 60s is well past the 5s poll interval km-seat sleeps between wake
        # checks and well short of anything an operator would want to sleep
        # through. The seven-hour orphans in gqlc-2vxs would have surfaced
        # here within a minute if this line had existed.
        #
        # Gated on state == asleep, because that is the shape 2vxs measures:
        # a resting citizen with a wake nobody read. The other states have a
        # legitimate reader — awake/asleep-pending seats keep the wake file
        # until claude exits and km-seat loops back to consume it, so an old
        # wake file there is the runner working, not the runner missing. The
        # IDLE / WEDGED / UNRESPONSIVE lines already speak for those cases.
        if [ "$st" = asleep ]; then
            wake_age=$(seat_wake_queue_age "$s")
            if [ -n "$wake_age" ] && [ "$wake_age" -ge 60 ]; then
                undrained="$undrained $s($(fmt_age "$wake_age"))"
            fi
        fi
        # A COLUMN and not only the line below it, so that every seat is
        # separately judged and none can go silent: an aggregate that prints
        # nothing reads the same whether sixteen seats conform or sixteen were
        # never measured, and that equivalence is the one this file is organised
        # against. The line then NAMES the flag, because "seat X is
        # misconfigured" sends the next operator back to the process table.
        launch=$(seat_launch_state "$s")
        launchcol=${launch%%$'\t'*}
        launchsay=${launch#*$'\t'}
        if [ "$launchcol" != "-" ] && [ "$launchcol" != ok ] && [ -n "$launchsay" ]; then
            mislaunched="$mislaunched $s($launchcol: $launchsay)"
        fi
        unread=$(unread_count "$s")
        if [ "$inprog_ok" -eq 0 ]; then
            # "?" and never the em dash: the dash is this column's word for
            # "nothing in flight", and printing it over a query that never
            # returned is the fail-open shape itself.
            beads="?"
        else
            beads=$(echo "$inprog" | awk -v s="$s" '$1 == s { printf "%s ", $2 }')
        fi
        printf '%-10s %-10s %-9s %-6s %-7s %-8s %-7s %-6s %-6s %s  (%s)\n' "$s" "$class" "$stcol" "$ctx" "$hbcol" "$workcol" "$tree" "$launchcol" "$unread" "${beads:-—}" "$disp"
    done
    if [ -n "$frozen" ]; then
        echo "UNRESPONSIVE:$frozen — no heartbeat for over $(fmt_age "$stale"); read the pane before believing the STATE column. A frozen seat holds its slot, answers no mail, and reports as healthy. Do not end the session: a modal is not consent (VI.2)."
    fi
    if [ -n "$idle" ]; then
        echo "IDLE:$idle — awake, alive, and sitting at an empty prompt: unroutable, because every dispatch pass wakes ASLEEP seats only, while the live session still spends one of $(cfg concurrency max_active) slots. Six of these stalled the whole town for eleven hours with every board reading healthy (gqlc-5vp7). One capture of a TUI is not proof — read the pane first, and 'km sleep --seat <seat>' frees the slot if the citizen is done. Nothing here ends a session: a seat that has not asked to leave has not consented (VI.2, gqlc-971s)."
    fi
    if [ -n "$wedged" ]; then
        echo "WEDGED:$wedged — a tool call that STARTED and has not come back, for longer than $(fmt_age "$dry"). This is the signal the heartbeat cannot carry: km-statusline keeps writing all through a wedged turn, so these seats' HB cells are as fresh as a seat doing real work (gqlc-n97e, 13+ minutes; gqlc-eier, 80 and 152 while every board read healthy). The named tool is the newest one started, not necessarily the one that hung. The third word is WHY, and these are opposite jobs: 'consent' is a seat waiting on one keystroke, which a citizen can answer; 'limit' is a usage wall, which no keystroke clears and which ends the turn without ending the session (gqlc-3evsn); 'unknown' means the pane carried neither marker, which covers a genuinely hung command AND every modal nobody has sampled yet, so it is a reason to look rather than a reason not to; 'unreadable'/'no-pane' mean km could not ask. Read the pane — the word is a snapshot of the screen at the moment this table was built, the seat may have moved since, and a modal answered just before the read left no trace on it. Do not end the session: a modal is not consent (VI.2)."
    fi
    if [ -n "$nowork" ]; then
        echo "NOWORK:$nowork — awake, nothing in flight, and no tool call has FINISHED for that long. Two seats look like this: one wedged between turns (a usage-limit modal eats the turn, so no tool ever starts) and one that finished its work and never ran 'km sleep' — which is the LEAST available state there is, because it holds a slot against max_active and answers no dispatch. Neither is a working citizen, and neither is waiting on you: km dispatch's idle pass confirms the state over two passes, asks the seat to pick up work or run 'km sleep', and repeats no sooner than every $(cfg welfare renudge_after_minutes) minutes. After $(recover_cap) unanswered asks in one episode it stops typing and mails sedrak, and says ESCALATED here on every later pass. The counter clears when the agent leaves 'idle' — witnessed work, not a pane that merely looks different. Reading the pane is still the fastest way to tell the two apart, and it is the only way to tell a dead turn from a finished day."
    fi
    # MARK, never act — Constitution VI.2. Nothing in km consumes any of the
    # lines below; they exist so a human or the mayor can decide, exactly
    # as UNRESPONSIVE above does.
    if [ -n "$stalewt" ]; then
        echo "STALE:$stalewt — a PARKED worktree that many commits behind origin/master. Nothing else in this table can show it: the seat reads its own tree correctly, its commands succeed, its tests pass and its own km prints a healthy board — of a town that no longer exists. Measured 2026-08-22: five seats at the founding commit, 14 behind, among them the guard and one of two judges (gqlc-d38n). 'km seat-refresh <seat>' moves a parked worktree to origin/master. A wip- cell is NOT this: a seat mid-PR is legitimately behind."
    fi
    if [ -n "$exposed" ]; then
        echo "EXPOSED:$exposed — (N) commits touching .githooks/.claude that this seat's worktree has NOT got, so those gates do not run for it. core.hooksPath is relative and reads '.githooks' in every one of these seats, which is why no drift check in the town sees it (gqlc-xtre, gqlc-p1ek: 7 of 14 seats held no push guard hours after it merged). The refresh at wake deliberately does not move a seat holding work, so a wip! cell is expected and is still exposed."
    fi
    if [ -n "$unjudged" ]; then
        echo "UNJUDGED:$unjudged — no worktree, or git could not read one, or this checkout has no origin/master ref. The TREE cell is '?' rather than 'ok': a question that was not answered is not a clean answer."
    fi
    if [ "$inprog_ok" -eq 0 ]; then
        echo "BEADS: UNAVAILABLE — the in-progress query (bd list --status in_progress, or the jq over it) did not answer, so the BEADS column above is '?' for every seat and this board cannot tell you what is in flight. It is NOT a town with nothing in flight; that is the same rendering, and the equivalence is what hid gqlc-z1qw for the kingdom's whole life. Run the query by hand before concluding anything about who is working (gqlc-bn5r)."
    fi
    if [ -n "$unwitnessed" ]; then
        echo "UNWITNESSED:$unwitnessed — a live seat whose CHECKOUT cannot write a progress witness: .githooks/claude-tool-witness and the PostToolUse wiring in .claude/settings.json are tracked files, so a worktree parked before they landed writes no progress.json. Its WORK cell is this instrument's silence, not the seat's, and an unwitnessed seat working all night reads exactly like a stalled one — which is the equivalence the WORK column exists to break. 'km seat-refresh <seat>' moves a parked worktree to origin/master."
    fi
    if [ -n "$blind" ]; then
        echo "BLIND:$blind — a live seat whose CHECKOUT cannot write a heartbeat: kingdom/bin/km-statusline and the statusLine key in .claude/settings.json are both tracked files, so a worktree parked on a branch that forked before the kingdom landed has neither. The blank HB column above is this instrument's silence, not the seat's, and a seat working all night reads exactly like an idle one. Read the pane, and 'km seat-refresh <seat>' moves a parked worktree back to origin/master."
    fi
    if [ -n "$mislaunched" ]; then
        echo "LAUNCH:$mislaunched — a live session whose claude process does not match kingdom.toml. Codes: P permission mode, S soul (--append-system-prompt), M model, E effort; '?' means herdr reports a live agent but the process could not be resolved, which is reported rather than passed. Fifteen of sixteen seats ran a whole day like this as bare 'claude --resume <uuid>' — permission-gated, soulless, and on the wrong model — while every instrument in the town reported on kingdom.toml's INTENT and called them healthy (gqlc-8dsa). Settings are read at LAUNCH, so nothing fixes a running session: it keeps its flags until it ends. Report only — ending a citizen's session is not km's to do on a timer (VI.2); the repair is that seat's next wake through km-seat."
    fi
    if [ -n "$undrained" ]; then
        echo "UNDRAINED:$undrained — a wake file older than a minute, so nothing has parked to read it. km-seat's consume loop is a 5-second poll, so a healthy runner drains its file within ten seconds; if the age keeps climbing, the runner is gone. This is the tell for a dead km-seat when the predicate above misses it — 14 seats sat this way for seven hours because seat_runner_live gated on pane existence and every repair rode that gate (gqlc-2vxs). Report only; the recovery is 'km reconcile' (which now finds them because the predicate looks at the process too), or 'km up' for the whole town."
    fi

    echo
    printf 'dispatch: %s\n' "$(unit_health kingdom-dispatch.service)"
    printf 'guard:    %s\n' "$(unit_health kingdom-guard.service)"

    echo
    local ready
    # `-n 0`: without it these counters are silently FLOORS, not counts — and a
    # precise-looking wrong number is worse than none, because the mayor sizes
    # his standing labelling chore off this line (gqlc-mlca).
    #
    # `|| ready="[]"` substituted an EMPTY BOARD for an unanswered question and
    # then counted it, printing "0 architect, 0 warrior, 0 judge, 0 unlabelled"
    # — four precise-looking numbers, none of them measured (gqlc-bn5r). The
    # `jq -e .` is the second half and not decoration: bd can exit 0 and hand
    # back a lock message, and the counting jqs below then each fail
    # independently under command substitution, rendering "  architect,
    # warrior" — a blank where a count goes, which is a worse lie than a zero
    # because nothing in the line says a query failed.
    if ! ready=$(bd ready -n 0 --json 2>/dev/null) || ! printf '%s' "$ready" | jq -e . >/dev/null 2>&1; then
        echo "ready queue: UNAVAILABLE — 'bd ready' did not answer, or answered with something jq could not parse. No count is printed because none was measured: the four zeroes this line used to print in exactly this situation are indistinguishable from an empty queue (gqlc-bn5r)."
        ready=""
    else
        echo "ready queue: $(echo "$ready" | jq '[.[] | select((.labels // []) | index("class:architect"))] | length') architect, $(echo "$ready" | jq '[.[] | select((.labels // []) | index("class:warrior"))] | length') warrior, $(echo "$ready" | jq '[.[] | select((.labels // []) | index("class:judge"))] | length') judge, $(echo "$ready" | jq '[.[] | select([((.labels // []) | index("class:architect")), ((.labels // []) | index("class:warrior")), ((.labels // []) | index("class:judge"))] | all(. == null))] | length') unlabelled (Սեդրակ's chore)"
    fi
    # The king's box is NOT a seat's box, and the old line printed the same word
    # over both (gqlc-2abx). A letter leaves inbox/ only when someone runs
    # `km mail read`; every seat is a process that runs it, and Անդրանիկ is a
    # human who reads the file in an editor. Measured 2026-08-22: inbox 30,
    # read 0, zero reads since the town was founded — a number that reads
    # identically whether he has read every word or none of them.
    #
    # This is worth a distinction and not just a softer word because the count
    # had already changed the mayor's conduct twice in one day, both times
    # toward silence: two digests to the king were withheld with "he has 30
    # unread" written down as the reason, and the thing withheld was a bench
    # decision only he could make. A metric that argues for silence toward the
    # one person who can unblock you is worse than an absent one, because an
    # absent one sends you to look.
    local kbox kread
    kbox=$(unread_count andranik)
    kread=$(mail_box_count andranik read)
    if [ "$kbox" -gt 0 ] && [ "$kread" -eq 0 ]; then
        echo "the king's inbox (andranik): $kbox delivered, UNKNOWN read — this box has never been drained, and it is drained only by 'km mail read', which the king does not run. The number counts DELIVERY. Do not read it as 'unread' and do not withhold a letter on it (gqlc-2abx)."
    else
        echo "the king's inbox (andranik): $kbox in box, $kread moved to read/ by 'km mail read'"
    fi
}

# ---------- doctor / install ----------

cmd_doctor() {
    local ok=0 ws_row ws_rc
    # TWO labels, not one prefix (gqlc-67ml). A row that printed one label under
    # both outcomes STATED THE OPPOSITE of what it measured whenever the label
    # was phrased as a positive assertion: 'warn: town is up' over a town that
    # was down, 'warn: guard last run succeeded' over a run that had failed,
    # both in a real run on 2026-08-23. Four characters of prefix were carrying
    # the whole negation of a sentence written to mean the other thing, and an
    # operator scanning this on restart morning reads the sentence.
    #
    # So the failing phrasing is supplied per call and says what is wrong. It is
    # a required argument, not a defaulted one: a default would silently
    # reinstate the defect for every row that forgot it.
    check() { # check <hard|soft> <label-when-true> <label-when-false> <cmd...>
        check_rc "$1" "$2" "$3" '' '' "${@:4}"
    }

    # check_rc adds ONE more outcome: a named rc with a sentence of its own, for
    # a command whose exit status says more than yes/no. Two rows below have
    # one — herdr_server_up answers 0 running / 1 not running / 2 could not ask,
    # and `systemctl --user is-enabled` answers rc 0 enabled / 1 disabled / 4
    # not-found. A two-valued row asserts one cause for both of the last two,
    # whose remedies differ. That is the defect gqlc-ygcfi and gqlc-pgbfp each
    # fixed one level down, arriving here (gqlc-vdko8).
    #
    # stdout is dropped, stderr is NOT. `check` swallowed both, and the doctor
    # is the command an operator runs precisely when something is wrong — the
    # one caller guaranteed to throw the reason away. Measured 2026-08-30 over
    # every row here: only `mkdir -p` and herdr_server_up write to stderr at
    # all, and both write a diagnosis naming what actually failed. `command -v`
    # and `systemctl --user is-enabled` write none on any outcome, so passing
    # stderr through costs those rows nothing and no per-row redirect is needed.
    check_rc() { # <hard|soft> <label> <negative> <extra-rc|''> <its sentence> <cmd...>
        local kind=$1 label=$2 negative=$3 extra=$4 extra_negative=$5 rc=0
        shift 5
        "$@" >/dev/null || rc=$?
        if [ "$rc" = 0 ]; then
            echo "ok:   $label"
            return 0
        fi
        # Chosen once, above the hard/soft split: selecting it inside each arm
        # is one edit away from a row that distinguishes the causes when it
        # fails and not when it warns.
        if [ -n "$extra" ] && [ "$rc" = "$extra" ]; then negative=$extra_negative; fi
        if [ "$kind" = hard ]; then
            echo "FAIL: $negative"
            ok=1
        else
            echo "warn: $negative"
        fi
    }
    check hard "herdr installed" "herdr is NOT installed, and the town's panes are herdr agents (https://herdr.dev)" command -v herdr
    check_rc hard "herdr server running" \
        "the herdr server is NOT running, and the town's panes are herdr agents (herdr status server)" \
        2 "km could not ask herdr whether its server is running (its own account is above). Not saying it is down: that is a positive claim this failure does not support." \
        herdr_server_up
    check hard "claude installed" "claude is NOT installed, so no seat can be woken" command -v claude
    check hard "bd installed" "bd is NOT installed, so there is no ledger to dispatch from" command -v bd
    check hard "jq installed" "jq is NOT installed, and every ledger query here is parsed with it" command -v jq
    check hard "python3 installed" "python3 is NOT installed" command -v python3
    check hard "state dir writable" "the state dir could NOT be created or written: $(state_dir)" mkdir -p "$(state_dir)"
    # Not a `check` row: this one must NAME what it found. A boolean row labelled
    # "matches origin/master" reports a measured mismatch, so on a root that
    # could not be measured at all it sends the reader to `km deploy` for a
    # difference that was never observed.
    # Asked BEFORE the content row and independently of it, because a root that
    # cannot be deployed reads clean on content until master moves — and the
    # content row is silent for exactly that window (bd gqlc-ssfqj).
    local deployblocked
    deployblocked=$(deploy_blocker)
    if [ -n "$deployblocked" ]; then
        echo "FAIL: the deploy root cannot be fast-forwarded, so the next drift will not be repaired and the timers will keep running this tree: $deployblocked"
        ok=1
    fi
    local drift
    drift=$(kingdom_drift)
    if [ -z "$drift" ]; then
        echo "ok:   the deployed kingdom/, .githooks/ and .claude/ match origin/master"
    else
        echo "FAIL: the deployed kingdom/, .githooks/ or .claude/ is not certified against origin/master, so the town runs stale machinery or stale gates:"
        echo "      ${drift//$'\n'/$'\n      '}"
        ok=1
    fi
    # Not a `check` row either, and for the same reason twice over: this one has
    # three outcomes, and the failing one has to NAME the beads. A gate an
    # operator cannot act on is a warning wearing a gate's clothes.
    local stranded
    if ! stranded=$(stranded_ids); then
        echo "FAIL: the reachability query failed, so no bead can be certified reachable"
        ok=1
    elif [ -n "$stranded" ]; then
        echo "FAIL: in progress and assigned to nobody, so no dispatch pass can wake anyone: $stranded"
        ok=1
    else
        echo "ok:   every bead is in some dispatch pass"
    fi
    # The second unreachable shape (gqlc-t4zx), and deliberately a WARN where
    # the arm above is a FAIL. The difference is what the finding rests on. A
    # bead in progress with no assignee is unreachable as a matter of the
    # dispatcher's own arithmetic; an unresolvable assignee is unreachable as a
    # matter of a roster somebody maintains by hand, so a person who took a bead
    # before their name was added reddens this arm through no fault of the
    # board. A gate that goes red when a human takes work is one operators learn
    # to run with, and this file has that failure written into it twice already.
    # A named warning is the thing an operator can act on; the acting is theirs.
    local urows uname uids
    if ! urows=$(unreachable_owner_rows); then
        echo "warn: the assignee-resolution query failed, so no assignee can be certified reachable"
    elif [ -n "$urows" ]; then
        while IFS=' ' read -r uname uids; do
            [ -n "$uname" ] || continue
            echo "warn: assigned to '$uname', which is in neither [seats] nor [humans], so no dispatch pass can wake anyone for it — add them to [humans] if they are a person, or move the work if the seat is gone: $uids"
        done <<<"$urows"
    else
        echo "ok:   every assignee on the board is a seat or a known person"
    fi

    # ADR 0009's detector, and a WARN for the same reason the arm above is one:
    # it rests on the wording of a sentence a judge typed, not on the
    # dispatcher's arithmetic. Three outcomes, and the finding NAMES the beads —
    # the whole complaint ADR 0009 makes about a conditioned PASS is that its
    # content reaches nobody, so a row reporting a count would repeat the defect.
    local conditioned
    if ! conditioned=$(conditioned_verdict_ids); then
        echo "warn: the conditioned-verdict query failed, so no close reason can be certified unconditional"
    elif [ -n "$conditioned" ]; then
        echo "warn: closed with a condition in the close reason, which carries it to nobody — a verdict is PASS or FAIL, a PASS is unconditional, and binding content travels in bead ids (ADR 0009): $conditioned"
    else
        echo "ok:   every judge verdict closed since ADR 0009 is unconditional"
    fi

    # The stranded arm above answers "can any pass reach this bead"; this one
    # answers "did the last run actually place the town's highest work", which
    # is a different question with the same consequence — nothing happens, and
    # every board reads healthy (gqlc-tz95).
    #
    # Graded on AGE and not on the fact. Under the threshold the commonest
    # cause is a class whose wakes are already queued and which routes on the
    # next tick without anybody acting; failing hard on that trains the reader
    # to skip the row, which costs more than the row is worth.
    local stall stall_age stall_list
    if ! stall=$(stalled_p0_render); then
        # Named on the clean path too: an arm that is silent when it passes is
        # indistinguishable from an arm that is not there. It says whose record
        # it is, because absence here means the DISPATCHER saw no stall — the
        # last-run row below is what says whether it ran at all.
        echo "ok:   the last dispatch run recorded no stalled P0"
    else
        stall_age=${stall%%$'\t'*}
        stall_list=${stall#*$'\t'}
        if [ "$stall_age" -ge "$(stalled_p0_after)" ]; then
            echo "FAIL: P0 work has been unroutable for $(fmt_age "$stall_age") — ready, unassigned, and no seat can take it: $stall_list"
            ok=1
        else
            echo "warn: P0 work went unroutable on the last dispatch run, under $(fmt_age "$(stalled_p0_after)") ago, so it may still route on the next tick: $stall_list"
        fi
    fi
    # THE IDENTITY ARM (gqlc-0rv9). `.githooks/commit-msg` refuses an
    # implausible author and `.github/scripts/check-pr-authors.sh` refuses one
    # in Actions — both gate GIT. Nothing gated BD, and both consume the same
    # ambient `git config user.email`: when a fixture identity leaks into the
    # shared repo config, git refuses the commit and bd silently writes the
    # false address onto every bead created in the window. Measured
    # 2026-08-22: 15 beads across 5 citizens, in two windows 50 minutes apart
    # (km@test, then fixture@example.invalid). The human noticed at 03:20Z; the
    # second window had closed at 03:01Z. The noticing arrives after the window
    # structurally, every time, which is what makes this worth an arm.
    #
    # SOURCED, not copied. This is the predicate's third consumer, and
    # gqlc-gy3q is the record of what a second copy costs: while that bead was
    # open two PRs carried independent copies that had ALREADY disagreed on
    # four inputs. Copying it here would put the divergence between what git
    # refuses and what bd is audited for — silently, in the direction where
    # master accepts what commit-msg rejects. That file is read-only to this
    # one: km defines nothing in it and changes nothing about it.
    local idsrc
    idsrc="$(dirname "$KINGDOM_DIR")/.githooks/implausible-identity.sh"
    if [ ! -r "$idsrc" ]; then
        echo "FAIL: cannot read $idsrc, so no bead owner can be certified a real address"
        ok=1
    else
        # shellcheck source=/dev/null
        . "$idsrc"
        # THE POPULATION (gqlc-c7b5). This asked `--status open`, and in bd that
        # is the LITERAL status `open`, not "not closed": a bead in in_progress
        # or blocked was never queried and the arm reported on the rest with
        # full confidence. Measured 2026-08-23 while repairing gqlc-3x1r — the
        # arm named exactly three open beads owned by km@test and was silent
        # about gqlc-o13d, in_progress, owner fixture@example.invalid, and a P0.
        #
        # So: `--all`, which applies no status filter, and CLOSED is excluded in
        # jq rather than by asking for three statuses by name. Two reasons for
        # that shape. A named list has to be revised every time bd gains a
        # status, and it fails silently in the direction of omission when nobody
        # does. And closed is excluded on purpose, not incidentally: a closed
        # bead's owner is history — the window is shut, there is nothing to
        # reassign — so failing on one would leave this arm permanently red over
        # the beads gqlc-0rv9 already repaired, and a permanently red gate is
        # one nobody reads.
        #
        # `-n 0` for the row cap, which is a SEPARATE default from the status
        # filter and disables only itself.
        local owners bad_owners="" o why
        if ! owners=$(bd list --all -n 0 --json 2>/dev/null |
            jq -r '[ .[] | select(.status != "closed") | .owner // empty | select(. != "") ] | unique | .[]'); then
            # Fail-closed. gqlc-z1qw: an unanswered query that reads as a clean
            # board is the failure mode this whole file is organised against.
            echo "FAIL: could not read the beads, so no owner can be certified a real address"
            ok=1
        else
            while IFS= read -r o; do
                [ -n "$o" ] || continue
                if ! why=$(implausible_email_reason "$o"); then
                    bad_owners="$bad_owners $o ($why);"
                fi
            done <<<"$owners"
            if [ -n "$bad_owners" ]; then
                # NAMES the address, and FAILS. A check that prints a complaint
                # and exits 0 is not a gate (gqlc-z1qw, and `just doctor`
                # printing ok over a warning at gqlc-bn5r).
                echo "FAIL: beads that are not closed carry an owner that cannot belong to a person:$bad_owners fix 'git config user.email' and reassign them"
                ok=1
            else
                echo "ok:   every open, in progress and blocked bead's owner is a deliverable address"
            fi
        fi
    fi
    # THE COVERAGE ARM (gqlc-p1ek). The deployment half is already fixed —
    # km-seat refreshes a parked seat at wake — but the refresh deliberately
    # does NOT move a seat holding work, and it tells only that seat, in its
    # own wake banner. Nobody sweeping the town could see the gap, and the
    # population it covers is exactly the seats that are working, i.e. the ones
    # about to push. SOFT, not hard: a worktree that is legitimately mid-PR is
    # not an operator error, and Constitution VI.2 forbids anything here from
    # coercing the citizen standing in it. It is a mark.
    local ctarget cexposed="" cs cf cstate cball cbgates cahead cdetail
    ctarget=$(git_at "$(main_root)" rev-parse --verify --quiet origin/master 2>/dev/null || true)
    if [ -z "$ctarget" ]; then
        echo "warn: no origin/master here, so no seat's gate coverage could be measured"
    else
        for cs in $(seats_all); do
            cf=$(seat_freshness "$cs" "$ctarget")
            read -r cstate cball cbgates cahead cdetail <<<"$cf"
            : "$cstate $cball $cahead $cdetail"
            if [ "$cbgates" -gt 0 ]; then cexposed="$cexposed $cs($cbgates)"; fi
        done
        if [ -n "$cexposed" ]; then
            echo "warn: seats whose worktree is missing merged .githooks/.claude commits, so those gates do not run for them:$cexposed"
        else
            echo "ok:   every seat's worktree carries every merged .githooks/.claude commit"
        fi
    fi
    # THE LAUNCH ARM (gqlc-8dsa). Every other row in this file reports on
    # CONFIGURATION; this one reports on the sixteen processes. That distinction
    # is the whole finding: `km cfg claude permission_mode` answered
    # bypassPermissions truthfully while fifteen sessions had no such flag, and
    # `km status` called them awake and healthy for a day.
    #
    # HARD, unlike the coverage arm above it. A worktree legitimately mid-PR is
    # behind on hooks and that is nobody's error, so coverage is a mark; a
    # session with no soul or the wrong model is not a state the town has any
    # legitimate route into. The one axis a citizen may legitimately vary
    # (--effort, V.6.2) is the one seat_launch_probe deliberately does not fail
    # on.
    #
    # Per seat and never in aggregate: an "all seats ok" over sixteen sources
    # passes when fifteen go silent, so each seat is judged alone and an
    # unresolvable process is named rather than skipped.
    local lseat ls lcode lsay lbad="" lseen=0
    for lseat in $(seats_all); do
        ls=$(seat_launch_state "$lseat")
        lcode=${ls%%$'\t'*}
        lsay=${ls#*$'\t'}
        [ "$lcode" = "-" ] && continue
        lseen=$((lseen + 1))
        [ "$lcode" = ok ] && continue
        lbad="$lbad $lseat($lcode: $lsay);"
    done
    if [ -n "$lbad" ]; then
        echo "FAIL: live sessions whose claude process does not match kingdom.toml (P permission mode, S soul, M model, E effort; '?' the process could not be resolved):$lbad settings are read at launch, so a running session keeps its flags until it ends — the repair is that seat's next wake through km-seat, and ending a session is nobody's to do on a timer (VI.2)"
        ok=1
    else
        # The count is here so that silence is falsifiable. "every live session
        # matches" over a roster where nothing was live is a true sentence that
        # means nothing, and it is the sentence a reader takes for reassurance.
        echo "ok:   every live session matches kingdom.toml on permission mode, soul and model ($lseen live, $(($(seats_all | wc -l) - lseen)) asleep and not judged)"
    fi
    check soft "bd mail.delegate points at km" "bd mail.delegate does NOT resolve to 'km mail', so mail bd delegates goes nowhere this town reads" sh -c "bd config get mail.delegate | grep -q 'km mail'"
    # `systemctl --user is-enabled` answers three ways, measured 2026-08-30 on
    # this host: rc 0 "enabled", rc 1 "disabled", rc 4 "not-found", all three on
    # stdout and none of them on stderr. Installed-but-off and never-installed
    # have different remedies, so one sentence for both sends half its readers
    # to a command that cannot work.
    check_rc soft "dispatch timer enabled" \
        "the dispatch timer is NOT enabled, so nothing will route a bead until someone runs km dispatch by hand ('systemctl --user enable --now kingdom-dispatch.timer')" \
        4 "the dispatch timer is NOT INSTALLED, so nothing will route a bead and enabling it would fail — its unit file was never written ('km deploy')" \
        systemctl --user is-enabled kingdom-dispatch.timer
    check_rc soft "guard timer enabled" \
        "the guard timer is NOT enabled, so no sweep will run until someone runs km guard-sweep by hand ('systemctl --user enable --now kingdom-guard.timer')" \
        4 "the guard timer is NOT INSTALLED, so no sweep will run and enabling it would fail — its unit file was never written ('km deploy')" \
        systemctl --user is-enabled kingdom-guard.timer
    # An enabled timer says the machinery is armed, not that it works: the
    # dispatcher routed nothing for its whole life with both timers green
    # (gqlc-z1qw), and now that it dies on a bad query, the death lands only in
    # the journal unless something asks the unit how its last run went.
    #
    # Not `check` rows: three outcomes, not two. unit_health already separates
    # never-fired, not-installed, mid-run and unanswerable from a genuine
    # failure, and a boolean row threw all of that away and printed one label —
    # 'guard last run succeeded', with the run having failed (gqlc-67ml). So the
    # row renders unit_health's own sentence, which is the thing that was
    # measured.
    check_unit_run() { # <what> <unit>
        local uh
        uh=$(unit_health "$2")
        case "$uh" in
            ok*)      echo "ok:   $1 last run succeeded ${uh#ok }" ;;
            UNKNOWN*) echo "warn: $1 last run is UNKNOWN — ${uh#UNKNOWN — }" ;;
            # gqlc-28ysg. Without this arm the two no-record labels fall to the
            # last one and are announced as a run that did NOT succeed — the
            # bead's own defect, restated by the caller of the function that
            # stopped making it. No run is on record, so none failed either.
            "NOT SCHEDULED"*|"NO RUN ON RECORD"*) echo "warn: $1 has no last run on record — $uh" ;;
            *)        echo "warn: $1 last run did NOT succeed — $uh" ;;
        esac
    }
    check_unit_run dispatch kingdom-dispatch.service
    check_unit_run guard kingdom-guard.service
    # THE LINGER ARM (gqlc-yxnf). Not a `check` row, and deliberately not a
    # pass/fail one: both answers are legitimate configurations, and which is
    # correct depends on something km cannot see. `loginctl enable-linger` is
    # what a headless town NEEDS — without it the user manager is torn down at
    # logout and neither timer fires again until the next login. With it, the
    # timers keep dispatching after logout and across reboots, with nobody
    # attached to any pane. So the row NAMES the state and its consequence.
    #
    # A boolean row here would have to pick one of those as the failure and
    # would then be wrong for half the deployments; what nobody could see
    # before is which of the two this box is in, and that is the whole ask.
    #
    # The unanswerable case is the one that must not read as either: CI has no
    # user bus (the same reason every systemctl row above is soft), and
    # loginctl exits non-zero with nothing on stdout there. Reporting "not
    # lingering" for "could not ask" is the fail-open this file is organised
    # against (gqlc-z1qw).
    local lingerout
    if ! lingerout=$(loginctl show-user "${USER:-$(id -un)}" -p Linger 2>/dev/null) ||
        [ -z "$lingerout" ]; then
        echo "warn: lingering is UNKNOWN — loginctl could not be asked, so whether the timers survive logout was not measured"
    elif [ "${lingerout#*=}" = yes ]; then
        echo "ok:   lingering is ON, so the timers keep dispatching after logout and across reboots — 'just kingdom-uninstall' removes the units, 'loginctl disable-linger' leaves them but stops them surviving logout"
    else
        echo "ok:   lingering is off, so the timers fire only while a login session is open — a headless town needs 'loginctl enable-linger'"
    fi
    # THE TOWN ROW: is the herdr workspace present? Server-down and
    # workspace-absent both mean the town is down; render each with its own
    # message so an operator knows whether to start herdr or run `km up`.
    local srv_rc=0
    herdr_server_up || srv_rc=$?
    if [ "$srv_rc" = 2 ]; then
        echo "warn: cannot tell whether the town is up — km could not ask herdr whether its server is running (diagnosis above). Not advising 'km up': it would be wrong if the town is already up."
    elif [ "$srv_rc" != 0 ]; then
        echo "warn: the town is DOWN — the herdr server is not running (herdr status server)"
    else
        # The rc, not the emptiness. `[ -z "$(workspace_id)" ]` stood here and
        # advised `km up` on a list km could not read — a raise that would be
        # wrong if the town were in fact already up (gqlc-ygcfi).
        ws_row=$(workspace_id) && ws_rc=0 || ws_rc=$?
        if [ "$ws_rc" != 0 ]; then
            echo "warn: cannot tell whether the town is up — the herdr workspace list did not parse (diagnosis above). Not advising 'km up': it would be wrong if the town is already up."
        elif [ -z "$ws_row" ]; then
            echo "warn: the town is DOWN — no herdr workspace '$WORKSPACE' ('km up' creates it)"
        else
            echo "ok:   the town is up — herdr workspace '$WORKSPACE' exists"
        fi
    fi
    return "$ok"
}

# ---------- seat worktree freshness ----------

# core.hooksPath is RELATIVE, so a seat runs the hooks in its OWN checkout and
# acquires a merged one only when its worktree next moves. `km up` parks a seat
# detached and nothing moves it again, so merging a gate deploys it to nobody
# and the town's drift detectors all read clean — they check the hooksPath
# VALUE, which stays '.githooks' in a seat whose .githooks/ predates the gate
# (bd gqlc-xtre: 7 of 14 seats had no push guard hours after it merged).
#
# Exit 3 means "still exposed": held for work in flight AND behind on hooks.
# km-seat turns that into a banner in the citizen's first message.

# seat_freshness <seat> <target-sha> -> "<state> <behind_all> <behind_gates> <ahead> <detail>"
#
# ONE derivation, read by seat-refresh (which acts on it), by status and by
# doctor (which only report it). gqlc-p1ek asks for exactly this and says why:
# the obvious second derivation is to read `git config --get core.hooksPath`,
# and that value is '.githooks' in a seat whose .githooks/ predates the gate —
# measured 2026-08-22, all 14 seats read healthy while 7 held no push guard.
# Coverage is a question about CONTENT, so it is answered by counting commits
# the worktree has not got, against the paths that ARE the gates.
#
# Deliberately no fetch here. status renders this per seat on every call, and a
# board that stalls on the network is a board nobody runs; seat-refresh fetches
# once itself before calling in. The remote-tracking ref is shared by every
# worktree in the town, so it is as fresh as the last fetch by anybody.
#
# States, and the distinction gqlc-d38n turns on — "behind because working" is
# not "behind because parked", and only the second is a defect. Extended by
# decision 0008 to name a fourth state git alone cannot judge:
#   current   HEAD is origin/master
#   parked    clean, and holding nothing that some other ref does not already
#             hold, so moving it can lose nothing. THIS is the 14-commit case.
#   working   a dirty tree, or commits that live in this checkout and nowhere
#             else. Legitimately behind; reported, never counted as stale.
#   published on a branch, clean, every commit held by its upstream. Nothing
#             is lost by moving, but "on a branch" is not "finished" — that
#             question lives in the PR record, which the board cannot ask
#             without a network call, so it is deferred to seat_refresh_step
#             (0008). Legitimately behind; reported, never counted as stale.
#   unknown   no worktree, or git could not answer. Never rendered as current:
#             a question that was not answered is not a clean answer.
seat_freshness() {
    local seat=$1 target=$2 wt head branch dirty ahead behind_all behind_gates
    wt=$(seat_worktree "$seat")
    [ -d "$wt" ] || { echo "unknown 0 0 0 no worktree at $wt"; return 0; }
    [ -n "$target" ] || { echo "unknown 0 0 0 no origin/master to judge against"; return 0; }
    head=$(git_at "$wt" rev-parse HEAD 2>/dev/null) ||
        { echo "unknown 0 0 0 git cannot read $wt"; return 0; }

    branch=$(git_at "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
    dirty=$(git_at "$wt" status --porcelain 2>/dev/null || echo "?")
    # Detached and clean is not the same as parked. A citizen who committed
    # without first cutting a branch leaves both of those signals empty, and
    # moving that worktree takes the commit off every ref. A genuinely parked
    # seat is an ancestor of target, so this is 0 for it and holds nobody
    # who is not carrying something.
    ahead=$(git_at "$wt" rev-list --count "$target..HEAD" 2>/dev/null) || ahead=0
    behind_all=$(git_at "$wt" rev-list --count "HEAD..$target" 2>/dev/null) || behind_all=0
    # Restricted to the paths that ARE the gates, and counted before any move.
    # kingdom/ is deliberately NOT in this count, though it is in KM_GATE_PATHS:
    # the machinery a seat runs is the DEPLOYED copy (deploy_root), never the
    # seat's own, so kingdom/ staleness in a worktree costs that seat nothing.
    # The hooks are the opposite — core.hooksPath is relative, so they resolve
    # inside the seat's own checkout.
    behind_gates=$(git_at "$wt" rev-list --count "HEAD..$target" -- .githooks .claude 2>/dev/null) || behind_gates=0

    # What makes a move unsafe is not being on a branch; it is holding the ONLY
    # copy of something. Being on a branch used to be sufficient for `working`,
    # and `working` never moves, so a seat whose branch had merged was reported
    # exposed forever and resolved never — measured 2026-08-23, three seats
    # 63-65 commits behind on the gate paths, every one of them clean with
    # nothing unpushed (bd gqlc-5t2u).
    #
    # Asked as "does any ref elsewhere hold this?", which needs no opinion about
    # merges. Deliberately NOT `--is-ancestor` and not patch-id: a squash-merged
    # branch is neither an ancestor of master nor patch-identical to it, so both
    # refuse such a seat forever, and patch-id said "not on master" for all five
    # of ayg's merged commits — confidently and wrongly.
    #
    #   on a branch   commits its upstream has not got
    #   detached      commits target has not got, as before
    #
    # One question, not two, FOR THE HOLD: "no upstream configured" and "git
    # would not answer" take the same branch and are held for the same reason —
    # nothing was shown to hold this. They are told apart for the REPORT below,
    # which is a different question. Asking rev-parse first and rev-list second would read
    # better and would put an unreachable fallback under the second call, which
    # a mutation duly SURVIVED: rev-list cannot fail for a ref rev-parse has
    # just verified, so no row could ever reach it.
    #
    # An unresolvable @{u} is the SAME hold whatever caused it — nothing was
    # shown to hold this — so the hold does not move and only the sentence does
    # (gqlc-guq3). @{u} cannot say which case it is: it is the one question
    # whose answer is identical. The branch's config can, offline, with no
    # network call and no gh auth, because neither a remote-side deletion nor a
    # prune touches it. Measured 2026-08-29 in a scratch repo, after push -u
    # then remote-side delete then fetch --prune:
    #   no upstream configured   branch.<n>.remote UNSET, branch.<n>.merge UNSET
    #   upstream configured      both INTACT, tracking ref absent
    # Configured is ALL the keys answer, and the sentence below says no more.
    # It is not "published to a remote": an upstream may be a local branch,
    # where remote is "." and nothing was ever pushed anywhere (Միհր, PR #1763
    # F1 — the earlier wording said "was published" and lied about that case).
    # Read the config keys, not git's two error strings: those also differ, and
    # they are human-facing text, unversioned and localisable.
    #
    # Published is NOT safe, so this changes no verdict: the branch reached a
    # remote once, which says nothing about whether the work landed, and a
    # branch pushed to the wrong upstream (gqlc-tfh1) is held by nothing.
    local unique upstream_known=0 upstream_gone=""
    if [ -n "$branch" ]; then
        if unique=$(git_at "$wt" rev-list --count "@{u}..HEAD" 2>/dev/null); then
            upstream_known=1
        else
            unique=1
            local cfg_remote cfg_merge
            cfg_remote=$(git_at "$wt" config --get "branch.$branch.remote" 2>/dev/null || true)
            cfg_merge=$(git_at "$wt" config --get "branch.$branch.merge" 2>/dev/null || true)
            if [ -n "$cfg_remote" ] && [ -n "$cfg_merge" ]; then
                upstream_gone="$cfg_remote/${cfg_merge#refs/heads/}"
            fi
        fi
    else
        unique=$ahead
    fi

    if [ -n "$dirty" ] || [ "$unique" -gt 0 ]; then
        local why="$ahead commit(s) of its own, on no branch"
        [ -n "$branch" ] && why="branch $branch in flight"
        [ -n "$upstream_gone" ] &&
            why="branch $branch had upstream $upstream_gone, which is gone — whether its work landed is not a question git can answer"
        [ -n "$dirty" ] && why="uncommitted work in the tree"
        echo "working $behind_all $behind_gates $ahead $why"
        return 0
    fi
    if [ "$head" = "$target" ]; then
        echo "current 0 0 0 at $(git_at "$wt" rev-parse --short HEAD 2>/dev/null || echo "$head")"
        return 0
    fi
    # On a branch, clean, upstream resolved, everything held by that upstream:
    # published. Nothing here is at risk from git's point of view, but nothing
    # here tells us the branch is FINISHED — an open PR looks identical to a
    # merged one. The word deliberately refuses to say `parked`; the PR record
    # is the authority (0008) and seat_refresh_step is where it is consulted.
    if [ -n "$branch" ] && [ "$upstream_known" -eq 1 ]; then
        echo "published $behind_all $behind_gates 0 branch $branch fully held by its upstream"
        return 0
    fi
    echo "parked $behind_all $behind_gates 0 at $(git_at "$wt" rev-parse --short HEAD 2>/dev/null || echo "$head")"
}

# seat_refresh_step <seat> <check> <target> <mr> <stale_note>
#
# One seat's verdict and, unless --check, the one move that is ever safe.
# Echoes a line beginning "<seat>: "; the exit status is the whole point of
# separating it from the printing:
#
#   0  covered — current, refreshed, or held with its hooks already current
#   3  still exposed, and the tree is holding work: a branch or uncommitted
#      changes stand in the way of the move
#   4  unjudged — no worktree, or git could not answer, or the move failed
#   5  still exposed, but only because --check declined to move it; the tree
#      is parked and nothing is in the way
#
# All three non-zero statuses are distinct because their remedies are addressed
# to different people: 3 wants the citizen standing in that tree to rebase, 4
# wants `km up` or a human with a shell, 5 wants the operator who typed --check
# to type it again without. Collapsing 3 and 4 would send an unseated seat's
# operator to a citizen who does not exist; collapsing 3 and 5 did send one to
# ask three citizens to rebase trees with nothing in them (gqlc-jjcj).
#
# 5 is reachable only under --check. km-seat is the only caller that branches
# on this status and it never passes --check (km-seat:183), so no existing
# reader of 3 can be handed a 5.
#
# SHARED by the single-seat path and the sweep, not copied into each. The two
# differ only in whether an unjudged seat aborts, and gqlc-gy3q is the record
# of what a second copy of a predicate costs — two copies of one rule had
# already disagreed on four inputs while that bead was open.
seat_refresh_step() {
    local seat=$1 check=$2 target=$3 mr=$4 stale_note=$5
    local wt f state behind_all behind_gates ahead detail head
    wt=$(seat_worktree "$seat")
    f=$(seat_freshness "$seat" "$target")
    read -r state behind_all behind_gates ahead detail <<<"$f"
    : "$ahead"

    case "$state" in
        unknown)
            echo "$seat: cannot judge — $detail"
            return 4
            ;;
        working)
            local why="$detail"
            if [ "$behind_gates" -eq 0 ]; then
                echo "$seat: held ($why); its hooks are current$stale_note"
                return 0
            fi
            echo "$seat: HELD — $behind_gates hook/settings change(s) behind master and NOT applied ($why)$stale_note"
            return 3
            ;;
        current)
            echo "$seat: current at $(git_at "$wt" rev-parse --short HEAD)$stale_note"
            return 0
            ;;
        published)
            # git says safe; ask the PR record whether the work is finished
            # (0008). branch_pr_state answers on stdout with one of four words,
            # each of which becomes a reason-naming verdict below — two paths
            # to one HOLD must stay tellable apart.
            local pr_branch pr_state pr_reason
            pr_branch=$(git_at "$wt" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
            # Strip the remote prefix; a PR's head is a remote branch and the
            # local name can differ (a same-named local branch is not the PR
            # head — town law, measured).
            pr_branch=${pr_branch#*/}
            pr_state=$(branch_pr_state "$pr_branch")
            case "$pr_state" in
                open)     pr_reason="open PR for $pr_branch — mid-work" ;;
                none)     pr_reason="published but not shown finished (no PR for $pr_branch)" ;;
                unanswered) pr_reason="GitHub did not answer; refusing to guess" ;;
                finished) pr_reason="" ;;
            esac
            if [ "$pr_state" != "finished" ]; then
                if [ "$behind_gates" -eq 0 ]; then
                    echo "$seat: held ($pr_reason); its hooks are current$stale_note"
                    return 0
                fi
                echo "$seat: HELD — $behind_gates hook/settings change(s) behind master and NOT applied ($pr_reason)$stale_note"
                return 3
            fi
            # finished: safe AND finished. One more conjunct before moving —
            # km-seat's own wake comment ("no checkout happens under a live
            # claude") generalised to the sweep and the manual path. Reads the
            # world (herdr's report), not the status file: a dead-turn seat is
            # held either way, but a seat whose record says `awake` over a
            # crashed session is movable, which the record would wrongly
            # strand. At the wake path the session is never live (km-seat
            # refreshes before claude starts), so the guard cannot starve the
            # main clearing route.
            if seat_session_live "$seat"; then
                echo "$seat: held (branch $pr_branch finished, but herdr reports a live session in it — or could not be read at all, which is held the same way; its wake-path refresh will take it)$stale_note"
                return 0
            fi
            head=$(git_at "$wt" rev-parse HEAD)
            if [ "$check" -eq 1 ]; then
                echo "$seat: would refresh (branch $pr_branch finished: every PR for it is closed) — --check, nothing moved$stale_note"
                return 0
            fi
            if ! git_at "$wt" checkout --detach --quiet "$target" 2>/dev/null; then
                echo "$seat: could not move its published worktree to origin/master"
                return 4
            fi
            echo "$seat: refreshed $(git_at "$mr" rev-parse --short "$head") -> $(git_at "$wt" rev-parse --short HEAD) (branch $pr_branch finished: every PR for it is closed)$stale_note"
            return 0
            ;;
    esac

    # parked: safe to move, and the only state in which anything moves.
    head=$(git_at "$wt" rev-parse HEAD)
    if [ "$check" -eq 1 ]; then
        # --check never moves, so a parked seat behind on gates is STILL
        # exposed when this returns, and the exit status has to say so. It says
        # so as 5 rather than 3, because the two exposures want different
        # people: 3 wants the citizen standing in that tree to rebase, 5 wants
        # the operator who just typed --check to type it again without. Both
        # were 3 until gqlc-jjcj, and the sweep's summary — the only reader
        # that buckets by status — attributed the merged bucket to the one
        # cause that fits 3, sending an operator to ask three citizens to
        # rebase trees with nothing in them.
        #
        # Reachable only under --check, and km-seat (the sole caller that
        # branches on this status, km-seat:183) never passes it, so nothing
        # that reads 3 today can be handed a 5.
        echo "$seat: STALE (--check, nothing moved) — $behind_all commit(s) behind origin/master, $behind_gates of them touching .githooks/.claude$stale_note"
        [ "$behind_gates" -eq 0 ] || return 5
        return 0
    fi
    if ! git_at "$wt" checkout --detach --quiet "$target" 2>/dev/null; then
        echo "$seat: could not move its parked worktree to origin/master"
        return 4
    fi
    echo "$seat: refreshed $(git_at "$mr" rev-parse --short "$head") -> $(git_at "$wt" rev-parse --short HEAD) ($behind_gates hook/settings change(s) picked up)$stale_note"
    return 0
}

# The sweep (gqlc-k9r2). MEASURED 2026-08-23 on the live town: 15 of 16 seat
# worktrees were missing merged .githooks/.claude commits, 7 of them PARKED as
# far as 53 commits back — all three architects, both seated judges and the
# guard — and a 16th roster seat had no worktree at all. The per-seat command
# was already correct and already refused every unsafe move; what was missing
# was any way to apply it to the town without composing sixteen invocations by
# hand at the moment of switching the town on.
#
# It refuses exactly what the single-seat path refuses, seat by seat, and it
# moves nothing else — Constitution VI.2's no-forcing applies to a citizen's
# work in a tree as much as to their session. The failure this must never have
# is the convenient one: a sweep that treats "held" as "skip the guard".
cmd_seat_refresh_all() {
    local check=$1 mr target stale_note="" s line rc
    local refreshed=0 current=0 held=0 exposed="" declined="" unjudged=""
    mr=$(main_root)
    git_at "$mr" fetch --quiet origin 2>/dev/null ||
        stale_note=" [fetch failed: judged against the last known origin/master]"
    target=$(git_at "$mr" rev-parse --verify --quiet origin/master) ||
        die "seat-refresh --all: no origin/master to refresh anyone against"

    for s in $(seats_all); do
        rc=0
        line=$(seat_refresh_step "$s" "$check" "$target" "$mr" "$stale_note") || rc=$?
        printf '  %s\n' "$line"
        case "$rc" in
            3) exposed="$exposed $s" ;;
            5) declined="$declined $s" ;;
            # NOT fatal, and this is the property the sweep turns on: tir is
            # last in roster order and has no worktree at all, so a loop that
            # died here would print most of the table and silently never visit
            # the seats after him. A seat that cannot be judged is a row.
            4) unjudged="$unjudged $s" ;;
            *) case "$line" in
                   *refreshed*) refreshed=$((refreshed + 1)) ;;
                   *current*)   current=$((current + 1)) ;;
                   *)           held=$((held + 1)) ;;
               esac ;;
        esac
    done

    local summary="seat-refresh --all: $refreshed refreshed, $current already current, $held held with hooks current"
    if [ -n "$exposed" ]; then
        summary="$summary; STILL EXPOSED:$exposed — each is holding work, so nothing here will move it; its citizen must rebase"
    fi
    # Deliberately not phrased as an alarm. Under --check this is the ordinary
    # outcome for every parked seat behind on gates, and the remedy is one
    # command the operator already has, addressed to the operator (gqlc-jjcj).
    if [ -n "$declined" ]; then
        summary="$summary; NOT MOVED because --check:$declined — parked and safe to move; re-run without --check"
    fi
    if [ -n "$unjudged" ]; then
        summary="$summary; UNJUDGED:$unjudged — no worktree or git could not read one, so a bead routed there goes nowhere ('km up' seats it)"
    fi
    echo "$summary$stale_note"
    # Non-zero while anything is uncovered. The exit status is all a morning
    # script reads, and "it ran" must not be readable as "the town is covered".
    # A --check-declined seat is uncovered too: nothing moved, so it counts.
    [ -z "$exposed$declined$unjudged" ] || return 3
    return 0
}

cmd_seat_refresh() {
    local seat="" check=0 all=0 a
    for a in "$@"; do
        case "$a" in
            --check) check=1 ;;
            --all) all=1 ;;
            -*) die "seat-refresh: unknown flag $a" ;;
            *) [ -z "$seat" ] || die "seat-refresh: one seat at a time"; seat=$a ;;
        esac
    done
    # Ambiguous rather than merely redundant: does a seat name narrow the sweep,
    # or is --all a typo away from a single-seat run the operator meant? Refuse
    # instead of guessing, since one reading moves sixteen worktrees.
    if [ "$all" -eq 1 ] && [ -n "$seat" ]; then
        die "seat-refresh: --all sweeps the whole roster; pass it or a seat name, not both (got --all and '$seat')"
    fi
    if [ "$all" -eq 1 ]; then
        cmd_seat_refresh_all "$check"
        return
    fi
    [ -n "$seat" ] || die "seat-refresh: which seat? (or --all for the whole roster)"
    is_seat "$seat" || die "seat-refresh: unknown seat: $seat"

    local mr wt
    mr=$(main_root)
    wt=$(seat_worktree "$seat")
    [ -d "$wt" ] || die "seat-refresh: no worktree at $wt (km up creates it)"

    # A failed fetch judges the seat against a stale origin/master, which would
    # report a seat current on evidence that is itself behind. Say so rather
    # than reporting a clean result from an unanswered question.
    local stale_note=""
    git_at "$mr" fetch --quiet origin 2>/dev/null ||
        stale_note=" [fetch failed: judged against the last known origin/master]"

    local target
    target=$(git_at "$mr" rev-parse --verify --quiet origin/master) ||
        die "seat-refresh: no origin/master to refresh $seat against"

    # A single named seat that cannot be judged is an operator error worth an
    # exit — he asked about THIS seat and got no answer. The sweep treats the
    # same rc as a row, because there the alternative is truncating the table.
    local line rc=0
    line=$(seat_refresh_step "$seat" "$check" "$target" "$mr" "$stale_note") || rc=$?
    [ "$rc" -ne 4 ] || die "seat-refresh: $line"
    echo "seat-refresh $line"
    return "$rc"
}

render_unit() { # <src> <dst>
    # @STATE@ is resolved here, at install time, for the same reason @REPO@ is:
    # the alarm unit's fallback append must reach the wake file without running
    # km, so it cannot ask km where the state dir is (bd gqlc-leq7).
    sed -e "s|@REPO@|$(main_root)|g" \
        -e "s|@STATE@|$(state_dir)|g" \
        -e "s|@DISPATCH_MIN@|$(cfg cadence dispatch_minutes)|g" \
        -e "s|@GUARD_MIN@|$(cfg cadence guard_minutes)|g" \
        "$1" >"$2"
}

cmd_install_units() {
    no_args install-units "$@"
    local unitdir="$HOME/.config/systemd/user" u
    mkdir -p "$unitdir"
    for u in kingdom-dispatch.service kingdom-dispatch-alarm.service kingdom-dispatch.timer kingdom-guard.service kingdom-guard.timer; do
        render_unit "$KINGDOM_DIR/systemd/$u" "$unitdir/$u"
    done
    systemctl --user daemon-reload
    systemctl --user enable --now kingdom-dispatch.timer kingdom-guard.timer
    bd config set mail.delegate "$(main_root)/kingdom/bin/km mail"
    ensure_state_tree
    echo "installed: dispatch every $(cfg cadence dispatch_minutes)m, guard every $(cfg cadence guard_minutes)m; bd mail now delegates to km"
}

cmd_uninstall_units() {
    no_args uninstall-units "$@"
    systemctl --user disable --now kingdom-dispatch.timer kingdom-guard.timer 2>/dev/null || true
    rm -f "$HOME/.config/systemd/user"/kingdom-{dispatch,guard}.{service,timer} \
        "$HOME/.config/systemd/user/kingdom-dispatch-alarm.service"
    systemctl --user daemon-reload
    echo "units removed; state, mail, and worktrees untouched"
}

# ---------- main ----------

cmd=${1:-}
shift || true
case "$cmd" in
    status)          cmd_status "$@" ;;
    up)              cmd_up "$@" ;;
    down)            cmd_down "$@" ;;
    wake)            cmd_wake "$@" ;;
    sleep)           cmd_sleep "$@" ;;
    mail)            cmd_mail "$@" ;;
    dispatch)        cmd_dispatch "$@" ;;
    hold-verdict)    cmd_hold_verdict "$@" ;;
    reconcile)       cmd_reconcile "$@" ;;
    seat-live)       seat_session_live "$1" ;;
    seat-runner)     seat_runner_live "$1" ;;
    seat-idle)       seat_pane_idle "$1" ;;
    guard-sweep)     cmd_guard_sweep "$@" ;;
    halt)            cmd_halt "$@" ;;
    resume)          cmd_resume "$@" ;;
    doctor)          cmd_doctor "$@" ;;
    deploy)          cmd_deploy "$@" ;;
    install-units)   cmd_install_units "$@" ;;
    uninstall-units) cmd_uninstall_units "$@" ;;
    # Guarded here rather than inside the function, as the eight verbs above
    # are: state_dir and capped_seats are ordinary helpers with 25 and 4
    # internal callers, so a refusal inside them would answer for every one of
    # those and not for the verb. The dispatch site is the only place that
    # holds this verb's argv. Neither is a write, so what they cost is the
    # help someone asked for, not the town.
    state-dir)       no_args state-dir "$@"; state_dir ;;
    capped-seats)    no_args capped-seats "$@"; capped_seats ;;
    cfg)             cfg "${1:?km cfg <section> <key>}" "${2:?km cfg <section> <key>}" ;;
    seat-info)       is_seat "${1:-}" || die "seat-info: unknown seat ${1:-<none>}"
                     echo "$(seat_class "$1") $(seat_model "$1") $(seat_display "$1")" ;;
    seat-worktree)   is_seat "${1:-}" || die "seat-worktree: unknown seat ${1:-<none>}"
                     seat_worktree "$1" ;;
    seat-refresh)    cmd_seat_refresh "$@" ;;
    -h | --help | help | "") usage ;;
    *) die "unknown command: $cmd (km --help)" ;;
esac
