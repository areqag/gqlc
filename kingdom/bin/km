#!/usr/bin/env bash
# km — the machinery of the Թագաւորութիւն (kingdom/README.md).
#
# Path resolution: this script's own location names the kingdom/ tree it
# serves; the runtime state dir is derived from the git COMMON dir so every
# seat worktree resolves the same shared state (KM_STATE_DIR overrides, for
# tests). tmux may be absent (CI): every tmux-touching path degrades to a
# message or a state file, never a crash.
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
KM_SELF=$SCRIPT_DIR/${BASH_SOURCE[0]##*/}
KINGDOM_DIR=$(dirname "$SCRIPT_DIR")
# KM_CONFIG overrides for tests, as KM_STATE_DIR does for state; the town
# itself never sets it. Without it a test that exercises a tuning parameter has
# to assert the town's live value, so the parameter can no longer be tuned
# without editing the suite that guards it — Constitution V.6.1 says these
# numbers change by a config edit, and that is only true if nothing else pins
# them (gqlc-p5s8).
CONFIG="${KM_CONFIG:-$KINGDOM_DIR/kingdom.toml}"

die() { echo "km: $*" >&2; exit 1; }

# history: kingdom/brain/km-notes.md#verb
verb() { # <name> — echoes "km <name>"; warns, rc 1, if km dispatches no <name>
    # Recomputed per call rather than cached in a global, because a global is a
    # name an inherited environment can preload — and so answer on km's behalf
    # about what km dispatches. Three awk passes over one file costs nothing.
    local v dispatched
    dispatched=$(
        awk '/^case "\$cmd" in$/{d=1;next} d&&/^esac$/{exit}
             d&&/^[[:space:]]*[-a-z"|[:space:]]+\)/{
                 sub(/\).*/,""); gsub(/[[:space:]"]/,"")
                 n=split($0,a,"|"); for(i=1;i<=n;i++) if(a[i]!="") print a[i]}' \
            "$KM_SELF"
    )
    printf 'km %s' "$1"
    for v in $dispatched; do
        [ "$v" != "$1" ] || return 0
    done
    echo "km: INTERNAL — '$1' was just advertised to an operator, but km's dispatch table has no such verb" >&2
    return 1
}

# history: kingdom/brain/km-notes.md#require_identity
require_identity() { # <command> — returns only if this session has an identity
    [ -n "${KINGDOM_SEAT:-}" ] && return 0
    echo "km $1: refused — this session has no identity (KINGDOM_SEAT is unset)." >&2
    echo "  Acting anyway would record this as Անդրանիկ, the crown." >&2
    echo "  If you are the crown, say so: KINGDOM_SEAT=andranik km $1" >&2
    exit 1
}

usage() {
    cat <<'EOF'
km — the machinery of the Թագաւորութիւն

  km status                      the town's mechanical readout (open `herdr` for the pane view)
  km up | down                   raise / close the town's herdr workspace and its per-seat agents
  km wake <seat> [--bead ID] [--reason TEXT]
  km sleep [--seat NAME]         end the current seat's workday
  km mail send <to> -s SUBJ [-m BODY]   (body on stdin if no -m)
  km mail inbox [--seat NAME] | read <id> | sent
  km dispatch                    route ready beads to free seats (timer)
  km hold-verdict                ROUTE/HOLD per candidate bead, docs on stdin
  km reconcile                   match seat status to the sessions that exist
  km seat-live <seat>            exit 0 if a claude session exists there (herdr reports it)
  km seat-runner <seat>          exit 0 if the seat has an active herdr agent
  km seat-idle <seat>            exit 0 if the seat is at an empty prompt
                                 (agent_status `idle` or `done`)
  km guard-sweep                 wake Րաֆֆի for a round (timer)
  km halt [reason] | halt --status | halt --history [N] | resume
                                 raise / ask about / replay / lower the town halt
  km install-units | uninstall-units
  km deploy                      fast-forward the checkout the timers run from
  km doctor                      health checks
  km seat-refresh <s>|--all [--check]
                                 bring a parked seat's worktree (and its hooks) up to master
                                 --all sweeps the roster; it moves ONLY parked seats and
                                 refuses a dirty tree, a branch, or commits of its own
                                 --check reports and moves nothing (status/doctor read it)
  km state-dir | deploy-root | capped-seats | seat-info <s> | seat-worktree <s>
EOF
}

# history: kingdom/brain/km-notes.md#no_args
no_args() { # <verb> "$@" — for a verb that takes none; --help prints usage
    local na_verb=$1
    shift
    [ "$#" -gt 0 ] || return 0
    case "$1" in
    -h | --help | help)
        usage
        exit 0
        ;;
    esac
    die "$na_verb takes no arguments, and it did NOT run — got: $*
  to ask what it does:  $(verb "$na_verb") --help
  to run it:            $(verb "$na_verb")"
}

# ---------- config ----------

cfg() { # cfg <section> <key> -> value with quotes and inline comment stripped
    awk -F' *= *' -v sec="[$1]" -v key="$2" '
        /^\[/ { insec = ($0 == sec); next }
        insec && $1 == key {
            v = $2
            sub(/[ \t]+#.*$/, "", v)
            gsub(/^"|"$/, "", v)
            print v
            exit
        }
    ' "$CONFIG"
}

# The bare keys of every entry under one section header. There are two rosters
# now — [seats] and [humans] — and they are read by the same reader on purpose:
# a second copy of this awk would let the two disagree about what counts as an
# entry, and the whole value of the second roster is that a name found in
# neither is a real finding rather than a parsing difference (gqlc-t4zx).
roster_names() { # <section> -> one name per line
    awk -F' *= *' -v sec="[$1]" '
        index($0, sec) == 1 { s = 1; next }
        /^\[/               { s = 0 }
        s && NF >= 2 && $1 !~ /^#/ { print $1 }
    ' "$CONFIG"
}

seats_all() { roster_names seats; }

# The people who legitimately hold beads. They are not seats and nothing routes
# to them; the list exists so that an assignee in NEITHER roster can be told
# apart from a person's name. See the [humans] comment in kingdom.toml.
humans_all() { roster_names humans; }

seat_raw() {
    local raw
    raw=$(cfg seats "$1")
    [ -n "$raw" ] || die "unknown seat: $1"
    echo "$raw"
}

seat_class()   { seat_raw "$1" | cut -d: -f1; }
seat_model()   { seat_raw "$1" | cut -d: -f2; }
seat_display() { seat_raw "$1" | cut -d: -f3; }

is_seat()  { seats_all  | grep -qx "$1"; }
is_human() { humans_all | grep -qx "$1"; }

# ---------- paths ----------

# history: kingdom/brain/km-notes.md#git_at
git_at() { # git_at <dir> <args...>
    local dir=$1
    shift
    local -a scrub=() keep=() bound=()
    local v
    for v in "${!GIT_@}"; do
        case $v in
            GIT_SSH | GIT_SSH_COMMAND | GIT_ASKPASS | GIT_TERMINAL_PROMPT)
                keep+=("$v=${!v}") ;;
            *) scrub+=(-u "$v") ;;
        esac
    done
    [ -n "${KM_GIT_TIMEOUT:-}" ] && bound=(timeout "$KM_GIT_TIMEOUT")
    env "${scrub[@]}" "${keep[@]}" "${bound[@]}" git -C "$dir" "$@"
}

# history: kingdom/brain/km-notes.md#main_root
main_root() {
    local common root base
    common=$(git_at . rev-parse --path-format=absolute --git-common-dir)
    root=$(dirname "$common")
    base=$(basename "$root")
    case $base in
        *-seat-*) echo "$(dirname "$root")/${base%-seat-*}" ;;
        *) echo "$root" ;;
    esac
}

state_dir() {
    if [ -n "${KM_STATE_DIR:-}" ]; then
        echo "$KM_STATE_DIR"
    else
        echo "$(dirname "$(main_root)")/$(cfg kingdom state_dirname)"
    fi
}

seat_worktree() {
    local mr
    mr=$(main_root)
    echo "$(dirname "$mr")/$(basename "$mr")-seat-$1"
}

# Both layouts are live at once during the migration of gqlc-w5bh, and a seat
# is told apart by where its common dir lands: inside itself for a clone,
# inside the main checkout for a linked worktree. Asked of the directory
# rather than looked up in config, so a seat converted by hand answers the
# same as one `km up` created.
seat_is_clone() { # <seat-dir>
    local wt=$1 common
    common=$(git_at "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
    case "$common" in "$wt"/*) return 0 ;; *) return 1 ;; esac
}

# The origin/master a seat is judged and moved against. A clone has its own
# object store, so the main checkout's SHA may not exist there at all and the
# fallback would name a commit the seat cannot resolve. Deliberately no fetch:
# both callers that want fresh refs fetch first and say so when it failed.
seat_target() { # <seat-dir> <main-checkout-target> -> sha, empty if unresolvable
    local wt=$1 fallback=$2
    if seat_is_clone "$wt"; then
        git_at "$wt" rev-parse --verify --quiet origin/master 2>/dev/null || true
        return 0
    fi
    echo "$fallback"
}

# The runner script each seat's tmux window executes, from kingdom/bin/. Only
# km-seat is in-tree today; the config knob is kept so a future alternative can
# be swapped in without touching every call site here. Whatever it names must
# honour the km-seat contract: park on the wake file, keep $home/status
# asleep/awake.
seat_runner() {
    local v
    v=$(cfg kingdom seat_runner)
    echo "${v:-km-seat}"
}

# ---------- deploy ----------

# The systemd units execute kingdom/ out of the main checkout, never out of the
# seat worktree a fix was written in, and nothing advances that checkout — so a
# merged fix ran for hours while the town believed it was live (bd gqlc-ed2u).
# KM_DEPLOY_ROOT overrides, for tests, as KM_STATE_DIR does for state.
deploy_root() { echo "${KM_DEPLOY_ROOT:-$(main_root)}"; }

# history: kingdom/brain/km-notes.md#km_gate_paths
KM_GATE_PATHS=(kingdom/ .githooks/ .claude/)

# history: kingdom/brain/km-notes.md#master_holder
master_holder() { # <root>
    git_at "$1" worktree list --porcelain 2>/dev/null |
        awk '/^worktree /{wt=substr($0, 10)} /^branch refs\/heads\/master$/{print wt; exit}'
}

deploy_blocker() {
    local root branch holder msg
    root=$(deploy_root)
    git_at "$root" rev-parse --git-dir >/dev/null 2>&1 \
        || { echo "$root is not a git checkout, so nothing can be deployed into it"; return 0; }
    branch=$(git_at "$root" symbolic-ref --quiet --short HEAD || true)
    if [ "$branch" != master ]; then
        msg="$root is parked on '${branch:-a detached HEAD}', not master"
        # history: kingdom/brain/km-notes.md#deploy_blocker
        holder=$(master_holder "$root")
        [ -z "$holder" ] || msg="$msg, and 'git checkout master' there will refuse because $holder holds that branch"
        echo "$msg"
    fi
}

# history: kingdom/brain/km-notes.md#kingdom_drift
kingdom_drift() {
    local root out rc=0
    root=$(deploy_root)
    # history: kingdom/brain/km-notes.md#kingdom_drift-2
    local KM_GIT_TIMEOUT="${KM_FETCH_TIMEOUT:-30}"
    git_at "$root" fetch --quiet origin master 2>/dev/null \
        || echo "drift: could not fetch origin/master in $root; measuring against a possibly-stale ref" >&2
    if ! git_at "$root" rev-parse --verify -q origin/master >/dev/null 2>&1; then
        echo "origin/master is unknown in $root"
        return 0
    fi
    # A diff that could not run is not a clean tree. On a root git cannot use as
    # a checkout at all, `git diff` exits non-zero with EMPTY stdout — and empty
    # is this function's word for "no drift", so the gate would open widest
    # where it knows least. Measured shape: core.bare=true in the config, which
    # clears the rev-parse guard above and then fails here (bd gqlc-ed2u).
    # Carry the failure as drift, like the missing ref above.
    out=$(git_at "$root" diff --name-only origin/master -- "${KM_GATE_PATHS[@]}" 2>&1) || rc=$?
    if [ "$rc" -ne 0 ]; then
        echo "cannot measure drift in $root (git exited $rc): ${out//$'\n'/ }"
        return 0
    fi
    echo "$out"
}

deployed_ok() { [ -z "$(kingdom_drift)" ]; }

# How many consecutive refused ticks before the mayor is mailed. Fail-open to
# 10 for the same reason cfg_minutes does, and 0 is refused for the same reason
# recover_cap refuses it: it would mail on the first refusal, before anything
# is known to persist.
#
# A tick is any call that reaches here, and BOTH timers do: dispatch every two
# minutes and the guard sweep every fifteen. So ten of them is about seventeen
# minutes of wall clock, not twenty. The refusals that heal by themselves are
# races — a merge landing between the fetch and the diff, an index lock held by
# a concurrent deploy — and they are gone on the next tick or two. The ones
# worth a letter are the parked-root shape, which never heals: 1700 of the
# retained journal's refusals name one branch (gqlc-1amz6).
deploy_escalate_cap() {
    local v
    v=$(cfg kingdom deploy_escalate_after_ticks)
    case "$v" in '' | *[!0-9]*) v=10 ;; esac
    [ "$v" -gt 0 ] || v=10
    echo "$v"
}

deploy_refusals_file() { echo "$(state_dir)/deploy-refusals"; }
deploy_escalated_marker() { echo "$(state_dir)/deploy-escalated"; }

# The episode ends the moment the deployed tree is good again, and BOTH files
# go with it — the count so the next episode starts from one, and the marker so
# the next episode can be reported at all. Leaving the marker behind is the
# failure the idle ladder measured next door: a stale one silences the channel
# permanently for an episode in which nobody was ever told.
deploy_episode_clear() { rm -f "$(deploy_refusals_file)" "$(deploy_escalated_marker)"; }

# Fail-open on a channel nobody reads is silence. Every refusal below has
# printed a WARNING to the journal since the fail-open was introduced, and over
# the retained journal 1800+ of them produced no repair — every fix came from
# someone noticing something else, the most recent costing ~2.5 hours with two
# merged km fixes sitting inert in the stale tree (gqlc-1amz6). So the Nth
# consecutive refusal mails the one citizen whose job is deciding, once.
#
# ONCE per episode. The marker records a DELIVERY and not an attempt: mail_send
# returns 0 once the body reaches the SENDER's sent box, so a send that never
# reached the inbox would otherwise write the marker and restore exactly the
# permanent silence this exists to end. Counted from andranik alone, because
# any letter landing in the window confirms a plain inbox count.
#
# andranik is the sender because a tick has no seat author, and mail_send's
# is_seat check would refuse anything but a registered seat or the crown.
deploy_refusal_escalate() { # <command name for the message> <drift> <last deploy output>
    local name=$1 drift=$2 out=$3 file marker cap count before
    file=$(deploy_refusals_file)
    marker=$(deploy_escalated_marker)
    cap=$(deploy_escalate_cap)
    # `|| true` under `set -e`: the file is absent on the first refusal of every
    # episode, which is the commonest case rather than a corner of one. Without
    # it the failing substitution takes down the tick this function exists to
    # keep running — the same rung the idle ladder died on (gqlc-w3wb).
    count=$(cat "$file" 2>/dev/null || true)
    case "$count" in '' | *[!0-9]*) count=0 ;; esac
    count=$((count + 1))
    # State this function cannot write is state it cannot count, and it must
    # still not stop the tick: fail-open applies to its own bookkeeping too.
    # ENOSPC has emptied this town's scratch before (gqlc-vze6), so a refused
    # write here is not hypothetical — and without the guard `set -e` turns it
    # into the halted dispatcher this whole path exists to avoid.
    { mkdir -p "$(dirname "$file")" && echo "$count" >"$file"; } 2>/dev/null || return 0
    [ "$count" -ge "$cap" ] || return 0
    [ ! -f "$marker" ] || return 0
    before=$(mail_unread_from sedrak andranik)
    if mail_send sedrak --from andranik \
        -s "$(deploy_root) has run stale for $count consecutive ticks" \
        -m "km has refused to deploy $(deploy_root) on $count consecutive ticks, and every one of them ran the town's machinery from that tree anyway. That is by design (gqlc-nm7w — refusing is what stopped the town once), and it is why nothing has turned red.

What the refusal says:

  ${drift//$'\n'/$'\n  '}

Last deploy attempt: ${out:-not attempted on this tick}

Nothing here has stopped. Every tick since the first refusal has run whatever machinery that tree holds, so a merged fix to km, the hooks, or .claude/ is not reaching the town — the last episode of this ran ~2.5 hours with two merged km fixes sitting inert in it.

The repair is 'km deploy' (just kingdom-deploy) in that root. If it refuses because the root is parked off master, 'km doctor' names the worktree holding the branch.

You will not be mailed about this episode again. The count and this suppression both clear on the first tick that finds the tree deployable." >/dev/null \
        && [ "$(mail_unread_from sedrak andranik)" -gt "$before" ]; then
        : >"$marker"
        echo "$name: ESCALATED to sedrak — $count consecutive ticks have run from a stale $(deploy_root); not mailing again until a deploy lands" >&2
    else
        echo "$name: ESCALATION UNDELIVERED — no new letter from andranik reached sedrak's inbox, so nothing was recorded and the next tick will try again" >&2
    fi
}

# history: kingdom/brain/km-notes.md#ensure_deployed
ensure_deployed() { # <command name for the message> [the args to hand on]
    local name=$1 drift out km
    shift
    drift=$(kingdom_drift)
    [ -n "$drift" ] || { deploy_episode_clear; return 0; }
    if [ -z "${KM_SELF_DEPLOYED:-}" ]; then
        echo "$name: DRIFT — deploying $(deploy_root) before it runs" >&2
        if out=$(cmd_deploy 2>&1); then
            printf '%s: %s\n' "$name" "${out//$'\n'/ }" >&2
            # The km executing this line is the copy the fast-forward just
            # replaced, so finishing the tick here runs exactly the stale code
            # the deploy retired — gqlc-ed2u, one level down. Hand the command
            # to the deployed copy instead.
            km="$(deploy_root)/kingdom/bin/km"
            if [ -x "$km" ]; then
                export KM_SELF_DEPLOYED=1
                exec "$km" "$name" "$@"
            fi
            deploy_episode_clear
            return 0
        fi
        drift=$(kingdom_drift)
        [ -n "$drift" ] || { deploy_episode_clear; return 0; }
        printf '%s: deploy failed: %s\n' "$name" "${out//$'\n'/ }" >&2
    fi
    {
        echo "$name: WARNING — $(deploy_root) is not origin/master and could not be deployed; running from this tree anyway:"
        echo "  ${drift//$'\n'/$'\n  '}"
        echo "$name: run 'km deploy' (just kingdom-deploy) by hand — km status and km doctor carry this too"
    } >&2
    deploy_refusal_escalate "$name" "$drift" "${out:-}"
    return 0
}

# history: kingdom/brain/km-notes.md#merge_blockers
merge_blockers() { # <root> : tracked files that are both dirty and incoming
    local root=$1 incoming dirty
    incoming=$(git_at "$root" diff --name-only HEAD origin/master 2>/dev/null) || return 1
    dirty=$(git_at "$root" diff --name-only HEAD 2>/dev/null) || return 1
    [ -n "$incoming" ] && [ -n "$dirty" ] || return 0
    comm -12 <(printf '%s\n' "$incoming" | sort -u) <(printf '%s\n' "$dirty" | sort -u)
}

set_aside_bd_exports() { # <root>
    local root=$1 blockers aside f
    blockers=$(merge_blockers "$root") || return 0
    [ -n "$blockers" ] || return 0
    printf '%s\n' "$blockers" | grep -qv '^\.beads/' && return 0
    aside="$(state_dir)/deploy-set-aside/$(date -u +%Y%m%dT%H%M%SZ)-$$"
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        mkdir -p "$aside/$(dirname "$f")"
        cp -p "$root/$f" "$aside/$f" 2>/dev/null || true
        git_at "$root" checkout HEAD -- "$f" \
            || die "deploy: could not set aside $f in $root; nothing was moved"
    done <<<"$blockers"
    echo "deploy: set aside bd's export so the fast-forward could pass: ${blockers//$'\n'/ } (copy: $aside)"
}

cmd_deploy() {
    no_args deploy "$@"
    local root blocker drift
    # The fetch and the merge reach the network and the disk from inside a
    # systemd tick; see git_at. A caller may raise or lower it.
    local KM_GIT_TIMEOUT="${KM_FETCH_TIMEOUT:-60}"
    root=$(deploy_root)
    blocker=$(deploy_blocker)
    [ -z "$blocker" ] || die "deploy: $blocker"
    git_at "$root" fetch --quiet origin master || die "deploy: cannot reach origin from $root"
    set_aside_bd_exports "$root"
    # --ff-only is still the safety argument for everything except bd's own
    # exports: git refuses to overwrite a dirty file the incoming commits
    # touch, and refuses a divergence, so no stash-and-reset dance can clobber
    # a human's uncommitted work in that tree.
    git_at "$root" merge --ff-only origin/master || die "deploy: refused to move $root; resolve the above by hand"
    drift=$(kingdom_drift)
    if [ -n "$drift" ]; then
        {
            echo "deploy: incomplete — kingdom/ still differs from origin/master:"
            echo "  ${drift//$'\n'/$'\n  '}"
        } >&2
        return 1
    fi
    echo "deployed: $root at $(git_at "$root" rev-parse --short HEAD)"
}

seat_home()   { echo "$(state_dir)/seats/$1"; }
seat_status() {
    local f
    f="$(seat_home "$1")/status"
    if [ -f "$f" ]; then cat "$f"; else echo asleep; fi
}

# ---------- herdr ----------

# Herdr owns the pane lifecycle: one workspace per town, one agent per seat.
# The socket API answers every question km used to derive from tmux + pgrep +
# pane grepping, so this section is thin wrappers, not a state machine.
# Kingdom-state (heartbeats, wake queues, mail) stays on disk as before.
#
# WORKSPACE is the herdr workspace name; the seats are agents inside it named
# by their seat id (sedrak, artur, ...). The env override is for tests.
WORKSPACE="${KM_HERDR_WORKSPACE:-$(cfg kingdom tmux_session)}"

have_herdr() { command -v herdr >/dev/null 2>&1; }
have_just()  { command -v just >/dev/null 2>&1; }

# history: kingdom/brain/km-notes.md#herdr_server_up
herdr_server_up() { # 0 running, 1 not running, 2 km could not ask
    # No herdr is a READABLE answer: there is no server. It stays on the rc-1
    # side for the same reason workspace_id keeps it on its rc-0 side — a
    # machine that simply has no herdr, CI among them, must not read `cannot
    # ask` and must not make km's callers hedge.
    have_herdr || return 1
    local out
    out=$(herdr status server 2>&1) || {
        echo "km: cannot ask herdr whether its server is running: ${out:-herdr gave no diagnosis on either stream}. Not answering 'not running', because that is a positive claim about the town this failure does not support." >&2
        return 2
    }
    printf '%s\n' "$out" | grep -q '^status: running$'
}

# history: kingdom/brain/km-notes.md#workspace_id

# The workspace exists as long as the town has been raised at least once and
# not torn down. Lookup by label; herdr assigns numeric IDs we don't hold.
workspace_id() { # -> id on stdout; rc 0 + empty = absent, rc 1 = unreadable
    # No herdr is a readable answer, not an unreadable one — there is no
    # workspace. It has to stay on the rc-0 side or every seat reads
    # `unreadable` (below) on a machine that simply has no herdr, such as CI.
    have_herdr || { echo ""; return 0; }
    local out
    out=$(herdr workspace list |
        python3 -c "import json,sys; d=json.load(sys.stdin); print(next((w['workspace_id'] for w in d['result']['workspaces'] if w['label']==sys.argv[1]),''))" "$WORKSPACE" 2>/dev/null) || {
        echo "km: cannot read the workspace list from herdr. If herdr wrote a reason above this line, that is the cause. If it wrote nothing, herdr answered and its payload no longer carries result.workspaces[].workspace_id/label. Not answering 'absent', because absent authorizes creating a second workspace under this label." >&2
        return 1
    }
    printf '%s\n' "$out"
}

# The two "cannot tell" answers are kept apart rather than merged into one,
# because the sentence a caller prints names which read failed, and pointing an
# operator at the workspace list when it was the server socket sends them to the
# wrong place. Callers pass this rc straight to town_absent_reason.
session_up() { # 0 up; 1 down; 2 the list did not parse; 3 could not ask herdr
    local srv=0
    herdr_server_up || srv=$?
    # `if` blocks rather than `[ ... ] && return`: an AND-OR list whose test
    # fails is a failing statement, and km runs `set -e`.
    if [ "$srv" -eq 2 ]; then return 3; fi
    if [ "$srv" -ne 0 ]; then return 1; fi
    local ws
    # The rc, not the emptiness. `[ -n "$(workspace_id)" ]` stood here and read
    # an unreadable workspace list as "no workspace", so every caller below
    # printed "the town is down" — a positive claim km cannot support — and
    # cmd_reconcile skipped a whole pass while the town was in fact up
    # (gqlc-ygcfi, residue of gqlc-cp40).
    ws=$(workspace_id) || return 2
    [ -n "$ws" ]
}

# The sentence a caller prints when session_up said no. Neither 2 nor 3 is
# "down": one is a workspace list that did not parse, the other a server km
# could not ask, and in both cases km does not know which it is. The failing
# read has already put its own diagnosis on stderr immediately above, which is
# why these point at it rather than restating it.
town_absent_reason() { # <session_up rc> [wording for the plain down case]
    case "${1:-1}" in
        2) printf '%s' "km cannot tell whether the town is up — the herdr workspace list did not parse (diagnosis above)" ;;
        3) printf '%s' "km cannot tell whether the town is up — it could not ask herdr whether its server is running (diagnosis above)" ;;
        *) printf '%s' "${2:-the town is down}" ;;
    esac
}

# The seat's tab exists inside the workspace. Herdr tabs carry a label; the
# label IS the seat name. Returns tab_id on stdout.
seat_tab_id() { # <seat> -> tab_id on stdout; rc 0 + empty = absent, rc 1 = unreadable
    local ws out
    ws=$(workspace_id) || return 1
    # A readably-absent workspace holds no tabs, so this is an absent tab and
    # not an unreadable one. `km up` creates the workspace and the tabs in one
    # pass, and seat_runner_start's caller has already refused on the empty ws.
    [ -n "$ws" ] || { echo ""; return 0; }
    out=$(herdr tab list --workspace "$ws" |
        python3 -c "import json,sys; d=json.load(sys.stdin); print(next((t['tab_id'] for t in d['result']['tabs'] if t.get('label','')==sys.argv[1]),''))" "$1" 2>/dev/null) || {
        echo "km: seat $1: cannot read the tab list from herdr (workspace $ws). If herdr wrote a reason above this line, that is the cause. If it wrote nothing, herdr answered and its payload no longer carries result.tabs[].tab_id/label. Not answering 'absent', because absent authorizes creating a tab." >&2
        return 1
    }
    printf '%s\n' "$out"
}

# The seat's primary pane inside its tab. One pane per tab in this town; if
# splits ever get introduced, this returns the first.
seat_pane_id() { # <seat> -> pane_id on stdout; rc 0 + empty = absent, rc 1 = unreadable
    local tab ws out
    tab=$(seat_tab_id "$1") || return 1
    # No tab is an absent pane, which is the state seat_runner_start is about
    # to fix by creating the tab — not a read that failed.
    [ -n "$tab" ] || { echo ""; return 0; }
    ws=$(workspace_id) || return 1
    out=$(herdr pane list --workspace "$ws" |
        python3 -c "import json,sys; d=json.load(sys.stdin); print(next((p['pane_id'] for p in d['result']['panes'] if p.get('tab_id')==sys.argv[1]),''))" "$tab" 2>/dev/null) || {
        echo "km: seat $1: cannot read the pane list from herdr (workspace $ws, tab $tab). If herdr wrote a reason above this line, that is the cause. If it wrote nothing, herdr answered and its payload no longer carries result.panes[].pane_id/tab_id." >&2
        return 1
    }
    printf '%s\n' "$out"
}

window_up() { # kept as a name for callers; asks "does the seat's tab exist?"
    [ -n "$(seat_tab_id "$1")" ]
}

# history: kingdom/brain/km-notes.md#seat_agent_status
seat_agent_status() { # <seat> -> idle|working|blocked|done|unknown|unreadable
    local pane status
    # The same direction as the pane-get read below, for the same reason: a
    # pane id we could not look up is not a seat with no session. This arm
    # answered `unknown` until 2026-08-29, so the paragraph above ("unreadable
    # reads live") held only when the unreadable payload was pane-get's — an
    # unreadable tab or pane LIST reached the callers as a false dead, which is
    # the error that ends a citizen's session under her (bd gqlc-cp40).
    pane=$(seat_pane_id "$1") || {
        echo "km: seat $1: no pane id could be resolved, so km cannot tell whether a session is running. Treating the seat as occupied." >&2
        echo unreadable
        return 0
    }
    # An absent pane is not an unreadable one: there is no session because
    # there is nowhere for one to be, and seat_runner_start makes the pane.
    [ -n "$pane" ] || { echo unknown; return 0; }
    status=$(herdr pane get "$pane" |
        python3 -c "import json,sys; print(json.load(sys.stdin)['result']['pane']['agent_status'])" 2>/dev/null) || {
        echo "km: seat $1: cannot read agent_status from herdr (pane $pane). If herdr wrote a reason above this line, that is the cause. If it wrote nothing, herdr answered and its payload no longer carries result.pane.agent_status. Treating the seat as occupied." >&2
        echo unreadable
        return 0
    }
    echo "$status"
}

# history: kingdom/brain/km-notes.md#seat_session_live
seat_session_live() {
    case "$(seat_agent_status "$1")" in
        unknown) return 1 ;;
        *) return 0 ;;
    esac
}

# history: kingdom/brain/km-notes.md#seat_runner_live
seat_runner_live() { # <seat>
    pgrep -f "/km-seat[[:space:]]+$1([[:space:]]|\$)" >/dev/null 2>&1
}

# history: kingdom/brain/km-notes.md#seat_wake_queue_age
seat_wake_queue_age() { # <seat> -> seconds since mtime, or empty
    local f
    f="$(seat_home "$1")/wake"
    [ -f "$f" ] || return 0
    printf '%d' $(( $(date +%s) - $(stat -c %Y "$f") ))
}

# history: kingdom/brain/km-notes.md#seat_launch_probe
seat_launch_probe() { # <worktree> <want-model> <want-effort> <want-permission-mode> -> "<code>\t<detail>"
    KM_LAUNCH_WT=$1 KM_LAUNCH_MODEL=$2 KM_LAUNCH_EFFORT=$3 KM_LAUNCH_PM=$4 python3 -c '
import os, sys

wt      = os.path.realpath(os.environ["KM_LAUNCH_WT"])
model   = os.environ["KM_LAUNCH_MODEL"]
effort  = os.environ["KM_LAUNCH_EFFORT"]
pm      = os.environ["KM_LAUNCH_PM"]
LEVELS  = ("low", "medium", "high", "xhigh", "max")

def argv_of(pid):
    with open("/proc/%s/cmdline" % pid, "rb") as f:
        raw = f.read()
    parts = raw.split(b"\0")
    if parts and parts[-1] == b"":
        parts.pop()
    return [p.decode("utf-8", "replace") for p in parts]

def ppid_of(pid):
    # Field 4 of stat. comm sits in parens and may itself contain one, so the
    # split starts after the LAST close paren.
    with open("/proc/%s/stat" % pid) as f:
        return f.read().rpartition(")")[2].split()[1]

found = []
try:
    pids = [d for d in os.listdir("/proc") if d.isdigit()]
except OSError as e:
    print("?\tthe process table could not be read (%s), so no seat could be judged" % e)
    sys.exit(0)
for pid in pids:
    try:
        exe = os.path.basename(os.readlink("/proc/%s/exe" % pid))
        argv = argv_of(pid)
        if exe != "claude" and (not argv or os.path.basename(argv[0]) != "claude"):
            continue
        if os.path.realpath(os.readlink("/proc/%s/cwd" % pid)) != wt:
            continue
        ppid = ppid_of(pid)
    except OSError:
        continue          # it exited, or is not ours to read; not this seat s answer
    found.append((pid, ppid, argv))

if not found:
    # FAIL LOUD. gqlc-jvlu is one line long: a lookup that cannot read its input
    # must not answer with the value that means fine. The caller has already
    # established that herdr reports a live agent in this pane, so an absent
    # process is a contradiction, not an idle seat.
    print("?\therdr reports a live agent in this pane but no claude process runs in %s, so nothing could be compared" % wt)
    sys.exit(0)
cand = set(pid for pid, _, _ in found)
roots = []
for pid, ppid, argv in found:
    cur, descends = ppid, False
    for _ in range(64):
        if cur in cand:
            descends = True
            break
        if cur in ("0", "1"):
            break
        try:
            cur = ppid_of(cur)
        except OSError:
            break     # the parent exited mid-walk; this one stays a root
    if not descends:
        roots.append((pid, argv))

if len(roots) != 1:
    # Named rather than resolved by picking one. Two INDEPENDENT claudes in one
    # worktree is the two-live-turns-on-one-tree hazard and deserves the alarm;
    # guessing between them would let a conforming stray vouch for a
    # mis-launched citizen.
    print("?\t%d claude processes run in %s, %d of them descended from no other (pids %s); which one is the seat is not something this can decide"
          % (len(found), wt, len(roots), ", ".join(p for p, _ in roots) or "none"))
    sys.exit(0)

argv = roots[0][1]

def flag(name):
    """The value of --name, as a space pair or --name=value. None if absent."""
    for i, a in enumerate(argv):
        if a == name:
            return argv[i + 1] if i + 1 < len(argv) else ""
        if a.startswith(name + "="):
            return a[len(name) + 1:]
    return None

codes, says = [], []

got = flag("--permission-mode")
if got is None:
    codes.append("P"); says.append("no --permission-mode (want %s), so it prompts and waits for somebody at the pane" % pm)
elif got != pm:
    codes.append("P"); says.append("--permission-mode %s, want %s" % (got or "<empty>", pm))

got = flag("--append-system-prompt")
if got is None:
    codes.append("S"); says.append("no --append-system-prompt, so this citizen is running with no soul")
elif not got.strip():
    codes.append("S"); says.append("--append-system-prompt is empty, so this citizen is running with no soul")

got = flag("--model")
if got is None:
    codes.append("M"); says.append("no --model (want %s), so it runs on whatever claude defaults to" % model)
elif got != model:
    codes.append("M"); says.append("--model %s, want %s" % (got or "<empty>", model))

# history: kingdom/brain/km-notes.md#seat_launch_probe-2
got = flag("--effort")
if effort in LEVELS:
    if got is None:
        codes.append("E"); says.append("no --effort (the class default is %s)" % effort)
    elif got not in LEVELS:
        codes.append("E"); says.append("--effort %s is not a level claude takes" % (got or "<empty>"))

print("%s\t%s" % ("".join(codes) if codes else "ok", "; ".join(says)))
'
}

# The per-seat verdict, with the expectations resolved from kingdom.toml — the
# same file km-seat reads at launch, so this compares the process against the
# town s own configuration and not against a value spelled twice.
#
# A seat with NO live agent is `-` and never a failure: it is asleep, which is
# legal, and conflating absent with wrong is exactly what gqlc-jvlu was.
seat_launch_state() { # <seat> -> "<code>\t<detail>"
    local pm
    seat_session_live "$1" || { printf -- '-\t\n'; return 0; }
    pm=$(cfg claude permission_mode)
    # km-seat's own default when the key is missing, read here rather than
    # spelled a second time to differ from it later (km-seat:24-25).
    : "${pm:=bypassPermissions}"
    seat_launch_probe "$(seat_worktree "$1")" "$(seat_model "$1")" "$(cfg effort "$(seat_class "$1")")" "$pm"
}

# history: kingdom/brain/km-notes.md#seat_runner_start
seat_runner_start() { # <seat> -> 0 started, 1 declined (live session), 2 no runner appeared
    seat_session_live "$1" && return 1
    local ws pane tab wt sd waited
    ws=$(workspace_id); [ -n "$ws" ] || return 2
    wt=$(seat_worktree "$1")
    # The rc, not the emptiness. `[ -z "$(seat_tab_id "$1")" ]` stood here and
    # read an unreadable tab list as "this seat has no tab", so a herdr shape
    # change would have minted one tab per seat on every wake, reconcile and
    # dispatch pass, unbounded, with the parse's diagnosis eaten (gqlc-cp40).
    tab=$(seat_tab_id "$1") || return 2
    if [ -z "$tab" ]; then
        herdr tab create --workspace "$ws" --label "$1" --cwd "$wt" --no-focus >/dev/null 2>&1 || return 2
    fi
    pane=$(seat_pane_id "$1"); [ -n "$pane" ] || return 2
    # Thread km's KM_STATE_DIR into the pane's env so km-seat agrees with km
    # about which state to work with. Without this, km-seat re-derives it from
    # the pane's cwd (a seat worktree → main_root → the shared kingdom-state)
    # and diverges from a test override, which reproduces the 2026-08-29
    # incident where a test workspace's km-seats claimed real wakes.
    sd=$(state_dir)
    herdr pane run "$pane" "KM_STATE_DIR=$sd $SCRIPT_DIR/km-seat $1" >/dev/null 2>&1 || return 2
    waited=0
    while [ "$waited" -lt 15 ]; do
        seat_runner_live "$1" && return 0
        sleep 0.2
        waited=$((waited + 1))
    done
    echo "km: $1: herdr accepted the km-seat command line for pane $pane, but no km-seat process appeared within 3s. The pane's foreground is something other than a shell, so it read those bytes instead — a claude started by hand is the known case, and it is invisible to agent_status, so the live-session guard could not decline. Read the pane and start the runner there (bd gqlc-c48e)." >&2
    return 2
}

# history: kingdom/brain/km-notes.md#seat_box_text
seat_box_text() { # <pane> -> 0 read it, 1 the buffer holds no box, 2 unreadable
    local buf
    buf=$(herdr pane read "$1" --source visible --lines 60 2>&1) || {
        echo "km: cannot read pane $1: ${buf:-herdr gave no diagnosis on either stream}" >&2
        return 2
    }
    # history: kingdom/brain/km-notes.md#seat_box_text-2
    printf '%s\n' "$buf" | awk '
        {
            line[NR] = $0
            probe = $0
            dashes = gsub(/─/, "-", probe)
            if (dashes > 0 && probe ~ /^-+( .* -+)?$/) {
                cand[++m] = NR
                wide[m] = dashes
                if (dashes > w) w = dashes
            }
        }
        END {
            for (j = 1; j <= m; j++) if (wide[j] * 2 >= w) edge[++n] = cand[j]
            if (n < 2) exit 1
            for (i = edge[n - 1] + 1; i < edge[n]; i++) {
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", line[i])
                if (line[i] != "" && line[i] != "❯" && line[i] != ">") print line[i]
            }
        }'
}

# history: kingdom/brain/km-notes.md#seat_wedge_reason
seat_wedge_reason() { # <seat> -> consent | limit | unknown | unreadable | no-pane
    local pane buf
    pane=$(seat_pane_id "$1" 2>/dev/null) || { echo unreadable; return 0; }
    [ -n "$pane" ] || { echo no-pane; return 0; }
    buf=$(herdr pane read "$pane" --source visible --lines 60 2>/dev/null) || {
        echo unreadable
        return 0
    }
    # history: kingdom/brain/km-notes.md#seat_wedge_reason-2
    printf '%s\n' "$buf" | awk '
        index($0, "hit your limit") { hit = NR }
        index($0, "/extra-usage") { xtr = NR }
        index($0, "Do you want to") { ask = NR }
        /^[[:space:]]*[>❯]?[[:space:]]*[0-9]+\.[[:space:]]/ { opt = NR }
        END {
            if (hit && xtr) lim = (hit > xtr ? hit : xtr)
            if (ask && opt) con = (ask > opt ? ask : opt)
            if (con && con > lim) { print "consent"; exit }
            if (lim) { print "limit"; exit }
            print "unknown"
        }'
}

# Both directions of this settle by the second read, 3 of 3 trials, so ten reads
# is roughly a tenfold margin (bd gqlc-gh7xj). The sleep is the poll interval.
# It is ordered first because typing takes those same two reads to appear, so a
# read taken immediately could find the box empty merely because nothing had
# rendered yet — but that is a cheap guard, not a measured necessity: deleting
# the sleep outright did not produce a false empty on the same rows, the pane
# read's own round trip being slower than the render.
seat_box_emptied() { # <pane> -> 0 emptied, 1 holds text, 2 no box, 3 unreadable
    local left=10 box rc=2
    while [ "$left" -gt 0 ]; do
        left=$((left - 1))
        sleep 0.2
        # `|| rc=$?` rather than a bare call and `rc=$?`. km runs `set -e`, and
        # -e is suspended only for the dynamic extent of a function evaluated in
        # a condition. A bare `box=$(...)` here is a statement, so a pane that
        # cannot be read ends the shell inside the first turn and the poll's
        # other nine never happen — the mechanism would work only for callers
        # who happened to write `if`. Same at the two reads in send_line and at
        # cmd_reconcile's session_up (bd gqlc-nvbd3).
        rc=0
        box=$(seat_box_text "$1") || rc=$?
        # An unreadable pane is not a state the poll can outwait, and every turn
        # would re-emit herdr's account of it. Nine more reads and two more
        # seconds buy nothing, so the first one ends the poll.
        if [ "$rc" -eq 2 ]; then return 3; fi
        [ "$rc" -eq 0 ] || continue
        [ -n "$box" ] || return 0
    done
    [ "$rc" -eq 0 ] && return 1
    return 2
}

# history: kingdom/brain/km-notes.md#box_one_line
box_one_line() { # <box text> -> one line, prompt glyph dropped, whitespace collapsed
    printf '%s' "$1" | sed -e 's/\xc2\xa0/ /g' | tr '\n\t' '  ' |
        sed -e 's/^ *❯ *//' -e 's/^ *> *//' -e 's/  */ /g' -e 's/^ //' -e 's/ *$//'
}

# history: kingdom/brain/km-notes.md#seat_box_echoes
seat_box_echoes() { # <pane> <text> -> 0 holds it, 1 holds something else, 2 no box, 3 unreadable
    local left=10 box rc=2 want
    want=$(box_one_line "$2")
    while [ "$left" -gt 0 ]; do
        left=$((left - 1))
        sleep 0.2
        # `|| rc=$?` and not a bare call: it suspends `set -e` for the
        # substitution, so a no-box read is a verdict this loop records rather
        # than an exit status that unwinds whichever caller happens not to be
        # inside a condition.
        rc=0
        box=$(seat_box_text "$1") || rc=$?
        # Unreadable ends the poll on the FIRST read, as seat_box_emptied's does
        # and for the same reason: it is not a state ten more reads can outwait,
        # and each turn re-emits herdr's account of it on stderr. Collapsing it
        # into the no-box arm also spent two seconds to reach a verdict that
        # named the wrong observation (bd gqlc-3e4m5, F2/I2).
        if [ "$rc" -eq 2 ]; then return 3; fi
        [ "$rc" -eq 0 ] || continue
        case "$(box_one_line "$box")" in *"$want"*) return 0 ;; esac
    done
    [ "$rc" -eq 0 ] && return 1
    return 2
}

# history: kingdom/brain/km-notes.md#km_authored_text
km_authored_text() { # <text> -> 0 km could have typed this, 1 nothing in km types it
    case $1 in
        '/exit' | '[km] '*) return 0 ;;
    esac
    return 1
}

# history: kingdom/brain/km-notes.md#send_line
send_line() { # <target> <text> -> 0 delivered, 1 not
    local target=$1 text=$2 seat pane out witnessed box boxrc echoed
    seat=${target##*:}
    # Before the pane is resolved: this is about km's own text, not the seat.
    if ! km_authored_text "$text"; then
        echo "km: send to $seat: refusing to type \"$text\" — every string km types into a citizen's composer is either /exit or carries the '[km] ' prefix, and that shape is the only thing that lets a string later found stranded in a box be attributed to km or ruled out (gqlc-cj7hp). Give the ask the prefix" >&2
        return 1
    fi
    pane=$(seat_pane_id "$seat") || pane=
    if [ -z "$pane" ]; then
        echo "km: send to $seat: no pane in the workspace; nothing was sent" >&2
        return 1
    fi
    if ! seat_prompt_visible "$seat"; then
        echo "km: send to $seat: agent_status is $(seat_agent_status "$seat"), so the Enter would answer a modal nobody read; nothing was sent" >&2
        return 1
    fi
    # Two refusals, not one. Saying "renders no input box" on a pane km never
    # read swears to an observation nobody made, and these sentences are quoted
    # verbatim into escalation letters (bd gqlc-3e4m5, F2/I1). rc=2 is herdr
    # failing to read the pane at all — its own account is already on stderr
    # above; rc=1 is a pane that rendered and had no box in it.
    boxrc=0
    box=$(seat_box_text "$pane") || boxrc=$?
    if [ "$boxrc" -eq 2 ]; then
        echo "km: send to $seat (pane $pane): the pane could not be read (herdr's own account of it is above), so whether it holds an input box is unknown and the Enter would be pressed blind; nothing was sent (VI.2, bd gqlc-3evsn)" >&2
        return 1
    fi
    if [ "$boxrc" -ne 0 ]; then
        echo "km: send to $seat (pane $pane): the pane renders no input box, so this text has nowhere to land and the Enter would press whatever that surface does answer; nothing was sent (VI.2, bd gqlc-3evsn)" >&2
        return 1
    fi
    if [ -n "$box" ]; then
        echo "km: send to $seat (pane $pane): the input box already holds text, and typing appends, so this would be pasted onto the end of a citizen's draft and submitted as one message; nothing was sent and the draft is untouched (bd gqlc-6bnkw)" >&2
        return 1
    fi
    out=$(herdr agent send "$pane" "$text" 2>&1) || {
        echo "km: send to $seat (pane $pane) failed: ${out:-herdr gave no diagnosis on either stream}" >&2
        return 1
    }
    # history: kingdom/brain/km-notes.md#send_line-2
    witnessed=0
    seat_box_echoes "$pane" "$text" || witnessed=$?
    if [ "$witnessed" -ne 0 ]; then
        if [ "$witnessed" -eq 3 ]; then
            echo "km: send to $seat (pane $pane): the text was typed, but the pane could not be read back (herdr's own account of it is above), so whether it landed is unknown; no Enter was pressed. The typed text may be sitting there unsent — read the pane (VI.2, bd gqlc-3evsn)" >&2
        elif [ "$witnessed" -eq 2 ]; then
            echo "km: send to $seat (pane $pane): the box was empty when this was checked and the pane renders none at all now, so something covered the composer mid-send; no Enter was pressed. The typed text may be sitting under it — read the pane (VI.2, bd gqlc-3evsn)" >&2
        else
            echo "km: send to $seat (pane $pane): herdr acked the text but the box does not hold it, so it did not land where the Enter would submit it; no Enter was pressed. Read the pane before sending again (bd gqlc-3evsn)" >&2
        fi
        return 1
    fi
    out=$(herdr pane send-keys "$pane" Enter 2>&1) || {
        echo "km: send to $seat (pane $pane): the text was typed, but the Enter that submits it failed: ${out:-herdr gave no diagnosis on either stream}. It is sitting unsent in her prompt box" >&2
        return 1
    }
    witnessed=0
    seat_box_emptied "$pane" || witnessed=$?
    [ "$witnessed" -eq 0 ] && return 0
    if [ "$witnessed" -eq 2 ]; then
        echo "km: send to $seat (pane $pane): herdr acked the text and the Enter, but the pane renders no input box, so the submission was not witnessed and is being reported as delivered (bd gqlc-gh7xj)" >&2
        return 0
    fi
    # history: kingdom/brain/km-notes.md#send_line-3
    if [ "$witnessed" -eq 3 ]; then
        echo "km: send to $seat (pane $pane): herdr acked the text and the Enter, but the pane could not be read back (herdr's own account of it is above), so the submission was not witnessed and is being reported as delivered" >&2
        return 0
    fi
    herdr pane send-keys "$pane" Enter >/dev/null 2>&1
    witnessed=0
    seat_box_emptied "$pane" || witnessed=$?
    if [ "$witnessed" -eq 3 ]; then
        echo "km: send to $seat (pane $pane): herdr acked the text and both Enters, but the pane could not be read back (herdr's own account of it is above), so the submission was not witnessed and is being reported as delivered" >&2
        return 0
    fi
    [ "$witnessed" -eq 1 ] || return 0
    # seat_box_emptied establishes ONE thing: the box is not empty. It never
    # compares what is in it against $text. Reporting that as "the box still
    # holds the message" swore to an observation nobody made, and it was false
    # in the case that found this: a five-character /exit that HAD been
    # submitted, read back seconds later with an empty box and the seat mid-turn
    # (bd gqlc-hrft2). So ask the question the sentence was already answering.
    #
    # A box that does not hold $text means $text LEFT it, and typing appends —
    # nothing km does replaces a composer's contents — so the only way out is
    # submission. That is the same inference the rc 2 and rc 3 arms above make
    # from a weaker premise, and it is why this arm reports delivered.
    #
    # Costs one more poll (measured 2106 ms to exhaust, 4 ms of it the pane
    # read; the rest is the interval) and only on this path, which is the one
    # that was about to declare a failure and send the caller to do by hand a
    # thing that had already happened.
    echoed=0
    seat_box_echoes "$pane" "$text" || echoed=$?
    if [ "$echoed" -ne 0 ]; then
        echo "km: send to $seat (pane $pane): herdr acked the text and both Enters, and the box is not empty — but what it holds is NOT this message, so this text did leave the composer and the submission is being reported as delivered. Something else has been typed there since; read the pane before sending again, because the next send will be refused while it sits there (bd gqlc-6bnkw, gqlc-hrft2)" >&2
        return 0
    fi
    # Only now is "it was typed and never submitted" an observation. gqlc-gh7xj
    # is named ONLY when the text could actually have tripped it: the threshold
    # is a property of the burst km sent, so it is knowable here and does not
    # have to be guessed. Naming it unconditionally is what made the /exit
    # report read as a diagnosis rather than the guess it was, and a message
    # that names the wrong cause is worse than one that says it does not know.
    if [ "${#text}" -ge 64 ]; then
        echo "km: send to $seat (pane $pane): herdr acked the text and both Enters, but the box still holds THIS message, so it was typed and never submitted — it is ${#text} characters, at or over the 64 at which claude reads a single burst as a paste and renders its trailing CR as a literal newline (bd gqlc-gh7xj). Nothing was delivered" >&2
    else
        echo "km: send to $seat (pane $pane): herdr acked the text and both Enters, but the box still holds THIS message, so it was typed and never submitted. km does not know why: at ${#text} characters this is under the 64-character paste threshold, so gqlc-gh7xj does not explain it (bd gqlc-hrft2). Nothing was delivered" >&2
    fi
    return 1
}

# Kept as a query name for callers that want to render the pane to a human.
# Under herdr the pane's visible buffer is what the operator sees in the TUI.
seat_pane() { # <seat> -> the pane's visible buffer
    local pane
    pane=$(seat_pane_id "$1") || return 1
    [ -n "$pane" ] || return 1
    herdr pane read "$pane" --source visible --lines 40 2>/dev/null
}

# history: kingdom/brain/km-notes.md#seat_pane_idle
seat_pane_idle() { # <seat>
    case "$(seat_agent_status "$1")" in
        idle | done) return 0 ;;
        *) return 1 ;;
    esac
}

# history: kingdom/brain/km-notes.md#seat_box_state
seat_box_state() { # <seat> -> none | km | foreign, on stdout
    local pane box
    pane=$(seat_pane_id "$1") || { echo none; return 0; }
    [ -n "$pane" ] || { echo none; return 0; }
    box=$(seat_box_text "$pane" 2>/dev/null) || { echo none; return 0; }
    box=$(box_one_line "$box")
    [ -n "$box" ] || { echo none; return 0; }
    if km_authored_text "$box"; then echo km; else echo foreign; fi
}

# history: kingdom/brain/km-notes.md#seat_prompt_visible
seat_prompt_visible() { # <seat>
    case "$(seat_agent_status "$1")" in
        idle | working | done) return 0 ;;
        *) return 1 ;;
    esac
}

# Under tmux, "did the nudge land" required scraping the prompt buffer for the
# typed text, because a tty burst could strand it half-typed with nothing but
# the buffer to say so. send_line reports a stranded send itself now — by
# scraping that same buffer, its Enter half having been the thing that could
# strand one (bd gqlc-gh7xj) — so this is kept as an alias that always answers
# "no, nothing stranded", and callers whose logic was "if the nudge was
# stranded, requeue" take the delivered branch.
seat_prompt_holds_nudge() { return 1; }

# Send + confirm was the tty-workaround shape. The confirmation lives inside
# send_line now: it types, submits, and says which of the two failed. This is a
# naming wrapper over that and nothing more.
seat_nudge() { # <seat> <text> -> 0 delivered, 1 refused
    send_line "$1" "$2"
}

# Minutes from the config, in seconds, with a default that survives a missing or
# malformed value. Fail-open and quiet is right for these two: both govern a
# REPORT and neither ends a session, so the worst a wrong value does is print a
# marker early or late, and a config typo that stopped the dispatcher would be
# the larger failure by far.
cfg_minutes() { # <section> <key> <default minutes> -> seconds
    local v
    v=$(cfg "$1" "$2")
    case "$v" in '' | *[!0-9]*) v=$3 ;; esac
    echo $((v * 60))
}

# How many times the idle pass asks ONE seat in a single episode before it stops
# typing and mails sedrak instead. Fail-open to 3 for the same reason cfg_minutes
# does. A cap of 0 escalates before ever asking, and the digit guard does not
# refuse it: `00` is all digits, so it reaches the comparison below, which is what
# catches it.
recover_cap() {
    local v
    v=$(cfg welfare recover_attempts)
    case "$v" in '' | *[!0-9]*) v=3 ;; esac
    [ "$v" -gt 0 ] || v=3
    echo "$v"
}

# history: kingdom/brain/km-notes.md#seat_can_report
seat_can_report() { # <seat> -> 1 if its checkout cannot write a heartbeat
    local wt
    wt=$(seat_worktree "$1")
    [ -d "$wt" ] || return 1
    [ -f "$wt/kingdom/bin/km-statusline" ] || return 1
    grep -qs '"statusLine"' "$wt/.claude/settings.json" "$wt/.claude/settings.local.json"
}

# Seconds since the statusLine hook last wrote this seat's heartbeat, from the
# file's own `updated` field rather than its mtime — the field is what the
# writer states, and a copied or restored state dir would give an mtime that
# means nothing. rc 1 for "unknown", which every caller must render as unknown
# and not as zero.
heartbeat_age() { # <seat> -> seconds
    local f t now
    f="$(seat_home "$1")/heartbeat.json"
    [ -f "$f" ] || return 1
    t=$(jq -r '.updated // empty' "$f" 2>/dev/null) || return 1
    [ -n "$t" ] || return 1
    t=$(date -u -d "$t" +%s 2>/dev/null) || return 1
    now=$(date +%s)
    echo $((now - t))
}

# history: kingdom/brain/km-notes.md#progress_field
progress_field() { # <seat> <jq field> -> value on stdout, rc 1 if unreadable
    local f v
    f="$(seat_home "$1")/progress.json"
    [ -f "$f" ] || return 1
    v=$(jq -r "$2 // empty" "$f" 2>/dev/null) || return 1
    [ -n "$v" ] || return 1
    printf '%s\n' "$v"
}

# Seconds since a stamp field in progress.json. rc 1 for unknown, never 0 — a
# zero would be the most reassuring possible rendering of a file nobody can read,
# which is the lesson the HB column already had to be taught (gqlc-eier).
progress_age() { # <seat> <.last_start|.last_progress> -> seconds
    local t now
    t=$(progress_field "$1" "$2") || return 1
    t=$(date -u -d "$t" +%s 2>/dev/null) || return 1
    now=$(date +%s)
    echo $((now - t))
}

# Is a tool call in flight? Timestamps decide it, not the started/completed
# counters the witness also keeps: a start strictly LATER than the newest finish
# is exactly "something began and has not come back". The counters are there for
# a human reading the file and are deliberately not the test — a lost increment
# (a killed hook, a hand edit) would wedge the reading permanently, where a stamp
# comparison self-heals at the seat's next tool call.
seat_tool_in_flight() { # <seat> -> 0 if a tool call started and has not finished
    local s p
    s=$(progress_age "$1" .last_start) || return 1
    p=$(progress_age "$1" .last_progress) || return 0 # started, never finished
    [ "$s" -lt "$p" ]
}

# history: kingdom/brain/km-notes.md#seat_dry_age
seat_dry_age() { # <seat> -> seconds since the progress witness last moved
    if seat_tool_in_flight "$1"; then
        progress_age "$1" .last_start
    else
        progress_age "$1" .last_progress
    fi
}

# history: kingdom/brain/km-notes.md#seat_can_witness
seat_can_witness() { # <seat> -> 1 if its checkout cannot write a progress witness
    local wt
    wt=$(seat_worktree "$1")
    [ -d "$wt" ] || return 1
    [ -f "$wt/.githooks/claude-tool-witness" ] || return 1
    grep -qs 'claude-tool-witness' "$wt/.claude/settings.json" "$wt/.claude/settings.local.json"
}

# ---------- mail ----------

# history: kingdom/brain/km-notes.md#mail_box_count
mail_box_count() {
    local d n
    d="$(state_dir)/mail/$1/$2"
    [ -d "$d" ] || { echo 0; return 0; }
    if ! n=$(find "$d" -type f -name '*.md' 2>/dev/null | wc -l); then
        echo "km: WARNING — $d could not be walked in full, so $n is a floor and not a total" >&2
    fi
    echo "$n"
}

# A letter leaves inbox/ in exactly ONE way: mail_read's final `mv`. So this
# number means "unread" only for a reader who drains the box with `km mail read`
# — which every SEAT does, because a seat is a process running that subcommand.
# It means nothing of the kind for the king, and cmd_status says so rather than
# printing the same word over both (gqlc-2abx).
unread_count() {
    mail_box_count "$1" inbox
}

# history: kingdom/brain/km-notes.md#mail_unread_from
mail_unread_from() { # <recipient> <sender> -> count
    local d
    d="$(state_dir)/mail/$1/inbox"
    [ -d "$d" ] || { echo 0; return 0; }
    find "$d" -maxdepth 1 -type f -name "*--$2--*.md" 2>/dev/null | wc -l
}

mail_deliver() { # write one message file into a recipient's box dir
    local dir=$1 fname=$2 content=$3 tmp
    mkdir -p "$dir"
    tmp=$(mktemp "$dir/.tmp.XXXXXX")
    printf '%s' "$content" >"$tmp"
    if [ -e "$dir/$fname" ]; then
        fname="${fname%.md}-$RANDOM.md"
    fi
    mv "$tmp" "$dir/$fname"
}

mail_send() {
    local to="" subj="" body="" from=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -s) subj=$2; shift 2 ;;
            -m) body=$2; shift 2 ;;
            --from) from=$2; shift 2 ;;
            -*) die "mail send: unknown flag $1" ;;
            *) [ -z "$to" ] || die "mail send: one recipient per message (use 'town' to broadcast)"
               to=${1%/}; shift ;;
        esac
    done
    [ -n "$from" ] || { require_identity "mail send"; from=$KINGDOM_SEAT; }
    [ -n "$to" ] || die "mail send: no recipient"
    [ -n "$subj" ] || die "mail send: -s SUBJECT is required"
    case "$from" in andranik) ;; *) is_seat "$from" || die "mail send: unknown sender $from" ;; esac
    case "$to" in town | andranik) ;; *) is_seat "$to" || die "mail send: unknown recipient $to" ;; esac
    if [ -z "$body" ]; then
        [ ! -t 0 ] || die "mail send: body via -m or stdin"
        body=$(cat)
    fi

    local ts slug fname content sd
    ts=$(date -u +%Y%m%dT%H%M%SZ)
    slug=$(printf '%s' "$subj" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')
    slug=$(printf '%s' "$slug" | sed 's/^-*//; s/-*$//' | cut -c1-40)
    [ -n "$slug" ] || slug=msg
    fname="$ts--$from--$slug.md"
    content=$(printf -- '---\nfrom: %s\nto: %s\ndate: %s\nsubject: %s\n---\n%s\n' \
        "$from" "$to" "$(date -u -Iseconds)" "$subj" "$body")
    sd=$(state_dir)

    local delivered=0 r
    if [ "$to" = town ]; then
        for r in $(seats_all) andranik; do
            [ "$r" = "$from" ] && continue
            mail_deliver "$sd/mail/$r/inbox" "$fname" "$content"
            delivered=$((delivered + 1))
        done
    else
        mail_deliver "$sd/mail/$to/inbox" "$fname" "$content"
        delivered=1
    fi
    mail_deliver "$sd/mail/$from/sent" "$fname" "$content"
    echo "mail: $from → $to ($delivered box(es)): $subj"
}

# The --seat override, or empty for "this session's own box". Resolving the
# empty case is the CALLER's job: this runs inside a command substitution, where
# require_identity's exit would be swallowed.
mail_box_owner() {
    local seat=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --seat) seat=$2; shift 2 ;;
            *) shift ;;
        esac
    done
    echo "$seat"
}

mail_inbox() {
    local seat sd n f
    seat=$(mail_box_owner "$@")
    [ -n "$seat" ] || { require_identity "mail inbox"; seat=$KINGDOM_SEAT; }
    sd=$(state_dir)
    n=$(unread_count "$seat")
    echo "inbox of $seat — $n unread"
    [ "$n" -gt 0 ] || return 0
    for f in "$sd/mail/$seat/inbox/"*.md; do
        printf '  %s\n    %s\n' "$(basename "$f")" "$(grep -m1 '^subject:' "$f" || true)"
    done
}

mail_read() {
    local id="" seat="" sd inbox readdir matches
    while [ $# -gt 0 ]; do
        case "$1" in
            --seat) seat=$2; shift 2 ;;
            *) id=$1; shift ;;
        esac
    done
    [ -n "$seat" ] || { require_identity "mail read"; seat=$KINGDOM_SEAT; }
    [ -n "$id" ] || die "mail read: which message? (filename or unique prefix)"
    sd=$(state_dir)
    inbox="$sd/mail/$seat/inbox"
    readdir="$sd/mail/$seat/read"
    matches=$(find "$inbox" -maxdepth 1 -type f -name "$id*" 2>/dev/null | sort)
    if [ -z "$matches" ]; then
        matches=$(find "$readdir" -maxdepth 1 -type f -name "$id*" 2>/dev/null | sort)
        [ -n "$matches" ] || die "mail read: no message matching '$id' for $seat"
        [ "$(echo "$matches" | wc -l)" -eq 1 ] || die "mail read: ambiguous prefix '$id'"
        echo "(already read)"
        cat "$matches"
        return 0
    fi
    [ "$(echo "$matches" | wc -l)" -eq 1 ] || die "mail read: ambiguous prefix '$id'"
    cat "$matches"
    mkdir -p "$readdir"
    mv "$matches" "$readdir/"
}

mail_sent() {
    local seat sd f
    seat=$(mail_box_owner "$@")
    [ -n "$seat" ] || { require_identity "mail sent"; seat=$KINGDOM_SEAT; }
    sd=$(state_dir)
    echo "sent by $seat:"
    for f in "$sd/mail/$seat/sent/"*.md; do
        [ -e "$f" ] || { echo "  (none)"; break; }
        printf '  %s\n' "$(basename "$f")"
    done
}

cmd_mail() {
    local sub=${1:-}
    shift || true
    case "$sub" in
        send)  mail_send "$@" ;;
        inbox) mail_inbox "$@" ;;
        read)  mail_read "$@" ;;
        sent)  mail_sent "$@" ;;
        *) die "mail: send|inbox|read|sent" ;;
    esac
}

# ---------- wake / sleep ----------

# history: kingdom/brain/km-notes.md#wake_queue_add
wake_queue_add() { # <seat> <reason>
    local f
    f="$(seat_home "$1")/wake"
    grep -Fxq -- "$2" "$f" 2>/dev/null || printf '%s\n' "$2" >>"$f"
}

cmd_wake() {
    local seat=${1:-} rc
    shift || true
    is_seat "$seat" || die "wake: unknown seat ${seat:-<none>}"
    local reason=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --bead) reason="bead:$2 $reason"; shift 2 ;;
            --reason) reason="$reason$2"; shift 2 ;;
            *) die "wake: unknown flag $1" ;;
        esac
    done
    [ -n "$reason" ] || reason="a new day"
    mkdir -p "$(seat_home "$seat")"
    if [ "$(seat_status "$seat")" = awake ] && window_up "$seat"; then
        # history: kingdom/brain/km-notes.md#cmd_wake
        if ! seat_prompt_visible "$seat"; then
            # A nudge ends in Enter, and on a modal Enter presses a button
            # nobody consented to (VI.2). Queued rather than dropped: km-seat
            # reads that queue when the session ends, so declining to type now
            # costs a delay and not the message.
            wake_queue_add "$seat" "$reason"
            echo "wake: $seat is awake but its pane shows no prompt to type at — a modal covers the input box, or the pane cannot be read. NOT nudged: Enter there would choose whichever option is highlighted, and a modal is not consent (VI.2). Queued instead — $reason"
        elif seat_nudge "$seat" "[km] $reason — check bd mail inbox when convenient"; then
            echo "wake: $seat is already awake; nudged instead — typed and submitted"
        else
            wake_queue_add "$seat" "$reason"
            echo "wake: NUDGE UNDELIVERED to $seat — see the diagnosis above for which half failed, and read the pane by hand. Queued to the wake file so the reason outlives the failed send — $reason"
        fi
    else
        wake_queue_add "$seat" "$reason"
        # "queued" was a statement about the QUEUE, and it stayed true while
        # being false about the world: for four hours nothing was parked on
        # Անահիտ's queue to read it (gqlc-6ha4, Article IV.1). So the report is
        # now conditioned on a reader existing, and where one does not, this is
        # the moment to put it back — a wake is exactly when a missing runner
        # starts costing the town something.
        if seat_runner_live "$seat" || ! session_up; then
            # Town down is not a defect: `km up` raises every runner and the
            # queue is read then. Saying so keeps the operator from reading the
            # line below as an incident.
            echo "wake: queued for $seat — $reason"
        else
            seat_runner_start "$seat" && rc=0 || rc=$?
            case "$rc" in
                0) echo "wake: queued for $seat — $reason (nothing was parked on that queue to read it; km-seat respawned — gqlc-6ha4)" ;;
                1) echo "wake: QUEUED UNREAD for $seat — $reason: no km-seat is parked on that queue and the respawn was declined because herdr reports a live session in the window, which cannot be replaced without ending one — or because herdr could not be read, which is declined the same way (see stderr); nobody will read this until that is resolved" ;;
                *) echo "wake: QUEUED UNREAD for $seat — $reason: no km-seat is parked on that queue and the respawn did not take — the command line was accepted and no runner appeared, so nobody will read this until that pane is repaired by hand (gqlc-c48e)" ;;
            esac
        fi
    fi
}

cmd_sleep() {
    local seat="${KINGDOM_SEAT:-}"
    while [ $# -gt 0 ]; do
        case "$1" in
            --seat) seat=$2; shift 2 ;;
            *) die "sleep: unknown flag $1" ;;
        esac
    done
    if [ -z "$seat" ]; then
        echo "sleep: not a seat session (KINGDOM_SEAT unset) — end your session normally"
        return 0
    fi
    is_seat "$seat" || die "sleep: unknown seat $seat"
    mkdir -p "$(seat_home "$seat")"
    # asleep-pending is a request, not a departure, and it stays one until the
    # session actually ends — km-seat writes `asleep` itself when claude exits.
    # `km sleep` cannot confirm its own exit: it runs as a child of the very
    # claude it is asking to leave, so the /exit is not acted on until this
    # command has already returned. Confirmation therefore belongs to
    # `km reconcile`, which is what makes an undelivered request recoverable.
    echo asleep-pending >"$(seat_home "$seat")/status"
    # The guard was `window_up`, which asks whether the seat's TAB exists, while
    # the action it guards needs an agent the send can reach. Different objects:
    # the guard passed, the send failed, and `set -e` took the success echo on
    # the next line with it — exit 1 and a blank screen, with the accurate
    # message unreachable in the else branch (bd gqlc-7bps). The send's own
    # status is the only thing that knows.
    if send_line "$seat" "/exit"; then
        echo "sleep: good night, $(seat_display "$seat") — the session ends when this turn does"
    else
        echo "sleep: $(seat_display "$seat") is recorded asleep-pending, but the /exit was NOT delivered (diagnosis above) — end your session normally; km reconcile settles the ledger"
    fi
}

# ---------- town lifecycle ----------

ensure_state_tree() {
    local sd s
    sd=$(state_dir)
    for s in $(seats_all) andranik; do
        mkdir -p "$sd/mail/$s/inbox" "$sd/mail/$s/read" "$sd/mail/$s/sent"
    done
    for s in $(seats_all); do
        mkdir -p "$sd/seats/$s/handoff/archive"
    done
    mkdir -p "$sd/seats/andranik/handoff/archive"
}

# The raise's own tally, and the sentence that reports it. seat_runner_start is
# three-valued — 0 started, 1 declined because a live session already holds the
# seat, 2 no runner appeared — and both of cmd_up's seat loops folded all three
# into `|| true`. The closing line then counted `seats_all | wc -l`, the ROSTER,
# so `km up` printed the same sentence whether sixteen seats came up, sixteen
# were declined or sixteen failed (gqlc-mit2u).
raise_seats() { # -> "<started> <declined> <failed>" on stdout
    local s rc started=0 declined=0 failed=0
    for s in $(seats_all); do
        # stdout only. These were the town's only two call sites that also
        # dropped stderr, so `km up` printed "the town is up: 16 seats" while
        # every runner spawn was silently refused; the recurring paths (wake,
        # reconcile, dispatch) have always passed it through.
        seat_runner_start "$s" >/dev/null && rc=0 || rc=$?
        case "$rc" in
            0) started=$((started + 1)) ;;
            1) declined=$((declined + 1)) ;;
            *) failed=$((failed + 1)) ;;
        esac
    done
    printf '%s %s %s\n' "$started" "$declined" "$failed"
}

# Declined is not a failure: it means the seat was already live, which is the
# ordinary answer to `km up` on a town that is already up. So the raise is
# empty only when nothing started AND nothing was already there.
raise_report() { # <started> <declined> <failed> -> 0 reported a town, 1 reported none
    local said="$1 started"
    if [ "$2" -gt 0 ]; then said="$said, $2 already live"; fi
    if [ "$3" -gt 0 ]; then said="$said, $3 could not be started (each one's reason is on stderr above)"; fi
    if [ "$1" -eq 0 ] && [ "$2" -eq 0 ]; then
        echo "km: no seat came up: $said. There is a '$WORKSPACE' workspace but no town in it." >&2
        return 1
    fi
    echo "the town is up: $said, all asleep until woken."
}

cmd_up() {
    no_args up "$@"
    have_herdr || die "herdr is not installed, so there is no town to raise (https://herdr.dev)"
    local srv_rc=0
    herdr_server_up || srv_rc=$?
    case "$srv_rc" in
        1) die "herdr server is not running — start it and retry (herdr status server)" ;;
        # Refused either way, but not under a claim km cannot support: raising a
        # town over a server km could not reach would create a second workspace
        # if the first one is in fact there.
        2) die "km could not ask herdr whether its server is running (its own account is above), so it will not raise the town — that could mint a second '$WORKSPACE' workspace over a town already up." ;;
    esac
    ensure_state_tree
    local mr s wt ws tally url
    mr=$(main_root)
    # history: kingdom/brain/km-notes.md#cmd_up
    url=$(git_at "$mr" remote get-url origin) ||
        die "up: cannot read the main checkout's origin URL, so it has no source to clone a seat from"
    for s in $(seats_all); do
        wt=$(seat_worktree "$s")
        if [ ! -d "$wt" ]; then
            git clone --quiet "$url" "$wt" || die "up: could not clone a repository for seat $s at $wt"
            git_at "$wt" config core.hooksPath .githooks
            git_at "$wt" checkout --detach --quiet origin/master
        fi
    done
    # The tab-level hazard's workspace-level twin: an unreadable list reads as
    # "no workspace", and this arm answers that by creating a SECOND workspace
    # under the same label, with sixteen tabs in it. Refuse instead.
    ws=$(workspace_id) || die "cannot read the herdr workspace list, so km cannot tell whether the town is already up — refusing to raise it rather than create a second '$WORKSPACE' workspace on top of the first. The parse's diagnosis is on stderr above."
    if [ -z "$ws" ]; then
        # herdr workspace create returns a workspace with a default root tab
        # whose pane has herdr's own cwd (typically $HOME). The seat loop
        # below wants each tab's pane to start in the SEAT's worktree, so
        # the auto-tab is not reused — the loop creates one tab per seat
        # with --cwd correct. The auto-tab is closed after the loop so the
        # roster does not carry an unlabelled placeholder.
        local created
        # history: kingdom/brain/km-notes.md#cmd_up-2
        created=$(herdr workspace create --label "$WORKSPACE" --no-focus) \
            || die "herdr could not create the '$WORKSPACE' workspace, so there is no town to raise and no seat was started. herdr's own account of it is on stderr above."
        # Neither read below may abort. km is between creating the workspace and
        # creating anything to put in it, and `set -e` on a bare `x=$(... python3
        # ...)` ends the raise right there — workspace up, unlabelled auto-tab,
        # zero seat tabs, and a python traceback instead of a sentence. What the
        # seat loop needs is not either of these ids: seat_runner_start derives
        # the workspace itself. So both reads report and continue (gqlc-be8t6).
        ws=$(printf '%s' "$created" | python3 -c "import json,sys; print(json.load(sys.stdin)['result']['workspace']['workspace_id'])" 2>/dev/null) || ws=
        [ -n "$ws" ] || echo "km: herdr created the '$WORKSPACE' workspace but km could not read its id back out of the reply. Raising the seats anyway — each looks the workspace up for itself, so the raise completes normally if the workspace is really there. If it is not, no seat tab is created, and the closing line below reports that no seat came up and exits non-zero." >&2
        local auto_tab
        auto_tab=$(printf '%s' "$created" | python3 -c "import json,sys; print(json.load(sys.stdin)['result']['tab']['tab_id'])" 2>/dev/null) || auto_tab=
        tally=$(raise_seats)
        # Close the placeholder AFTER the seats are up, so herdr doesn't
        # reap the workspace between "no seats yet" and "seats added".
        if [ -n "$auto_tab" ]; then
            herdr tab close "$auto_tab" >/dev/null 2>&1 || true
        else
            echo "km: could not read the auto-tab's id out of herdr's reply, so the workspace's unlabelled placeholder tab was not closed and is still in the roster. Harmless — close it by hand in herdr, or 'km down' and raise the town again." >&2
        fi
    else
        tally=$(raise_seats)
    fi
    # shellcheck disable=SC2086 # the tally is three integers, split on purpose
    raise_report $tally || return 1
    echo "  herdr              — open the town's TUI (every citizen is a tab in the '$WORKSPACE' workspace)"
}

cmd_down() {
    no_args down "$@"
    # town_absent_reason writes no newline — the other callers embed it in a
    # larger sentence — so this lone caller supplies one.
    session_up || { town_absent_reason $? "the town is already down"; echo; return 0; }
    # Declared, not inherited. This is a machine notice with no citizen behind
    # it — `km down` is an operator command — and require_identity would
    # otherwise refuse it from the plain shell it is normally run in, losing the
    # broadcast to the `|| true`. Naming the sender here keeps the fallback out
    # of mail_send, where it applied to every letter in the town.
    mail_send town --from andranik -s "town going down" -m "The herdr workspace is being closed. Sessions end; seats, mail, and handoffs persist." || true
    local ws
    ws=$(workspace_id)
    if [ -n "$ws" ]; then
        herdr workspace close "$ws" >/dev/null 2>&1 || true
    fi
    echo "the town is down. State, mail, and handoffs persist in $(state_dir)"
}

# ---------- halt ----------

# history: kingdom/brain/km-notes.md#halt_log
halt_log() { # <raise|lower> <actor> <detail> — appends one event
    local f verb actor detail
    f="$(state_dir)/halt-history"
    verb=$(printf '%s' "$1" | tr '\n\t' '  ')
    actor=$(printf '%s' "$2" | tr '\n\t' '  ')
    detail=$(printf '%s' "$3" | tr '\n\t' '  ')
    # Never abort the act being recorded. Under `set -e` a failed append would
    # exit cmd_resume BEFORE the rm, wedging the town halted because a log file
    # could not be written — the record is worth less than the brake. Losing the
    # line SILENTLY is this bead's defect, so the failure is loud instead.
    if ! printf '%s\t%s\t%s\t%s\n' \
        "$(date -u -Iseconds)" "$verb" "$actor" "$detail" \
        >>"$f"; then
        echo "km: WARNING — could not append to $f; this $verb goes unrecorded" >&2
    fi
}

cmd_halt() {
    ensure_state_tree
    local sd
    sd="$(state_dir)"
    # The reason is free text, so only a LEADING dash is read as a flag: dashes
    # live inside ordinary words and a reason has to be able to carry them.
    # Everything after the first word is reason, whatever it looks like.
    case "${1:-}" in
        -h | --help)
            # The one spelling in this family a careful person types on purpose,
            # before running a write verb, to find out what it will do. On
            # 2026-08-24 a seven-hour outage sat on the board with `--help`
            # recorded as its cause.
            usage
            return 0
            ;;
        --status | --show)
            if [ -f "$sd/halt" ]; then
                echo "halt is UP: $(head -1 "$sd/halt")"
                echo "  the dispatcher and the guard sweep wake nobody until it is lowered ($(verb resume))."
            else
                echo "no halt is raised: the dispatcher and the guard sweep are routing normally."
            fi
            return 0
            ;;
        --history)
            shift
            local n="${1:-10}" hist total shown
            hist="$sd/halt-history"
            case "$n" in
                '' | *[!0-9]*) die "halt --history: count must be a number, got '$n'" ;;
            esac
            # Force base 10 before the count is used twice. `$((...))` reads a
            # leading zero as octal and `tail -n` does not, so `--history 010`
            # printed a header saying 8 above a body of 10 rows — the record
            # disagreeing with its own count (gqlc-tq83, from Միհր's F3).
            n=$((10#$n))
            if [ ! -s "$hist" ]; then
                echo "halt history is empty: no halt has been raised or lowered since $hist was first written"
                return 0
            fi
            total=$(wc -l <"$hist")
            shown=$((total < n ? total : n))
            echo "halt history — last $shown of $total events ($hist)"
            tail -n "$n" "$hist" | awk -F'\t' '{ printf "  %s  %-5s  %-10s  %s\n", $1, $2, $3, $4 }'
            return 0
            ;;
        -*)
            # This verb used to take its whole argv as the reason, so a flag it
            # did not know became one and stopped the town — exit 0, and the same
            # success line a deliberate halt prints. Twice in fourteen minutes by
            # two citizens asking a question (bd gqlc-jqwf).
            die "halt: unknown flag $1 — to ask whether a halt is up, $(verb halt) --status; a reason may not begin with '-'"
            ;;
    esac
    # VI.4 lets two citizens lower a halt; for everyone else the recorded
    # reason is the whole of what they get, and a blank one forces that read to
    # be a guess between "stopped on purpose" and "fat-fingered". Whitespace
    # counts as blank — it is written to the file and reads on the board as
    # nothing at all (bd gqlc-jqwf).
    local reason="${*:-}"
    if [ -z "${reason//[[:space:]]/}" ]; then
        die "halt: a reason is required — say why the town must stop, so whoever finds it can tell deliberate from accidental"
    fi
    # history: kingdom/brain/km-notes.md#cmd_halt
    local -a reason_words=()
    # -d '' consumes the whole reason rather than its first line, and finds no
    # delimiter, hence the `|| true`. Reading one line counted `show` alone in a
    # multi-line reason whose remainder was prose, and refused it (F2).
    read -r -d '' -a reason_words <<<"$reason" || true
    local reason_is_question=0 reason_word
    case "$(printf '%s' "${reason_words[0]}" | tr '[:upper:]' '[:lower:]')" in
    show | status | history | help | state | info | list) reason_is_question=1 ;;
    esac
    for reason_word in "${reason_words[@]:1}"; do
        case "$reason_word" in
        *[!0-9]*) reason_is_question=0 ;;
        esac
    done
    if [ "$reason_is_question" -eq 1 ]; then
        die "halt: '$reason' reads as a question, not a reason — refusing to stop the town on a word that names a read.
  is a halt up?          $(verb halt) --status
  who raised or lowered? $(verb halt) --history [N]
  the dash is what separates the two: without it, km reads the rest as your reason.
  if you did mean to halt the town, say why in a sentence: $(verb halt) '<reason>'"
    fi
    # Read BEFORE the truncating write below, because afterwards nothing can
    # tell the two cases apart. A raise over a standing halt replaces another
    # citizen's reason, and until this was captured both printed the same line.
    local was_up=''
    if [ -f "$sd/halt" ]; then
        was_up=$(head -1 "$sd/halt")
    fi
    require_identity halt
    printf 'raised by %s at %s: %s\n' "$KINGDOM_SEAT" "$(date -u -Iseconds)" "$reason" \
        >"$sd/halt"
    # After the flag, not before: if the truncating write above fails, `set -e`
    # stops here and the history does not claim a halt that was never raised.
    halt_log raise "$KINGDOM_SEAT" "$reason"
    # history: kingdom/brain/km-notes.md#cmd_halt-2
    if [ -n "$was_up" ]; then
        # Raising over a standing halt is a truncating overwrite, so someone
        # else's recorded reason is gone. Both cases used to print one line.
        echo "halt RE-RAISED by you ($KINGDOM_SEAT) just now — this REPLACED a halt that was already up:"
        echo "    was: $was_up"
        echo "    now: $reason"
    else
        echo "halt RAISED by you ($KINGDOM_SEAT) just now — reason: $reason"
        echo "  the town was NOT halted before this command."
    fi
    # Names both timers, and says which paths it does NOT bind. The line used to
    # promise a quiet town while naming only the dispatcher, so an operator had
    # no reason to suspect the guard sweep was still launching sessions behind
    # the flag — and this line is the whole report he gets (gqlc-6dzi).
    echo "  the dispatcher and the guard sweep will wake nobody until it is lowered ($(verb resume))"
    # Spell the broadcast in full. This line is read at one moment — by whoever
    # has just stopped the town and now has to say why — and it used to name
    # `km herratsayn`, which #1595 stopped dispatching without editing the line
    # (bd gqlc-cw7h). The reader in a hurry runs it, gets the usage dump, and
    # concludes a halted town has no way to talk to itself.
    echo "  to tell the town why: $(verb mail) send town -s '<subject>' -m '<body>'"
    echo "  $(verb wake) <seat> still reaches one seat; neither is bound by the halt."
}

# Constitution VI.4, in full: "A halt (kingdom-state/halt) stops new wakes;
# running sessions finish their day. Anyone may raise a halt for cause; only
# Սեդրակ or Անդրանիկ lowers it." Raising stays open to everyone above; this list
# is the whole of the restriction, and it is two names because the clause names
# two. Widening it is a constitutional amendment (Article VII), not a patch.
HALT_LOWERERS="sedrak andranik"

cmd_resume() {
    no_args resume "$@"
    local seat="${KINGDOM_SEAT:-}"
    # Fail closed on an absent identity rather than defaulting to andranik the
    # way the rest of km does. Everywhere else that default is a convenience for
    # the operator at a terminal; here it is the hole, because every ephemeral
    # agent session in the shared checkout also runs with KINGDOM_SEAT unset and
    # would inherit the crown's authority over the town's only emergency brake.
    if [ -z "$seat" ]; then
        echo "resume: refused — this session has no identity (KINGDOM_SEAT is unset)." >&2
        echo "  Constitution VI.4 reserves lowering a halt to Սեդրակ or Անդրանիկ." >&2
        echo "  If you are the crown, say so: KINGDOM_SEAT=andranik $(verb resume)" >&2
        return 1
    fi
    case " $HALT_LOWERERS " in
        *" $seat "*) ;;
        *)
            echo "resume: refused — $seat may not lower a halt." >&2
            echo "  Constitution VI.4 reserves that to Սեդրակ (sedrak) or Անդրանիկ (andranik);" >&2
            echo "  anyone may RAISE one. Ask sedrak to lower it: $(verb mail) send sedrak -s ..." >&2
            return 1
            ;;
    esac
    if [ -f "$(state_dir)/halt" ]; then
        # The detail is the raise line verbatim, so a lower event is readable on
        # its own without scanning backwards for the raise it answers — and so
        # that nothing here has to parse the flag's prose for a reason.
        halt_log lower "$seat" "$(head -1 "$(state_dir)/halt")"
        rm -f "$(state_dir)/halt"
        echo "halt lowered by $seat: the dispatcher may wake seats again"
    else
        # Recorded nowhere: nothing came down, so no reserved power was
        # exercised. The history is a log of state changes, not of attempts.
        echo "no halt was raised"
    fi
}

# ---------- dispatcher ----------

worker_seats() {
    local s c
    for s in $(seats_all); do
        c=$(seat_class "$s")
        case "$c" in architect | warrior | judge) echo "$s" ;; esac
    done
}

# history: kingdom/brain/km-notes.md#cap_exempt_class
cap_exempt_class() { [ "$1" = judge ]; }

# The seats that spend a slot. The exemption lets the awake count exceed
# max_active by the number of judge seats the roster holds.
capped_seats() {
    local s
    for s in $(worker_seats); do
        cap_exempt_class "$(seat_class "$s")" || echo "$s"
    done
}

# history: kingdom/brain/km-notes.md#cmd_reconcile
cmd_reconcile() {
    no_args reconcile "$@"
    # main's case arm calls this as a statement (km:5133), so -e is live here.
    # `session_up; up_rc=$?` therefore ended the shell on every non-zero and the
    # whole block below was dead: `km reconcile` against a down town printed zero
    # bytes and exited 1, while dispatch, guard-sweep and status — which all use
    # an AND-OR or an `if` — spoke correctly (bd gqlc-nvbd3).
    local up_rc=0
    session_up || up_rc=$?
    if [ "$up_rc" != 0 ]; then
        echo "reconcile: $(town_absent_reason "$up_rc"); nothing to reconcile"
        # Exit non-zero when km could not tell. A scheduled pass that did not
        # run must not report success — reporting 0 over a dead query is the
        # shape this bead is an instance of. Both cannot-tell answers count: 2
        # is a workspace list that did not parse, 3 a server km could not ask,
        # and neither is evidence there was nothing to reconcile.
        case "$up_rc" in 2 | 3) return 1 ;; esac
        return 0
    fi
    local s st suspect rc repaired=0 redelivered=0 suspected=0 respawned=0 corrected=0
    for s in $(seats_all); do
        st=$(seat_status "$s")
        suspect="$(seat_home "$s")/suspect"
        # Before the status arms, and unconditional on status: this is the
        # polarity that was missing (gqlc-6ha4).
        if ! seat_runner_live "$s"; then
            seat_runner_start "$s" && rc=0 || rc=$?
            case "$rc" in
                0)
                    echo "reconcile: $s had no km-seat parked on its wake file, so no wake could ever have reached it; runner respawned"
                    respawned=$((respawned + 1)) ;;
                1)
                    # Refused because a session is live in that window. Reported and
                    # not acted on: replacing the window would end it (VI.2). It
                    # heals itself when the session does end — the next pass finds
                    # an empty window and replaces it then.
                    echo "reconcile: $s has no km-seat runner behind it and herdr reports a live session — or could not be read, which is declined the same way (see stderr). Nothing was replaced under what may be a live citizen; if the session is real it will not park again when that session ends" ;;
                *)
                    # Counted nowhere on purpose. This pass repaired nothing, and
                    # the whole defect being fixed here was a repair counter that
                    # climbed while the town stayed down (gqlc-c48e).
                    echo "reconcile: $s had no km-seat parked on its wake file and the respawn DID NOT TAKE — the command line was accepted and no runner appeared. Nothing here will repair it and every pass will say this again until someone reads that pane; km's own diagnosis is on stderr above" ;;
            esac
        fi
        case "$st" in
            awake | asleep-pending) ;;
            asleep)
                if seat_session_live "$s"; then
                    echo awake >"$(seat_home "$s")/status"
                    echo "reconcile: $s is recorded asleep and herdr reports a live session (or could not be read, which is treated as live); recorded awake so no pass hands her a second bead on top of the one she is working"
                    corrected=$((corrected + 1))
                fi
                rm -f "$suspect"; continue ;;
            *) rm -f "$suspect"; continue ;;
        esac
        if seat_session_live "$s"; then
            rm -f "$suspect"
            if [ "$st" = asleep-pending ]; then
                # history: kingdom/brain/km-notes.md#cmd_reconcile-2
                if send_line "$s" "/exit"; then
                    echo "reconcile: $s asked to leave and is still here; /exit re-sent"
                    redelivered=$((redelivered + 1))
                else
                    echo "reconcile: $s asked to leave and is still here, but the /exit could NOT be delivered (diagnosis above); the seat stays asleep-pending"
                fi
            fi
            continue
        fi
        # history: kingdom/brain/km-notes.md#cmd_reconcile-3
        if [ ! -f "$suspect" ]; then
            : >"$suspect"
            echo "reconcile: $s is recorded $st with no session; confirming next pass"
            suspected=$((suspected + 1))
            continue
        fi
        if [ "$(($(date +%s) - $(stat -c %Y "$suspect")))" -lt 60 ]; then
            echo "reconcile: $s is recorded $st with no session, but that sighting is too recent to tell a dead seat from a starting one; still confirming"
            suspected=$((suspected + 1))
            continue
        fi
        echo asleep >"$(seat_home "$s")/status"
        rm -f "$suspect" "$(seat_home "$s")/heartbeat.json"
        echo "reconcile: $s was recorded $st with no session for a full cycle; freed"
        repaired=$((repaired + 1))
    done
    echo "reconcile: done ($repaired freed, $suspected suspected, $redelivered re-sent, $respawned runner(s) respawned, $corrected status(es) corrected)"
}

free_worker_of_class() { # asleep, no queued wake
    local class=$1 s
    for s in $(worker_seats); do
        [ "$(seat_class "$s")" = "$class" ] || continue
        [ "$(seat_status "$s")" = asleep ] || continue
        [ ! -f "$(seat_home "$s")/wake" ] || continue
        echo "$s"
        return 0
    done
    return 1
}

# history: kingdom/brain/km-notes.md#class_roster_reason
class_roster_reason() { # <class> -> a sentence
    local class=$1 s total=0 awake=0 queued=0 leaving=0 free=0 parts=""
    for s in $(worker_seats); do
        [ "$(seat_class "$s")" = "$class" ] || continue
        total=$((total + 1))
        case "$(seat_status "$s")" in
            asleep-pending) leaving=$((leaving + 1)) ;;
            asleep) if [ -f "$(seat_home "$s")/wake" ]; then
                        queued=$((queued + 1))
                    else
                        # Unreachable from the call site — the lookup takes
                        # exactly this seat — so it is counted rather than
                        # dropped: an enumeration that does not sum to the
                        # total is how a reader learns to stop trusting it.
                        free=$((free + 1))
                    fi ;;
            *) awake=$((awake + 1)) ;;
        esac
    done
    # The one condition that never self-heals. A retired or never-seated class
    # swallows its whole queue for as long as the roster stands, so the remedy
    # is an edit and not a wait, and describing seats that do not exist would
    # send the operator to watch for a sleep that can never come.
    if [ "$total" -eq 0 ]; then
        echo "the roster seats no $class at all, so no $class bead can route until one is seated in kingdom.toml [seats]"
        return 0
    fi
    # Transient by construction: those wakes are already queued, so the next
    # run has somewhere to put this bead. Named apart from occupancy because
    # the correct response is to do nothing, and the occupancy response is not.
    if [ "$queued" -eq "$total" ]; then
        echo "all $total $class seat(s) are asleep with a wake queued already, so this one waits for a later run"
        return 0
    fi
    [ "$awake" -eq 0 ] || parts="$parts, $awake awake"
    [ "$queued" -eq 0 ] || parts="$parts, $queued asleep with a wake queued"
    [ "$leaving" -eq 0 ] || parts="$parts, $leaving asked to sleep and still leaving"
    [ "$free" -eq 0 ] || parts="$parts, $free free (which contradicts the lookup that just failed)"
    echo "all $total $class seat(s) are unavailable (${parts#, }); nothing here schedules a wake in response, so it waits for a citizen to sleep"
}

# history: kingdom/brain/km-notes.md#dispatch_loud_priority
DISPATCH_LOUD_PRIORITY=1

# Names a bead the fresh pass could not route, at a volume set by its priority.
# Reads and updates cmd_dispatch's `unroutable`, `stalled` and `quiet` through
# bash's dynamic scope, the same way route_owners reads `slots` and `wakes`,
# and for the same reason: the counting must not exist in two copies. It is
# only ever called from there.
report_unroutable() { # <id> <class> <priority> <reason>
    local rid=$1 rcls=$2 rprio=$3 rwhy=$4
    # A priority that is not a number sorts with the backlog rather than
    # aborting the run: this is a report, and a diagnostic that can stop
    # routing is a worse failure than the one it describes.
    case "$rprio" in '' | *[!0-9]*) rprio=99 ;; esac
    unroutable=$((unroutable + 1))
    if [ "$rprio" -eq 0 ]; then
        stalled=$((stalled + 1))
        echo "dispatch: STALLED $rid — P0 $rcls work, ready and unassigned, and no seat can take it: $rwhy"
        # And durably, because the line above is write-only (gqlc-tz95): see
        # record_stalled_p0, which is handed this list at the end of the run.
        stalled_beads="$stalled_beads$rid|$rcls|$rwhy
"
    elif [ "$rprio" -le "$DISPATCH_LOUD_PRIORITY" ]; then
        echo "dispatch: unroutable $rid — P$rprio $rcls work and no seat can take it: $rwhy"
    else
        quiet="$quiet$rcls|$rwhy
"
    fi
}

# history: kingdom/brain/km-notes.md#stalled_marker_path
stalled_marker_path() { echo "$(state_dir)/stalled-p0"; }

record_stalled_p0() { # <newline-separated "<id>|<class>|<reason>">
    local pending=$1 marker prev="" now id cls why seen out="" ids="" previds=""
    marker=$(stalled_marker_path)
    if [ -f "$marker" ]; then prev=$(cat "$marker" 2>/dev/null || true); fi
    previds=$(printf '%s' "$prev" | awk 'NF { print $2 }' | sort | tr '\n' ' ')
    if [ -z "$pending" ]; then
        # The clearing run, and it must happen: a marker nothing removes is a
        # doctor that fails forever, which is a gate that gets ignored.
        if [ -e "$marker" ]; then
            if rm -f "$marker" 2>/dev/null; then
                echo "dispatch: cleared the stalled-P0 marker — no P0 was unroutable this run, so km status and km doctor are clean again (was:${previds:- unreadable})"
            else
                echo "dispatch: the stalled-P0 marker at $marker could not be removed, so km status and km doctor will keep reporting a stall that has cleared" >&2
            fi
        fi
        return 0
    fi
    now=$(date +%s)
    while IFS='|' read -r id cls why; do
        [ -n "$id" ] || continue
        seen=$(printf '%s' "$prev" | awk -v i="$id" '$2 == i { print $1; exit }')
        case "$seen" in '' | *[!0-9]*) seen=$now ;; esac
        out="$out$seen $id $cls $why
"
        ids="$ids$id "
    done <<<"$pending"
    ids=$(printf '%s' "$ids" | tr ' ' '\n' | awk 'NF' | sort | tr '\n' ' ')
    # NON-FATAL, in the shape km:113 argues for: routing is the town's work and
    # a report about it must never be able to stop it. Said out loud on stderr,
    # because a failure to escalate that escalates nothing leaves both read
    # surfaces silently blind, which is this bead's own defect one layer down.
    if ! printf '%s' "$out" >"$marker" 2>/dev/null; then
        echo "dispatch: the stalled-P0 marker at $marker could not be written, so km status and km doctor cannot report this stall; the STALLED line(s) above are all there is" >&2
        return 0
    fi
    # ON CHANGE, never on a tick — and keyed on the ID SET rather than on the
    # file's bytes. The REASON for a stall flips between "awake" and "wake
    # queued" as seats move, and re-announcing on that would restore the
    # per-tick repetition through the back door.
    if [ "$ids" != "$previds" ]; then
        echo "dispatch: escalated — the stalled-P0 marker now names $ids and km status and km doctor carry it until it clears"
    fi
}

# history: kingdom/brain/km-notes.md#stalled_p0_render
stalled_p0_render() { # -> "<oldest age in seconds><TAB><summary>", rc 1 if none
    local marker seen id cls why now age oldest="" list=""
    marker=$(stalled_marker_path)
    [ -f "$marker" ] || return 1
    now=$(date +%s)
    while read -r seen id cls why || [ -n "$id" ]; do
        [ -n "$id" ] || continue
        case "$seen" in '' | *[!0-9]*) seen=$now ;; esac
        age=$((now - seen))
        [ "$age" -ge 0 ] || age=0
        if [ -z "$oldest" ] || [ "$age" -gt "$oldest" ]; then oldest=$age; fi
        list="$list $id (P0 ${cls:-?}, stalled $(fmt_age "$age") — ${why:-no reason recorded});"
        id=""
    done <"$marker"
    [ -n "$list" ] || return 1
    printf '%s\t%s\n' "$oldest" "${list# }"
}

# How long a P0 may be unroutable before doctor stops calling it a warning.
# 15 minutes is seven dispatch ticks. Below it the commonest cause is a class
# whose wakes are already queued, which routes on the next run with nobody
# acting at all; a hard failure on a condition that heals itself in two minutes
# is how a gate teaches its reader to skip it. A config key and not a constant,
# per Constitution V.6.1: it is a threshold on a report.
stalled_p0_after() { cfg_minutes dispatch stalled_p0_after_minutes 15; }

# history: kingdom/brain/km-notes.md#dispatch_candidate_docs
dispatch_candidate_docs() { # ready deps parents ids -> candidate documents
    jq -c -n \
        --slurpfile ready <(printf '%s' "$1") \
        --slurpfile deps <(printf '%s' "$2") \
        --slurpfile parents <(printf '%s' "$3") \
        --rawfile ids <(printf '%s' "$4") '
        ($ready[0] | map({key: .id, value: .}) | from_entries) as $byId
        | ($parents[0] | map({key: .id, value: .status}) | from_entries) as $status
        | [ ($ids | split("\n") | .[] | select(length > 0)) as $i
            | { id: $i,
                labels: ($byId[$i].labels // []),
                deps: [ $deps[0][]? | select(.issue_id == $i)
                        | {depends_on_id, type, status: ($status[.depends_on_id] // "unknown")} ] } ]'
}

# history: kingdom/brain/km-notes.md#route_owners
route_owners() { # <"seat id" lines> <reason prefix>
    local list=$1 prefix=$2 s capped mine st why b
    for s in $(worker_seats); do
        # Asked FIRST, and it is the one withholding here that stays silent: a
        # seat owning nothing in this list is the overwhelmingly common case and
        # says nothing about the town. Every other skip below now names the bead
        # it withheld, which is only possible in this order — the seat-state
        # tests used to run before `mine` existed, so there was nothing to name
        # (gqlc-wq9x).
        mine=$(echo "$list" | awk -v s="$s" '$1 == s { print $2 }')
        [ -n "$mine" ] || continue
        why=""
        st=$(seat_status "$s")
        if [ "$st" != asleep ]; then
            why="$s, who is $st rather than asleep — every dispatch pass wakes asleep seats only, so this routes when they next sleep"
        # A seat with a wake already queued is skipped rather than woken twice.
        # A seat holding in-progress work AND assigned an unclaimed bead is
        # therefore told about the in-progress half only, and hears about the
        # other when it next sleeps — a delay, not a strand, and the order
        # Constitution III.3 asks for.
        elif [ -f "$(seat_home "$s")/wake" ]; then
            why="$s, who already has a wake queued and is told one thing at a time — this routes on the next run (Constitution III.3)"
        fi
        capped=1
        if [ "$(seat_class "$s")" = judge ]; then capped=0; fi
        if [ -z "$why" ] && [ "$capped" -eq 1 ] && [ "$slots" -le 0 ]; then
            why="$s, who is asleep but every capped slot is spent ($active/$max awake) and only judge work is exempt from the cap"
        fi
        if [ -n "$why" ]; then
            # One line per bead, like every other arm, because the operator's
            # question is about a bead. The cap case is the one that made this
            # a bead: it is a normal steady state, so the dispatcher's own
            # advice — "assign it to a Ճարտարապետ and it routes" — moved beads
            # off the loudly-reported epic arm onto this silent one, and the
            # withheld line going away read as the assignment having worked.
            while IFS= read -r b; do
                [ -n "$b" ] || continue
                echo "dispatch: owner-withheld $b — assigned to $why"
                withheld=$((withheld + 1))
            done <<<"$mine"
            continue
        fi
        cmd_wake "$s" --reason "$prefix: $(echo "$mine" | tr '\n' ' ')"
        wakes=$((wakes + 1))
        if [ "$capped" -eq 1 ]; then slots=$((slots - 1)); fi
    done
}

# history: kingdom/brain/km-notes.md#stranded_ids
stranded_ids() {
    bd list --status in_progress -n 0 --json 2>/dev/null |
        jq -r '[ .[] | select(.assignee == null) | .id ] | join(" ")'
}

# history: kingdom/brain/km-notes.md#unreachable_owner_rows
unreachable_owner_rows() { # -> lines of "<assignee> <id> <id> ..."
    local board rows name ids
    board=$(bd list --status all -n 0 --json 2>/dev/null) || return 1
    jq -e 'type == "array"' >/dev/null 2>&1 <<<"$board" || return 1
    # Grouped in jq, resolved in bash: each distinct assignee is tested against
    # the rosters ONCE, rather than once per bead it holds.
    rows=$(jq -r '[ .[]
                    | select(.status != "closed")
                    | select(.assignee != null and .assignee != "") ]
                  | group_by(.assignee)[]
                  | "\(.[0].assignee) \([ .[].id ] | sort | join(" "))"' <<<"$board") || return 1
    while IFS=' ' read -r name ids; do
        [ -n "$name" ] || continue
        if is_seat "$name"; then continue; fi
        if is_human "$name"; then continue; fi
        echo "$name $ids"
    done <<<"$rows"
}

# history: kingdom/brain/km-notes.md#conditioned_verdict_ids
conditioned_verdict_ids() { # -> ids of judge beads closed with a condition in prose since ADR 0009
    local cutoff=2026-08-29T18:31:01Z board
    board=$(bd list --all --json -n 0 2>/dev/null) || return 1
    # A `bd` that exits 0 having printed a non-array is the one shape the
    # pipeline's own errors cannot catch: `{}` is valid JSON and `.[]` over it
    # iterates nothing rather than failing, so the row certifies every verdict
    # unconditional over a query that returned no beads at all. Same feed, same
    # idiom, as unreachable_owner_rows forty lines up — which guarded it and
    # this one did not.
    jq -e 'type == "array"' >/dev/null 2>&1 <<<"$board" || return 1
    jq -r --arg cutoff "$cutoff" \
        '[ .[]
           | select((.labels // []) | index("class:judge"))
           | select(.status == "closed")
           | select((.closed_at // "") > $cutoff)
           | select((.close_reason // "") | test("conditio"; "i"))
           | .id ] | join(" ")' <<<"$board"
}

cmd_dispatch() {
    # Above ensure_deployed, not below it: on a drifted tree ensure_deployed
    # deploys and then re-execs the deployed km with this argv, so a --help
    # guarded below it would have written to the town before printing.
    no_args dispatch "$@"
    ensure_deployed dispatch "$@" || return 1
    session_up || { echo "dispatch: $(town_absent_reason $?); nothing to do"; return 0; }
    local sd wakes=0 withheld=0
    sd=$(state_dir)

    # Սեդրակ answers his mail regardless of the cap — and regardless of the
    # halt (bd gqlc-ozfr): the halt's cause being over is exactly the kind of
    # news that travels by mail, so a halt that suppressed this wake could
    # never hear that it had outlived its purpose (one such halt held ~6.5h).
    # VI.4 is untouched — this hands Sedrak the DECISION about lowering; it
    # lowers nothing.
    if [ "$(seat_status sedrak)" != awake ] && [ ! -f "$(seat_home sedrak)/wake" ] \
        && [ "$(unread_count sedrak)" -gt 0 ]; then
        cmd_wake sedrak --reason "you have unread mail"
        wakes=$((wakes + 1))
    fi

    if [ -f "$sd/halt" ]; then
        echo "dispatch: halted — $(head -1 "$sd/halt")"
        return 0
    fi

    # history: kingdom/brain/km-notes.md#cmd_dispatch
    if ! cmd_reconcile | sed 's/^reconcile: /dispatch: reconcile: /'; then
        echo "dispatch: the reconcile pass failed (diagnosis above); routing continues on a possibly stale ledger, because a failed repair must not cost the town its routing" >&2
    fi

    # history: kingdom/brain/km-notes.md#cmd_dispatch-2
    local s idle_marker nudged_marker attempts_file escalated_marker refusal_file
    local pending ask floor since cap tries before_unread
    local dry idle_now stalled_age trigger age nudge_err delivered=0
    floor=$(cfg_minutes welfare renudge_after_minutes 30)
    cap=$(recover_cap)
    dry=$(status_stalled_after)
    for s in $(seats_all); do
        idle_marker="$(seat_home "$s")/idle"
        nudged_marker="$(seat_home "$s")/idle-nudged"
        attempts_file="$(seat_home "$s")/idle-attempts"
        escalated_marker="$(seat_home "$s")/idle-escalated"
        refusal_file="$(seat_home "$s")/idle-refusal"
        # history: kingdom/brain/km-notes.md#cmd_dispatch-3
        idle_now=0
        stalled_age=""
        if [ "$(seat_status "$s")" = awake ]; then
            seat_pane_idle "$s" && idle_now=1
            # rc 1 is an unreadable witness, and unreadable is not stalled.
            if age=$(seat_dry_age "$s") && [ "$age" -ge "$dry" ]; then stalled_age=$age; fi
        fi
        if [ "$idle_now" -eq 0 ] && [ -z "$stalled_age" ]; then
            rm -f "$idle_marker" "$nudged_marker" "$attempts_file" "$escalated_marker" "$refusal_file"
            continue
        fi
        # Escalated: the mayor has been told, so this pass says nothing further
        # INTO the seat for the rest of the episode. It keeps reporting, because
        # the slot is still held and going quiet here is how eleven hours passed
        # with every board reading healthy. Only witnessed work clears it — the
        # branch above.
        if [ -f "$escalated_marker" ]; then
            echo "dispatch: $s is awake and $([ -n "$stalled_age" ] && echo "has finished no tool call for $(fmt_age "$stalled_age")" || echo "idle"), ESCALATED to sedrak $(fmt_age "$(($(date +%s) - $(stat -c %Y "$escalated_marker")))") ago after $cap unanswered asks; not typing at her again this episode — read the pane"
            continue
        fi
        pending=$(unread_count "$s")
        # history: kingdom/brain/km-notes.md#cmd_dispatch-4
        trigger=""
        if [ "$idle_now" -eq 1 ]; then
            if [ ! -f "$idle_marker" ]; then
                : >"$idle_marker"
                [ -n "$stalled_age" ] || {
                    echo "dispatch: $s is awake at an empty prompt with $pending unread; confirming next pass before nudging"
                    continue
                }
            elif [ "$(($(date +%s) - $(stat -c %Y "$idle_marker")))" -ge 60 ]; then
                trigger=idle
                rm -f "$idle_marker"
            elif [ -z "$stalled_age" ]; then
                continue
            fi
        fi
        [ -n "$trigger" ] || trigger=stalled
        if [ "$trigger" = idle ]; then
            if [ "$pending" -gt 0 ]; then
                ask="[km] you have $pending unread letter(s) — bd mail inbox, and km sleep when you are done for the day (it is what makes you reachable)"
            else
                ask="[km] you are awake at an empty prompt with no unread mail: that holds one of the town's slots AND makes you unroutable, because every dispatch pass wakes asleep seats only. Pick up work, or run km sleep if you are done for the day"
            fi
        else
            # Self-reconciling, because the seat this reaches may have lost a
            # turn to a quota wall and cannot tell: it names the observation
            # rather than a diagnosis, gives the citizen both readings, and tells
            # the one whose turn died to re-read the world before trusting
            # anything in her own context (ADR 0007 §3).
            ask="[km] no tool call has FINISHED in your session for $(fmt_age "$stalled_age"), so from outside this cannot be told apart from a turn that died. If yours did — a usage-limit wall eats the turn and leaves the session looking busy — do not resume from memory: re-read the world first (git status in your worktree, bd show on whatever you hold, and whether your PR moved while you were gone). If you are inside one long tool call, carry on, this is only a check-in and costs you a line. If you are done for the day, km sleep is what makes you routable again"
            [ "$pending" -eq 0 ] || ask="$ask. You also have $pending unread letter(s) — bd mail inbox"
        fi
        # history: kingdom/brain/km-notes.md#cmd_dispatch-5
        if [ -f "$nudged_marker" ]; then
            since=$(($(date +%s) - $(stat -c %Y "$nudged_marker")))
            if [ "$since" -lt "$floor" ]; then
                echo "dispatch: $s is still $trigger $(fmt_age "$since") after an ask that changed nothing; holding off another for $(fmt_age "$floor") rather than spending her quota on a repeat — read the pane"
                continue
            fi
        fi
        # history: kingdom/brain/km-notes.md#cmd_dispatch-6
        tries=$(cat "$attempts_file" 2>/dev/null || true)
        case "$tries" in '' | *[!0-9]*) tries=0 ;; esac
        if [ "$tries" -ge "$cap" ]; then
            # history: kingdom/brain/km-notes.md#cmd_dispatch-7
            before_unread=$(mail_unread_from sedrak andranik)
            if mail_send sedrak --from andranik \
                -s "$s is $trigger after $cap unanswered asks" \
                -m "km dispatch's recovery ladder spent $cap attempts on $s in one episode and got nothing back, so it has stopped and is telling you instead. It will not mail you about this episode again.

Trigger: $trigger — $([ "$trigger" = idle ] && echo "her agent reports idle and she is sitting at an empty prompt" || echo "no tool call has FINISHED in her session for $(fmt_age "$stalled_age"); her agent reports $(seat_agent_status "$s")")

She is awake and holding one of $(cfg concurrency max_active) slots while answering no dispatch pass — every pass wakes ASLEEP seats only.

Unread mail: $pending
Last delivered ask: $(fmt_age "$(($(date +%s) - $(stat -c %Y "$nudged_marker" 2>/dev/null || date +%s)))") ago
Last refusal: $(cat "$refusal_file" 2>/dev/null || echo "none — every attempt was delivered and she did not act on it")

An attempt km could not DELIVER counts here too, and that is the case worth reading the pane for: it means the machinery could not witness a place to type at all, which is what a covered pane looks like from outside.

Nothing here ends a session and nothing should: a seat that has not asked to leave has not consented (VI.2). Read her pane before deciding. 'km sleep --seat $s' frees the slot if she is genuinely done; if her turn died mid-work, she needs a person, not another line of text.

This counter clears by itself the moment one of her tool calls finishes — witnessed work, not a pane that merely looks different." \
                && [ "$(mail_unread_from sedrak andranik)" -gt "$before_unread" ]; then
                : >"$escalated_marker"
                echo "dispatch: ESCALATED $s to sedrak — $cap asks in this episode changed nothing; not typing at her again this episode"
            else
                echo "dispatch: ESCALATION UNDELIVERED for $s — no new letter from andranik reached sedrak's inbox, so nothing was recorded and the next pass will try again; $s is at her $cap-ask cap and is not being typed at meanwhile"
            fi
            continue
        fi
        # history: kingdom/brain/km-notes.md#cmd_dispatch-8
        if [ "$delivered" -ge 1 ]; then
            echo "dispatch: $s is $trigger and due an ask, but one has already been delivered this run; waiting for the next pass rather than resuming the town all at once"
            continue
        fi
        # The reason is captured rather than streamed so the escalation letter can
        # quote it, and re-emitted here so the journal loses nothing by that.
        if nudge_err=$(seat_nudge "$s" "$ask" 2>&1 >/dev/null); then
            tries=$((tries + 1))
            echo "$tries" >"$attempts_file"
            rm -f "$refusal_file"
            : >"$nudged_marker"
            delivered=1
            echo "dispatch: nudged $s (ask $tries of $cap) — $trigger, $pending unread; the ask was typed and submitted"
            [ -z "$nudge_err" ] || echo "dispatch: $s: $nudge_err"
            wakes=$((wakes + 1))
        else
            # history: kingdom/brain/km-notes.md#cmd_dispatch-9
            tries=$((tries + 1))
            echo "$tries" >"$attempts_file"
            printf '%s\n' "$nudge_err" >"$refusal_file"
            echo "dispatch: ASK REFUSED for $s (attempt $tries of $cap, $trigger) — $nudge_err"
        fi
    done

    # history: kingdom/brain/km-notes.md#cmd_dispatch-10
    local max active=0 s slots
    max=$(cfg concurrency max_active)
    for s in $(capped_seats); do
        seat_session_live "$s" && active=$((active + 1))
    done
    slots=$((max - active))
    if [ "$slots" -le 0 ]; then
        slots=0
        echo "dispatch: $active/$max capped seats awake; no free slot"
    fi

    # history: kingdom/brain/km-notes.md#cmd_dispatch-11
    local inprog ids
    if ! ids=$(bd list --status in_progress -n 0 --json 2>/dev/null |
        jq -r '.[] | select(.assignee != null) | .id'); then
        die "dispatch: the in-progress query failed; nothing routed this run"
    fi
    inprog=""
    if [ -n "$ids" ]; then
        # One call, all ids: the argv is bounded by the count of ASSIGNED
        # in-progress beads (≲20 here), not by the backlog, so it is nowhere
        # near the E2BIG ceiling that killed the ready query (gqlc-fo48).
        # shellcheck disable=SC2086 # deliberate word splitting: ids are [a-z0-9-]
        if ! inprog=$(bd show $ids --json 2>/dev/null | jq -r '
            .[]
            | select(.assignee != null)
            | select([.dependencies // [] | .[]
                      | select(.dependency_type == "blocks" and .status != "closed")]
                     | length == 0)
            | "\(.assignee) \(.id)"' | sort); then
            die "dispatch: the blocker query failed; nothing routed this run"
        fi
    fi
    # `mine` is now the actionable subset, so the wake reason names only
    # actionable beads — behaviour, pinned by a row, not an accident. A seat
    # whose every in-progress bead is blocked matches nothing, is not woken, and
    # its slot flows to the passes below, which is where the judge is routed.
    route_owners "$inprog" "resume your in-progress work"

    # history: kingdom/brain/km-notes.md#cmd_dispatch-12
    local queue routed owned lowpri epics ready id cls prio seat
    if ! ready=$(bd ready -n 0 --json 2>/dev/null); then
        die "dispatch: the ready-queue query failed; nothing routed beyond the resume wakes above"
    fi

    # The floor the FRESH arm below applies, from [dispatch] max_priority.
    # Fail-OPEN and loud, deliberately: a config this pass cannot read must not
    # be able to stop the town, because "routed nothing, printed a healthy
    # summary" is the failure this file has been bitten by three times
    # (gqlc-z1qw, gqlc-fo48). An absent or malformed value routes everything and
    # says why, which an operator can see; the fail-closed alternative is silent.
    local maxprio
    maxprio=$(cfg dispatch max_priority)
    case "$maxprio" in
        '' | *[!0-9]*)
            echo "dispatch: [dispatch] max_priority = '${maxprio:-<unset>}' is not a number; every priority is routable this run"
            maxprio=99
            ;;
    esac
    # history: kingdom/brain/km-notes.md#cmd_dispatch-13
    if ! queue=$(jq -r --argjson maxp "$maxprio" '
        [ .[]
          | . as $b
          | (["architect", "warrior", "judge"]
             | map(. as $c | select(($b.labels // []) | index("class:" + $c))))[0] as $cls
          | {id, priority, assignee, cls: $cls, itype: .issue_type}
        ] | sort_by(.priority) | .[]
          | if .assignee != null           then "owned \(.assignee) \(.id)"
            elif .itype == "epic"          then "epic \(.id)"
            elif (.priority // 0) > $maxp  then "lowpri \(.id) \(.priority // 0)"
            elif .cls == null              then "fresh \(.id) warrior inferred \(.priority // 0)"
            else "fresh \(.id) \(.cls) labelled \(.priority // 0)" end' <<<"$ready"); then
        # Not "nothing routed": the resume pass above may already have queued
        # wakes, and they stand. An operator reading this during an incident has
        # to be able to trust it.
        # The owned pass is downstream of this query, so nothing owned has been
        # routed yet — only the resume wakes stand here.
        die "dispatch: the ready-queue query failed; neither owned nor fresh beads routed (the resume wakes above stand)"
    fi
    owned=$(echo "$queue" | awk '$1 == "owned" { print $2, $3 }')
    # The fourth field is the bead's priority, carried through so the
    # unroutable report below can be proportionate to it (gqlc-2ve4). Every
    # `read` over this list takes it, including the ones that ignore it: with
    # `read -r id cls origin` the trailing field lands INSIDE `origin`, and the
    # inferred-class arm's `[ "$origin" = inferred ]` then never matches.
    routed=$(echo "$queue" | awk '$1 == "fresh" { print $2, $3, $4, $5 }')
    lowpri=$(echo "$queue" | awk '$1 == "lowpri" { print $2, $3 }')
    epics=$(echo "$queue" | awk '$1 == "epic" { print $2 }')

    # history: kingdom/brain/km-notes.md#cmd_dispatch-14
    local skipped=0 floor_cap=10 floor_named=0
    while IFS=' ' read -r id prio; do
        [ -n "$id" ] || continue
        skipped=$((skipped + 1))
        if [ "$floor_named" -lt "$floor_cap" ]; then
            echo "dispatch: below the floor $id — priority $prio, and [dispatch] max_priority is $maxprio; filed and searchable, routed to nobody"
            floor_named=$((floor_named + 1))
        fi
    done <<<"$lowpri"
    if [ "$skipped" -gt "$floor_named" ]; then
        echo "dispatch: below the floor — and $((skipped - floor_named)) more, not named here (${skipped} withheld in all by [dispatch] max_priority $maxprio); 'bd ready -n 0' lists every one"
    fi

    # And the epics, said the same way and for the same reason. Withheld, NEVER
    # dropped: the arm this one sits beside used to drop unlabelled beads
    # silently, and that drop is why 25 beads including a P0 were absent from
    # every dispatch run the town ever made (gqlc-38ye). The line names the
    # remedy, because a refusal an operator cannot act on is only a quieter
    # version of the same silence.
    local epic_n=0
    while IFS=' ' read -r id; do
        [ -n "$id" ] || continue
        echo "dispatch: epic $id — its issue_type is epic, so it is a container for work rather than work; it needs a Ճարտարապետ to decompose it into execution beads (assign it to one and it routes), not a seat to claim it. Routed to nobody."
        epic_n=$((epic_n + 1))
    done <<<"$epics"

    # And the same courtesy for the beads whose class this pass GUESSED. Said
    # before routing rather than after, so a bead the hold verdict later
    # withholds is still on the record as unlabelled — the line reports where
    # the class came from, not that a wake happened.
    local origin prio inferred=0
    while IFS=' ' read -r id cls origin prio; do
        [ -n "$id" ] || continue
        [ "$origin" = inferred ] || continue
        echo "dispatch: class inferred $id — it carries no class: label, so it is routed as class:$cls by default; label it to send it somewhere else, or let the Ռազմիկ escalate it (Constitution III.1)"
        inferred=$((inferred + 1))
    done <<<"$routed"

    # history: kingdom/brain/km-notes.md#cmd_dispatch-15
    local ids deps parents parent_ids docs verdicts="" held=0 verdict reason
    ids=$(
        awk 'NF { print $1 }' <<<"$routed"
        awk 'NF { print $2 }' <<<"$owned"
    )
    if [ -n "$ids" ]; then
        # shellcheck disable=SC2086 # deliberate word splitting: one call, all ids
        if ! deps=$(bd dep list $ids --json 2>/dev/null); then
            echo "dispatch: the dependency query failed; neither the owned nor the fresh pass routed this run (the resume wakes above stand)"
            return 0
        fi
        parent_ids=$(jq -r '[ .[]? | select(.type == "discovered-from") | .depends_on_id ] | unique | .[]' \
            <<<"$deps" 2>/dev/null) || parent_ids=""
        parents='[]'
        if [ -n "$parent_ids" ]; then
            # shellcheck disable=SC2086 # deliberate word splitting: one call, all ids
            if ! parents=$(bd show $parent_ids --json 2>/dev/null |
                jq -c 'if type == "array" then . else [.] end' 2>/dev/null); then
                echo "dispatch: the parent-status query failed; neither the owned nor the fresh pass routed this run (the resume wakes above stand)"
                return 0
            fi
        fi
        if ! docs=$(dispatch_candidate_docs "$ready" "$deps" "$parents" "$ids"); then
            echo "dispatch: the candidate documents could not be assembled; neither the owned nor the fresh pass routed this run (the resume wakes above stand)"
            return 0
        fi
        # history: kingdom/brain/km-notes.md#cmd_dispatch-16
        local hv_rc=0
        verdicts=$(cmd_hold_verdict <<<"$docs") || hv_rc=$?
        if [ "$hv_rc" != 0 ]; then
            # Never fall through to routing unchecked. Since gqlc-2n3d5 that
            # covers the owned pass as well, which is the fail-closed direction:
            # a run that could not ASK the hold question must not route a bead
            # merely because the bead already names a seat. The resume wakes
            # taken above stand, and an operator reading this during an incident
            # must be able to trust that sentence.
            echo "dispatch: hold-verdict failed (rc=$hv_rc); neither the owned nor the fresh pass routed this run (the resume wakes above stand)"
            return 0
        fi
    fi

    # history: kingdom/brain/km-notes.md#cmd_dispatch-17
    local ownable="" oseat oid
    while IFS=' ' read -r oseat oid; do
        [ -n "$oid" ] || continue
        verdict=$(awk -v i="$oid" '$2 == i { $1 = $1; print; exit }' <<<"$verdicts")
        if [ "$verdict" != "ROUTE $oid" ]; then
            reason=${verdict#HOLD "$oid" — }
            [ -n "$reason" ] || reason="no verdict returned for this bead"
            echo "dispatch: hold $oid — $reason; assigned to $oseat, and it is this hold rather than the cap that stopped it"
            held=$((held + 1))
            continue
        fi
        ownable+="$oseat $oid"$'\n'
    done <<<"$owned"
    route_owners "$ownable" "assigned work waiting — claim it before you begin"

    # Fresh pass: ready, unassigned, class-labelled beads, priority first. It
    # runs with no slots left too, because judge work does not need one.
    #
    # report_unroutable's accumulators; see its comment where it is defined.
    local unroutable=0 stalled=0 quiet="" stalled_beads=""

    local how
    while IFS=' ' read -r id cls origin prio; do
        [ -n "$id" ] || continue
        verdict=$(awk -v i="$id" '$2 == i { $1 = $1; print; exit }' <<<"$verdicts")
        # An explicit ROUTE is the only thing that routes. A hold and a bead the
        # verdict never mentioned take the same arm on purpose: the default for
        # anything we did not affirmatively clear is to leave it alone.
        if [ "$verdict" != "ROUTE $id" ]; then
            reason=${verdict#HOLD "$id" — }
            [ -n "$reason" ] || reason="no verdict returned for this bead"
            echo "dispatch: hold $id — $reason"
            held=$((held + 1))
            continue
        fi
        # `continue`, not `break`: the queue is sorted by priority, not by class,
        # so exhausted slots must skip past capped beads to reach judge work
        # sitting behind them rather than abandoning the rest of the queue.
        if [ "$cls" != judge ] && [ "$slots" -le 0 ]; then
            # Not silent any more. The aggregate `no free slot` line above
            # announces the condition but names nothing it held, so a P0 stuck
            # behind the cap was indistinguishable from a P0 nobody had filed.
            report_unroutable "$id" "$cls" "$prio" \
                "every capped slot is spent ($active/$max awake) and only judge work is exempt from the cap"
            continue
        fi
        # The seat is told too, not just the operator: a warrior who can see the
        # class was guessed knows escalation is on the table, and one who cannot
        # has to assume the bead was aimed at them deliberately.
        how=""
        [ "$origin" != inferred ] || how=" (class inferred — this bead carries no class: label; escalate if it is not warrior work)"
        # history: kingdom/brain/km-notes.md#cmd_dispatch-18
        if seat=$(free_worker_of_class "$cls"); then
            cmd_wake "$seat" --bead "$id" --reason "ready ${cls} work${how} — claim it once you have checked its assignee. If another seat already holds it that is an ordinary lost race, not a failure: take another ready bead rather than going back to sleep (citizen-protocol, Waking step 4)"
            wakes=$((wakes + 1))
            if [ "$cls" != judge ]; then slots=$((slots - 1)); fi
        else
            report_unroutable "$id" "$cls" "$prio" "$(class_roster_reason "$cls")"
        fi
    done <<<"$routed"

    # The counted arm, one line per (class, reason) rather than per bead. The
    # aggregate is what keeps ordinary backlog visible without drowning the P0
    # lines above it.
    if [ -n "$quiet" ]; then
        local qn qrest qcls qwhy
        while IFS=' ' read -r qn qrest; do
            [ -n "$qn" ] || continue
            qcls=${qrest%%|*}
            qwhy=${qrest#*|}
            echo "dispatch: unroutable — $qn $qcls bead(s) of priority $((DISPATCH_LOUD_PRIORITY + 1)) or worse found no seat: $qwhy"
        done < <(printf '%s' "$quiet" | sort | uniq -c | sed 's/^ *//')
    fi

    # The report the routing cannot make for itself. This run's passes are done;
    # a bead none of them could reach is named here rather than left to be found
    # by accident, which is how each of the previous three invisibility shapes
    # was found. It does not stop the run: routing is the job, and a diagnostic
    # that can abort it would be a worse failure than the one it reports. `km
    # doctor` is where the same fact is a gate that FAILS.
    local stranded
    if ! stranded=$(stranded_ids); then
        echo "dispatch: the reachability check could not run; the routing above stands"
    elif [ -n "$stranded" ]; then
        echo "dispatch: STRANDED — in progress and assigned to nobody, so no pass can wake anyone for them: $stranded"
    fi

    # And the second unreachable shape, one line per unresolvable NAME rather
    # than per bead, because the name is the thing an operator acts on: a
    # retired seat appears once with its whole holding behind it. Nothing is
    # reassigned or cleared here — see unreachable_owner_rows.
    local urows uname uids
    if ! urows=$(unreachable_owner_rows); then
        echo "dispatch: the assignee-resolution check could not run; the routing above stands"
    else
        while IFS=' ' read -r uname uids; do
            [ -n "$uname" ] || continue
            echo "dispatch: UNREACHABLE ASSIGNEE $uname — it is in neither [seats] nor [humans] in kingdom.toml, so every pass matching assignees against the seat roster skips this work and no wake will ever come for it; nothing has been reassigned: $uids"
        done <<<"$urows"
    fi

    # The escalation, after every pass has had its chance at the queue, so the
    # marker describes the run's final state and not an intermediate one.
    record_stalled_p0 "$stalled_beads"
    echo "dispatch: done ($wakes wake(s) this run, $held held, $epic_n epic, $skipped below max_priority $maxprio, $inferred class inferred, $withheld owner-withheld, $unroutable unroutable ($stalled at P0))"
}

# history: kingdom/brain/km-notes.md#hold_fetch_master

hold_fetch_master() {
    [ -z "${KM_HOLD_SKIP_FETCH:-}" ] || return 0
    timeout 30 git -C "$(main_root)" fetch --quiet origin master 2>/dev/null && return 0
    # Over-holding, and it self-heals next run: a stale origin/master can only
    # make a path look absent, never make an absent one look present.
    echo "hold-verdict: could not fetch; consulting a possibly-stale origin/master" >&2
}

hold_open_pr_files() { # -> [{number, files:[path], truncated}]; rc 1 if gh cannot answer
    local raw limit=100 got
    raw=$(timeout 30 gh pr list --state open --limit "$limit" --json number,changedFiles,files 2>/dev/null) || return 1
    # The LIST-level cap, one level up from the per-PR one below. gh offers no
    # list-level tell: asked for N it returns N whether N or 4N are open, so the
    # (N+1)th PR is indistinguishable from no PR — and every PR it DID return can
    # be individually complete, so the per-PR guard never fires. A full-length
    # list is an unknown list; degrade to the hold a gh outage already takes.
    got=$(printf '%s' "$raw" | jq 'length' 2>/dev/null) || return 1
    if [ "$got" = "$limit" ]; then
        # Named on stderr because the reason line downstream says "gh unavailable",
        # which is true of the answer but not of the cause; without this the
        # journal sends an operator looking for an outage that did not happen.
        echo "hold-verdict: gh returned $got open PRs against a limit of $limit — the list may be truncated, holding" >&2
        return 1
    fi
    # MEASURED 2026-08-22 on PR #742: changedFiles 102, files 100 — `--json files`
    # caps per PR and says nothing. A capped list is an UNKNOWN list, not a
    # complete one; reading it as complete fails OPEN on the largest PRs.
    # changedFiles is the cap-independent tell, so no threshold is guessed here.
    printf '%s' "$raw" | jq -c '[ .[] | {
        number,
        files: [ .files[]?.path ],
        listed: (.files | length),
        changed: .changedFiles,
        truncated: (.changedFiles > (.files | length))
    } ]' 2>/dev/null || return 1
}

# history: kingdom/brain/km-notes.md#branch_pr_state
branch_pr_state() {
    local name=$1 raw count open
    [ -n "$name" ] || { echo unanswered; return 0; }
    raw=$(timeout 30 gh pr list --head "$name" --state all \
        --json state,headRefOid --limit 50 2>/dev/null) || { echo unanswered; return 0; }
    count=$(printf '%s' "$raw" | jq 'length' 2>/dev/null) || { echo unanswered; return 0; }
    if [ "$count" -eq 0 ]; then
        echo none
        return 0
    fi
    open=$(printf '%s' "$raw" | jq '[.[] | select(.state=="OPEN")] | length' 2>/dev/null) || { echo unanswered; return 0; }
    if [ "$open" -gt 0 ]; then
        echo open
        return 0
    fi
    echo finished
}

hold_paths_on_master() { # subjects on stdin, one per line -> {"<path>": true|false}
    local mr s present out='{}'
    mr=$(main_root)
    while IFS= read -r s; do
        [ -n "$s" ] || continue
        if git -C "$mr" cat-file -e "origin/master:$s" 2>/dev/null; then present=true; else present=false; fi
        out=$(printf '%s' "$out" | jq -c --arg s "$s" --argjson p "$present" '.[$s] = $p')
    done
    printf '%s' "$out"
}

cmd_hold_verdict() {
    no_args hold-verdict "$@"
    local input
    input=$(cat)
    if ! printf '%s' "$input" | jq -e 'type == "array"' >/dev/null 2>&1; then
        die "hold-verdict: stdin is not a JSON array of candidate documents"
    fi

    local subjects
    subjects=$(printf '%s' "$input" | jq -r '
        [ .[]? | select(type == "object") | .labels
          | select(type == "array") | .[]
          | select(type == "string" and startswith("subject:"))
          | .[8:] | sub("/+$"; "") | select(length > 0) ] | unique | .[]')

    # gh and the fetch cost a network round trip each, so they are paid only
    # when some candidate actually declares a subject. That is also what keeps
    # the ordinary-bead path — the overwhelming majority — free, and the test
    # suite hermetic without stubbing anything for it.
    local prs='[]' pr_known=true present='{}'
    if [ -n "$subjects" ]; then
        hold_fetch_master
        if ! prs=$(hold_open_pr_files); then
            prs='[]'
            pr_known=false
        fi
        present=$(printf '%s\n' "$subjects" | hold_paths_on_master)
    fi

    # On descriptors for the same reason dispatch_candidate_docs is, and before
    # rather than after it fires: $prs carries every open PR's full file list, so
    # it grows with the PR queue exactly as the ready payload grows with the bead
    # queue. Measured 2026-08-22 at 26 open PRs it was already within ~30% of the
    # 131072-byte per-argument ceiling. $prKnown is a bare true/false and could
    # stay in argv; it moves anyway, so that no future reader has to work out
    # which of three adjacent bindings was the safe one.
    printf '%s' "$input" | jq -r \
        --slurpfile prs <(printf '%s' "$prs") \
        --slurpfile prKnown <(printf '%s' "$pr_known") \
        --slurpfile present <(printf '%s' "$present") '
        ($prs[0]) as $prs | ($prKnown[0]) as $prKnown | ($present[0]) as $present |
        # (.labels // []) at both sites, and it is the same normalisation the
        # rest of this file already applies at five others (km:601, 609, 650,
        # and the two ready-queue counters in cmd_status). bd serialises a bead
        # carrying no labels as `labels: null`, so a bare `.labels[]` aborts jq
        # on the COMMONEST candidate shape in the town.
        def subjects_of:
            [ (.labels // [])[] | select(type == "string" and startswith("subject:"))
              | .[8:] | sub("/+$"; "") | select(length > 0) ];

        def is_judge: any((.labels // [])[]; . == "class:judge");

        # history: kingdom/brain/km-notes.md#cmd_hold_verdict
        def malformed:
            if type != "object" then "not an object"
            elif (.id | type) != "string" or (.id == "") then "no id"
            elif (.labels != null) and ((.labels | type) != "array")
                then "labels is \(.labels | type), not an array"
            else null end;

        # The slash boundary is the whole point of the second clause: a plain
        # substring test would hold internal/tools/tmpreaper for a PR touching
        # internal/tools/tmpreap, which are different subsystems.
        def touching($s): [ $prs[] | select(any(.files[]; . == $s or startswith($s + "/"))) ];

        # history: kingdom/brain/km-notes.md#cmd_hold_verdict-2
        def reason($s; $judge):
            if ($present[$s] // false) | not then
                "premise absent from origin/master: \($s)"
            elif $judge then null
            elif ($prKnown | not) then
                "gh unavailable — cannot rule out an open PR touching \($s)"
            elif (touching($s) | length) > 0 then
                # Before the truncation arm on purpose: a match in the VISIBLE
                # list of a truncated PR is still a definite match, and the
                # reason printed must be as strong as the evidence held.
                "open PR #\(touching($s)[0].number) touches \($s)"
            elif ([ $prs[] | select(.truncated) ] | length) > 0 then
                ([ $prs[] | select(.truncated) ][0]) as $t
                | "open PR #\($t.number) lists \($t.listed) of \($t.changed) files — cannot rule out \($s)"
            else null end;

        .[]
        | . as $c
        | (if (type == "object") and ((.id | type) == "string") then .id else "?" end) as $id
        | (malformed) as $bad
        | if $bad != null then "HOLD \($id) — malformed candidate: \($bad)"
          else
            (subjects_of) as $subs
            | if ($subs | length) == 0 then
                # Residue with no subject label yet. Only discovered-from carries
                # the "filed against that PR" meaning; until and related do not.
                [ ($c.deps // [])[] | select(type == "object")
                  | select(.type == "discovered-from")
                  # "not closed", never a whitelist of the states known today: a
                  # whitelist clears every state it has not met — including the
                  # empty subset bd returns for an id it cannot find — and that
                  # clearing is the fail-OPEN direction.
                  | select(.status != "closed") ] as $par
                # Exempt for a review: the printed remedy of this arm — add a
                # subject: label — is what trips the PR arm above, and the
                # parent cannot close until the PR merges, which needs this
                # review. Two doors, one deadlock (gqlc-n4oe).
                | if ($par | length) > 0 and (is_judge | not)
                  then "HOLD \($id) — unlabelled residue of open \($par[0].depends_on_id) — needs a subject: label"
                  else "ROUTE \($id)" end
              else
                (is_judge) as $judge
                | [ $subs[] | reason(.; $judge) | select(. != null) ] as $why
                | if ($why | length) > 0 then "HOLD \($id) — \($why[0])" else "ROUTE \($id)" end
              end
          end'
}

# history: kingdom/brain/km-notes.md#reap_scratch
reap_scratch() {
    local repo out rc=0
    if ! have_just; then
        # Named rather than skipped silently. On this host just is at
        # /usr/bin/just and is on the systemd user manager's PATH, so an absent
        # one means the environment changed underneath the unit — which is
        # exactly the shape of a cadence that stops firing without a symptom
        # until the filesystem fills months later.
        echo "guard-sweep: scratch not reaped — just is not on PATH, so nothing reclaims /tmp on a cadence" >&2
        return 0
    fi
    repo=$(deploy_root)
    if [ ! -f "$repo/justfile" ]; then
        echo "guard-sweep: scratch not reaped — no justfile in $repo" >&2
        return 0
    fi
    out=$(cd "$repo" && timeout "${KM_REAP_TIMEOUT:-600}" just tmp-reap-cadence 2>&1) || rc=$?
    if [ "$rc" -ne 0 ]; then
        echo "guard-sweep: scratch reap exited $rc — ${out//$'\n'/ }" >&2
        return 0
    fi
    # Reported on stdout on EVERY tick, including the quiet ones. The journal is
    # the only reader a timer has, and a line that appears only when something
    # was deleted cannot distinguish a healthy filesystem from a reaper that
    # stopped running (bd gqlc-vze6's own finding: the reaper nobody invokes).
    echo "guard-sweep: scratch — ${out//$'\n'/ }"
}

# history: kingdom/brain/km-notes.md#guard_unanswered
guard_unanswered() { # -> "seat(n, status) …", empty when nobody is holding two
    local s n out=""
    for s in $(seats_all); do
        [ "$s" = raffi ] && continue
        n=$(mail_unread_from "$s" raffi)
        [ "$n" -ge 2 ] || continue
        out="$out $s($n, $(seat_status "$s"))"
    done
    printf '%s' "${out# }"
}

cmd_guard_sweep() {
    # Above ensure_deployed, for the reason given in cmd_dispatch.
    no_args guard-sweep "$@"
    ensure_deployed guard-sweep "$@" || return 1
    # history: kingdom/brain/km-notes.md#cmd_guard_sweep
    reap_scratch
    session_up || { echo "guard-sweep: $(town_absent_reason $?)"; return 0; }
    # history: kingdom/brain/km-notes.md#cmd_guard_sweep-2
    local sd
    sd=$(state_dir)
    if [ -f "$sd/halt" ]; then
        echo "guard-sweep: halted — $(head -1 "$sd/halt")"
        return 0
    fi
    if [ "$(seat_status raffi)" = awake ]; then
        echo "guard-sweep: Րաֆֆի is already on his rounds"
        return 0
    fi
    file_patrol_bead
    tell_dirty_authors
    local reason="time for a round of the town (see your soul: rounds)" unanswered
    unanswered=$(guard_unanswered)
    if [ -n "$unanswered" ]; then
        reason="$reason. Letters of yours nobody has read: $unanswered. Unread is evidence of UNSEEN, not of declined, so do not write a gentler version of a letter that was never in front of anyone — escalate instead, and read kingdom/brain/playbooks/mail.md ('When a letter goes unanswered') for the ladder, including the case where the seat you would escalate TO is the seat you are writing ABOUT"
    fi
    cmd_wake raffi --reason "$reason"
}

# history: kingdom/brain/km-notes.md#patrol_open_ids
patrol_open_ids() { # <board json>
    jq -r '[ .[]
             | select(.status != "closed")
             | select((.labels // []) | index("patrol"))
             | .id ] | join(" ")' <<<"$1" 2>/dev/null
}

# history: kingdom/brain/km-notes.md#patrol_window_is_empty
patrol_window_is_empty() { # <root> <since> ; rc 0 ONLY when measured empty
    local root=$1 since=$2 out rc=0
    local KM_GIT_TIMEOUT="${KM_GIT_TIMEOUT:-30}"
    if ! git_at "$root" rev-parse --verify -q origin/master >/dev/null 2>&1; then
        echo "guard-sweep: patrol window could not be measured — origin/master is unknown in $root; filing rather than dropping a round" >&2
        return 1
    fi
    out=$(git_at "$root" log -1 --format=%H --since="$since" origin/master 2>/dev/null) || rc=$?
    if [ "$rc" -ne 0 ]; then
        echo "guard-sweep: patrol window could not be measured — git exited $rc in $root; filing rather than dropping a round" >&2
        return 1
    fi
    [ -z "$out" ]
}

file_patrol_bead() {
    local board open since window rc=0
    board=$(bd list --status all -n 0 --json 2>/dev/null) || rc=$?
    if [ "$rc" -ne 0 ] || ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"$board"; then
        # A bound that cannot be measured is not raised. Filing blind here
        # would add a patrol bead every cadence for as long as bd was unwell,
        # which is the queue this function exists to prevent.
        echo "guard-sweep: patrol not filed — the board query did not answer, so the one-open bound could not be measured" >&2
        return 0
    fi
    open=$(patrol_open_ids "$board")
    if [ -n "$open" ]; then
        echo "guard-sweep: patrol already open ($open) — the bound is one"
        return 0
    fi
    # The window is FRESH: it begins where the last patrol ended, because one
    # starting at the founding commit re-reads what has already been read.
    since=$(jq -r '[ .[]
                     | select((.labels // []) | index("patrol"))
                     | select(.status == "closed")
                     | .closed_at // empty ] | max // empty' <<<"$board" 2>/dev/null)
    if [ -n "$since" ]; then
        if patrol_window_is_empty "$(deploy_root)" "$since"; then
            echo "guard-sweep: patrol not filed — no merge to master since the previous patrol bead closed at $since, so the round would have nothing to read"
            return 0
        fi
        window="merges to master since the previous patrol bead closed, at $since"
    else
        window="merges to master in the recent window — no previous patrol bead exists to start from, and the founding commit would re-read what has already been read, so take a window you can read properly and name it in your close"
    fi
    if ! bd create "patrol: read merged work since the last patrol round" \
        -p 2 -l class:judge,patrol \
        -d "Filed by km guard-sweep. See kingdom/brain/decisions/0004-the-adversarial-read-after-the-gate.md section 2.

WINDOW: $window.

TARGET: merges whose PR was NOT reviewed. Under ADR 0003 a PR is read by a judge only if its bead was blocked by a design bead, if it amends the constitution, or if a citizen asked; everything else merged on green gates alone.

OUTPUT: defect beads, and a postmortem where something broke (Constitution V.4, Article III.4). Never a verdict — nothing in the window is open to one, the code has merged. A defect bead about already-merged code carries from-pr:<N>, the number of the PR that introduced it, and omits the label rather than guessing where no single PR can be identified (ADR 0004 section 3). That label is the only record Constitution V.2.0.4 will have when the town re-tunes its review gate.

DEPTH is yours. A round that reads one merge properly is a round. Closing this bead asserts NOTHING about the window being clean, and no citizen should read its closure that way.

BOUND: exactly one patrol bead is open at a time, permanently, whatever the merge rate (ADR 0004 section 2). This one was filed because none was open." >/dev/null 2>&1; then
        echo "guard-sweep: patrol bead could not be filed — bd create refused" >&2
        return 0
    fi
    echo "guard-sweep: filed a patrol bead — no open one was on the board"
}

# history: kingdom/brain/km-notes.md#dirty_open_prs

# `gh pr view --json mergeable` is the WRONG instrument and its wrongness is
# part of the decision: GitHub recomputes mergeability lazily after any push
# and returns UNKNOWN meanwhile, which a naive check reads as "not
# conflicting". Արամազդ's first pass with it reported 2 DIRTY where there were
# 7. This asks git instead, locally, against a ref it has just fetched.
dirty_open_prs() { # -> TSV number, head oid, head branch; rc 1 if gh cannot answer
    local raw got limit="${KM_DIRTY_PR_LIMIT:-100}"
    raw=$(timeout 30 gh pr list --state open --limit "$limit" \
        --json number,headRefOid,headRefName 2>/dev/null) || return 1
    got=$(jq 'length' <<<"$raw" 2>/dev/null) || return 1
    # A full-length list is an UNKNOWN list: gh offers no list-level tell, so
    # the (N+1)th PR is indistinguishable from no PR. Same reasoning as
    # hold_open_pr_files, and the same degradation.
    [ "$got" != "$limit" ] || return 1
    jq -r '.[] | select(.headRefOid != null and .headRefName != null)
                 | [ (.number | tostring), .headRefOid, .headRefName ] | @tsv' \
        <<<"$raw" 2>/dev/null
}

# history: kingdom/brain/km-notes.md#dirty_conflicted_paths
dirty_conflicted_paths() { # <root> <base ref> <head oid> -> paths; rc 1 = unknown
    local root=$1 base=$2 head=$3 out rc=0
    local KM_GIT_TIMEOUT="${KM_GIT_TIMEOUT:-30}"
    git_at "$root" rev-parse --verify --quiet "$head^{commit}" >/dev/null 2>&1 || return 1
    out=$(git_at "$root" merge-tree --write-tree --name-only "$base" "$head" 2>/dev/null) || rc=$?
    [ "$rc" -ne 0 ] || return 0
    # Line 1 is the written tree's oid; the conflicted names run to the first
    # blank line, after which merge-tree's informational messages begin.
    printf '%s\n' "$out" | awk 'NR == 1 { next } /^$/ { exit } { print }'
}

# Every PR here is pushed by one GitHub account, so `author.login` names the
# machine and not the citizen. The bead is what carries a seat, so the branch
# name is read for bead ids and the first one with a seat assignee is the
# author. A PR whose branch names no assigned bead is reported to Սեդրակ
# instead of being dropped: an unattributable DIRTY PR is exactly the case a
# human has to look at, and the suppression key below bounds it to one message.
dirty_author_of() { # <head branch> -> seat name
    local branch=$1 ids show who
    ids=$(grep -oE 'gqlc-[a-z0-9]+' <<<"$branch" | sort -u | tr '\n' ' ')
    if [ -n "${ids// /}" ]; then
        # shellcheck disable=SC2086 # deliberate word split: bd takes ids as separate args
        show=$(bd show $ids --json 2>/dev/null) || show=""
        if [ -n "$show" ]; then
            who=$(jq -r '[ .[]? | select(type == "object") | .assignee // empty ][0] // empty' \
                <<<"$show" 2>/dev/null)
            if [ -n "$who" ] && is_seat "$who"; then
                echo "$who"
                return 0
            fi
        fi
    fi
    echo sedrak
}

tell_dirty_authors() {
    local prs root sd told n oid branch paths who key
    if ! prs=$(dirty_open_prs); then
        echo "guard-sweep: DIRTY census skipped — gh could not answer for the open PRs" >&2
        return 0
    fi
    [ -n "$prs" ] || return 0
    root=$(main_root)
    # The census compares against origin/master and against heads it does not
    # own, so a stale remote would report conflicts that were resolved hours
    # ago. A failed fetch is NOT fatal — the same over-reporting the hold
    # verdict accepts — but it is said out loud, because a false DIRTY mail
    # costs the recipient a rebase they do not need.
    local KM_GIT_TIMEOUT="${KM_FETCH_TIMEOUT:-60}"
    git_at "$root" fetch --quiet origin 2>/dev/null \
        || echo "guard-sweep: DIRTY census could not fetch; reading a possibly-stale origin" >&2
    sd=$(state_dir)
    told="$sd/dirty-told"
    mkdir -p "$told"
    while IFS=$'\t' read -r n oid branch; do
        if [ -z "$n" ] || [ -z "$oid" ]; then continue; fi
        if ! paths=$(dirty_conflicted_paths "$root" origin/master "$oid"); then
            echo "guard-sweep: PR #$n — git could not merge-test $oid (a deleted branch?); not reported" >&2
            continue
        fi
        [ -n "$paths" ] || continue
        who=$(dirty_author_of "$branch")
        # Keyed on the HEAD, so a rebase or a new push earns a fresh message and
        # a head that has not moved earns silence. The cadence is minutes; a
        # tell that arrives every two minutes is a tell nobody reads.
        key="$told/$n-$oid-$who"
        [ -e "$key" ] && continue
        if mail_send "$who" --from sedrak \
            -s "PR #$n has gone DIRTY" \
            -m "Your open PR #$n ($branch, head $oid) no longer merges into origin/master.

Conflicted paths:
  ${paths//$'\n'/$'\n'  }

You almost certainly did not cause this. A merge that appends to a shared registry invalidates every open PR that appends to the same registry (ADR 0006, kingdom/brain/decisions/0006-a-head-that-moves-under-a-reader.md).

Rebase on origin/master, re-run the gates, and force-push. If a judge is reading this PR, warn them BEFORE you push, and state the delta as a merge-base comparison rather than a commit list — a rebase makes 'git log old..new' read as fix work (ADR 0006 section 3).

Measured by km guard-sweep with 'git merge-tree --write-tree --name-only', not with gh's mergeable field, which returns UNKNOWN while GitHub recomputes and reads as clean." 2>/dev/null; then
            : >"$key"
            echo "guard-sweep: PR #$n is DIRTY — told $who"
        else
            echo "guard-sweep: PR #$n is DIRTY but the message to $who could not be sent" >&2
        fi
    done <<<"$prs"
}

# ---------- unit health ----------

# systemd answers Result=success for a unit that has never fired AND for one
# that is not installed at all — measured 2026-08-22: LoadState=not-found came
# back with Result=success — so health cannot be read off Result alone.
unit_health() { # <unit> -> "ok …" | "FAILED …" | "NEVER RUN …" | "NOT INSTALLED …" | "UNKNOWN …"
    local props line load="" active="" last="" result="" code=""
    if ! props=$(systemctl --user show "$1" \
        -p LoadState -p ActiveState -p InactiveEnterTimestamp -p Result -p ExecMainStatus 2>/dev/null); then
        echo "UNKNOWN — systemctl could not answer (is there a user bus?)"
        return 0
    fi
    # By key, never by position: systemd returns the properties in its own
    # order, not the order they were asked for.
    while IFS= read -r line; do
        case "$line" in
            LoadState=*) load=${line#*=} ;;
            ActiveState=*) active=${line#*=} ;;
            InactiveEnterTimestamp=*) last=${line#*=} ;;
            Result=*) result=${line#*=} ;;
            ExecMainStatus=*) code=${line#*=} ;;
        esac
    done <<<"$props"
    if [ "$load" != loaded ]; then
        echo "NOT INSTALLED — $1 is ${load:-absent} (km install-units)"
    elif [ "$active" = activating ] || [ "$active" = active ]; then
        # history: kingdom/brain/km-notes.md#unit_health
        echo "UNKNOWN — $1 is $active right now, so its last run was not measured"
    elif [ -z "$last" ]; then
        # history: kingdom/brain/km-notes.md#unit_health-2
        local timer=${1%.service}.timer tprops="" tload="" tactive=""
        if ! tprops=$(systemctl --user show "$timer" -p LoadState -p ActiveState 2>/dev/null); then
            echo "UNKNOWN — $1 has no run on record and $timer could not be asked why (is there a user bus?)"
            return 0
        fi
        while IFS= read -r line; do
            case "$line" in
                LoadState=*) tload=${line#*=} ;;
                ActiveState=*) tactive=${line#*=} ;;
            esac
        done <<<"$tprops"
        if [ "$tload" != loaded ]; then
            echo "NOT SCHEDULED — $timer is ${tload:-absent}, so nothing will fire $1 (km install-units)"
        elif [ "$tactive" != active ] && [ "$tactive" != activating ]; then
            # An installed-but-inactive timer is also what one that was never
            # started looks like, so this sentence may not narrate a stop
            # (gqlc-rnndr) any more than the old one could narrate a never-run.
            echo "NOT SCHEDULED — $timer is $tactive, so nothing will fire $1; whether it ran before is not in systemd's memory ('systemctl --user enable --now $timer')"
        else
            echo "NO RUN ON RECORD — $timer is $tactive, but systemd holds no finished run of $1"
        fi
    elif [ "$result" != success ]; then
        echo "FAILED — last run $last ($result, exit ${code:-?}): journalctl --user -u $1"
    else
        echo "ok (last run $last)"
    fi
}

# ---------- status ----------

# history: kingdom/brain/km-notes.md#status_unresponsive_after
status_unresponsive_after() { cfg_minutes welfare unresponsive_after_minutes 30; }

# history: kingdom/brain/km-notes.md#status_stalled_after
status_stalled_after() { cfg_minutes welfare stalled_after_minutes 20; }

# history: kingdom/brain/km-notes.md#seat_escalated_tag
seat_escalated_tag() { # <seat> -> " ESCALATED <age>" if the ladder has stopped asking
    local m
    m="$(seat_home "$1")/idle-escalated"
    [ -f "$m" ] || return 0
    printf ' ESCALATED %s' "$(fmt_age "$(($(date +%s) - $(stat -c %Y "$m")))")"
}

# Compact enough for a column: 45s, 12m, 3h20m.
fmt_age() { # <seconds>
    local s=$1
    if [ "$s" -lt 60 ]; then printf '%ds' "$s"
    elif [ "$s" -lt 3600 ]; then printf '%dm' "$((s / 60))"
    else printf '%dh%02dm' "$((s / 3600))" "$(((s % 3600) / 60))"
    fi
}

cmd_status() {
    no_args status "$@"
    local sd s disp class st stcol boxstate ctx hb beads unread age hbcol stale frozen="" blind="" idle="" boxed=""
    local target tree fresh fstate fball fbgates fahead fdetail stalewt="" exposed="" unjudged=""
    local workcol wage sage dry wedged="" nowork="" unwitnessed=""
    local stall stall_age stall_list wake_age undrained=""
    local launch launchcol launchsay mislaunched=""
    sd=$(state_dir)
    echo "Թագաւորութիւն — $(date -u -Iseconds)"
    if session_up; then echo "town: UP (herdr workspace '$WORKSPACE')"
    else echo "town: $(case $? in 2) echo 'UNKNOWN — the herdr workspace list did not parse (diagnosis above)' ;; 3) echo 'UNKNOWN — km could not ask herdr whether its server is running (diagnosis above)' ;; *) echo DOWN ;; esac)"; fi
    if [ -f "$sd/halt" ]; then
        # The age rides the line because a transient halt outliving its cause
        # is invisible behind any timestamp subtraction (bd gqlc-ozfr: one ran
        # ~6.5h past its cause). mtime is the raise moment; km never edits it.
        local hage=$(( $(date +%s) - $(stat -c %Y "$sd/halt") )) htxt
        if [ "$hage" -ge 3600 ]; then
            htxt="$(printf '%dh%02dm' $((hage / 3600)) $(((hage % 3600) / 60)))"
        elif [ "$hage" -ge 60 ]; then
            htxt="$((hage / 60))m"
        else
            htxt="under a minute"
        fi
        echo "HALT: $(head -1 "$sd/halt") — up $htxt"
    fi
    # A dispatcher refusing on drift is otherwise visible only in the journal
    # (bd gqlc-vzpn), so the town's one glance carries it.
    if ! deployed_ok; then
        echo "DRIFT: $(deploy_root) is not origin/master in kingdom/, .githooks/ or .claude/ — the timers refuse, and the hooks that run there are the stale copies, until 'km deploy'"
    fi
    # In the HEADER and not among the trailing marks: this is the town's highest
    # work standing still, and it is invisible in every other cell of this board
    # by construction — each seat is legitimately working or legitimately
    # resting, and the bead reaching nobody is a property of the pair (gqlc-tz95).
    if stall=$(stalled_p0_render); then
        stall_age=${stall%%$'\t'*}
        stall_list=${stall#*$'\t'}
        echo "STALLED P0: $stall_list oldest $(fmt_age "$stall_age") — ready P0 work the last dispatch run could hand to no seat. Recorded by the dispatcher, so it is as old as its last run; it clears itself on the first run that can route it. Nothing here wakes anyone (VI.2): free a seat, or take it yourself."
    fi
    echo

    # history: kingdom/brain/km-notes.md#cmd_status
    local inprog inprog_ok=1
    inprog=$(bd list --status in_progress -n 0 --json 2>/dev/null |
        jq -r '.[] | select(.assignee != null) | "\(.assignee) \(.id)"') || { inprog=""; inprog_ok=0; }

    stale=$(status_unresponsive_after)
    dry=$(status_stalled_after)
    # No fetch: see seat_freshness. An absent ref makes every TREE cell "?" and
    # prints the UNJUDGED line below, rather than letting sixteen unanswered
    # questions render as sixteen healthy seats.
    target=$(git_at "$(main_root)" rev-parse --verify --quiet origin/master 2>/dev/null || true)
    printf '%-10s %-10s %-9s %-6s %-7s %-8s %-7s %-6s %-6s %s\n' SEAT CLASS STATE CTX HB WORK TREE LAUNCH MAIL BEADS
    for s in $(seats_all); do
        disp=$(seat_display "$s")
        class=$(seat_class "$s")
        st=$(seat_status "$s")
        if [ "$st" = awake ] && ! window_up "$s"; then st="awake?"; fi
        # history: kingdom/brain/km-notes.md#cmd_status-2
        stcol="$st"
        if [ "$st" = awake ] && seat_pane_idle "$s"; then
            # BOXED is a refinement of IDLE, not a population beside it, and a
            # boxed seat is deliberately taken OUT of idle rather than listed in
            # both. IDLE's stated remedy is `km sleep --seat <seat>`, which
            # routes through send_line and is refused by the very box this
            # detects — so leaving a boxed seat on the IDLE line hands the
            # operator a remedy that cannot work, which is worse than the
            # silence it replaces.
            #
            # Costs one extra pane read per already-idle seat, and only for
            # those: the working majority never reaches this branch.
            boxstate=$(seat_box_state "$s")
            if [ "$boxstate" != none ]; then
                stcol="awake-box"
                boxed="$boxed $s($boxstate)"
            else
                stcol="awake-idle"
                idle="$idle $s"
            fi
        fi
        ctx="-"
        hbcol="-"
        workcol="-"
        hb="$sd/seats/$s/heartbeat.json"
        # BOTH live statuses, not `awake` alone. Անահիտ was frozen under
        # asleep-pending — she had written her handoff and run `km sleep`, and
        # the shutdown modal ate the exit — so a column that only looked at
        # awake seats would have shown a dash for the worse of the two freezes
        # (gqlc-eier).
        case "$st" in
            awake | 'awake?' | asleep-pending)
                if [ -f "$hb" ]; then
                    ctx=$(jq -r 'if .context_pct == null then "-" else "\(.context_pct | floor)%" end' "$hb" 2>/dev/null || echo "-")
                    # The evidence was already on disk, in the file this table
                    # opens, and the table read context_pct and threw the
                    # timestamp away. That discard is the whole bug.
                    if age=$(heartbeat_age "$s"); then
                        hbcol=$(fmt_age "$age")
                        if [ "$age" -ge "$stale" ]; then
                            hbcol="$hbcol!"
                            frozen="$frozen $s($hbcol)"
                        fi
                    else
                        # Unknown, never zero: a heartbeat that cannot be parsed
                        # says nothing about the seat, and "0s" would say the
                        # most reassuring possible thing.
                        hbcol="?"
                    fi
                elif ! seat_can_report "$s"; then
                    # A live seat with no heartbeat file at all. Left as a dash
                    # this is the third reading of a blank the board already had
                    # two readings for, and the one that says the INSTRUMENT is
                    # out — so it is named rather than rendered as quiet
                    # (gqlc-h17n).
                    hbcol="blind"
                    blind="$blind $s"
                fi
                # The WORK column, and the reason it cannot be folded into HB:
                # the two columns answer different questions and the whole of
                # gqlc-r3ac is that they disagree. HB says the instrument
                # reported. WORK says a tool call FINISHED — the only event on
                # this seat that nothing on a timer produces. A seat wedged on a
                # modal keeps a fresh HB forever and its WORK age climbs from the
                # moment it froze.
                if ! sage=$(progress_age "$s" .last_start); then sage=""; fi
                if ! wage=$(progress_age "$s" .last_progress); then wage=""; fi
                if [ -z "$sage" ] && [ -z "$wage" ]; then
                    if [ -f "$sd/seats/$s/progress.json" ]; then
                        # Present and unreadable. Unknown, never an age: see the
                        # HB column's "?" above for the same argument.
                        workcol="?"
                    elif ! seat_can_witness "$s"; then
                        workcol="unwired"
                        unwitnessed="$unwitnessed $s"
                    fi
                    # A wired seat that has simply not run a tool yet keeps the
                    # dash. That blank was always the correct reading and the
                    # arm above exists so it stops being the ONLY reading.
                elif seat_tool_in_flight "$s"; then
                    # Leading * — a tool call that started and has not come back.
                    # The age is from the NEWEST start, so several calls in one
                    # block understate a wedge: late, never early.
                    workcol="*$(fmt_age "$sage")"
                    if [ "$sage" -ge "$dry" ]; then
                        workcol="$workcol!"
                        # The reason stays the THIRD word — the WEDGED line below
                        # says so, and the escalation tag is appended after it so
                        # that claim survives the tag being present.
                        wedged="$wedged $s($workcol $(progress_field "$s" .last_tool || echo tool) $(seat_wedge_reason "$s")$(seat_escalated_tag "$s"))"
                    fi
                else
                    workcol=$(fmt_age "$wage")
                    if [ "$wage" -ge "$dry" ]; then
                        workcol="$workcol!"
                        nowork="$nowork $s($workcol$(seat_escalated_tag "$s"))"
                    fi
                fi
                ;;
        esac
        # The tree the seat is STANDING IN. Everything else in this table is
        # read out of the state dir, which is shared, so it is identical for
        # every seat and identically right — and a seat parked fifteen hours
        # back renders exactly like one at master (gqlc-d38n). Its own board is
        # not blank, it is WRONG AND PLAUSIBLE: Րաֆֆի the guard read a roster
        # with one judge in it, from a detached HEAD 14 commits behind, and
        # correctly concluded the roster was broken.
        fresh=$(seat_freshness "$s" "$target")
        read -r fstate fball fbgates fahead fdetail <<<"$fresh"
        : "$fahead $fdetail"
        case "$fstate" in
            current) tree="ok" ;;
            parked)
                tree="-$fball"
                if [ "$fbgates" -gt 0 ]; then tree="$tree!"; fi
                if [ "$fball" -gt 0 ]; then stalewt="$stalewt $s(-$fball)"; fi
                ;;
            working)
                if [ "$fball" -eq 0 ]; then tree="wip"; else tree="wip-$fball"; fi
                if [ "$fbgates" -gt 0 ]; then tree="$tree!"; fi
                ;;
            published)
                # Reported in working's shape rather than parked's — a
                # published branch is legitimately behind, not stale. The
                # finished-ness question is not asked here: 0008 keeps the
                # board offline; seat_refresh_step consults gh in the acting
                # path and prints its verdict there.
                if [ "$fball" -eq 0 ]; then tree="pub"; else tree="pub-$fball"; fi
                if [ "$fbgates" -gt 0 ]; then tree="$tree!"; fi
                ;;
            *) tree="?"; unjudged="$unjudged $s" ;;
        esac
        if [ "$fbgates" -gt 0 ]; then exposed="$exposed $s($fbgates)"; fi
        # history: kingdom/brain/km-notes.md#cmd_status-3
        if [ "$st" = asleep ]; then
            wake_age=$(seat_wake_queue_age "$s")
            if [ -n "$wake_age" ] && [ "$wake_age" -ge 60 ]; then
                undrained="$undrained $s($(fmt_age "$wake_age"))"
            fi
        fi
        # A COLUMN and not only the line below it, so that every seat is
        # separately judged and none can go silent: an aggregate that prints
        # nothing reads the same whether sixteen seats conform or sixteen were
        # never measured, and that equivalence is the one this file is organised
        # against. The line then NAMES the flag, because "seat X is
        # misconfigured" sends the next operator back to the process table.
        launch=$(seat_launch_state "$s")
        launchcol=${launch%%$'\t'*}
        launchsay=${launch#*$'\t'}
        if [ "$launchcol" != "-" ] && [ "$launchcol" != ok ] && [ -n "$launchsay" ]; then
            mislaunched="$mislaunched $s($launchcol: $launchsay)"
        fi
        unread=$(unread_count "$s")
        if [ "$inprog_ok" -eq 0 ]; then
            # "?" and never the em dash: the dash is this column's word for
            # "nothing in flight", and printing it over a query that never
            # returned is the fail-open shape itself.
            beads="?"
        else
            beads=$(echo "$inprog" | awk -v s="$s" '$1 == s { printf "%s ", $2 }')
        fi
        printf '%-10s %-10s %-9s %-6s %-7s %-8s %-7s %-6s %-6s %s  (%s)\n' "$s" "$class" "$stcol" "$ctx" "$hbcol" "$workcol" "$tree" "$launchcol" "$unread" "${beads:-—}" "$disp"
    done
    if [ -n "$frozen" ]; then
        echo "UNRESPONSIVE:$frozen — no heartbeat for over $(fmt_age "$stale"); read the pane before believing the STATE column. A frozen seat holds its slot, answers no mail, and reports as healthy. Do not end the session: a modal is not consent (VI.2)."
    fi
    if [ -n "$boxed" ]; then
        echo "BOXED:$boxed — awake and idle, with TEXT SITTING UNSUBMITTED in the input box, so no transport in this town can reach these seats at all. send_line refuses every send into a non-empty box, correctly: typing APPENDS, so it would paste onto the end of a citizen's draft and submit the pair as one message (gqlc-6bnkw). cmd_wake, cmd_sleep, cmd_down and dispatch's recovery ask all route through that one function, so these seats cannot be woken, nudged, slept or brought down, while each still holds one of $(cfg concurrency max_active) slots and every dispatch pass wakes ASLEEP seats only. EACH SEAT CARRIES A TAG for what its box holds, which narrows how the text got there without settling it. (km) is text km itself types — /exit, or an ask carrying the '[km] ' prefix, which send_line now refuses to send without — so read gqlc-gh7xj first: a burst of 64 characters or more is read as a paste and its trailing CR renders as a literal newline. (foreign) is neither shape, so no code path in this town typed it: it is a citizen composing right now, or the second sender of gqlc-cj7hp — seven stranded strings had been measured against km's corpus by 2026-09-02 — a different seven from the panes counted two sentences down — not one of them km's, and the longest was 61 characters against gh7xj's threshold of 64, so gh7xj explains none of that population — but 61 is close enough that the next one may land the other side of it, and a string over 64 is NOT thereby km's. The tag reads the composer's bytes and nothing else, so a citizen whose own draft opens with '[km] ' is tagged km, and a box holding two texts is tagged by whichever is first. Seven panes sat like this through the eleven-hour freeze of 2026-09-01, every one of them reporting as awake-idle, and the ESCALATED tags on that board were asks that never arrived rather than citizens ignoring them (gqlc-5vp7). It refines the IDLE population and nothing else: a seat whose agent still reports \`working\` never reaches this check, so an ABSENT BOXED line says only that no IDLE pane holds a stranded ask. These are NOT on the IDLE line below, because IDLE's remedy — 'km sleep --seat <seat>' — is itself a send and is refused by this same box. DO NOT RELAX THAT GUARD: appending to a live draft and submitting it is a worse failure than a held slot. km neither clears nor submits the text, because it cannot tell a stale line from work in progress — reading the pane and deciding is an operator's, and ending or unblocking a session is not km's to do on a timer (VI.2)."
    fi
    if [ -n "$idle" ]; then
        echo "IDLE:$idle — awake, alive, and sitting at an empty prompt — the composer was READ and found empty, so these are the ones a send can still reach; a seat whose box held text is on the BOXED line above instead, and is not reachable at all. Unroutable, because every dispatch pass wakes ASLEEP seats only, while the live session still spends one of $(cfg concurrency max_active) slots. Six of these stalled the whole town for eleven hours with every board reading healthy (gqlc-5vp7). One capture of a TUI is not proof — read the pane first, and 'km sleep --seat <seat>' frees the slot if the citizen is done. Nothing here ends a session: a seat that has not asked to leave has not consented (VI.2, gqlc-971s)."
    fi
    if [ -n "$wedged" ]; then
        echo "WEDGED:$wedged — a tool call that STARTED and has not come back, for longer than $(fmt_age "$dry"). This is the signal the heartbeat cannot carry: km-statusline keeps writing all through a wedged turn, so these seats' HB cells are as fresh as a seat doing real work (gqlc-n97e, 13+ minutes; gqlc-eier, 80 and 152 while every board read healthy). The named tool is the newest one started, not necessarily the one that hung. The third word is WHY, and these are opposite jobs: 'consent' is a seat waiting on one keystroke, which a citizen can answer; 'limit' is a usage wall, which no keystroke clears and which ends the turn without ending the session (gqlc-3evsn); 'unknown' means the pane carried neither marker, which covers a genuinely hung command AND every modal nobody has sampled yet, so it is a reason to look rather than a reason not to; 'unreadable'/'no-pane' mean km could not ask. The recovery ladder's stalled trigger asks these seats too, under the same consent witness; a genuinely long tool call costs one queued line the citizen reads at the turn's end, and a trailing ESCALATED marks a seat the ladder has stopped asking. Read the pane — the word is a snapshot of the screen at the moment this table was built, the seat may have moved since, and a modal answered just before the read left no trace on it. Do not end the session: a modal is not consent (VI.2)."
    fi
    if [ -n "$nowork" ]; then
        echo "NOWORK:$nowork — awake, nothing in flight, and no tool call has FINISHED for that long. Two seats look like this: one wedged between turns (a usage-limit modal eats the turn, so no tool ever starts) and one that finished its work and never ran 'km sleep' — which is the LEAST available state there is, because it holds a slot against max_active and answers no dispatch. Neither is a working citizen. km dispatch's recovery ladder now asks BOTH populations — the idle pass for a seat whose agent reports idle, and the stalled trigger for one whose progress witness has run dry, which is this line's own threshold — pacing one delivered ask per run, repeating no sooner than every $(cfg welfare renudge_after_minutes) minutes, and typing only when the seat's own input box is rendered, empty, and echoes the text: a modal is not consent (VI.2). A send it cannot witness is refused, counted, and after $(recover_cap) counted attempts in one episode it stops and mails sedrak — ESCALATED above marks that state. The counter clears when one of her tool calls finishes — witnessed work, not a pane that merely looks different. Reading the pane is still the fastest way to tell the two apart, and it is the only way to tell a dead turn from a finished day."
    fi
    # MARK, never act — Constitution VI.2. Nothing in km consumes any of the
    # lines below; they exist so a human or the mayor can decide, exactly
    # as UNRESPONSIVE above does.
    if [ -n "$stalewt" ]; then
        echo "STALE:$stalewt — a PARKED worktree that many commits behind origin/master. Nothing else in this table can show it: the seat reads its own tree correctly, its commands succeed, its tests pass and its own km prints a healthy board — of a town that no longer exists. Measured 2026-08-22: five seats at the founding commit, 14 behind, among them the guard and one of two judges (gqlc-d38n). 'km seat-refresh <seat>' moves a parked worktree to origin/master. A wip- cell is NOT this: a seat mid-PR is legitimately behind."
    fi
    if [ -n "$exposed" ]; then
        echo "EXPOSED:$exposed — (N) commits touching .githooks/.claude that this seat's worktree has NOT got, so those gates do not run for it. core.hooksPath is relative and reads '.githooks' in every one of these seats, which is why no drift check in the town sees it (gqlc-xtre, gqlc-p1ek: 7 of 14 seats held no push guard hours after it merged). The refresh at wake deliberately does not move a seat holding work, so a wip! cell is expected and is still exposed."
    fi
    if [ -n "$unjudged" ]; then
        echo "UNJUDGED:$unjudged — no worktree, or git could not read one, or this checkout has no origin/master ref. The TREE cell is '?' rather than 'ok': a question that was not answered is not a clean answer."
    fi
    if [ "$inprog_ok" -eq 0 ]; then
        echo "BEADS: UNAVAILABLE — the in-progress query (bd list --status in_progress, or the jq over it) did not answer, so the BEADS column above is '?' for every seat and this board cannot tell you what is in flight. It is NOT a town with nothing in flight; that is the same rendering, and the equivalence is what hid gqlc-z1qw for the kingdom's whole life. Run the query by hand before concluding anything about who is working (gqlc-bn5r)."
    fi
    if [ -n "$unwitnessed" ]; then
        echo "UNWITNESSED:$unwitnessed — a live seat whose CHECKOUT cannot write a progress witness: .githooks/claude-tool-witness and the PostToolUse wiring in .claude/settings.json are tracked files, so a worktree parked before they landed writes no progress.json. Its WORK cell is this instrument's silence, not the seat's, and an unwitnessed seat working all night reads exactly like a stalled one — which is the equivalence the WORK column exists to break. 'km seat-refresh <seat>' moves a parked worktree to origin/master."
    fi
    if [ -n "$blind" ]; then
        echo "BLIND:$blind — a live seat whose CHECKOUT cannot write a heartbeat: kingdom/bin/km-statusline and the statusLine key in .claude/settings.json are both tracked files, so a worktree parked on a branch that forked before the kingdom landed has neither. The blank HB column above is this instrument's silence, not the seat's, and a seat working all night reads exactly like an idle one. Read the pane, and 'km seat-refresh <seat>' moves a parked worktree back to origin/master."
    fi
    if [ -n "$mislaunched" ]; then
        echo "LAUNCH:$mislaunched — a live session whose claude process does not match kingdom.toml. Codes: P permission mode, S soul (--append-system-prompt), M model, E effort; '?' means herdr reports a live agent but the process could not be resolved, which is reported rather than passed. Fifteen of sixteen seats ran a whole day like this as bare 'claude --resume <uuid>' — permission-gated, soulless, and on the wrong model — while every instrument in the town reported on kingdom.toml's INTENT and called them healthy (gqlc-8dsa). Settings are read at LAUNCH, so nothing fixes a running session: it keeps its flags until it ends. Report only — ending a citizen's session is not km's to do on a timer (VI.2); the repair is that seat's next wake through km-seat."
    fi
    if [ -n "$undrained" ]; then
        echo "UNDRAINED:$undrained — a wake file older than a minute, so nothing has parked to read it. km-seat's consume loop is a 5-second poll, so a healthy runner drains its file within ten seconds; if the age keeps climbing, the runner is gone. This is the tell for a dead km-seat when the predicate above misses it — 14 seats sat this way for seven hours because seat_runner_live gated on pane existence and every repair rode that gate (gqlc-2vxs). Report only; the recovery is 'km reconcile' (which now finds them because the predicate looks at the process too), or 'km up' for the whole town."
    fi

    echo
    printf 'dispatch: %s\n' "$(unit_health kingdom-dispatch.service)"
    printf 'guard:    %s\n' "$(unit_health kingdom-guard.service)"

    echo
    local ready
    # history: kingdom/brain/km-notes.md#cmd_status-4
    if ! ready=$(bd ready -n 0 --json 2>/dev/null) || ! printf '%s' "$ready" | jq -e . >/dev/null 2>&1; then
        echo "ready queue: UNAVAILABLE — 'bd ready' did not answer, or answered with something jq could not parse. No count is printed because none was measured: the four zeroes this line used to print in exactly this situation are indistinguishable from an empty queue (gqlc-bn5r)."
        ready=""
    else
        echo "ready queue: $(echo "$ready" | jq '[.[] | select((.labels // []) | index("class:architect"))] | length') architect, $(echo "$ready" | jq '[.[] | select((.labels // []) | index("class:warrior"))] | length') warrior, $(echo "$ready" | jq '[.[] | select((.labels // []) | index("class:judge"))] | length') judge, $(echo "$ready" | jq '[.[] | select([((.labels // []) | index("class:architect")), ((.labels // []) | index("class:warrior")), ((.labels // []) | index("class:judge"))] | all(. == null))] | length') unlabelled (Սեդրակ's chore)"
    fi
    # history: kingdom/brain/km-notes.md#cmd_status-5
    local kbox kread
    kbox=$(unread_count andranik)
    kread=$(mail_box_count andranik read)
    if [ "$kbox" -gt 0 ] && [ "$kread" -eq 0 ]; then
        echo "the king's inbox (andranik): $kbox delivered, UNKNOWN read — this box has never been drained, and it is drained only by 'km mail read', which the king does not run. The number counts DELIVERY. Do not read it as 'unread' and do not withhold a letter on it (gqlc-2abx)."
    else
        echo "the king's inbox (andranik): $kbox in box, $kread moved to read/ by 'km mail read'"
    fi
}

# ---------- doctor / install ----------

cmd_doctor() {
    no_args doctor "$@"
    local ok=0 ws_row ws_rc
    # history: kingdom/brain/km-notes.md#cmd_doctor
    check() { # check <hard|soft> <label-when-true> <label-when-false> <cmd...>
        check_rc "$1" "$2" "$3" '' '' "${@:4}"
    }

    # history: kingdom/brain/km-notes.md#cmd_doctor-2
    check_rc() { # <hard|soft> <label> <negative> <extra-rc|''> <its sentence> <cmd...>
        local kind=$1 label=$2 negative=$3 extra=$4 extra_negative=$5 rc=0
        shift 5
        "$@" >/dev/null || rc=$?
        if [ "$rc" = 0 ]; then
            echo "ok:   $label"
            return 0
        fi
        # Chosen once, above the hard/soft split: selecting it inside each arm
        # is one edit away from a row that distinguishes the causes when it
        # fails and not when it warns.
        if [ -n "$extra" ] && [ "$rc" = "$extra" ]; then negative=$extra_negative; fi
        if [ "$kind" = hard ]; then
            echo "FAIL: $negative"
            ok=1
        else
            echo "warn: $negative"
        fi
    }
    check hard "herdr installed" "herdr is NOT installed, and the town's panes are herdr agents (https://herdr.dev)" command -v herdr
    check_rc hard "herdr server running" \
        "the herdr server is NOT running, and the town's panes are herdr agents (herdr status server)" \
        2 "km could not ask herdr whether its server is running (its own account is above). Not saying it is down: that is a positive claim this failure does not support." \
        herdr_server_up
    check hard "claude installed" "claude is NOT installed, so no seat can be woken" command -v claude
    check hard "bd installed" "bd is NOT installed, so there is no ledger to dispatch from" command -v bd
    check hard "jq installed" "jq is NOT installed, and every ledger query here is parsed with it" command -v jq
    check hard "python3 installed" "python3 is NOT installed" command -v python3
    check hard "state dir writable" "the state dir could NOT be created or written: $(state_dir)" mkdir -p "$(state_dir)"
    # Not a `check` row: this one must NAME what it found. A boolean row labelled
    # "matches origin/master" reports a measured mismatch, so on a root that
    # could not be measured at all it sends the reader to `km deploy` for a
    # difference that was never observed.
    # Asked BEFORE the content row and independently of it, because a root that
    # cannot be deployed reads clean on content until master moves — and the
    # content row is silent for exactly that window (bd gqlc-ssfqj).
    local deployblocked
    deployblocked=$(deploy_blocker)
    if [ -n "$deployblocked" ]; then
        echo "FAIL: the deploy root cannot be fast-forwarded, so the next drift will not be repaired and the timers will keep running this tree: $deployblocked"
        ok=1
    fi
    local drift
    drift=$(kingdom_drift)
    if [ -z "$drift" ]; then
        echo "ok:   the deployed kingdom/, .githooks/ and .claude/ match origin/master"
    else
        echo "FAIL: the deployed kingdom/, .githooks/ or .claude/ is not certified against origin/master, so the town runs stale machinery or stale gates:"
        echo "      ${drift//$'\n'/$'\n      '}"
        ok=1
    fi
    # Not a `check` row either, and for the same reason twice over: this one has
    # three outcomes, and the failing one has to NAME the beads. A gate an
    # operator cannot act on is a warning wearing a gate's clothes.
    local stranded
    if ! stranded=$(stranded_ids); then
        echo "FAIL: the reachability query failed, so no bead can be certified reachable"
        ok=1
    elif [ -n "$stranded" ]; then
        echo "FAIL: in progress and assigned to nobody, so no dispatch pass can wake anyone: $stranded"
        ok=1
    else
        echo "ok:   every bead is in some dispatch pass"
    fi
    # history: kingdom/brain/km-notes.md#cmd_doctor-3
    local urows uname uids
    if ! urows=$(unreachable_owner_rows); then
        echo "warn: the assignee-resolution query failed, so no assignee can be certified reachable"
    elif [ -n "$urows" ]; then
        while IFS=' ' read -r uname uids; do
            [ -n "$uname" ] || continue
            echo "warn: assigned to '$uname', which is in neither [seats] nor [humans], so no dispatch pass can wake anyone for it — add them to [humans] if they are a person, or move the work if the seat is gone: $uids"
        done <<<"$urows"
    else
        echo "ok:   every assignee on the board is a seat or a known person"
    fi

    # ADR 0009's detector, and a WARN for the same reason the arm above is one:
    # it rests on the wording of a sentence a judge typed, not on the
    # dispatcher's arithmetic. Three outcomes, and the finding NAMES the beads —
    # the whole complaint ADR 0009 makes about a conditioned PASS is that its
    # content reaches nobody, so a row reporting a count would repeat the defect.
    local conditioned
    if ! conditioned=$(conditioned_verdict_ids); then
        echo "warn: the conditioned-verdict query failed, so no close reason can be certified unconditional"
    elif [ -n "$conditioned" ]; then
        echo "warn: closed with a condition in the close reason, which carries it to nobody — a verdict is PASS or FAIL, a PASS is unconditional, and binding content travels in bead ids (ADR 0009): $conditioned"
    else
        echo "ok:   every judge verdict closed since ADR 0009 is unconditional"
    fi

    # history: kingdom/brain/km-notes.md#cmd_doctor-4
    local stall stall_age stall_list
    if ! stall=$(stalled_p0_render); then
        # Named on the clean path too: an arm that is silent when it passes is
        # indistinguishable from an arm that is not there. It says whose record
        # it is, because absence here means the DISPATCHER saw no stall — the
        # last-run row below is what says whether it ran at all.
        echo "ok:   the last dispatch run recorded no stalled P0"
    else
        stall_age=${stall%%$'\t'*}
        stall_list=${stall#*$'\t'}
        if [ "$stall_age" -ge "$(stalled_p0_after)" ]; then
            echo "FAIL: P0 work has been unroutable for $(fmt_age "$stall_age") — ready, unassigned, and no seat can take it: $stall_list"
            ok=1
        else
            echo "warn: P0 work went unroutable on the last dispatch run, under $(fmt_age "$(stalled_p0_after)") ago, so it may still route on the next tick: $stall_list"
        fi
    fi
    # history: kingdom/brain/km-notes.md#cmd_doctor-5
    local idsrc
    idsrc="$(dirname "$KINGDOM_DIR")/.githooks/implausible-identity.sh"
    if [ ! -r "$idsrc" ]; then
        echo "FAIL: cannot read $idsrc, so no bead owner can be certified a real address"
        ok=1
    else
        # shellcheck source=/dev/null
        . "$idsrc"
        # history: kingdom/brain/km-notes.md#cmd_doctor-6
        local owners bad_owners="" o why
        if ! owners=$(bd list --all -n 0 --json 2>/dev/null |
            jq -r '[ .[] | select(.status != "closed") | .owner // empty | select(. != "") ] | unique | .[]'); then
            # Fail-closed. gqlc-z1qw: an unanswered query that reads as a clean
            # board is the failure mode this whole file is organised against.
            echo "FAIL: could not read the beads, so no owner can be certified a real address"
            ok=1
        else
            while IFS= read -r o; do
                [ -n "$o" ] || continue
                if ! why=$(implausible_email_reason "$o"); then
                    bad_owners="$bad_owners $o ($why);"
                fi
            done <<<"$owners"
            if [ -n "$bad_owners" ]; then
                # NAMES the address, and FAILS. A check that prints a complaint
                # and exits 0 is not a gate (gqlc-z1qw, and `just doctor`
                # printing ok over a warning at gqlc-bn5r).
                echo "FAIL: beads that are not closed carry an owner that cannot belong to a person:$bad_owners fix 'git config user.email' and reassign them"
                ok=1
            else
                echo "ok:   every open, in progress and blocked bead's owner is a deliverable address"
            fi
        fi
    fi
    # history: kingdom/brain/km-notes.md#cmd_doctor-7
    local ctarget cexposed="" cs cf cstate cball cbgates cahead cdetail
    ctarget=$(git_at "$(main_root)" rev-parse --verify --quiet origin/master 2>/dev/null || true)
    if [ -z "$ctarget" ]; then
        echo "warn: no origin/master here, so no seat's gate coverage could be measured"
    else
        for cs in $(seats_all); do
            cf=$(seat_freshness "$cs" "$ctarget")
            read -r cstate cball cbgates cahead cdetail <<<"$cf"
            : "$cstate $cball $cahead $cdetail"
            if [ "$cbgates" -gt 0 ]; then cexposed="$cexposed $cs($cbgates)"; fi
        done
        if [ -n "$cexposed" ]; then
            echo "warn: seats whose worktree is missing merged .githooks/.claude commits, so those gates do not run for them:$cexposed"
        else
            echo "ok:   every seat's worktree carries every merged .githooks/.claude commit"
        fi
    fi
    # history: kingdom/brain/km-notes.md#cmd_doctor-8
    local lseat ls lcode lsay lbad="" lseen=0
    for lseat in $(seats_all); do
        ls=$(seat_launch_state "$lseat")
        lcode=${ls%%$'\t'*}
        lsay=${ls#*$'\t'}
        [ "$lcode" = "-" ] && continue
        lseen=$((lseen + 1))
        [ "$lcode" = ok ] && continue
        lbad="$lbad $lseat($lcode: $lsay);"
    done
    if [ -n "$lbad" ]; then
        echo "FAIL: live sessions whose claude process does not match kingdom.toml (P permission mode, S soul, M model, E effort; '?' the process could not be resolved):$lbad settings are read at launch, so a running session keeps its flags until it ends — the repair is that seat's next wake through km-seat, and ending a session is nobody's to do on a timer (VI.2)"
        ok=1
    else
        # The count is here so that silence is falsifiable. "every live session
        # matches" over a roster where nothing was live is a true sentence that
        # means nothing, and it is the sentence a reader takes for reassurance.
        echo "ok:   every live session matches kingdom.toml on permission mode, soul and model ($lseen live, $(($(seats_all | wc -l) - lseen)) asleep and not judged)"
    fi
    check soft "bd mail.delegate points at km" "bd mail.delegate does NOT resolve to 'km mail', so mail bd delegates goes nowhere this town reads" sh -c "bd config get mail.delegate | grep -q 'km mail'"
    # `systemctl --user is-enabled` answers three ways, measured 2026-08-30 on
    # this host: rc 0 "enabled", rc 1 "disabled", rc 4 "not-found", all three on
    # stdout and none of them on stderr. Installed-but-off and never-installed
    # have different remedies, so one sentence for both sends half its readers
    # to a command that cannot work.
    check_rc soft "dispatch timer enabled" \
        "the dispatch timer is NOT enabled, so nothing will route a bead until someone runs km dispatch by hand ('systemctl --user enable --now kingdom-dispatch.timer')" \
        4 "the dispatch timer is NOT INSTALLED, so nothing will route a bead and enabling it would fail — its unit file was never written ('km deploy')" \
        systemctl --user is-enabled kingdom-dispatch.timer
    check_rc soft "guard timer enabled" \
        "the guard timer is NOT enabled, so no sweep will run until someone runs km guard-sweep by hand ('systemctl --user enable --now kingdom-guard.timer')" \
        4 "the guard timer is NOT INSTALLED, so no sweep will run and enabling it would fail — its unit file was never written ('km deploy')" \
        systemctl --user is-enabled kingdom-guard.timer
    # history: kingdom/brain/km-notes.md#cmd_doctor-9
    check_unit_run() { # <what> <unit>
        local uh
        uh=$(unit_health "$2")
        case "$uh" in
            ok*)      echo "ok:   $1 last run succeeded ${uh#ok }" ;;
            FAILED*)  echo "FAIL: $1's last run FAILED, so whatever this unit does the town is not doing — $uh"; ok=1 ;;
            UNKNOWN*) echo "warn: $1 last run is UNKNOWN — ${uh#UNKNOWN — }" ;;
            # gqlc-28ysg. Without this arm the two no-record labels fall to the
            # last one and are announced as a run that did NOT succeed — the
            # bead's own defect, restated by the caller of the function that
            # stopped making it. No run is on record, so none failed either.
            "NOT SCHEDULED"*|"NO RUN ON RECORD"*) echo "warn: $1 has no last run on record — $uh" ;;
            *)        echo "warn: $1 last run did NOT succeed — $uh" ;;
        esac
    }
    check_unit_run dispatch kingdom-dispatch.service
    check_unit_run guard kingdom-guard.service
    # history: kingdom/brain/km-notes.md#cmd_doctor-10
    local lingerout
    if ! lingerout=$(loginctl show-user "${USER:-$(id -un)}" -p Linger 2>/dev/null) ||
        [ -z "$lingerout" ]; then
        echo "warn: lingering is UNKNOWN — loginctl could not be asked, so whether the timers survive logout was not measured"
    elif [ "${lingerout#*=}" = yes ]; then
        echo "ok:   lingering is ON, so the timers keep dispatching after logout and across reboots — 'just kingdom-uninstall' removes the units, 'loginctl disable-linger' leaves them but stops them surviving logout"
    else
        echo "ok:   lingering is off, so the timers fire only while a login session is open — a headless town needs 'loginctl enable-linger'"
    fi
    # THE TOWN ROW: is the herdr workspace present? Server-down and
    # workspace-absent both mean the town is down; render each with its own
    # message so an operator knows whether to start herdr or run `km up`.
    local srv_rc=0
    herdr_server_up || srv_rc=$?
    if [ "$srv_rc" = 2 ]; then
        echo "warn: cannot tell whether the town is up — km could not ask herdr whether its server is running (diagnosis above). Not advising 'km up': it would be wrong if the town is already up."
    elif [ "$srv_rc" != 0 ]; then
        echo "warn: the town is DOWN — the herdr server is not running (herdr status server)"
    else
        # The rc, not the emptiness. `[ -z "$(workspace_id)" ]` stood here and
        # advised `km up` on a list km could not read — a raise that would be
        # wrong if the town were in fact already up (gqlc-ygcfi).
        ws_row=$(workspace_id) && ws_rc=0 || ws_rc=$?
        if [ "$ws_rc" != 0 ]; then
            echo "warn: cannot tell whether the town is up — the herdr workspace list did not parse (diagnosis above). Not advising 'km up': it would be wrong if the town is already up."
        elif [ -z "$ws_row" ]; then
            echo "warn: the town is DOWN — no herdr workspace '$WORKSPACE' ('km up' creates it)"
        else
            echo "ok:   the town is up — herdr workspace '$WORKSPACE' exists"
        fi
    fi
    return "$ok"
}

# ---------- seat worktree freshness ----------

# history: kingdom/brain/km-notes.md#seat_freshness

# history: kingdom/brain/km-notes.md#seat_freshness-2
seat_freshness() {
    local seat=$1 target=$2 wt head branch dirty ahead behind_all behind_gates
    wt=$(seat_worktree "$seat")
    [ -d "$wt" ] || { echo "unknown 0 0 0 no worktree at $wt"; return 0; }
    target=$(seat_target "$wt" "$target")
    [ -n "$target" ] || { echo "unknown 0 0 0 no origin/master to judge against"; return 0; }
    head=$(git_at "$wt" rev-parse HEAD 2>/dev/null) ||
        { echo "unknown 0 0 0 git cannot read $wt"; return 0; }

    branch=$(git_at "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
    dirty=$(git_at "$wt" status --porcelain 2>/dev/null || echo "?")
    # Detached and clean is not the same as parked. A citizen who committed
    # without first cutting a branch leaves both of those signals empty, and
    # moving that worktree takes the commit off every ref. A genuinely parked
    # seat is an ancestor of target, so this is 0 for it and holds nobody
    # who is not carrying something.
    ahead=$(git_at "$wt" rev-list --count "$target..HEAD" 2>/dev/null) || ahead=0
    behind_all=$(git_at "$wt" rev-list --count "HEAD..$target" 2>/dev/null) || behind_all=0
    # Restricted to the paths that ARE the gates, and counted before any move.
    # kingdom/ is deliberately NOT in this count, though it is in KM_GATE_PATHS:
    # the machinery a seat runs is the DEPLOYED copy (deploy_root), never the
    # seat's own, so kingdom/ staleness in a worktree costs that seat nothing.
    # The hooks are the opposite — core.hooksPath is relative, so they resolve
    # inside the seat's own checkout.
    behind_gates=$(git_at "$wt" rev-list --count "HEAD..$target" -- .githooks .claude 2>/dev/null) || behind_gates=0

    # history: kingdom/brain/km-notes.md#seat_freshness-3
    local unique upstream_known=0 upstream_gone=""
    if [ -n "$branch" ]; then
        if unique=$(git_at "$wt" rev-list --count "@{u}..HEAD" 2>/dev/null); then
            upstream_known=1
        else
            unique=1
            local cfg_remote cfg_merge
            cfg_remote=$(git_at "$wt" config --get "branch.$branch.remote" 2>/dev/null || true)
            cfg_merge=$(git_at "$wt" config --get "branch.$branch.merge" 2>/dev/null || true)
            if [ -n "$cfg_remote" ] && [ -n "$cfg_merge" ]; then
                upstream_gone="$cfg_remote/${cfg_merge#refs/heads/}"
            fi
        fi
    else
        unique=$ahead
    fi

    if [ -n "$dirty" ] || [ "$unique" -gt 0 ]; then
        local why="$ahead commit(s) of its own, on no branch"
        [ -n "$branch" ] && why="branch $branch in flight"
        [ -n "$upstream_gone" ] &&
            why="branch $branch had upstream $upstream_gone, which is gone — whether its work landed is not a question git can answer"
        [ -n "$dirty" ] && why="uncommitted work in the tree"
        echo "working $behind_all $behind_gates $ahead $why"
        return 0
    fi
    if [ "$head" = "$target" ]; then
        echo "current 0 0 0 at $(git_at "$wt" rev-parse --short HEAD 2>/dev/null || echo "$head")"
        return 0
    fi
    # On a branch, clean, upstream resolved, everything held by that upstream:
    # published. Nothing here is at risk from git's point of view, but nothing
    # here tells us the branch is FINISHED — an open PR looks identical to a
    # merged one. The word deliberately refuses to say `parked`; the PR record
    # is the authority (0008) and seat_refresh_step is where it is consulted.
    if [ -n "$branch" ] && [ "$upstream_known" -eq 1 ]; then
        echo "published $behind_all $behind_gates 0 branch $branch fully held by its upstream"
        return 0
    fi
    echo "parked $behind_all $behind_gates 0 at $(git_at "$wt" rev-parse --short HEAD 2>/dev/null || echo "$head")"
}

# history: kingdom/brain/km-notes.md#seat_refresh_step
seat_refresh_step() {
    local seat=$1 check=$2 target=$3 stale_note=$4
    local wt f state behind_all behind_gates ahead detail head
    wt=$(seat_worktree "$seat")
    # A clone's refs are its own, so the caller's one fetch in the main
    # checkout says nothing about this seat. Fetch per clone before judging,
    # and note the failure the same way the caller does rather than reporting a
    # clean verdict from an unanswered question.
    if [ -d "$wt" ] && seat_is_clone "$wt"; then
        git_at "$wt" fetch --quiet origin 2>/dev/null ||
            stale_note=" [fetch failed in $seat's own clone: judged against its last known origin/master]"
        target=$(seat_target "$wt" "$target")
        [ -n "$target" ] || {
            echo "$seat: cannot judge — its clone has no origin/master to judge against$stale_note"
            return 4
        }
    fi
    f=$(seat_freshness "$seat" "$target")
    read -r state behind_all behind_gates ahead detail <<<"$f"
    : "$ahead"

    case "$state" in
        unknown)
            echo "$seat: cannot judge — $detail"
            return 4
            ;;
        working)
            local why="$detail"
            if [ "$behind_gates" -eq 0 ]; then
                echo "$seat: held ($why); its hooks are current$stale_note"
                return 0
            fi
            echo "$seat: HELD — $behind_gates hook/settings change(s) behind master and NOT applied ($why)$stale_note"
            return 3
            ;;
        current)
            echo "$seat: current at $(git_at "$wt" rev-parse --short HEAD)$stale_note"
            return 0
            ;;
        published)
            # git says safe; ask the PR record whether the work is finished
            # (0008). branch_pr_state answers on stdout with one of four words,
            # each of which becomes a reason-naming verdict below — two paths
            # to one HOLD must stay tellable apart.
            local pr_branch pr_state pr_reason
            pr_branch=$(git_at "$wt" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
            # Strip the remote prefix; a PR's head is a remote branch and the
            # local name can differ (a same-named local branch is not the PR
            # head — town law, measured).
            pr_branch=${pr_branch#*/}
            pr_state=$(branch_pr_state "$pr_branch")
            case "$pr_state" in
                open)     pr_reason="open PR for $pr_branch — mid-work" ;;
                none)     pr_reason="published but not shown finished (no PR for $pr_branch)" ;;
                unanswered) pr_reason="GitHub did not answer; refusing to guess" ;;
                finished) pr_reason="" ;;
            esac
            if [ "$pr_state" != "finished" ]; then
                if [ "$behind_gates" -eq 0 ]; then
                    echo "$seat: held ($pr_reason); its hooks are current$stale_note"
                    return 0
                fi
                echo "$seat: HELD — $behind_gates hook/settings change(s) behind master and NOT applied ($pr_reason)$stale_note"
                return 3
            fi
            # history: kingdom/brain/km-notes.md#seat_refresh_step-2
            if seat_session_live "$seat"; then
                echo "$seat: held (branch $pr_branch finished, but herdr reports a live session in it — or could not be read at all, which is held the same way; its wake-path refresh will take it)$stale_note"
                return 0
            fi
            head=$(git_at "$wt" rev-parse HEAD)
            if [ "$check" -eq 1 ]; then
                echo "$seat: would refresh (branch $pr_branch finished: every PR for it is closed) — --check, nothing moved$stale_note"
                return 0
            fi
            if ! git_at "$wt" checkout --detach --quiet "$target" 2>/dev/null; then
                echo "$seat: could not move its published worktree to origin/master"
                return 4
            fi
            echo "$seat: refreshed $(git_at "$wt" rev-parse --short "$head") -> $(git_at "$wt" rev-parse --short HEAD) (branch $pr_branch finished: every PR for it is closed)$stale_note"
            return 0
            ;;
    esac

    # parked: safe to move, and the only state in which anything moves.
    head=$(git_at "$wt" rev-parse HEAD)
    if [ "$check" -eq 1 ]; then
        # history: kingdom/brain/km-notes.md#seat_refresh_step-3
        echo "$seat: STALE (--check, nothing moved) — $behind_all commit(s) behind origin/master, $behind_gates of them touching .githooks/.claude$stale_note"
        [ "$behind_gates" -eq 0 ] || return 5
        return 0
    fi
    if ! git_at "$wt" checkout --detach --quiet "$target" 2>/dev/null; then
        echo "$seat: could not move its parked worktree to origin/master"
        return 4
    fi
    echo "$seat: refreshed $(git_at "$wt" rev-parse --short "$head") -> $(git_at "$wt" rev-parse --short HEAD) ($behind_gates hook/settings change(s) picked up)$stale_note"
    return 0
}

# history: kingdom/brain/km-notes.md#cmd_seat_refresh_all
cmd_seat_refresh_all() {
    local check=$1 mr target stale_note="" s line rc
    local refreshed=0 current=0 held=0 exposed="" declined="" unjudged=""
    mr=$(main_root)
    git_at "$mr" fetch --quiet origin 2>/dev/null ||
        stale_note=" [fetch failed: judged against the last known origin/master]"
    target=$(git_at "$mr" rev-parse --verify --quiet origin/master) ||
        die "seat-refresh --all: no origin/master to refresh anyone against"

    for s in $(seats_all); do
        rc=0
        line=$(seat_refresh_step "$s" "$check" "$target" "$stale_note") || rc=$?
        printf '  %s\n' "$line"
        case "$rc" in
            3) exposed="$exposed $s" ;;
            5) declined="$declined $s" ;;
            # NOT fatal, and this is the property the sweep turns on: tir is
            # last in roster order and has no worktree at all, so a loop that
            # died here would print most of the table and silently never visit
            # the seats after him. A seat that cannot be judged is a row.
            4) unjudged="$unjudged $s" ;;
            *) case "$line" in
                   *refreshed*) refreshed=$((refreshed + 1)) ;;
                   *current*)   current=$((current + 1)) ;;
                   *)           held=$((held + 1)) ;;
               esac ;;
        esac
    done

    local summary="seat-refresh --all: $refreshed refreshed, $current already current, $held held with hooks current"
    if [ -n "$exposed" ]; then
        summary="$summary; STILL EXPOSED:$exposed — each is holding work, so nothing here will move it; its citizen must rebase"
    fi
    # Deliberately not phrased as an alarm. Under --check this is the ordinary
    # outcome for every parked seat behind on gates, and the remedy is one
    # command the operator already has, addressed to the operator (gqlc-jjcj).
    if [ -n "$declined" ]; then
        summary="$summary; NOT MOVED because --check:$declined — parked and safe to move; re-run without --check"
    fi
    if [ -n "$unjudged" ]; then
        summary="$summary; UNJUDGED:$unjudged — no worktree or git could not read one, so a bead routed there goes nowhere ('km up' seats it)"
    fi
    echo "$summary$stale_note"
    # Non-zero while anything is uncovered. The exit status is all a morning
    # script reads, and "it ran" must not be readable as "the town is covered".
    # A --check-declined seat is uncovered too: nothing moved, so it counts.
    [ -z "$exposed$declined$unjudged" ] || return 3
    return 0
}

cmd_seat_refresh() {
    local seat="" check=0 all=0 a
    for a in "$@"; do
        case "$a" in
            --check) check=1 ;;
            --all) all=1 ;;
            -*) die "seat-refresh: unknown flag $a" ;;
            *) [ -z "$seat" ] || die "seat-refresh: one seat at a time"; seat=$a ;;
        esac
    done
    # Ambiguous rather than merely redundant: does a seat name narrow the sweep,
    # or is --all a typo away from a single-seat run the operator meant? Refuse
    # instead of guessing, since one reading moves sixteen worktrees.
    if [ "$all" -eq 1 ] && [ -n "$seat" ]; then
        die "seat-refresh: --all sweeps the whole roster; pass it or a seat name, not both (got --all and '$seat')"
    fi
    if [ "$all" -eq 1 ]; then
        cmd_seat_refresh_all "$check"
        return
    fi
    [ -n "$seat" ] || die "seat-refresh: which seat? (or --all for the whole roster)"
    is_seat "$seat" || die "seat-refresh: unknown seat: $seat"

    local mr wt
    mr=$(main_root)
    wt=$(seat_worktree "$seat")
    [ -d "$wt" ] || die "seat-refresh: no worktree at $wt (km up creates it)"

    # A failed fetch judges the seat against a stale origin/master, which would
    # report a seat current on evidence that is itself behind. Say so rather
    # than reporting a clean result from an unanswered question.
    local stale_note=""
    git_at "$mr" fetch --quiet origin 2>/dev/null ||
        stale_note=" [fetch failed: judged against the last known origin/master]"

    local target
    target=$(git_at "$mr" rev-parse --verify --quiet origin/master) ||
        die "seat-refresh: no origin/master to refresh $seat against"

    # A single named seat that cannot be judged is an operator error worth an
    # exit — he asked about THIS seat and got no answer. The sweep treats the
    # same rc as a row, because there the alternative is truncating the table.
    local line rc=0
    line=$(seat_refresh_step "$seat" "$check" "$target" "$stale_note") || rc=$?
    [ "$rc" -ne 4 ] || die "seat-refresh: $line"
    echo "seat-refresh $line"
    return "$rc"
}

render_unit() { # <src> <dst>
    # @STATE@ is resolved here, at install time, for the same reason @REPO@ is:
    # the alarm unit's fallback append must reach the wake file without running
    # km, so it cannot ask km where the state dir is (bd gqlc-leq7).
    sed -e "s|@REPO@|$(main_root)|g" \
        -e "s|@STATE@|$(state_dir)|g" \
        -e "s|@DISPATCH_MIN@|$(cfg cadence dispatch_minutes)|g" \
        -e "s|@GUARD_MIN@|$(cfg cadence guard_minutes)|g" \
        "$1" >"$2"
}

cmd_install_units() {
    no_args install-units "$@"
    local unitdir="$HOME/.config/systemd/user" u
    mkdir -p "$unitdir"
    for u in kingdom-dispatch.service kingdom-dispatch-alarm.service kingdom-dispatch.timer kingdom-guard.service kingdom-guard.timer; do
        render_unit "$KINGDOM_DIR/systemd/$u" "$unitdir/$u"
    done
    systemctl --user daemon-reload
    systemctl --user enable --now kingdom-dispatch.timer kingdom-guard.timer
    bd config set mail.delegate "$(main_root)/kingdom/bin/km mail"
    ensure_state_tree
    echo "installed: dispatch every $(cfg cadence dispatch_minutes)m, guard every $(cfg cadence guard_minutes)m; bd mail now delegates to km"
}

cmd_uninstall_units() {
    no_args uninstall-units "$@"
    systemctl --user disable --now kingdom-dispatch.timer kingdom-guard.timer 2>/dev/null || true
    rm -f "$HOME/.config/systemd/user"/kingdom-{dispatch,guard}.{service,timer} \
        "$HOME/.config/systemd/user/kingdom-dispatch-alarm.service"
    systemctl --user daemon-reload
    echo "units removed; state, mail, and worktrees untouched"
}

# ---------- main ----------

cmd=${1:-}
shift || true
case "$cmd" in
    status)          cmd_status "$@" ;;
    up)              cmd_up "$@" ;;
    down)            cmd_down "$@" ;;
    wake)            cmd_wake "$@" ;;
    sleep)           cmd_sleep "$@" ;;
    mail)            cmd_mail "$@" ;;
    dispatch)        cmd_dispatch "$@" ;;
    hold-verdict)    cmd_hold_verdict "$@" ;;
    reconcile)       cmd_reconcile "$@" ;;
    seat-live)       seat_session_live "$1" ;;
    seat-runner)     seat_runner_live "$1" ;;
    seat-idle)       seat_pane_idle "$1" ;;
    guard-sweep)     cmd_guard_sweep "$@" ;;
    halt)            cmd_halt "$@" ;;
    resume)          cmd_resume "$@" ;;
    doctor)          cmd_doctor "$@" ;;
    deploy)          cmd_deploy "$@" ;;
    install-units)   cmd_install_units "$@" ;;
    uninstall-units) cmd_uninstall_units "$@" ;;
    # Guarded here rather than inside the function, as the eight verbs above
    # are: state_dir and capped_seats are ordinary helpers with 25 and 4
    # internal callers, so a refusal inside them would answer for every one of
    # those and not for the verb. The dispatch site is the only place that
    # holds this verb's argv. Neither is a write, so what they cost is the
    # help someone asked for, not the town.
    state-dir)       no_args state-dir "$@"; state_dir ;;
    deploy-root)     no_args deploy-root "$@"; deploy_root ;;
    capped-seats)    no_args capped-seats "$@"; capped_seats ;;
    cfg)             cfg "${1:?km cfg <section> <key>}" "${2:?km cfg <section> <key>}" ;;
    seat-info)       is_seat "${1:-}" || die "seat-info: unknown seat ${1:-<none>}"
                     echo "$(seat_class "$1") $(seat_model "$1") $(seat_display "$1")" ;;
    seat-worktree)   is_seat "${1:-}" || die "seat-worktree: unknown seat ${1:-<none>}"
                     seat_worktree "$1" ;;
    seat-refresh)    cmd_seat_refresh "$@" ;;
    -h | --help | help | "") usage ;;
    *) die "unknown command: $cmd (km --help)" ;;
esac
