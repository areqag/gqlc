#!/usr/bin/env bash
# km — the machinery of the Թագաւորութիւն (kingdom/README.md).
#
# Path resolution: this script's own location names the kingdom/ tree it
# serves; the runtime state dir is derived from the git COMMON dir so every
# seat worktree resolves the same shared state (KM_STATE_DIR overrides, for
# tests). tmux may be absent (CI): every tmux-touching path degrades to a
# message or a state file, never a crash.
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
KINGDOM_DIR=$(dirname "$SCRIPT_DIR")
# KM_CONFIG exists so the test suite can read a throwaway roster; the town
# itself never sets it.
CONFIG="${KM_CONFIG:-$KINGDOM_DIR/kingdom.toml}"

die() { echo "km: $*" >&2; exit 1; }

usage() {
    cat <<'EOF'
km — the machinery of the Թագաւորութիւն

  km status                      the town at a glance
  km up | down                   start / stop the tmux town
  km attach <seat>               attach to a seat's window
  km herratsayn                  Հեռաձայն: wake Սեդրակ if asleep, attach
  km wake <seat> [--bead ID] [--reason TEXT]
  km sleep [--seat NAME]         end the current seat's workday
  km mail send <to> -s SUBJ [-m BODY]   (body on stdin if no -m)
  km mail inbox [--seat NAME] | read <id> | sent
  km dispatch                    route ready beads to free seats (timer)
  km hold-verdict                ROUTE/HOLD per candidate bead, docs on stdin
  km reconcile                   match seat status to the sessions that exist
  km seat-live <seat>            exit 0 if a session actually exists there
  km guard-sweep                 wake Րաֆֆի for a round (timer)
  km halt [reason] | resume      raise / lower the town halt
  km install-units | uninstall-units
  km deploy                      fast-forward the checkout the timers run from
  km doctor                      health checks
  km seat-refresh <s>            bring a parked seat's worktree (and its hooks) up to master
  km state-dir | seat-info <s> | seat-worktree <s>
EOF
}

# ---------- config ----------

cfg() { # cfg <section> <key> -> value with quotes and inline comment stripped
    awk -F' *= *' -v sec="[$1]" -v key="$2" '
        /^\[/ { insec = ($0 == sec); next }
        insec && $1 == key {
            v = $2
            sub(/[ \t]+#.*$/, "", v)
            gsub(/^"|"$/, "", v)
            print v
            exit
        }
    ' "$CONFIG"
}

seats_all() {
    awk -F' *= *' '
        /^\[seats\]/ { s = 1; next }
        /^\[/        { s = 0 }
        s && NF >= 2 && $1 !~ /^#/ { print $1 }
    ' "$CONFIG"
}

seat_raw() {
    local raw
    raw=$(cfg seats "$1")
    [ -n "$raw" ] || die "unknown seat: $1"
    echo "$raw"
}

seat_class()   { seat_raw "$1" | cut -d: -f1; }
seat_model()   { seat_raw "$1" | cut -d: -f2; }
seat_display() { seat_raw "$1" | cut -d: -f3; }

is_seat() { seats_all | grep -qx "$1"; }

# ---------- paths ----------

# git exports GIT_DIR and friends into every hook environment, and with GIT_DIR
# set `git -C <path>` resolves the repo from GIT_DIR rather than from <path>. km
# is reachable from a hook (bd delegates mail to it), and a deploy that merged
# into whichever repo invoked the hook would be the same class of accident the
# deploy command exists to end — so every git call that names a repo by path
# scrubs the inheritance first.
#
# Drop the whole GIT_* namespace and re-export an allowlist, rather than
# enumerating what to remove. The asymmetry decides it: a git release that adds
# an auth variable breaks LOUDLY here — at the deploy that needed it, naming
# itself — while one that adds a repo-selecting variable would break SILENTLY,
# later, in someone else's repo. Default-deny puts the new unknown on the safe
# side. The allowlist is transport only: GIT_CONFIG_* is deliberately absent,
# since it can inject core.hooksPath and aliases.
git_at() { # git_at <dir> <args...>
    local dir=$1
    shift
    local -a scrub=() keep=()
    local v
    for v in "${!GIT_@}"; do
        case $v in
            GIT_SSH | GIT_SSH_COMMAND | GIT_ASKPASS | GIT_TERMINAL_PROMPT)
                keep+=("$v=${!v}") ;;
            *) scrub+=(-u "$v") ;;
        esac
    done
    env "${scrub[@]}" "${keep[@]}" git -C "$dir" "$@"
}

# Scrubbed like the rest: an exported GIT_DIR would otherwise name the repo that
# invoked the hook, and deploy_root() below is the first caller that WRITES to
# whatever this returns.
main_root() {
    local common
    common=$(git_at . rev-parse --path-format=absolute --git-common-dir)
    dirname "$common"
}

state_dir() {
    if [ -n "${KM_STATE_DIR:-}" ]; then
        echo "$KM_STATE_DIR"
    else
        echo "$(dirname "$(main_root)")/$(cfg kingdom state_dirname)"
    fi
}

seat_worktree() {
    local mr
    mr=$(main_root)
    echo "$(dirname "$mr")/$(basename "$mr")-seat-$1"
}

# ---------- deploy ----------

# The systemd units execute kingdom/ out of the main checkout, never out of the
# seat worktree a fix was written in, and nothing advances that checkout — so a
# merged fix ran for hours while the town believed it was live (bd gqlc-ed2u).
# KM_DEPLOY_ROOT overrides, for tests, as KM_STATE_DIR does for state.
deploy_root() { echo "${KM_DEPLOY_ROOT:-$(main_root)}"; }

# Names the kingdom/ paths where the deployed tree differs from origin/master;
# silence means no drift. It diffs the WORKING TREE, not HEAD, because that is
# what the units execute: a file edited or staged in place is drift at the right
# commit. Reads the remote-tracking ref rather than the network, so it cannot
# stall the dispatcher — every seat worktree shares one ref store, so the ref is
# as fresh as the last fetch by anyone in the town.
kingdom_drift() {
    local root out rc=0
    root=$(deploy_root)
    if ! git_at "$root" rev-parse --verify -q origin/master >/dev/null 2>&1; then
        echo "origin/master is unknown in $root"
        return 0
    fi
    # A diff that could not run is not a clean tree. On a root git cannot use as
    # a checkout at all, `git diff` exits non-zero with EMPTY stdout — and empty
    # is this function's word for "no drift", so the gate would open widest
    # where it knows least. Measured shape: core.bare=true in the config, which
    # clears the rev-parse guard above and then fails here (bd gqlc-ed2u).
    # Carry the failure as drift, like the missing ref above.
    out=$(git_at "$root" diff --name-only origin/master -- kingdom/ 2>&1) || rc=$?
    if [ "$rc" -ne 0 ]; then
        echo "cannot measure drift in $root (git exited $rc): ${out//$'\n'/ }"
        return 0
    fi
    echo "$out"
}

deployed_ok() { [ -z "$(kingdom_drift)" ]; }

# Fail-closed: an unexpected failure inside leaves the caller refusing.
assert_deployed() { # <command name for the message>
    local drift
    drift=$(kingdom_drift)
    if [ -z "$drift" ]; then return 0; fi
    {
        echo "$1: DRIFT — $(deploy_root) is not origin/master, so the town would run stale code:"
        echo "  ${drift//$'\n'/$'\n  '}"
        echo "$1: run 'km deploy' (just kingdom-deploy) first"
    } >&2
    return 1
}

cmd_deploy() {
    local root branch drift
    root=$(deploy_root)
    branch=$(git_at "$root" symbolic-ref --quiet --short HEAD || true)
    [ "$branch" = master ] || die "deploy: $root is parked on '${branch:-a detached HEAD}', not master"
    git_at "$root" fetch --quiet origin master || die "deploy: cannot reach origin from $root"
    # --ff-only is the whole safety argument: git itself refuses to overwrite a
    # dirty file the incoming commits touch, and refuses a divergence, so bd's
    # exports in that tree are never clobbered by a stash-and-reset dance.
    git_at "$root" merge --ff-only origin/master || die "deploy: refused to move $root; resolve the above by hand"
    drift=$(kingdom_drift)
    if [ -n "$drift" ]; then
        {
            echo "deploy: incomplete — kingdom/ still differs from origin/master:"
            echo "  ${drift//$'\n'/$'\n  '}"
        } >&2
        return 1
    fi
    echo "deployed: $root at $(git_at "$root" rev-parse --short HEAD)"
}

seat_home()   { echo "$(state_dir)/seats/$1"; }
seat_status() {
    local f
    f="$(seat_home "$1")/status"
    if [ -f "$f" ]; then cat "$f"; else echo asleep; fi
}

# ---------- tmux ----------

SESSION="${KM_TMUX_SESSION:-$(cfg kingdom tmux_session)}"

have_tmux()  { command -v tmux >/dev/null 2>&1; }
session_up() { have_tmux && tmux has-session -t "=$SESSION" 2>/dev/null; }
window_up()  { session_up && tmux list-windows -t "=$SESSION" -F '#W' | grep -qx "$1"; }

# Does a session actually EXIST for this seat? The status file cannot answer
# that: it holds a claim written either side of a session by something that is
# not the session, and when the two disagree the town spends slots on nothing
# (gqlc-s16s). The pane's tty can answer it, because km-seat runs claude as the
# pane's own child.
#
# Deliberately no heartbeat here. heartbeat.json is written by the statusLine
# hook, which fires at TURN BOUNDARIES: measured in-seat, a 53s tool call left
# it untouched for the whole 53s and the age simply tracked the call. So it
# separates mid-turn from between-turns, not working from abandoned, and any
# threshold over it would reap a seat for being busy.
#
# window_up first, and it is not redundant with the pane lookup. tmux resolves a
# bare window target by PREFIX when nothing matches exactly, so `-t "=$SESSION:ar"`
# returns artur's pane (measured, tmux 3.7c) — and this roster has `ar` in it.
# pgrep wants the tty without its /dev/ prefix; the real-tmux row in the suite is
# what keeps that transform honest end to end.
seat_session_live() {
    local tty
    window_up "$1" || return 1
    tty=$(tmux list-panes -t "=$SESSION:$1" -F '#{pane_tty}' 2>/dev/null | head -1)
    [ -n "$tty" ] || return 1
    pgrep -t "${tty#/dev/}" -x claude >/dev/null 2>&1
}

# Text and its Enter as SEPARATE invocations. Bundled, tmux hands both to the
# pane in one read() burst and a TUI that reads a burst as a paste takes the CR
# as literal text — the keystroke is typed and never submitted (measured, tmux
# 3.7c, raw-tty reader). C-u first clears whatever a previous stranded attempt
# left in the box, which is what makes a re-send idempotent.
#
# This is necessary and NOT sufficient: if the reader is not in read() between
# the two writes the tty buffer re-coalesces them regardless of any delay, so
# no caller may treat a return from here as proof of delivery. Confirm instead.
send_line() { # <target> <text>
    tmux send-keys -t "$1" C-u
    tmux send-keys -t "$1" "$2"
    tmux send-keys -t "$1" Enter
}

# ---------- mail ----------

unread_count() {
    find "$(state_dir)/mail/$1/inbox" -type f -name '*.md' 2>/dev/null | wc -l
}

mail_deliver() { # write one message file into a recipient's box dir
    local dir=$1 fname=$2 content=$3 tmp
    mkdir -p "$dir"
    tmp=$(mktemp "$dir/.tmp.XXXXXX")
    printf '%s' "$content" >"$tmp"
    if [ -e "$dir/$fname" ]; then
        fname="${fname%.md}-$RANDOM.md"
    fi
    mv "$tmp" "$dir/$fname"
}

mail_send() {
    local to="" subj="" body="" from="${KINGDOM_SEAT:-andranik}"
    while [ $# -gt 0 ]; do
        case "$1" in
            -s) subj=$2; shift 2 ;;
            -m) body=$2; shift 2 ;;
            --from) from=$2; shift 2 ;;
            -*) die "mail send: unknown flag $1" ;;
            *) [ -z "$to" ] || die "mail send: one recipient per message (use 'town' to broadcast)"
               to=${1%/}; shift ;;
        esac
    done
    [ -n "$to" ] || die "mail send: no recipient"
    [ -n "$subj" ] || die "mail send: -s SUBJECT is required"
    case "$from" in andranik) ;; *) is_seat "$from" || die "mail send: unknown sender $from" ;; esac
    case "$to" in town | andranik) ;; *) is_seat "$to" || die "mail send: unknown recipient $to" ;; esac
    if [ -z "$body" ]; then
        [ ! -t 0 ] || die "mail send: body via -m or stdin"
        body=$(cat)
    fi

    local ts slug fname content sd
    ts=$(date -u +%Y%m%dT%H%M%SZ)
    slug=$(printf '%s' "$subj" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')
    slug=$(printf '%s' "$slug" | sed 's/^-*//; s/-*$//' | cut -c1-40)
    [ -n "$slug" ] || slug=msg
    fname="$ts--$from--$slug.md"
    content=$(printf -- '---\nfrom: %s\nto: %s\ndate: %s\nsubject: %s\n---\n%s\n' \
        "$from" "$to" "$(date -u -Iseconds)" "$subj" "$body")
    sd=$(state_dir)

    local delivered=0 r
    if [ "$to" = town ]; then
        for r in $(seats_all) andranik; do
            [ "$r" = "$from" ] && continue
            mail_deliver "$sd/mail/$r/inbox" "$fname" "$content"
            delivered=$((delivered + 1))
        done
    else
        mail_deliver "$sd/mail/$to/inbox" "$fname" "$content"
        delivered=1
    fi
    mail_deliver "$sd/mail/$from/sent" "$fname" "$content"
    echo "mail: $from → $to ($delivered box(es)): $subj"
}

mail_box_owner() { # --seat override, else caller identity
    local seat="${KINGDOM_SEAT:-andranik}"
    while [ $# -gt 0 ]; do
        case "$1" in
            --seat) seat=$2; shift 2 ;;
            *) shift ;;
        esac
    done
    echo "$seat"
}

mail_inbox() {
    local seat sd n f
    seat=$(mail_box_owner "$@")
    sd=$(state_dir)
    n=$(unread_count "$seat")
    echo "inbox of $seat — $n unread"
    [ "$n" -gt 0 ] || return 0
    for f in "$sd/mail/$seat/inbox/"*.md; do
        printf '  %s\n    %s\n' "$(basename "$f")" "$(grep -m1 '^subject:' "$f" || true)"
    done
}

mail_read() {
    local id="" seat="${KINGDOM_SEAT:-andranik}" sd inbox readdir matches
    while [ $# -gt 0 ]; do
        case "$1" in
            --seat) seat=$2; shift 2 ;;
            *) id=$1; shift ;;
        esac
    done
    [ -n "$id" ] || die "mail read: which message? (filename or unique prefix)"
    sd=$(state_dir)
    inbox="$sd/mail/$seat/inbox"
    readdir="$sd/mail/$seat/read"
    matches=$(find "$inbox" -maxdepth 1 -type f -name "$id*" 2>/dev/null | sort)
    if [ -z "$matches" ]; then
        matches=$(find "$readdir" -maxdepth 1 -type f -name "$id*" 2>/dev/null | sort)
        [ -n "$matches" ] || die "mail read: no message matching '$id' for $seat"
        [ "$(echo "$matches" | wc -l)" -eq 1 ] || die "mail read: ambiguous prefix '$id'"
        echo "(already read)"
        cat "$matches"
        return 0
    fi
    [ "$(echo "$matches" | wc -l)" -eq 1 ] || die "mail read: ambiguous prefix '$id'"
    cat "$matches"
    mkdir -p "$readdir"
    mv "$matches" "$readdir/"
}

mail_sent() {
    local seat sd f
    seat=$(mail_box_owner "$@")
    sd=$(state_dir)
    echo "sent by $seat:"
    for f in "$sd/mail/$seat/sent/"*.md; do
        [ -e "$f" ] || { echo "  (none)"; break; }
        printf '  %s\n' "$(basename "$f")"
    done
}

cmd_mail() {
    local sub=${1:-}
    shift || true
    case "$sub" in
        send)  mail_send "$@" ;;
        inbox) mail_inbox "$@" ;;
        read)  mail_read "$@" ;;
        sent)  mail_sent "$@" ;;
        *) die "mail: send|inbox|read|sent" ;;
    esac
}

# ---------- wake / sleep ----------

cmd_wake() {
    local seat=${1:-}
    shift || true
    is_seat "$seat" || die "wake: unknown seat ${seat:-<none>}"
    local reason=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --bead) reason="bead:$2 $reason"; shift 2 ;;
            --reason) reason="$reason$2"; shift 2 ;;
            *) die "wake: unknown flag $1" ;;
        esac
    done
    [ -n "$reason" ] || reason="a new day"
    mkdir -p "$(seat_home "$seat")"
    if [ "$(seat_status "$seat")" = awake ] && window_up "$seat"; then
        send_line "=$SESSION:$seat" "[km] $reason — check bd mail inbox when convenient"
        echo "wake: $seat is already awake; nudged instead"
    else
        printf '%s\n' "$reason" >>"$(seat_home "$seat")/wake"
        echo "wake: queued for $seat — $reason"
    fi
}

cmd_sleep() {
    local seat="${KINGDOM_SEAT:-}"
    while [ $# -gt 0 ]; do
        case "$1" in
            --seat) seat=$2; shift 2 ;;
            *) die "sleep: unknown flag $1" ;;
        esac
    done
    if [ -z "$seat" ]; then
        echo "sleep: not a seat session (KINGDOM_SEAT unset) — end your session normally"
        return 0
    fi
    is_seat "$seat" || die "sleep: unknown seat $seat"
    mkdir -p "$(seat_home "$seat")"
    # asleep-pending is a request, not a departure, and it stays one until the
    # session actually ends — km-seat writes `asleep` itself when claude exits.
    # `km sleep` cannot confirm its own exit: it runs as a child of the very
    # claude it is asking to leave, so the /exit is not acted on until this
    # command has already returned. Confirmation therefore belongs to
    # `km reconcile`, which is what makes an undelivered request recoverable.
    echo asleep-pending >"$(seat_home "$seat")/status"
    if window_up "$seat"; then
        send_line "=$SESSION:$seat" "/exit"
        echo "sleep: good night, $(seat_display "$seat") — the session ends when this turn does"
    else
        echo "sleep: no tmux window for $seat; end the session normally"
    fi
}

# ---------- town lifecycle ----------

ensure_state_tree() {
    local sd s
    sd=$(state_dir)
    for s in $(seats_all) andranik; do
        mkdir -p "$sd/mail/$s/inbox" "$sd/mail/$s/read" "$sd/mail/$s/sent"
    done
    for s in $(seats_all); do
        mkdir -p "$sd/seats/$s/handoff/archive"
    done
    mkdir -p "$sd/seats/andranik/handoff/archive"
}

cmd_up() {
    have_tmux || die "tmux is not installed (sudo pacman -S tmux), so there is no town to raise"
    ensure_state_tree
    local mr s wt placeholder=0
    mr=$(main_root)
    for s in $(seats_all); do
        wt=$(seat_worktree "$s")
        if [ ! -d "$wt" ]; then
            git -C "$mr" worktree add --detach "$wt" origin/master
        fi
    done
    if ! session_up; then
        tmux new-session -d -s "$SESSION" -n _km 'sleep 5'
        placeholder=1
    fi
    for s in $(seats_all); do
        window_up "$s" || tmux new-window -d -t "=$SESSION" -n "$s" "$SCRIPT_DIR/km-seat $s"
    done
    [ "$placeholder" -eq 1 ] && tmux kill-window -t "=$SESSION:_km" 2>/dev/null
    echo "the town is up: $(seats_all | wc -l) seats, all asleep until woken."
    echo "  just kingdom       — status"
    echo "  just herratsayn    — call Սեդրակ"
}

cmd_down() {
    session_up || { echo "the town is already down"; return 0; }
    mail_send town -s "town going down" -m "The tmux session is being stopped. Sessions end; seats, mail, and handoffs persist." || true
    tmux kill-session -t "=$SESSION"
    echo "the town is down. State, mail, and handoffs persist in $(state_dir)"
}

cmd_attach() {
    local seat=${1:-}
    is_seat "$seat" || die "attach: unknown seat ${seat:-<none>}"
    window_up "$seat" || die "attach: no window for $seat — is the town up? (just kingdom-up)"
    if [ -n "${TMUX:-}" ]; then
        tmux switch-client -t "=$SESSION"
        tmux select-window -t "=$SESSION:$seat"
    else
        tmux select-window -t "=$SESSION:$seat"
        exec tmux attach-session -t "=$SESSION"
    fi
}

cmd_herratsayn() {
    if [ "$(seat_status sedrak)" != awake ]; then
        cmd_wake sedrak --reason "Հեռաձայն from Անդրանիկ — he is calling you now"
    fi
    cmd_attach sedrak
}

# ---------- halt ----------

cmd_halt() {
    ensure_state_tree
    printf 'raised by %s at %s: %s\n' "${KINGDOM_SEAT:-andranik}" "$(date -u -Iseconds)" "${*:-no reason given}" \
        >"$(state_dir)/halt"
    # Names both timers, and says which paths it does NOT bind. The line used to
    # promise a quiet town while naming only the dispatcher, so an operator had
    # no reason to suspect the guard sweep was still launching sessions behind
    # the flag — and this line is the whole report he gets (gqlc-6dzi).
    echo "halt raised: the dispatcher and the guard sweep will wake nobody until it is lowered (km resume)"
    echo "  km wake and km herratsayn still reach a seat, so the town stays workable by hand."
}

cmd_resume() {
    if [ -f "$(state_dir)/halt" ]; then
        rm -f "$(state_dir)/halt"
        echo "halt lowered by ${KINGDOM_SEAT:-andranik}: the dispatcher may wake seats again"
    else
        echo "no halt was raised"
    fi
}

# ---------- dispatcher ----------

worker_seats() {
    local s c
    for s in $(seats_all); do
        c=$(seat_class "$s")
        case "$c" in architect | warrior | judge) echo "$s" ;; esac
    done
}

# Judges are exempt from concurrency.max_active alongside the mayor and the
# guard: the bench is the town's merge gate, so a cap that can close it is a
# merge freeze rather than a throttle, and it competes with the very seats
# producing its queue (gqlc-dz85). Judges are still worker seats above —
# dropping them there would leave free_worker_of_class unable to find them and
# route them nothing at all.
#
# Named, because it used to exist only as the difference between two case
# statements twelve lines apart: worker_seats listing three classes and
# capped_seats listing two. A reader had to diff them to find the exemption,
# and a fourth class added to one and not the other would have been silently
# capped or silently exempt (gqlc-a4tu, Ծովինար).
cap_exempt_class() { [ "$1" = judge ]; }

# The seats that spend a slot. The exemption lets the awake count exceed
# max_active by the number of judge seats the roster holds.
capped_seats() {
    local s
    for s in $(worker_seats); do
        cap_exempt_class "$(seat_class "$s")" || echo "$s"
    done
}

# Bring the ledger back into agreement with the world before anything reads it.
#
# Two repairs, and the difference between them is consent. A seat marked awake
# or asleep-pending with NO session left is simply a stale record: correcting it
# frees the slot and, because free_worker_of_class only ever picks an `asleep`
# seat, hands the seat back to the town. A seat marked asleep-pending whose
# claude is still ALIVE is the other half — the citizen asked to leave and the
# /exit never landed — so the request is re-delivered. That needs no asking:
# `km sleep` was the asking.
#
# What is NOT here: a seat marked awake, alive, and idle at its prompt. From
# outside it is indistinguishable from one thinking, and ending it would be
# ending a session against a citizen's will (Constitution VI.2). It needs to be
# ASKED, and that is gqlc-971s rather than something smuggled in here.
cmd_reconcile() {
    session_up || { echo "reconcile: the town is down; nothing to reconcile"; return 0; }
    local s st suspect repaired=0 redelivered=0 suspected=0
    for s in $(seats_all); do
        st=$(seat_status "$s")
        suspect="$(seat_home "$s")/suspect"
        case "$st" in awake | asleep-pending) ;; *) rm -f "$suspect"; continue ;; esac
        if seat_session_live "$s"; then
            rm -f "$suspect"
            if [ "$st" = asleep-pending ]; then
                send_line "=$SESSION:$s" "/exit"
                echo "reconcile: $s asked to leave and is still here; /exit re-sent"
                redelivered=$((redelivered + 1))
            fi
            continue
        fi
        # Confirmed over elapsed time, not over a count of passes. km-seat
        # writes `awake` BEFORE it execs claude, so there is a brief moment when
        # a seat that is starting up is indistinguishable from one that has died
        # — and rewriting the ledger there would hand a running seat's name back
        # to the dispatcher, against a session that is by then alive. Nothing
        # repairs that: `asleep` is not a state this function revisits.
        #
        # A sighting COUNT does not close the gap, because nothing separates two
        # passes: reconcile is a public subcommand, and a manual `km dispatch`
        # landing seconds before a cron tick makes a pair with no time in it.
        # The marker's age is the signal instead. 60s clears any exec window and
        # sits well under the 120s cadence, so a genuinely dead seat is still
        # freed on the next tick. The cap stopped counting it on the first pass
        # either way, so the throughput that matters is already recovered.
        if [ ! -f "$suspect" ]; then
            : >"$suspect"
            echo "reconcile: $s is recorded $st with no session; confirming next pass"
            suspected=$((suspected + 1))
            continue
        fi
        if [ "$(($(date +%s) - $(stat -c %Y "$suspect")))" -lt 60 ]; then
            echo "reconcile: $s is recorded $st with no session, but that sighting is too recent to tell a dead seat from a starting one; still confirming"
            suspected=$((suspected + 1))
            continue
        fi
        echo asleep >"$(seat_home "$s")/status"
        rm -f "$suspect" "$(seat_home "$s")/heartbeat.json"
        echo "reconcile: $s was recorded $st with no session for a full cycle; freed"
        repaired=$((repaired + 1))
    done
    echo "reconcile: done ($repaired freed, $suspected suspected, $redelivered re-sent)"
}

free_worker_of_class() { # asleep, no queued wake
    local class=$1 s
    for s in $(worker_seats); do
        [ "$(seat_class "$s")" = "$class" ] || continue
        [ "$(seat_status "$s")" = asleep ] || continue
        [ ! -f "$(seat_home "$s")/wake" ] || continue
        echo "$s"
        return 0
    done
    return 1
}

# Wakes every sleeping seat that owns work in <list> (lines of "seat id"), with
# <prefix> naming what those ids are to it. Both routing passes that hand a seat
# its OWN bead go through here: the cap arithmetic is the part that must not
# exist in two copies, because a divergence between them overspends the cap
# silently, and the cap is what keeps the town inside its quota.
#
# It reads and updates cmd_dispatch's `slots` and `wakes` through bash's dynamic
# scope, which is why it is only ever called from there.
route_owners() { # <"seat id" lines> <reason prefix>
    local list=$1 prefix=$2 s capped mine
    for s in $(worker_seats); do
        [ "$(seat_status "$s")" = asleep ] || continue
        # A seat with a wake already queued is skipped rather than woken twice.
        # A seat holding in-progress work AND assigned an unclaimed bead is
        # therefore told about the in-progress half only, and hears about the
        # other when it next sleeps — a delay, not a strand, and the order
        # Constitution III.3 asks for.
        [ ! -f "$(seat_home "$s")/wake" ] || continue
        capped=1
        if [ "$(seat_class "$s")" = judge ]; then capped=0; fi
        [ "$capped" -eq 0 ] || [ "$slots" -gt 0 ] || continue
        mine=$(echo "$list" | awk -v s="$s" '$1 == s { print $2 }')
        [ -n "$mine" ] || continue
        cmd_wake "$s" --reason "$prefix: $(echo "$mine" | tr '\n' ' ')"
        wakes=$((wakes + 1))
        if [ "$capped" -eq 1 ]; then slots=$((slots - 1)); fi
    done
}

# The state no dispatch pass can reach. The resume pass takes in_progress beads
# that name a seat, the owned and fresh passes take ready ones — and `bd ready`
# returns beads whose status is open only, so an in_progress bead with no
# assignee is in no pass and cannot re-enter one. It reads as work underway and
# no wake will ever come for it. Unassigning a bead a seat had already claimed
# produces exactly this state, and did on gqlc-gwf0 (recorded in gqlc-mro7),
# done by someone trying to make the bead more routable.
#
# NOT counted here, though it is equally unreachable: a bead assigned to a name
# that is not a seat. People hold beads here legitimately, so failing on that
# would mean failing whenever a human takes one — but it also means a RETIRED
# seat's work would hide in that category, indistinguishable from a person's
# (gqlc-t4zx).
stranded_ids() {
    bd list --status in_progress -n 0 --json 2>/dev/null |
        jq -r '[ .[] | select(.assignee == null) | .id ] | join(" ")'
}

cmd_dispatch() {
    assert_deployed dispatch || return 1
    session_up || { echo "dispatch: the town is down; nothing to do"; return 0; }
    local sd
    sd=$(state_dir)
    if [ -f "$sd/halt" ]; then
        echo "dispatch: halted — $(head -1 "$sd/halt")"
        return 0
    fi

    # Before anything is counted or chosen. Every decision below reads the
    # status files, and a stale one both spends a slot and hides the seat from
    # free_worker_of_class, so the same record costs the town twice.
    cmd_reconcile | sed 's/^reconcile: /dispatch: reconcile: /'

    local wakes=0

    # Սեդրակ answers his mail regardless of the cap.
    if [ "$(seat_status sedrak)" != awake ] && [ ! -f "$(seat_home sedrak)/wake" ] \
        && [ "$(unread_count sedrak)" -gt 0 ]; then
        cmd_wake sedrak --reason "you have unread mail"
        wakes=$((wakes + 1))
    fi

    # A full cap no longer returns early. It used to, which put the whole
    # routing decision behind the cap check: at 5/5 nothing was considered at
    # all, at any priority, so a P0 judge bead did not outrank a running P3 and
    # the town's only merge gate could be held shut by its own throughput
    # (gqlc-dz85). Zeroing the slots instead lets both passes below run and
    # decline capped work on their own, which is what leaves the judge reachable.
    # A slot is spent by a session that EXISTS, not by a file that says one
    # does. Reading the status string here is what let a finished session hold
    # a slot forever, and what let a live one under asleep-pending hold none at
    # all so the cap could overcommit (gqlc-s16s, gqlc-0gjt).
    local max active=0 s slots
    max=$(cfg concurrency max_active)
    for s in $(capped_seats); do
        seat_session_live "$s" && active=$((active + 1))
    done
    slots=$((max - active))
    if [ "$slots" -le 0 ]; then
        slots=0
        echo "dispatch: $active/$max capped seats awake; no free slot"
    fi

    # Resume pass: a seat with in-progress beads gets its own work back first
    # (Constitution III.3) before any fresh bead is routed anywhere.
    #
    # Both queries below are fail-closed. A query that FAILS is not a queue with
    # nothing in it: swallowing the status with `|| x=""` is what let a total
    # routing failure print "done (0 wake(s) this run)" and exit 0 for the whole
    # life of the kingdom, with no seat ever woken and nothing to see (gqlc-z1qw).
    # `-n 0` is unlimited and is load-bearing on every bd query here. The JSON
    # renderers cap silently — `ready` at 100, `list` at 50 — while the plain
    # renderers disclose it ("Showing 100 of 234 ready issues"), so the caller
    # that cannot read prose is the only one not told. A bead past the window
    # is not a bead nobody claimed, it is a bead nobody was shown, and the two
    # are indistinguishable from the board (gqlc-mlca).
    local inprog
    if ! inprog=$(bd list --status in_progress -n 0 --json 2>/dev/null |
        jq -r '.[] | select(.assignee != null) | "\(.assignee) \(.id)"' | sort); then
        die "dispatch: the in-progress query failed; nothing routed this run"
    fi
    route_owners "$inprog" "resume your in-progress work"

    # The ready queue serves the two passes below. Its rows split by whether the
    # bead names an owner:
    #
    #   owned — assigned to a seat. It goes to that seat and to nobody else, at
    #           any status. Before this split, a bead that was assigned but
    #           still OPEN was in neither pass — not null-assignee for the fresh
    #           one, not in_progress for the resume one — so it sat on the board
    #           looking owned and routed to nobody, at any priority, with
    #           nothing reporting the omission (gqlc-xq8a, gqlc-g10n).
    #   fresh — unassigned and class-labelled, routed to a free seat of its
    #           class.
    #
    # A class label decides nothing for an owned bead: the assignee already
    # names the seat, which is the rule the resume pass has always used. Hence
    # the `select($cls != null)` sits on the fresh arm only, where a label is
    # the sole way to choose a seat at all.
    #
    # Captured once rather than piped: the hold verdict below needs each
    # candidate's labels, and re-querying could read a different queue.
    local queue routed owned ready id cls seat
    if ! ready=$(bd ready -n 0 --json 2>/dev/null); then
        die "dispatch: the ready-queue query failed; nothing routed beyond the resume wakes above"
    fi
    # `. as $c` binds the class name before the pipe, and must stay bound: inside
    # `map(...)` the pipe in `($b.labels // []) | index(...)` rebinds `.` to the
    # labels array, so a bare `"class:" + .` is string + array — a type error that
    # aborts the whole program on any unassigned bead, labelled or not.
    if ! queue=$(jq -r '
        [ .[]
          | . as $b
          | (["architect", "warrior", "judge"]
             | map(. as $c | select(($b.labels // []) | index("class:" + $c))))[0] as $cls
          | {id, priority, assignee, cls: $cls}
        ] | sort_by(.priority) | .[]
          | if .assignee != null then "owned \(.assignee) \(.id)"
            elif .cls != null    then "fresh \(.id) \(.cls)"
            else empty end' <<<"$ready"); then
        # Not "nothing routed": the resume pass above may already have queued
        # wakes, and they stand. An operator reading this during an incident has
        # to be able to trust it.
        # The owned pass is downstream of this query, so nothing owned has been
        # routed yet — only the resume wakes stand here.
        die "dispatch: the ready-queue query failed; neither owned nor fresh beads routed (the resume wakes above stand)"
    fi
    owned=$(echo "$queue" | awk '$1 == "owned" { print $2, $3 }')
    routed=$(echo "$queue" | awk '$1 == "fresh" { print $2, $3 }')

    # Owned pass: an unclaimed bead that names a seat goes back to that seat,
    # ahead of any fresh routing, for the same reason the resume pass runs first
    # (Constitution III.3). An assignee that is not a seat — a person, most of
    # them — matches no seat here and is left alone.
    route_owners "$owned" "assigned work waiting — claim it before you begin"

    # Fresh pass: ready, unassigned, class-labelled beads, priority first. It
    # runs with no slots left too, because judge work does not need one.
    #
    # Before routing anything, ask whether each candidate's premise is actually
    # on master and out of every open PR's way (gqlc-pj4r). The edges come from
    # ONE multi-id `bd dep list` — the single-id form returns the parent issue
    # object instead of {issue_id, depends_on_id, type} rows, so a per-id loop
    # would parse a different shape and quietly find no edges — and the parent
    # statuses from ONE `bd show` over the discovered-from parents.
    local ids deps parents parent_ids docs verdicts="" held=0
    ids=$(awk 'NF { print $1 }' <<<"$routed")
    if [ -n "$ids" ]; then
        # shellcheck disable=SC2086 # deliberate word splitting: one call, all ids
        if ! deps=$(bd dep list $ids --json 2>/dev/null); then
            echo "dispatch: the dependency query failed; fresh pass skipped this run (the resume and owned wakes above stand)"
            return 0
        fi
        parent_ids=$(jq -r '[ .[]? | select(.type == "discovered-from") | .depends_on_id ] | unique | .[]' \
            <<<"$deps" 2>/dev/null) || parent_ids=""
        parents='[]'
        if [ -n "$parent_ids" ]; then
            # shellcheck disable=SC2086 # deliberate word splitting: one call, all ids
            if ! parents=$(bd show $parent_ids --json 2>/dev/null |
                jq -c 'if type == "array" then . else [.] end' 2>/dev/null); then
                echo "dispatch: the parent-status query failed; fresh pass skipped this run (the resume and owned wakes above stand)"
                return 0
            fi
        fi
        if ! docs=$(jq -c -n --argjson ready "$ready" --argjson deps "$deps" \
            --argjson parents "$parents" --arg ids "$ids" '
            ($ready | map({key: .id, value: .}) | from_entries) as $byId
            | ($parents | map({key: .id, value: .status}) | from_entries) as $status
            | [ ($ids | split("\n") | .[] | select(length > 0)) as $i
                | { id: $i,
                    labels: ($byId[$i].labels // []),
                    deps: [ $deps[]? | select(.issue_id == $i)
                            | {depends_on_id, type, status: ($status[.depends_on_id] // "unknown")} ] } ]'); then
            echo "dispatch: the candidate documents could not be assembled; fresh pass skipped this run"
            return 0
        fi
        if ! verdicts=$(cmd_hold_verdict <<<"$docs"); then
            # Never fall through to routing unchecked. The resume wakes taken
            # above stand, and an operator reading this during an incident must
            # be able to trust that sentence.
            echo "dispatch: hold-verdict failed (rc=$?); fresh pass skipped this run (the resume and owned wakes above stand)"
            return 0
        fi
    fi

    local verdict reason
    while IFS=' ' read -r id cls; do
        [ -n "$id" ] || continue
        verdict=$(awk -v i="$id" '$2 == i { $1 = $1; print; exit }' <<<"$verdicts")
        # An explicit ROUTE is the only thing that routes. A hold and a bead the
        # verdict never mentioned take the same arm on purpose: the default for
        # anything we did not affirmatively clear is to leave it alone.
        if [ "$verdict" != "ROUTE $id" ]; then
            reason=${verdict#HOLD "$id" — }
            [ -n "$reason" ] || reason="no verdict returned for this bead"
            echo "dispatch: hold $id — $reason"
            held=$((held + 1))
            continue
        fi
        # `continue`, not `break`: the queue is sorted by priority, not by class,
        # so exhausted slots must skip past capped beads to reach judge work
        # sitting behind them rather than abandoning the rest of the queue.
        if [ "$cls" != judge ]; then
            [ "$slots" -gt 0 ] || continue
        fi
        if seat=$(free_worker_of_class "$cls"); then
            cmd_wake "$seat" --bead "$id" --reason "ready ${cls} work — claim it before you begin"
            wakes=$((wakes + 1))
            if [ "$cls" != judge ]; then slots=$((slots - 1)); fi
        fi
    done <<<"$routed"

    # The report the routing cannot make for itself. This run's passes are done;
    # a bead none of them could reach is named here rather than left to be found
    # by accident, which is how each of the previous three invisibility shapes
    # was found. It does not stop the run: routing is the job, and a diagnostic
    # that can abort it would be a worse failure than the one it reports. `km
    # doctor` is where the same fact is a gate that FAILS.
    local stranded
    if ! stranded=$(stranded_ids); then
        echo "dispatch: the reachability check could not run; the routing above stands"
    elif [ -n "$stranded" ]; then
        echo "dispatch: STRANDED — in progress and assigned to nobody, so no pass can wake anyone for them: $stranded"
    fi
    echo "dispatch: done ($wakes wake(s) this run, $held held)"
}

# ---------- the routing hold ----------
#
# A bead filed against code that exists only on an unmerged PR branch reads
# `ready`, and a warrior routed to it branches from origin/master and finds
# nothing to fix. Until now the only guard was Սեդրակ declining to class-label
# such beads, from a list he carried in his handoff — a person remembering.
#
# HOLD a fresh-routing candidate if EITHER its declared subject path is absent
# from origin/master, OR an open PR modifies it. Release is automatic: merging
# or closing the PR changes the answer on the next run, so nobody has to
# remember anything. Holds gate FRESH routing only; work that already names a
# seat is never withheld, whether that seat has started it or merely been
# assigned it (Constitution III.3) — both owner-facing passes run upstream of
# the verdict, so no hold can reach them.
#
# The convention this reads is a bd label `subject:<path>`, repo-relative, file
# or directory. A title-prefix→path map was measured and rejected: it would live
# on master and be maintained reactively, so residue about a NEW subsystem — the
# premise-absent case exactly — hits it as an unknown prefix and fails open at
# the worst spot.

hold_fetch_master() {
    [ -z "${KM_HOLD_SKIP_FETCH:-}" ] || return 0
    timeout 30 git -C "$(main_root)" fetch --quiet origin master 2>/dev/null && return 0
    # Over-holding, and it self-heals next run: a stale origin/master can only
    # make a path look absent, never make an absent one look present.
    echo "hold-verdict: could not fetch; consulting a possibly-stale origin/master" >&2
}

hold_open_pr_files() { # -> [{number, files:[path], truncated}]; rc 1 if gh cannot answer
    local raw limit=100 got
    raw=$(timeout 30 gh pr list --state open --limit "$limit" --json number,changedFiles,files 2>/dev/null) || return 1
    # The LIST-level cap, one level up from the per-PR one below. gh offers no
    # list-level tell: asked for N it returns N whether N or 4N are open, so the
    # (N+1)th PR is indistinguishable from no PR — and every PR it DID return can
    # be individually complete, so the per-PR guard never fires. A full-length
    # list is an unknown list; degrade to the hold a gh outage already takes.
    got=$(printf '%s' "$raw" | jq 'length' 2>/dev/null) || return 1
    if [ "$got" = "$limit" ]; then
        # Named on stderr because the reason line downstream says "gh unavailable",
        # which is true of the answer but not of the cause; without this the
        # journal sends an operator looking for an outage that did not happen.
        echo "hold-verdict: gh returned $got open PRs against a limit of $limit — the list may be truncated, holding" >&2
        return 1
    fi
    # MEASURED 2026-08-22 on PR #742: changedFiles 102, files 100 — `--json files`
    # caps per PR and says nothing. A capped list is an UNKNOWN list, not a
    # complete one; reading it as complete fails OPEN on the largest PRs.
    # changedFiles is the cap-independent tell, so no threshold is guessed here.
    printf '%s' "$raw" | jq -c '[ .[] | {
        number,
        files: [ .files[]?.path ],
        listed: (.files | length),
        changed: .changedFiles,
        truncated: (.changedFiles > (.files | length))
    } ]' 2>/dev/null || return 1
}

hold_paths_on_master() { # subjects on stdin, one per line -> {"<path>": true|false}
    local mr s present out='{}'
    mr=$(main_root)
    while IFS= read -r s; do
        [ -n "$s" ] || continue
        if git -C "$mr" cat-file -e "origin/master:$s" 2>/dev/null; then present=true; else present=false; fi
        out=$(printf '%s' "$out" | jq -c --arg s "$s" --argjson p "$present" '.[$s] = $p')
    done
    printf '%s' "$out"
}

cmd_hold_verdict() {
    local input
    input=$(cat)
    if ! printf '%s' "$input" | jq -e 'type == "array"' >/dev/null 2>&1; then
        die "hold-verdict: stdin is not a JSON array of candidate documents"
    fi

    local subjects
    subjects=$(printf '%s' "$input" | jq -r '
        [ .[]? | select(type == "object") | .labels
          | select(type == "array") | .[]
          | select(type == "string" and startswith("subject:"))
          | .[8:] | sub("/+$"; "") | select(length > 0) ] | unique | .[]')

    # gh and the fetch cost a network round trip each, so they are paid only
    # when some candidate actually declares a subject. That is also what keeps
    # the ordinary-bead path — the overwhelming majority — free, and the test
    # suite hermetic without stubbing anything for it.
    local prs='[]' pr_known=true present='{}'
    if [ -n "$subjects" ]; then
        hold_fetch_master
        if ! prs=$(hold_open_pr_files); then
            prs='[]'
            pr_known=false
        fi
        present=$(printf '%s\n' "$subjects" | hold_paths_on_master)
    fi

    printf '%s' "$input" | jq -r \
        --argjson prs "$prs" --argjson prKnown "$pr_known" --argjson present "$present" '
        def subjects_of:
            [ .labels[] | select(type == "string" and startswith("subject:"))
              | .[8:] | sub("/+$"; "") | select(length > 0) ];

        def is_judge: any(.labels[]; . == "class:judge");

        # Fail closed per candidate, never a silent drop: gqlc-z1qw was a jq
        # abort that read as a healthy zero, and one bad row must cost one line
        # rather than the whole run.
        def malformed:
            if type != "object" then "not an object"
            elif (.id | type) != "string" or (.id == "") then "no id"
            elif (.labels | type) != "array" then "labels is not an array"
            else null end;

        # The slash boundary is the whole point of the second clause: a plain
        # substring test would hold internal/tools/tmpreaper for a PR touching
        # internal/tools/tmpreap, which are different subsystems.
        def touching($s): [ $prs[] | select(any(.files[]; . == $s or startswith($s + "/"))) ];

        # The premise of a review bead IS an open PR touching its subject, so
        # the three arms below that ask "might an open PR be touching this?"
        # are inverted for it: they hold the review for as long as it is wanted
        # and release it when the PR merges. The premise-absent arm above them
        # is NOT inverted — a review naming a path no branch has is a typo — so
        # the exemption is per-arm, never a pass for the class (gqlc-n4oe).
        #
        # No apostrophes in this jq program: it is a single-quoted shell string.
        def reason($s; $judge):
            if ($present[$s] // false) | not then
                "premise absent from origin/master: \($s)"
            elif $judge then null
            elif ($prKnown | not) then
                "gh unavailable — cannot rule out an open PR touching \($s)"
            elif (touching($s) | length) > 0 then
                # Before the truncation arm on purpose: a match in the VISIBLE
                # list of a truncated PR is still a definite match, and the
                # reason printed must be as strong as the evidence held.
                "open PR #\(touching($s)[0].number) touches \($s)"
            elif ([ $prs[] | select(.truncated) ] | length) > 0 then
                ([ $prs[] | select(.truncated) ][0]) as $t
                | "open PR #\($t.number) lists \($t.listed) of \($t.changed) files — cannot rule out \($s)"
            else null end;

        .[]
        | . as $c
        | (if (type == "object") and ((.id | type) == "string") then .id else "?" end) as $id
        | (malformed) as $bad
        | if $bad != null then "HOLD \($id) — malformed candidate: \($bad)"
          else
            (subjects_of) as $subs
            | if ($subs | length) == 0 then
                # Residue with no subject label yet. Only discovered-from carries
                # the "filed against that PR" meaning; until and related do not.
                [ ($c.deps // [])[] | select(type == "object")
                  | select(.type == "discovered-from")
                  # "not closed", never a whitelist of the states known today: a
                  # whitelist clears every state it has not met — including the
                  # empty subset bd returns for an id it cannot find — and that
                  # clearing is the fail-OPEN direction.
                  | select(.status != "closed") ] as $par
                # Exempt for a review: the printed remedy of this arm — add a
                # subject: label — is what trips the PR arm above, and the
                # parent cannot close until the PR merges, which needs this
                # review. Two doors, one deadlock (gqlc-n4oe).
                | if ($par | length) > 0 and (is_judge | not)
                  then "HOLD \($id) — unlabelled residue of open \($par[0].depends_on_id) — needs a subject: label"
                  else "ROUTE \($id)" end
              else
                (is_judge) as $judge
                | [ $subs[] | reason(.; $judge) | select(. != null) ] as $why
                | if ($why | length) > 0 then "HOLD \($id) — \($why[0])" else "ROUTE \($id)" end
              end
          end'
}

cmd_guard_sweep() {
    assert_deployed guard-sweep || return 1
    session_up || { echo "guard-sweep: the town is down"; return 0; }
    # The halt binds every TIMER-driven wake, not just the dispatcher's. This is
    # the second one, and each wake here starts a real claude session, so a halt
    # that missed it went on spending tokens once per guard cadence — and since
    # Article VI.4 reserves lowering a halt to Սեդրակ or Անդրանիկ, whoever
    # raised it had no way to find that out (gqlc-6dzi). `km wake` and
    # `km herratsayn` are deliberately NOT bound: a halted town still has to be
    # workable by the operator who is going to lower the halt.
    local sd
    sd=$(state_dir)
    if [ -f "$sd/halt" ]; then
        echo "guard-sweep: halted — $(head -1 "$sd/halt")"
        return 0
    fi
    if [ "$(seat_status raffi)" = awake ]; then
        echo "guard-sweep: Րաֆֆի is already on his rounds"
        return 0
    fi
    cmd_wake raffi --reason "time for a round of the town (see your soul: rounds)"
}

# ---------- unit health ----------

# systemd answers Result=success for a unit that has never fired AND for one
# that is not installed at all — measured 2026-08-22: LoadState=not-found came
# back with Result=success — so health cannot be read off Result alone.
unit_health() { # <unit> -> "ok …" | "FAILED …" | "NEVER RUN …" | "NOT INSTALLED …" | "UNKNOWN …"
    local props line load="" last="" result="" code=""
    if ! props=$(systemctl --user show "$1" \
        -p LoadState -p InactiveEnterTimestamp -p Result -p ExecMainStatus 2>/dev/null); then
        echo "UNKNOWN — systemctl could not answer (is there a user bus?)"
        return 0
    fi
    # By key, never by position: systemd returns the properties in its own
    # order, not the order they were asked for.
    while IFS= read -r line; do
        case "$line" in
            LoadState=*) load=${line#*=} ;;
            InactiveEnterTimestamp=*) last=${line#*=} ;;
            Result=*) result=${line#*=} ;;
            ExecMainStatus=*) code=${line#*=} ;;
        esac
    done <<<"$props"
    if [ "$load" != loaded ]; then
        echo "NOT INSTALLED — $1 is ${load:-absent} (km install-units)"
    elif [ -z "$last" ]; then
        echo "NEVER RUN — $1 exists but its timer has never fired it"
    elif [ "$result" != success ]; then
        echo "FAILED — last run $last ($result, exit ${code:-?}): journalctl --user -u $1"
    else
        echo "ok (last run $last)"
    fi
}

unit_ran_ok() { case "$(unit_health "$1")" in ok*) return 0 ;; *) return 1 ;; esac; }

# ---------- status ----------

cmd_status() {
    local sd s disp class st ctx hb beads unread
    sd=$(state_dir)
    echo "Թագաւորութիւն — $(date -u -Iseconds)"
    if session_up; then echo "town: UP (tmux session '$SESSION')"; else echo "town: DOWN"; fi
    if [ -f "$sd/halt" ]; then echo "HALT: $(head -1 "$sd/halt")"; fi
    # A dispatcher refusing on drift is otherwise visible only in the journal
    # (bd gqlc-vzpn), so the town's one glance carries it.
    if ! deployed_ok; then
        echo "DRIFT: $(deploy_root) is not origin/master — the timers refuse until 'km deploy'"
    fi
    echo

    local inprog
    inprog=$(bd list --status in_progress -n 0 --json 2>/dev/null |
        jq -r '.[] | select(.assignee != null) | "\(.assignee) \(.id)"') || inprog=""

    printf '%-10s %-10s %-8s %-6s %-6s %s\n' SEAT CLASS STATE CTX MAIL BEADS
    for s in $(seats_all); do
        disp=$(seat_display "$s")
        class=$(seat_class "$s")
        st=$(seat_status "$s")
        if [ "$st" = awake ] && ! window_up "$s"; then st="awake?"; fi
        ctx="-"
        hb="$sd/seats/$s/heartbeat.json"
        if [ "$st" = awake ] && [ -f "$hb" ]; then
            ctx=$(jq -r 'if .context_pct == null then "-" else "\(.context_pct | floor)%" end' "$hb" 2>/dev/null || echo "-")
        fi
        unread=$(unread_count "$s")
        beads=$(echo "$inprog" | awk -v s="$s" '$1 == s { printf "%s ", $2 }')
        printf '%-10s %-10s %-8s %-6s %-6s %s  (%s)\n' "$s" "$class" "$st" "$ctx" "$unread" "${beads:-—}" "$disp"
    done

    echo
    printf 'dispatch: %s\n' "$(unit_health kingdom-dispatch.service)"
    printf 'guard:    %s\n' "$(unit_health kingdom-guard.service)"

    echo
    local ready
    # `-n 0`: without it these counters are silently FLOORS, not counts — and a
    # precise-looking wrong number is worse than none, because the mayor sizes
    # his standing labelling chore off this line (gqlc-mlca).
    ready=$(bd ready -n 0 --json 2>/dev/null) || ready="[]"
    echo "ready queue: $(echo "$ready" | jq '[.[] | select((.labels // []) | index("class:architect"))] | length') architect, $(echo "$ready" | jq '[.[] | select((.labels // []) | index("class:warrior"))] | length') warrior, $(echo "$ready" | jq '[.[] | select((.labels // []) | index("class:judge"))] | length') judge, $(echo "$ready" | jq '[.[] | select([((.labels // []) | index("class:architect")), ((.labels // []) | index("class:warrior")), ((.labels // []) | index("class:judge"))] | all(. == null))] | length') unlabelled (Սեդրակ's chore)"
    echo "the king's inbox (andranik): $(unread_count andranik) unread"
}

# ---------- doctor / install ----------

cmd_doctor() {
    local ok=0
    check() { # check <hard|soft> <label> <cmd...>
        local kind=$1 label=$2
        shift 2
        if "$@" >/dev/null 2>&1; then
            echo "ok:   $label"
        elif [ "$kind" = hard ]; then
            echo "FAIL: $label"
            ok=1
        else
            echo "warn: $label"
        fi
    }
    check hard "tmux installed" command -v tmux
    check hard "claude installed" command -v claude
    check hard "bd installed" command -v bd
    check hard "jq installed" command -v jq
    check hard "python3 installed" command -v python3
    check hard "state dir writable" mkdir -p "$(state_dir)"
    # Not a `check` row: this one must NAME what it found. A boolean row labelled
    # "matches origin/master" reports a measured mismatch, so on a root that
    # could not be measured at all it sends the reader to `km deploy` for a
    # difference that was never observed.
    local drift
    drift=$(kingdom_drift)
    if [ -z "$drift" ]; then
        echo "ok:   deployed kingdom/ matches origin/master"
    else
        echo "FAIL: deployed kingdom/ is not certified against origin/master:"
        echo "      ${drift//$'\n'/$'\n      '}"
        ok=1
    fi
    # Not a `check` row either, and for the same reason twice over: this one has
    # three outcomes, and the failing one has to NAME the beads. A gate an
    # operator cannot act on is a warning wearing a gate's clothes.
    local stranded
    if ! stranded=$(stranded_ids); then
        echo "FAIL: the reachability query failed, so no bead can be certified reachable"
        ok=1
    elif [ -n "$stranded" ]; then
        echo "FAIL: in progress and assigned to nobody, so no dispatch pass can wake anyone: $stranded"
        ok=1
    else
        echo "ok:   every bead is in some dispatch pass"
    fi
    check soft "bd mail.delegate points at km" sh -c "bd config get mail.delegate | grep -q 'km mail'"
    check soft "dispatch timer enabled" systemctl --user is-enabled kingdom-dispatch.timer
    check soft "guard timer enabled" systemctl --user is-enabled kingdom-guard.timer
    # An enabled timer says the machinery is armed, not that it works: the
    # dispatcher routed nothing for its whole life with both timers green
    # (gqlc-z1qw), and now that it dies on a bad query, the death lands only in
    # the journal unless something asks the unit how its last run went.
    check soft "dispatch last run succeeded" unit_ran_ok kingdom-dispatch.service
    check soft "guard last run succeeded" unit_ran_ok kingdom-guard.service
    check soft "town is up" tmux has-session -t "=$SESSION"
    return "$ok"
}

# ---------- seat worktree freshness ----------

# core.hooksPath is RELATIVE, so a seat runs the hooks in its OWN checkout and
# acquires a merged one only when its worktree next moves. `km up` parks a seat
# detached and nothing moves it again, so merging a gate deploys it to nobody
# and the town's drift detectors all read clean — they check the hooksPath
# VALUE, which stays '.githooks' in a seat whose .githooks/ predates the gate
# (bd gqlc-xtre: 7 of 14 seats had no push guard hours after it merged).
#
# Exit 3 means "still exposed": held for work in flight AND behind on hooks.
# km-seat turns that into a banner in the citizen's first message.
cmd_seat_refresh() {
    local seat=${1:-}
    [ -n "$seat" ] || die "seat-refresh: which seat?"
    is_seat "$seat" || die "seat-refresh: unknown seat: $seat"

    local mr wt
    mr=$(main_root)
    wt=$(seat_worktree "$seat")
    [ -d "$wt" ] || die "seat-refresh: no worktree at $wt (km up creates it)"

    # A failed fetch judges the seat against a stale origin/master, which would
    # report a seat current on evidence that is itself behind. Say so rather
    # than reporting a clean result from an unanswered question.
    local stale_note=""
    git -C "$mr" fetch --quiet origin 2>/dev/null ||
        stale_note=" [fetch failed: judged against the last known origin/master]"

    local target
    target=$(git -C "$mr" rev-parse --verify --quiet origin/master) ||
        die "seat-refresh: no origin/master to refresh $seat against"

    local head branch dirty behind ahead
    head=$(git -C "$wt" rev-parse HEAD)
    branch=$(git -C "$wt" symbolic-ref --quiet --short HEAD || true)
    dirty=$(git -C "$wt" status --porcelain)
    # Counted before any move, and restricted to the paths that ARE the gates.
    behind=$(git -C "$wt" log --oneline "HEAD..$target" -- .githooks .claude | wc -l)
    # Detached and clean is not the same as parked. A citizen who committed
    # without first cutting a branch leaves both of those signals empty, and
    # moving that worktree takes the commit off every ref. A genuinely parked
    # seat is an ancestor of target, so this is 0 for it and holds nobody
    # who is not carrying something.
    ahead=$(git -C "$wt" rev-list --count "$target..HEAD")

    if [ -n "$dirty" ] || [ -n "$branch" ] || [ "$ahead" -gt 0 ]; then
        local why="$ahead commit(s) of its own, on no branch"
        [ -n "$branch" ] && why="branch $branch in flight"
        [ -n "$dirty" ] && why="uncommitted work in the tree"
        if [ "$behind" -eq 0 ]; then
            echo "seat-refresh $seat: held ($why); its hooks are current$stale_note"
            return 0
        fi
        echo "seat-refresh $seat: HELD — $behind hook/settings change(s) behind master and NOT applied ($why)$stale_note"
        return 3
    fi

    if [ "$head" = "$target" ]; then
        echo "seat-refresh $seat: current at $(git -C "$wt" rev-parse --short HEAD)$stale_note"
        return 0
    fi

    git -C "$wt" checkout --detach --quiet "$target" ||
        die "seat-refresh: could not move $seat's parked worktree to origin/master"
    echo "seat-refresh $seat: refreshed $(git -C "$mr" rev-parse --short "$head") -> $(git -C "$wt" rev-parse --short HEAD) ($behind hook/settings change(s) picked up)$stale_note"
}

render_unit() { # <src> <dst>
    sed -e "s|@REPO@|$(main_root)|g" \
        -e "s|@DISPATCH_MIN@|$(cfg cadence dispatch_minutes)|g" \
        -e "s|@GUARD_MIN@|$(cfg cadence guard_minutes)|g" \
        "$1" >"$2"
}

cmd_install_units() {
    local unitdir="$HOME/.config/systemd/user" u
    mkdir -p "$unitdir"
    for u in kingdom-dispatch.service kingdom-dispatch.timer kingdom-guard.service kingdom-guard.timer; do
        render_unit "$KINGDOM_DIR/systemd/$u" "$unitdir/$u"
    done
    systemctl --user daemon-reload
    systemctl --user enable --now kingdom-dispatch.timer kingdom-guard.timer
    bd config set mail.delegate "$(main_root)/kingdom/bin/km mail"
    ensure_state_tree
    echo "installed: dispatch every $(cfg cadence dispatch_minutes)m, guard every $(cfg cadence guard_minutes)m; bd mail now delegates to km"
}

cmd_uninstall_units() {
    systemctl --user disable --now kingdom-dispatch.timer kingdom-guard.timer 2>/dev/null || true
    rm -f "$HOME/.config/systemd/user"/kingdom-{dispatch,guard}.{service,timer}
    systemctl --user daemon-reload
    echo "units removed; state, mail, and worktrees untouched"
}

# ---------- main ----------

cmd=${1:-}
shift || true
case "$cmd" in
    status)          cmd_status "$@" ;;
    up)              cmd_up "$@" ;;
    down)            cmd_down "$@" ;;
    attach)          cmd_attach "$@" ;;
    herratsayn)      cmd_herratsayn "$@" ;;
    wake)            cmd_wake "$@" ;;
    sleep)           cmd_sleep "$@" ;;
    mail)            cmd_mail "$@" ;;
    dispatch)        cmd_dispatch "$@" ;;
    hold-verdict)    cmd_hold_verdict "$@" ;;
    reconcile)       cmd_reconcile "$@" ;;
    seat-live)       seat_session_live "$1" ;;
    guard-sweep)     cmd_guard_sweep "$@" ;;
    halt)            cmd_halt "$@" ;;
    resume)          cmd_resume "$@" ;;
    doctor)          cmd_doctor "$@" ;;
    deploy)          cmd_deploy "$@" ;;
    install-units)   cmd_install_units "$@" ;;
    uninstall-units) cmd_uninstall_units "$@" ;;
    state-dir)       state_dir ;;
    cfg)             cfg "${1:?km cfg <section> <key>}" "${2:?km cfg <section> <key>}" ;;
    seat-info)       is_seat "${1:-}" || die "seat-info: unknown seat ${1:-<none>}"
                     echo "$(seat_class "$1") $(seat_model "$1") $(seat_display "$1")" ;;
    seat-worktree)   is_seat "${1:-}" || die "seat-worktree: unknown seat ${1:-<none>}"
                     seat_worktree "$1" ;;
    seat-refresh)    cmd_seat_refresh "$@" ;;
    -h | --help | help | "") usage ;;
    *) die "unknown command: $cmd (km --help)" ;;
esac
