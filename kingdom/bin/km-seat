#!/usr/bin/env bash
# km-seat <seat> — the runner that IS a seat's tmux window (kingdom/README.md).
#
# An endless day/night cycle: park until `km wake` queues a reason, compose
# the first message (wake reasons, unread mail, pending handoff notes — only
# what exists, so a cleanly finished day wakes to nothing stale), run ONE
# interactive claude session in the seat's own worktree with the soul
# appended, then park again. Same window, same identity, fresh context every
# wake.
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
KINGDOM_DIR=$(dirname "$SCRIPT_DIR")
KM="$SCRIPT_DIR/km"
SELF="$SCRIPT_DIR/$(basename -- "${BASH_SOURCE[0]}")"

# The parse this process is running, identified by the CONTENT of the file it
# came from rather than its mtime: mtime is whole seconds here, so a deploy
# landing in the same second as a respawn is invisible to it, and content also
# answers "no change" correctly when a deploy puts back what was already there.
# See the re-exec at the top of the loop (bd gqlc-s67rz).
#
# `|| self_sum=""` is load-bearing under `set -euo pipefail`: a failed read makes
# the pipeline non-zero, `cut` exiting 0 does not mask it, the bare assignment
# carries that status, and set -e would end this process before anything could
# read the variable (bd gqlc-r6fdz).
self_sum=$(sha256sum "$SELF" 2>/dev/null | cut -d' ' -f1) || self_sum=""

seat=${1:-}
[ -n "$seat" ] || { echo "km-seat: which seat?" >&2; exit 1; }

read -r class model display <<<"$("$KM" seat-info "$seat")"
sd=$("$KM" state-dir)
home="$sd/seats/$seat"
wt=$("$KM" seat-worktree "$seat")
soul="$KINGDOM_DIR/seats/$seat/soul.md"
pm=$("$KM" cfg claude permission_mode)
: "${pm:=bypassPermissions}"

# Thinking depth. Two sources now, one gate: the class default from [effort],
# and a per-bead `effort:<level>` label that overrides it for one wake
# (Constitution V.6.2, bd gqlc-jmwh). A seat must launch whatever it is told, so
# anything we would not recognise is dropped rather than passed on: claude
# refuses an unknown --effort, and a bad value would otherwise take out every
# seat of that class at once. The label is the LESS trustworthy of the two —
# any citizen can write one, and nobody reviews a label — so it goes through the
# same gate and not a laxer one.
valid_effort() { # <level> <where it came from> -> the level, or nothing and a warning
    case "$1" in
        low | medium | high | xhigh | max) printf '%s' "$1" ;;
        "") ;;
        *) echo "km-seat: $2 = '$1' is not a level claude takes; launching $seat without it" >&2 ;;
    esac
}

class_effort=$(valid_effort "$("$KM" cfg effort "$class")" "[effort] $class")

[ -f "$soul" ] || { echo "km-seat: no soul at $soul" >&2; exit 1; }
[ -d "$wt" ] || { echo "km-seat: no worktree at $wt (km up creates it)" >&2; exit 1; }

# Permission mode, gated here with the other preflights and for the same reason:
# one line of [claude] decides how every seat in the town starts, and one of the
# six values claude takes cannot work here at all (bd gqlc-twmh).
#
# `plan` starts the session INSIDE the state .githooks/claude-pre-ask exists to
# keep seats out of. That hook denies EnterPlanMode and deliberately leaves
# ExitPlanMode open, because denying the exit would strand a session inside plan
# mode — sound only while no seat STARTS there. Set permission_mode = "plan" and
# it inverts: there is nothing to enter, so the gate never fires, and the only
# way out is the plan-approval prompt with nobody at the pane to answer it. The
# session then waits until someone kills it while the statusline heartbeat keeps
# refreshing, because the turn is still live (bd gqlc-n97e measured 13 minutes
# of that on one seat; this would be every seat, on one line of config).
#
# REFUSED rather than coerced to a workable mode, which is the trade this case
# makes: the failure it prevents is silent, open-ended and town-wide, while the
# refusal is one line of stderr and a one-line fix in kingdom.toml. Coercion
# would launch sixteen seats at a mode the operator did not ask for and give
# them no way to find out.
#
# An UNRECOGNISED value is refused too, and not dropped the way valid_effort
# drops a bad level. Dropping --effort leaves claude at its own default, which
# is a working seat; dropping --permission-mode leaves `default`, which prompts
# for everything and puts the same wedge back. claude refuses the value anyway
# ("Allowed choices are acceptEdits, auto, bypassPermissions, default, dontAsk,
# plan"), but only after km-seat has consumed the wake — so the refusal belongs
# here, before the loop, where the wake is still queued for the next attempt.
#
# The middle arm launches and complains. acceptEdits is what kingdom.toml itself
# offers for a supervised run, so refusing it would take away a documented
# affordance; what it must not do is stay quiet, because such a seat works only
# while someone is watching the pane and nothing else in the town says so. Which
# of auto/default/dontAsk can survive unattended is NOT measured here; that is
# why they are warned about rather than blessed or refused.
case "$pm" in
    bypassPermissions) ;;
    plan)
        echo "km-seat: [claude] permission_mode = 'plan' cannot launch $seat: a seat is unattended, so the plan waits for an approval nobody is there to give, and the heartbeat stays green while it waits (bd gqlc-twmh, gqlc-n97e). Set permission_mode = \"bypassPermissions\" in kingdom/kingdom.toml." >&2
        exit 1
        ;;
    acceptEdits | auto | default | dontAsk)
        echo "km-seat: [claude] permission_mode = '$pm' is not the unattended mode the town runs (bypassPermissions); launching $seat there anyway, but a permission prompt in this mode blocks until someone attached to this pane answers it (bd gqlc-twmh)." >&2
        ;;
    *)
        echo "km-seat: [claude] permission_mode = '$pm' is not a mode claude takes, so $seat was not launched: claude allows acceptEdits, auto, bypassPermissions, default, dontAsk, plan. Fix kingdom/kingdom.toml — the wake is still queued (bd gqlc-twmh)." >&2
        exit 1
        ;;
esac

mkdir -p "$home/handoff/archive"
echo asleep >"$home/status"
trap 'echo asleep >"$home/status"' EXIT
trap 'exit 0' INT TERM

compose() { # $1 = wake reasons, one per line; $2 = a stale-hooks warning, or empty
    printf 'Բարի լոյս, %s։ A new workday begins in your seat (%s).\n\n' "$display" "$seat"
    printf 'Why you were woken:\n'
    printf '%s\n' "$1" | sed 's/^/  - /'

    if [ -n "$2" ]; then
        printf '\nBEFORE YOU PUSH — your gates are not master'"'"'s:\n  %s\n' "$2"
        printf 'You have work in flight here, so nothing was moved for you. The hooks in\n'
        printf 'this worktree (and .claude/settings.json) are the versions your branch was\n'
        printf 'cut from — including the guard that refuses a push resolving to master.\n'
        printf 'Rebase onto origin/master, or check your push destination by hand with\n'
        printf 'git branch -vv (bd gqlc-xtre).\n'
    fi

    local unread
    unread=$(find "$sd/mail/$seat/inbox" -type f -name '*.md' 2>/dev/null | wc -l)
    if [ "$unread" -gt 0 ]; then
        printf '\nYou have %s unread letter(s): bd mail inbox.\n' "$unread"
    fi

    local notes
    notes=$(find "$home/handoff" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort)
    if [ -n "$notes" ]; then
        printf '\nYour pending handoff note(s) — your own past self talking to you, read before anything else:\n'
        printf '%s\n' "$notes" | sed 's/^/  - /'
    fi

    printf '\nBegin with the wake ritual: kingdom/brain/playbooks/citizen-protocol.md.\n'
}

while :; do
    until [ -s "$home/wake" ] || [ -s "$home/wake.reading" ]; do sleep 5; done

    # A runner is a long-lived bash process holding the parse of the file it
    # started from, so `km deploy` replacing km-seat on disk reaches no seat at
    # all: measured on the live town, 16 runners between 69725 and 85752 seconds
    # old while deploy reported the new sha, one of them running a fix merged
    # that morning (bd gqlc-s67rz). Take the new parse here — the park has
    # exited, so a wake is pending and the seat is about to work anyway, but the
    # queue is still untouched on disk, so exec loses no reason. A session in
    # flight is never interrupted, because this line is only ever reached
    # between sessions.
    #
    # Both halves of the guard are about one failure: a version we exec and
    # cannot run ends the runner, and a seat with no runner is woken by nobody
    # until reconcile notices. `bash -n` refuses one that does not parse, `-x`
    # one whose mode moved — git tracks the mode, so a bad commit can change it,
    # and a failed exec is the same silent death by another route. Either way the
    # version is left unrun and said out loud, the old parse keeps the seat
    # alive, and the wake is still delivered. Nothing is remembered across the
    # refusal, so repairing the file is all that is needed to recover. An empty
    # hash is a third answer, "we could not look": that is what this file looks
    # like for an instant while a deploy replaces it, since `git merge --ff-only`
    # unlinks a changed tracked file before creating it.
    #
    # `|| now_sum=""` is what makes that third answer reachable. Without it the
    # failed read is a failed pipeline under `set -euo pipefail`, the assignment
    # carries that status, and set -e ends the runner one line ABOVE the guard
    # that was written to handle it — the seat dying in the deploy window that
    # this stanza exists to survive (bd gqlc-r6fdz).
    now_sum=$(sha256sum "$SELF" 2>/dev/null | cut -d' ' -f1) || now_sum=""
    if [ -n "$now_sum" ] && [ "$now_sum" != "$self_sum" ]; then
        if [ -x "$SELF" ] && bash -n "$SELF" 2>/dev/null; then
            exec "$SELF" "$seat"
        fi
        echo "km-seat: $SELF changed on disk but is not runnable — it does not parse as bash, or it is not executable — so $seat is still running the parse it started with. Fix the file and the next wake takes it (bd gqlc-s67rz)." >&2
    fi

    # Consume by rename. `mv` within a directory is atomic, so a `km wake` that
    # lands after this point starts a fresh queue for the next turn instead of
    # being destroyed by an rm that raced the read — the reason arrives a turn
    # late rather than never (gqlc-baj5j). The old shape read with `cat` and then
    # removed the file, and anything appended between the two was deleted
    # unread, with cmd_wake having already reported it queued.
    #
    # A wake.reading already sitting here is what a km-seat killed mid-drain left
    # behind. It is THIS turn's batch and whatever queued behind it is the next
    # one, so the reasons it holds arrive late rather than rotting in a file
    # nothing else reads. The guard has a second job: where that residue is all
    # there is, `wake` does not exist, and renaming it under set -e would take
    # the runner down.
    [ -s "$home/wake.reading" ] || mv "$home/wake" "$home/wake.reading"
    reasons=$(cat "$home/wake.reading")
    rm -f "$home/wake.reading"

    # V.6.2 delivered at wake. `km wake --bead ID` writes "bead:ID <reason>", so
    # the reasons are where a seat learns which bead it is being woken for, and
    # an `effort:<level>` label on that bead launches this session at that level
    # instead of the class default. Scoped to the wake by construction: the next
    # one recomputes from scratch, so nothing has to remember to put it back.
    #
    # The wake file APPENDS, so one wake can name several beads. The FIRST bead
    # named wins, because that is the one the citizen is asked to begin with; a
    # later bead asking for a different level is said out loud rather than
    # silently overruling it or being silently overruled. A label that is not a
    # level is not a request at all — it is dropped with a warning by the same
    # gate the config goes through, and the next bead's ask is still considered.
    effort=$class_effort
    bead_ids=$(printf '%s\n' "$reasons" | sed -n 's/^bead:\([^[:space:]][^[:space:]]*\).*$/\1/p' | tr '\n' ' ')
    asked=""
    beads_json='[]'
    beads_read=1
    if [ -n "$bead_ids" ]; then
        # bd's exit code is not the health signal: it is 1 both when the ledger
        # is unreachable and when every id named simply does not exist, and
        # those owe opposite lines. Its stdout does separate them — a miss
        # prints an error OBJECT, an unreachable ledger prints nothing — so bd
        # is run on its own, out of the pipeline, where pipefail cannot fold
        # the two together, and `|| true` swallows the code without discarding
        # the payload that tells them apart.
        # shellcheck disable=SC2086 # deliberate word splitting: one call, all ids
        raw=$(bd show $bead_ids --json 2>/dev/null) || true
        beads_json=$(jq -c 'if type == "array" then . else [.] end' <<<"$raw" 2>/dev/null) || beads_json=""
        [ -n "$beads_json" ] || { beads_json='[]'; beads_read=0; }
        asks=$(jq -r '.[] | .id as $i | (.labels // [])[]
                   | select(startswith("effort:")) | "\($i) \(ltrimstr("effort:"))"' <<<"$beads_json" 2>/dev/null) || asks=""
        for b in $bead_ids; do
            # Wake order, not bd's: `bd show a b` does not promise to answer in
            # the order it was asked, and "the first bead named" is a claim
            # about the wake file.
            lvl=$(awk -v i="$b" '$1 == i { print $2; exit }' <<<"$asks")
            [ -n "$lvl" ] || continue
            if [ -n "$asked" ]; then
                echo "km-seat: $b also asks for --effort $lvl; $seat launches at $effort, which $asked asked for first" >&2
                continue
            fi
            lvl=$(valid_effort "$lvl" "bead $b's effort: label")
            [ -n "$lvl" ] || continue
            asked=$b
            effort=$lvl
            echo "km-seat: $b asks for --effort $effort; $seat launches there rather than the $class default '${class_effort:-<none>}'" >&2
        done
    fi
    effort_args=()
    [ -z "$effort" ] || effort_args=(--effort "$effort")

    # A wake reason is derived when the wake is QUEUED and read here, and until
    # now nothing between the two re-checked its premise (bd gqlc-oqu5). Three
    # instances measured 2026-08-29, each falsifying a DIFFERENT field of the
    # same sentence: a bead that had since closed, a bead whose class label
    # contradicted the reason's "carries no class: label", and a bead claimed by
    # another seat 21 seconds after dispatch composed "ready warrior work —
    # claim it before you begin".
    #
    # Those 21 seconds are why this re-derives unconditionally instead of
    # rejecting a reason for being old: no freshness threshold worth having
    # would have caught the third, and the town was healthy when it happened.
    # Staleness here is a race inherent to deriving early and consuming late,
    # not a symptom of a slow queue.
    #
    # The reason itself is never edited or dropped. It is provenance — it says
    # what the town believed when it woke you, and a citizen shown only the
    # corrected state cannot tell a race from a bug. What is added is the bead's
    # state read HERE, which corrects an arbitrary stale field without anyone
    # having to predict which fields rot; that enumeration was already short by
    # one twice in one day. Only the two mechanical contradictions are called
    # out on top, and dispatch's wording is deliberately not pattern-matched:
    # the facts line states the labels, and that IS the correction.
    # READINESS is the fourth field of the same sentence and the one no bd field
    # carries (bd gqlc-zu7fm). dispatch's fresh pass reads `bd ready`, which is
    # blocker-aware, so it composes "ready warrior work — claim it"; add a blocks
    # edge between that and this and the bead leaves the ready queue while its
    # STORED status stays `open` and its assignee stays null. Both branches below
    # then decline and the facts line states three fields that are all true, so
    # the citizen is confirmed rather than corrected — and a `blocks` edge is the
    # only hold this town enforces, so it is the mechanism that degrades to
    # advice at the point of delivery.
    #
    # Derived here rather than queried: `bd show --json` already returns the
    # blockers with their own status, in the payload above. Only `blocks` counts,
    # and only while the blocker is unclosed — `discovered-from` edges ride in the
    # same array and hold nothing. Measured against the whole live ledger below.
    #
    # The negative is stated too (`blocked-by=-`), which is why this rides on the
    # facts line and not only in a STALE branch: an unblocked bead asserts that
    # readiness WAS re-derived, where silence is also what a version that never
    # checked would print.
    for b in $bead_ids; do
        row=$(jq -r --arg i "$b" '.[] | select(.id == $i)
                | [ .id, (.status // "-"),
                    (if (.assignee // "") == "" then "-" else .assignee end),
                    ((.labels // []) | join(",") | if . == "" then "-" else . end),
                    ([ (.dependencies // [])[]
                       | select(.dependency_type == "blocks" and .status != "closed")
                       | "\(.id)(\(.status))" ]
                     | join(",") | if . == "" then "-" else . end) ]
                | join(" ")' <<<"$beads_json" 2>/dev/null) || row=""
        if [ -z "$row" ]; then
            [ "$beads_read" -eq 1 ] || continue
            reasons="$reasons
STALE: $b does not resolve on the ledger at wake time, so nothing said about it above can be acted on."
            continue
        fi
        read -r _ b_status b_assignee b_labels b_blockers <<<"$row"
        reasons="$reasons
$b now, re-derived at wake: status=$b_status assignee=$b_assignee labels=$b_labels blocked-by=$b_blockers"
        if [ "$b_status" = closed ]; then
            reasons="$reasons
STALE: $b is closed, so that reason is spent — do not act on it."
        elif [ "$b_assignee" != "-" ] && [ "$b_assignee" != "$seat" ]; then
            reasons="$reasons
STALE: $b is held by $b_assignee, not you — do not claim it. If it was meant to be yours, say so rather than taking it."
        elif [ "$b_blockers" != "-" ]; then
            reasons="$reasons
STALE: $b is blocked by $b_blockers and is not on the ready queue — do not claim it. Somebody placed that edge to keep this bead out of a citizen's hands until the blocker closes, and a blocks edge is the only hold this town enforces. Take other ready work: the bead returns to the queue on its own when the blocker closes, though not necessarily to you."
        fi
    done
    # Fail loud. A silent fall-back to the old behaviour would retire this guard
    # exactly when the ledger is sick, which is when a reason is least trustworthy.
    if [ "$beads_read" -eq 0 ]; then
        reasons="$reasons
The bead(s) named above could not be re-derived — the ledger query failed — so treat every claim in those lines as unverified."
    fi

    # A seat runs the hooks in its own checkout, so a parked one keeps running
    # the gates it was created with however many have merged since (bd
    # gqlc-xtre). Wake is the only safe moment to move it: the session has not
    # started, so no checkout happens under a live claude. A seat holding work
    # is never moved — it gets told instead, in its first message.
    refresh_out=$("$KM" seat-refresh "$seat" 2>&1) && refresh_rc=0 || refresh_rc=$?
    stale=""
    case "$refresh_rc" in
        0) ;;
        3) stale=$refresh_out ;;
        *) echo "km-seat: could not refresh $seat's worktree: $refresh_out" >&2 ;;
    esac

    msg=$(compose "$reasons" "$stale")

    echo awake >"$home/status"
    (
        cd "$wt"
        # KM_CONFIG is the suite's seam and must not follow the seat in: a
        # citizen's own `km` calls have to read the town's real config, not
        # whichever throwaway launched them. Same shape as the GIT_DIR that
        # redirected bd into the shared repo this week.
        unset KM_CONFIG
        KINGDOM_SEAT=$seat BEADS_ACTOR=$seat KM_STATE_DIR=$sd \
            claude --model "$model" \
            "${effort_args[@]}" \
            --permission-mode "$pm" \
            -n "$display" \
            --append-system-prompt "$(cat "$soul")" \
            "$msg"
    ) || echo "km-seat: $seat's session ended abnormally; parking" >&2
    echo asleep >"$home/status"
    rm -f "$home/heartbeat.json"
done
