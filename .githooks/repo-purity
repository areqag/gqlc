#!/usr/bin/env bash
# Runs a command and FAILS the run if it changed the repository it ran in.
#
# On 2026-08-22 the km suite, invoked from pre-push, flipped core.bare on the
# SHARED config, force-moved a seat's branch, and left a fixture identity in
# user.email where it sat for days (bd gqlc-ed2u). Every one of those was found
# by hand, afterwards, by a citizen who noticed their own branch had moved.
# This is the boundary detector: no suite has to remember to be careful for it
# to fire.
#
# WHY THE WHOLE CONFIG AND NOT A KEY LIST. `just check-shared-config` names the
# keys already known to brick a worktree; that is prevention against a known
# set. This is the other half, so it must catch a key nobody taught it the name
# of — the enumeration complaint of gqlc-n8n0 and gqlc-kl2d. The snapshot is
# therefore every line of `git config --list --local`, diffed.
#
# THE BRANCH MOVE NEEDS ITS OWN SNAPSHOT, and for a while it did not have one.
# The config diff covers the two config-shaped damages above; the third is not
# config-shaped. A force-moved branch that this worktree does not have checked
# out changes no config line, does not move this worktree's HEAD, and does not
# change its symbolic-ref — so with only those three the guard exited 0 on the
# one damage a citizen had actually noticed by hand (bd gqlc-lekg). Refs are
# shared across every worktree of a repo, which is both why the damage reaches a
# seat that is running nothing and why a snapshot taken here can see it.
#
# THAT SNAPSHOT IS refs/heads ONLY, and the limit is deliberate. A suite is
# allowed to `git fetch`, which rewrites refs/remotes/*, and bd's sync moves
# refs/dolt/* on its own; watching those would fail honest pushes, and a gate
# that cries wolf gets switched off. Local branches are the namespace where the
# observed damage landed and where a test run has no business writing. Damage to
# any other namespace is NOT detected here — say so rather than implying the
# guard covers every ref.
#
# VERIFICATION RUNS IN AN EXIT TRAP, deliberately. The worst run is the one that
# breaks the repo AND fails: verifying only on the success path would report the
# test failure and hide the damage.
#
# Read from a linked worktree, `--local` resolves to the SHARED config, which is
# the damaged surface. That is why this can run from a seat and still see it.
set -uo pipefail

if [ "$#" -eq 0 ]; then
    echo "usage: repo-purity <cmd> [args...]" >&2
    exit 2
fi

SNAP="$(mktemp -d)"
mkdir -p "$SNAP/before" "$SNAP/after"

snapshot() {
    local into="$1"
    git config --list --local 2>/dev/null | sort >"$into/config"
    git rev-parse HEAD 2>/dev/null >"$into/head"
    git symbolic-ref -q HEAD 2>/dev/null >"$into/ref"
    # Not piped through `sort` as the config line above is: `git config --list`
    # emits in file order, `for-each-ref` sorts by refname already.
    git for-each-ref --format='%(refname) %(objectname)' refs/heads 2>/dev/null \
        >"$into/heads"
}

INNER_RC=0
VERIFIED=0

# shellcheck disable=SC2317  # every line below is reached only through the EXIT
# trap, which shellcheck does not follow. Running here rather than inline is the
# whole design: a run that damages the repo AND fails must still report both.
verify() {
    [ "$VERIFIED" = 1 ] && return
    VERIFIED=1

    snapshot "$SNAP/after"
    local damaged=0

    if ! cmp -s "$SNAP/before/config" "$SNAP/after/config"; then
        damaged=1
        echo "repo-purity: the run changed the repository's local git config:" >&2
        diff "$SNAP/before/config" "$SNAP/after/config" | grep -E '^[<>]' >&2
    fi

    local h_before h_after r_before r_after
    h_before="$(cat "$SNAP/before/head")"; h_after="$(cat "$SNAP/after/head")"
    r_before="$(cat "$SNAP/before/ref")";  r_after="$(cat "$SNAP/after/ref")"

    if [ "$h_before" != "$h_after" ]; then
        damaged=1
        printf 'repo-purity: HEAD changed: %s -> %s\n' \
            "${h_before:-<none>}" "${h_after:-<none>}" >&2
    fi
    if [ "$r_before" != "$r_after" ]; then
        damaged=1
        printf 'repo-purity: the checked-out branch changed: %s -> %s\n' \
            "${r_before:-<none>}" "${r_after:-<none>}" >&2
    fi

    if ! cmp -s "$SNAP/before/heads" "$SNAP/after/heads"; then
        damaged=1
        echo "repo-purity: the run moved, created or deleted local branches:" >&2
        diff "$SNAP/before/heads" "$SNAP/after/heads" | grep -E '^[<>]' >&2
    fi

    rm -rf "$SNAP"

    if [ "$damaged" -ne 0 ]; then
        printf 'repo-purity: the repository DIFFERS across this run (the command itself exited %d).\n' \
            "$INNER_RC" >&2
        echo "repo-purity: this does NOT prove your command did it. Every seat in this town is a" >&2
        echo "  linked worktree of one repository, so another seat committing in its own tree" >&2
        echo "  during the window moves the same refs and reads exactly like your damage." >&2
        echo "  To tell them apart: 'git reflog' the ref named above and look at who wrote it." >&2
        echo "  A test run should still leave its own repository untouched (bd gqlc-2zet); the" >&2
        echo "  reason this cannot yet be enforced is bd gqlc-w5bh." >&2
        # Advisory is what the town wires into pre-push (ruled on gqlc-06y9): a
        # strict verdict here refuses pushes over a NEIGHBOUR's concurrent work.
        # Only the purity verdict softens — INNER_RC is passed through untouched,
        # so a failing `just test` still fails the push. That is the whole reason
        # this is a flag in here rather than a `|| true` at the call site, which
        # could not tell the two failures apart.
        [ "${GQLC_REPO_PURITY_ADVISORY:-0}" = 1 ] && exit "$INNER_RC"
        exit 1
    fi

    exit "$INNER_RC"
}

trap verify EXIT

snapshot "$SNAP/before"
"$@" || INNER_RC=$?
exit "$INNER_RC"
