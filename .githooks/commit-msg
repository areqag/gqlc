#!/usr/bin/env bash
# Commit-msg hook: reject commits whose message carries a Co-Authored-By
# trailer attributing authorship to Claude / Anthropic. See CLAUDE.md
# section "AI attribution" for the rule and rationale.
# Activated by: git config core.hooksPath .githooks
# (run `just init` after cloning)
set -euo pipefail

MSG_FILE="$1"

# During a merge, git may auto-populate the message with trailers copied from
# the merged branch's HEAD. Those were already screened at commit-time on the
# source branch; blocking here would only make merges painful and cannot
# rewrite history. Skip cleanly.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    exit 0
fi

# Check author and committer identities for known-bogus patterns.
# git var GIT_AUTHOR_IDENT / GIT_COMMITTER_IDENT returns:
#   Name <email> timestamp tz
# We extract the email (content between the last < and >) and validate it.
_check_identity() {
    local label="$1"
    local ident
    ident="$(git var "$2" 2>/dev/null)" || return 0   # skip if git var fails
    # Extract email between < and >
    local email
    email="$(printf '%s' "$ident" | sed 's/.*<\(.*\)>.*/\1/')"

    # Denylist: the names RFC 2606 and RFC 6761 reserve so that they can never
    # be a real mailbox. Matched on DOMAIN only, never on local-part.
    #
    # The previous version spelled out `test@example.invalid` beside globbed
    # `*@example.com` and `*@example.org`. The globs made it read as
    # categorical; it was not. Every local-part other than `test`, at the one
    # TLD whose entire purpose is to be unresolvable, went through — and one
    # did: 42191059, a genuine feature commit authored `fixture
    # <fixture@example.invalid>`. Nothing on master carries it, but only because
    # squash-merge re-authors to the PR author, which discards the evidence and
    # not the defect (bd gqlc-s989).
    #
    # Do not add local-parts here. If a domain cannot receive mail, no mailbox
    # at it is real.
    case "$email" in
        *@example.com|*@example.net|*@example.org|\
        *@invalid|*@*.invalid|\
        *@test|*@*.test|\
        *@example|*@*.example|\
        *@localhost|*@*.localhost|\
        "")
            cat >&2 <<ERRMSG
ERROR: Bogus $label identity: <$email>
       That domain is reserved by RFC 2606 / RFC 6761 and can never receive
       mail, so this is a test fixture or placeholder, not a person.
       Fix with: git commit --amend --reset-author
ERRMSG
            return 1
            ;;
    esac

    # Shape: must contain @ and the domain part must contain a dot
    local domain="${email##*@}"
    if [[ "$email" != *@* ]] || [[ "$domain" != *.* ]]; then
        cat >&2 <<ERRMSG
ERROR: Implausible $label email: <$email>
       Expected format: user@host.tld
       Fix with: git commit --amend --reset-author
ERRMSG
        return 1
    fi
}

_check_identity "author"    GIT_AUTHOR_IDENT    || exit 1
_check_identity "committer" GIT_COMMITTER_IDENT || exit 1

# Extract only the trailer block (folded/interleaved trailers handled by git),
# then look for Co-Authored-By values that mention `claude` or the
# `@anthropic.com` email domain. Case-fold both key and value for the match.
offender="$(
    git interpret-trailers --parse <"$MSG_FILE" \
        | awk 'BEGIN{IGNORECASE=1} /^co-authored-by:[[:space:]]/ {
            v = tolower($0)
            if (v ~ /claude/ || v ~ /@anthropic\.com/) { print; exit }
        }'
)"

if [ -n "$offender" ]; then
    cat >&2 <<EOF
ERROR: Co-Authored-By trailer attributes this commit to Claude/Anthropic.
       Offending line: $offender

Per CLAUDE.md section "AI attribution", commits must not carry
AI-attribution trailers. Remove the Co-Authored-By line and retry.
EOF
    exit 1
fi

exit 0
