#!/usr/bin/env bash
# Commit-msg hook: reject commits whose message carries a Co-Authored-By
# trailer attributing authorship to Claude / Anthropic. See CLAUDE.md
# section "AI attribution" for the rule and rationale.
# Activated by: git config core.hooksPath .githooks
# (run `just init` after cloning)
set -euo pipefail

MSG_FILE="$1"

# The rules themselves live in .githooks/implausible-identity.sh, shared with
# the CI gate wired in .github/workflows/ci.yml (bd gqlc-gy3q). This hook is
# the LOCAL half and cannot protect master on its own: --no-verify skips it, an
# unconfigured clone never runs it, and core.hooksPath has been seen rewritten
# under us. What lives here is the git plumbing (which identities to read, when
# to stand down); what a bogus identity IS lives in the shared file.
_HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# SC1091: `just lint-hooks` runs shellcheck without -x, so it cannot follow the
# source. The path is a literal under this hook's own directory; a missing file
# fails loudly at run time under `set -e`, and the suite exercises the hook end
# to end.
# shellcheck source=implausible-identity.sh disable=SC1091
. "$_HOOK_DIR/implausible-identity.sh"

# During a merge, git may auto-populate the message with trailers copied from
# the merged branch's HEAD. Those were already screened at commit-time on the
# source branch; blocking here would only make merges painful and cannot
# rewrite history. Skip cleanly.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    exit 0
fi

# Check author and committer identities for known-bogus patterns.
# git var GIT_AUTHOR_IDENT / GIT_COMMITTER_IDENT returns:
#   Name <email> timestamp tz
# We extract the email (content between the last < and >) and hand it to the
# shared predicate.
_check_identity() {
    local label="$1"
    local ident
    ident="$(git var "$2" 2>/dev/null)" || return 0   # skip if git var fails
    # Extract email between < and >
    local email
    email="$(printf '%s' "$ident" | sed 's/.*<\(.*\)>.*/\1/')"

    local reason
    if reason="$(implausible_email_reason "$email")"; then
        return 0
    fi
    cat >&2 <<ERRMSG
ERROR: Implausible $label identity: <$email>
       Refused: $reason.
       An address like this says something that is not true about who wrote
       this commit.
       Where it came from:  git config --show-origin user.email
       Fix this commit with: git commit --amend --reset-author
ERRMSG
    return 1
}

_check_identity "author"    GIT_AUTHOR_IDENT    || exit 1
_check_identity "committer" GIT_COMMITTER_IDENT || exit 1

# Look for Co-Authored-By values that mention `claude` or the `@anthropic.com`
# email domain. The match itself lives in the shared file.
if ! offender="$(ai_attribution_trailer <"$MSG_FILE")"; then
    cat >&2 <<EOF
ERROR: Co-Authored-By trailer attributes this commit to Claude/Anthropic.
       Offending line: $offender

Per CLAUDE.md section "AI attribution", commits must not carry
AI-attribution trailers. Remove the Co-Authored-By line and retry.
EOF
    exit 1
fi

exit 0
