#!/usr/bin/env bash
# GH↔bd sync helper. Single sync surface shared by:
#   - .githooks/post-merge      (pull, on git pull/merge)
#   - .githooks/pre-push        (push, on git push)
#   - .claude/settings.json     (pull, on Claude Code session start)
#
# Args: pull | push
# Silent to stdout/stderr — caller decides whether to redirect or tail.
# Never fails: exits 0 on any error so the git/session operation continues.
#
# Design: human works through GitHub issues; agents work through bd.
#   - pull:  mirror GH state (creates, closes, comments) into bd.
#            --prefer-github breaks ties toward GH; GH is source of truth.
#   - push:  mirror bd-created beads that have no GH mirror yet, AND close
#            GH issues whose bead was closed locally.
#            Deliberately does NOT run `bd github sync --push-only` (which
#            takes ~30s scanning every bead) — its close propagation is also
#            unreliable (memory: bd-github-sync-quirks). Instead:
#              1. `bd github push <ids>` per new bead (no external_ref).
#              2. Bulk `gh issue list --state open` intersected with
#                 closed-bd beads bearing an external_ref; each mismatch
#                 gets `gh issue close`.

_action="${1:-}"
case "$_action" in pull|push) ;; *)
  echo "usage: $0 pull|push" >&2
  exit 0
esac

command -v bd >/dev/null 2>&1 || exit 0
command -v gh >/dev/null 2>&1 || exit 0
_token=$(gh auth token 2>/dev/null) || exit 0
[ -n "$_token" ] || exit 0

if [ "$_action" = "pull" ]; then
  # Guard: --prefer-github makes the GH issue body authoritative for bead
  # descriptions, so a bd-only amendment is silently reverted on the next pull.
  # Detect divergence BEFORE the sync and skip the pull with actionable
  # instructions rather than letting the overwrite happen without notice.
  # One bulk `gh issue list` call keeps overhead O(1) across all beads.
  _bd_beads=$(bd list --status all --limit 0 --json 2>/dev/null || echo '[]')
  _gh_bodies=$(GITHUB_TOKEN="$_token" gh issue list \
    --state all --limit 1000 --json number,body 2>/dev/null || echo '[]')
  _diverged=$(BD_BEADS="$_bd_beads" GH_BODIES="$_gh_bodies" python3 - <<'PYEOF'
import json, re, os, sys

try:
    bd_beads = json.loads(os.environ["BD_BEADS"])
except Exception:
    bd_beads = []
try:
    gh_issues = json.loads(os.environ["GH_BODIES"])
except Exception:
    gh_issues = []

gh_body_by_num = {i["number"]: (i.get("body") or "").strip() for i in gh_issues}
pat = re.compile(r"/issues/(\d+)$")

for b in bd_beads:
    # Only open/in-progress beads get description amendments; skip closed ones.
    if b.get("status") not in ("open", "in_progress"):
        continue
    ext = b.get("external_ref") or ""
    m = pat.search(ext)
    if not m:
        continue
    n = int(m.group(1))
    local_desc = (b.get("description") or "").strip()
    if not local_desc:
        continue
    remote_body = gh_body_by_num.get(n)
    if remote_body is None:
        continue  # GH issue not in bulk list (>1000); skip safely
    if local_desc != remote_body:
        print(f"{b['id']}:{n}:{len(local_desc)}:{len(remote_body)}")
PYEOF
)

  if [ -n "$_diverged" ]; then
    echo "bd-gh-sync: SKIPPING pull — bd description differs from GH issue body." >&2
    echo "bd-gh-sync: Pulling would silently revert the local amendment(s)." >&2
    echo "" >&2
    printf '%s\n' "$_diverged" | while IFS=: read bid n local_len gh_len; do
      echo "  $bid  local=${local_len}ch  GH #${n}=${gh_len}ch" >&2
      echo "  Mirror to GH first: bd show $bid | ... > /tmp/${bid}.md" >&2
      echo "                      gh issue edit $n --body-file /tmp/${bid}.md" >&2
    done
    echo "" >&2
    echo "bd-gh-sync: Once GH matches bd, re-run or start a new session." >&2
    exit 0
  fi

  GITHUB_TOKEN="$_token" bd github sync --pull-only --prefer-github || true
  exit 0
fi

# push
_beads=$(bd list --status all --limit 0 --json 2>/dev/null || echo '[]')

_new=$(printf '%s' "$_beads" | python3 -c '
import json, sys
try:
    for b in json.load(sys.stdin):
        if not b.get("external_ref"):
            print(b["id"])
except Exception:
    pass
' 2>/dev/null)
if [ -n "$_new" ]; then
  GITHUB_TOKEN="$_token" bd github push $_new || true
fi

# Close GH mirrors for beads that are closed locally but still open on GH.
# One bulk `gh issue list` + one `gh issue close` per mismatch; skipped when
# there are none. Idempotent: closing an already-closed GH issue is a no-op.
_open_gh=$(GITHUB_TOKEN="$_token" gh issue list --state open --limit 500 --json number 2>/dev/null || echo '[]')
printf '%s' "$_beads" | GITHUB_TOKEN="$_token" python3 -c '
import json, sys, re, subprocess
try:
    open_nums = {i["number"] for i in json.loads(sys.argv[1])}
except Exception:
    open_nums = set()
if not open_nums:
    sys.exit(0)
try:
    beads = json.load(sys.stdin)
except Exception:
    beads = []
pat = re.compile(r"/issues/(\d+)$")
for b in beads:
    if b.get("status") != "closed":
        continue
    m = pat.search(b.get("external_ref") or "")
    if not m:
        continue
    n = int(m.group(1))
    if n not in open_nums:
        continue
    tag = ((b.get("close_reason") or "").splitlines() or [""])[0].strip()
    if len(tag) > 300:
        tag = tag[:297] + "..."
    bid = b["id"]
    body = f"Auto-close: bead {bid} closed locally."
    if tag:
        body += f" {tag}"
    subprocess.run(
        ["gh", "issue", "close", str(n), "--comment", body],
        capture_output=True, check=False,
    )
' "$_open_gh" >/dev/null 2>&1 || true
exit 0
