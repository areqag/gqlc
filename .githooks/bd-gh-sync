#!/usr/bin/env bash
# GH↔bd sync helper. Single sync surface shared by:
#   - .githooks/post-merge      (pull, on git pull/merge)
#   - .githooks/pre-push        (push, on git push)
#   - .claude/settings.json     (pull, on Claude Code session start)
#
#   - nothing yet                (drift, see below — it has no caller here)
#
# Args: pull | push | drift
#
# pull and push end by writing their verdict to the *last* stderr line, because
# both callers keep only that one: a summary line on a run that got as far as
# choosing what to do, a SKIPPING line on one that refused. pull always exits 0:
# it rides on `git pull` and on session start, where a non-zero aborts the
# operation underneath it. push runs from pre-push behind `|| true`, so its exit
# status is free to carry the same verdict the summary line does — 0 iff every
# new bead reached GitHub and every stale mirror was closed. The silent exits
# are exactly the ones meaning "sync is not configured here" (no bd, gh or
# token): nothing was attempted and nothing is wrong. Every other early exit —
# no python3, no writable temp directory — is a fault and says so on the line
# the caller keeps, because a run that produced no line at all is
# indistinguishable from one that had nothing to do. drift is the exception and
# is a gate rather than a hook: it writes nothing anywhere, its whole output is
# for a reader, and its exit status is the answer — 0 for a corpus it read and
# found clean, non-zero for drift, for a corpus it could not read, and for a
# corpus that came back empty.
# Diagnostics go to stderr, so a caller that wants silence must redirect it.
#
# Design: human works through GitHub issues; agents work through bd.
#   - pull:  mirror GH state into bd for the beads where GitHub is capable of
#            holding the local value and is not behind it. `bd github sync`
#            offers no field-level exclusion, so scope is the only lever: the
#            eligible bead ids are passed as --issues and everything else is
#            left untouched. A bead is eligible only when
#              * it carries an external_ref present in the bulk GH listing,
#              * its status is open or closed — GitHub's issue state is a
#                two-value domain, so in_progress/blocked/deferred have no
#                representable counterpart and any pull reverts them,
#              * it is not closed locally while still open on GH,
#              * the GH body extends the bead description verbatim, i.e.
#                gh_body.startswith(description) — append-only, and
#              * where it extends it, GitHub's edit time is later than the
#                bead's by more than SKEW_S.
#            The last four conditions are one rule: refuse the pull wherever the
#            evidence leaves room for GitHub to be behind bd — because it cannot
#            hold the status, because it lacks content the bead has, or because
#            nothing says it moved last. A re-indent, a reorder and a de-dup add
#            no content, so the bodies alone refuse them; a trailing block cut in
#            bd leaves the same two bodies as a block appended on GitHub, so only
#            the edit times separate those. Neither side's is a
#            description-edit time — GitHub's moves on a comment, and bd's on
#            writes that are not description edits. The bd set is not every
#            write either: measured 2026-08-17 against the bd on this machine,
#            --status, --priority, --title, --notes, --assignee, close and
#            reopen move it, while `bd tag`, `bd label add`, `bd comment` and
#            `bd link` all succeed with the write visible in `bd show` and
#            leave it where it was. The subcommand is load-bearing: bare
#            `bd label` prints usage and exits 0 without writing. So the
#            ordering is a proxy, and it is one with a residue in each
#            direction wherever the later of the two writes clears the margin:
#            a GH append that a moving bd-side write follows is held, and a
#            bd-side cut that a GH comment follows is pulled — including the
#            comment this script's own push path writes when it auto-closes a
#            mirror (gqlc-o22k). Nothing here re-checks that measurement — the
#            suite stubs `bd` — so a release that stops moving the timestamp on
#            a description edit widens the fail-open half in silence
#            (gqlc-3205).
#            Selection failing for any reason yields an empty allowlist and no
#            pull at all.
#            Whatever the allowlist, the run ends by re-reading the bead list
#            and reporting any out-of-scope bead whose status or description
#            moved, or that is gone from the list altogether, plus the fact
#            that it could not look if it could not — the allowlist is empty in
#            the steady state, so a postcondition conditional on a pull would
#            never run. Deletion is named apart from the rest because it is the
#            one change no re-assert undoes. The last stderr line carries the
#            outcome, warnings included, because the session-start caller keeps
#            only that line, and no count reaches it unless this run enumerated
#            the set behind it: a bead list that came back empty withdraws both
#            arms read off it, a GitHub listing cut off at its --limit withdraws
#            the orphan one. Emptiness here withdraws a number and never
#            refuses the pull — an external_ref is matched over any URL and may
#            name another repository, so mirrored beads over an empty listing
#            is a legitimate configuration rather than a lost one.
#   - push:  mirror bd-created beads that have no GH mirror yet, AND close
#            GH issues whose bead was closed locally.
#            Deliberately does NOT run `bd github sync --push-only` (which
#            takes ~30s scanning every bead) — its close propagation is also
#            unreliable (memory: bd-github-sync-quirks). Instead:
#              1. `bd github push <ids>` per new bead (no external_ref).
#              2. Bulk `gh issue list --state open` intersected with
#                 closed-bd beads bearing an external_ref; each mismatch
#                 gets `gh issue close`.
#            Both arms mutate GitHub, so both are counted and both are in the
#            summary. Every way of mutating nothing — an id that cannot be
#            passed, a batch that exited non-zero, an input that would not
#            load — is reported and makes the run non-zero, because otherwise
#            it is byte-for-byte a steady-state run with nothing to do.
#            The whole action runs under an exclusive lock taken before the
#            bead list is read, because step 1 is a read-modify-write and two
#            unserialised runs minted two issues for one bead. See the lock
#            below for the measurement.
#   - drift: the pull's classification with nothing after it — no write to bd,
#            none to GitHub, no lock. It fails on the one class neither
#            direction can repair: a bead in a status GitHub cannot represent
#            (in_progress/blocked/deferred) whose mirror is CLOSED. The pull
#            cannot take it — the status has no counterpart there — and the push
#            only ever closes mirrors, never reopens them, so unlike a GH-side
#            closure of an open bead there is no window in which it resolves
#            itself. gqlc-23e sat in it for a month behind a stderr line under a
#            hook that exits 0, which is why the exit status here is the point.
#            Deliberately NOT gated: `bd open / GH closed`, which the pull
#            applies and thereby resolves, and `bd closed / GH open`, which the
#            push closes — both transient, and a gate firing on them fires on
#            ordinary work. Nothing in this repository calls it yet: it needs
#            `gh`, so it cannot live in the offline `just test` (gqlc-x98l).
#
# Payloads reach python through temp files, never argv or the environment. The
# bead listing alone is ~1MB, and execve caps any single argument or
# environment string at 128KB (MAX_ARG_STRLEN) — a limit no ulimit raises.

# This file ran 1067 lines with no shell options at all until gqlc-650j: an
# unset variable expanded to empty, a failing stage of a pipeline was invisible
# behind a succeeding last one, and any command that failed mid-run carried on
# to the next statement — in the one tool that decides what to overwrite in the
# bead ledger.
#
# `set -e` on its own would trade one silence for another. Both callers keep
# only the last stderr line, and a script that dies where it stands writes no
# such line, so an abort and a run with nothing to do arrive as the same bytes —
# the shape this header refuses everywhere else. The options therefore come with
# an ERR trap that puts the abort on the line the caller keeps, and exits with
# the status the action is allowed to carry: pull always 0, because it rides on
# `git pull` and on session start where a non-zero aborts the operation
# underneath it, push non-zero, because its caller reads the status as the
# verdict.
#
# `-E` is load-bearing: without it an ERR trap is not inherited by shell
# functions, and the two batch functions below are where a failure would
# otherwise abort in silence. It also means the trap fires inside command
# substitutions, which is why every line it writes goes to stderr — a trap
# writing to stdout would be captured into the value being assigned.
#
# Zero matches is an answer, not a failure, and `grep -c` reports it as exit 1.
# Every count taken here goes through _count for that reason, rather than
# through a `|| true` that would also absorb grep's exit 2.
set -Eeuo pipefail

_action="${1:-}"
case "$_action" in pull|push|drift) ;; *)
  echo "usage: $0 pull|push|drift" >&2
  exit 0
esac

# shellcheck disable=SC2317 # reached only through the ERR trap installed below
_abort() {
  _status=$?
  # Disarmed first: every echo below is a command, and one of them failing
  # inside the handler would re-enter it.
  trap - ERR
  echo "bd-gh-sync: a command failed at line ${1} (status ${_status}) and stopped this" >&2
  echo "bd-gh-sync: run where it stood. Nothing after that line was attempted, so the" >&2
  echo "bd-gh-sync: counts this run would have reported were never established, and" >&2
  echo "bd-gh-sync: whatever it had already written to bd or GitHub stands." >&2
  if [ "$_action" = "pull" ]; then
    echo "bd-gh-sync: PULL FAILED — aborted at line ${1}; the pull is incomplete." >&2
    exit 0
  fi
  if [ "$_action" = "drift" ]; then
    echo "bd-gh-sync: DRIFT CHECK FAILED — aborted at line ${1}; nothing was decided." >&2
    exit 1
  fi
  echo "bd-gh-sync: PUSH FAILED — aborted at line ${1}; the push is incomplete." >&2
  exit 1
}
trap '_abort "$LINENO"' ERR

# `grep -c` exits 1 when the count is zero. That is the answer, not a failure,
# and under `set -e` an unguarded count of zero would abort the run — so the
# distinction has to be made here rather than by a blanket `|| true`, which
# would also swallow exit 2 (an unreadable file, a bad pattern) and hand the
# summary line a zero nobody measured.
_count() {
  _n=$(grep -c "$1" "$2") && _s=0 || _s=$?
  [ "$_s" -le 1 ] || return "$_s"
  printf '%s\n' "${_n:-0}"
}

command -v bd >/dev/null 2>&1 || exit 0
command -v gh >/dev/null 2>&1 || exit 0
command -v python3 >/dev/null 2>&1 || {
  echo "bd-gh-sync: python3 not found — skipping ${_action}." >&2
  exit 0
}
_token=$(gh auth token 2>/dev/null) || exit 0
[ -n "$_token" ] || exit 0

# Every payload below reaches python through a file in here, so there is no
# reduced service to fall back to. Said out loud rather than exited quietly:
# both callers keep only the last stderr line, and mktemp's own message on it
# names a failed command without naming what was abandoned.
_tmp=$(mktemp -d) || {
  # Detail first, verdict last, as at every other refusal here: the callers keep
  # the last line and mktemp's own message is not on it by the time this runs.
  echo "bd-gh-sync: mktemp could not create a working directory, and every" >&2
  echo "bd-gh-sync: payload this script hands python travels through one." >&2
  echo "bd-gh-sync: Nothing was read from bd or GitHub, nothing was mutated." >&2
  echo "bd-gh-sync: SKIPPING ${_action} — no writable temporary directory." >&2
  exit 0
}
trap 'rm -rf "$_tmp"' EXIT

# `bd github sync --issues` and `bd github push` both take their bead ids on
# argv. Batch them so a growing corpus cannot walk into the same 128KB argument
# cap that this script already hit once by passing payloads through the
# environment.
_batch=100

# `gh issue list` cuts its answer at --limit and says nothing about having done
# so, which leaves a listing of exactly the cap indistinguishable from a complete
# one. Each cap is named once and handed to the code that checks for it, because
# a flag and a check that drift apart turn the check off without a diff to it.
#
# The ceiling is asked of GitHub rather than chosen here, because a chosen one is
# outgrown in silence and this repository has already done it: at 1000 the pull
# compared 1000 of 1182 issues and held 178 beads as `not-in-listing` — a reason
# string for the truncation, not a finding about those beads (bd gqlc-lgwjt).
# Issue numbers are sequential and shared with pull requests, so the newest
# issue's number is a strict upper bound on how many issues can exist, and it
# rises on its own as the repository grows.
#
# A ceiling costs nothing until it is reached: GraphQL paging stops when the
# corpus is exhausted, and `--limit 2000` over 1182 issues took the same 9.4s as
# `--limit 1000` over 1000 (measured 2026-08-30). So there is no wall-time
# argument for a small number, which was the only argument there was.
#
# Both listings take the same bound. The open-issue cap was 500 against 221 open
# issues — not breached, the same shape, and left behind it would have been the
# identical defect one path along.
#
# `// 1` is the empty repository, not a failure: a fork with no issues yet has
# nothing to bound, and refusing there would block the run that creates the very
# first mirror. The deny-pin below is for a listing that would not answer at all.
_bound_rc=0
_gh_limit_all=$(GITHUB_TOKEN="$_token" gh issue list --state all --limit 1 \
  --json number --jq '(.[0].number // 1)' 2>/dev/null) || _bound_rc=$?
# Fail closed, per action, in each one's own currency. A fallback constant here
# would restore exactly the defect this replaces, and would do it on the one run
# that had already said GitHub was unreadable.
case "$_bound_rc:$_gh_limit_all" in
  0:[1-9]*) ;;
  *) echo "bd-gh-sync: GitHub would not say what its newest issue number is, so no" >&2
     echo "bd-gh-sync: listing below has a bound this run established. Refusing rather" >&2
     echo "bd-gh-sync: than falling back to a number nobody measured." >&2
     case "$_action" in
       drift) echo "bd-gh-sync: DRIFT CHECK FAILED — GitHub's state could not be read at all." >&2
              exit 1 ;;
       push)  echo "bd-gh-sync: PUSH FAILED — GitHub's state could not be read at all." >&2
              exit 1 ;;
       *)     echo "bd-gh-sync: SKIPPING pull — GitHub's state could not be read at all." >&2
              exit 0 ;;
     esac ;;
esac
_gh_limit_open=$_gh_limit_all

if [ "$_action" = "pull" ] || [ "$_action" = "drift" ]; then
  # `drift` shares this whole block and stops at the end of it. Everything down
  # to the plan is two listings and a classification over them — no write to bd
  # and none to GitHub — and everything after it mutates the ledger, so the two
  # actions can share the reading without the gate inheriting the writing.
  #
  # Both statuses are kept rather than thrown away with `|| : >file`. An input
  # that will not load already refuses the run below, on the selection's own
  # JSONDecodeError — but that traceback is the same whether bd never answered
  # or answered with something unparseable, and the two send the operator to
  # different places: one is contention on the database, the other is a listing
  # to go and look at. Deciding "unreadable" on the status rather than inferring
  # it from what came back is also what keeps this separable from cardinality,
  # which on this path is not decidable as failure at all. Same reading as the
  # push side's `_list_rc`.
  _list_rc=0
  bd list --status all --limit 0 --json >"$_tmp/beads.json" 2>/dev/null \
    || { _list_rc=$?; : >"$_tmp/beads.json"; }
  _gh_rc=0
  GITHUB_TOKEN="$_token" gh issue list --state all --limit "$_gh_limit_all" \
    --json number,state,body,updatedAt >"$_tmp/gh.json" 2>/dev/null \
    || { _gh_rc=$?; : >"$_tmp/gh.json"; }

  # Emits ALLOW/HOLD/ORPHAN records terminated by DONE. That sentinel is what
  # separates "selection ran and chose nothing" from "selection did not run";
  # without it an empty result is indistinguishable from a crash, which is how
  # the previous guard fell through into an unscoped pull.
  # The status is taken on the command rather than from `$?` on the next line:
  # under `set -e` a selection that died would never reach that line, and the
  # refusal below — the one thing this path exists to guarantee — would be
  # replaced by a bare abort.
  _rc=0
  python3 - "$_tmp/beads.json" "$_tmp/gh.json" "$_gh_limit_all" \
    >"$_tmp/plan.txt" 2>"$_tmp/plan.err" <<'PYEOF' || _rc=$?
import datetime, json, re, sys

def load(path):
    with open(path, encoding="utf-8") as fh:
        return json.load(fh)

# The eligibility rule below is a byte-for-byte prefix test, so it has to be
# told which byte differences are not content. GitHub's web editor stores CRLF
# and bd stores LF; a no-break space arrives by copy-paste out of rendered
# markdown. Neither is an edit anyone made, and treating one as an edit holds
# the bead back for good: the GH append becomes unreachable and the hold notice
# reprints on every merge forever. Measured on the live corpus, 188 of 289
# bodies are multi-line, so a single edit through the GitHub UI is the whole
# distance to that state. (A pull of an append does rewrite the bead's copy to
# GitHub's encoding — that is what --prefer-github means, and it is a
# whitespace-level change riding along with an append that was asked for.)
def norm(s):
    return ((s or "").replace("\r\n", "\n").replace("\r", "\n")
            .replace("\u00a0", " ").strip())

# Records below are line-delimited and read back line by line, so an id carrying
# a newline would split its record in two and the charset gate downstream would
# be handed two halves it finds unobjectionable \u2014 never examining the id it was
# meant to refuse, and free to reconstitute the name of a bead the same run
# declared held. Escaping keeps the record whole and hands the gate something
# that still fails its test. Every id the gate accepts is ASCII
# [A-Za-z0-9._-], which this leaves byte-for-byte alone.
def one_line(s):
    return str(s).encode("unicode_escape").decode("ascii")

# bd's edit time comes off the machine running this hook and GitHub's off
# GitHub, and both are reported in whole seconds, so a difference this small is
# as likely to be the two clocks as it is to be an ordering. Measured
# 2026-08-17 on an NTP-disciplined machine: 4.5ms jitter against its stratum-2
# peer, and agreement with GitHub's own Date header to within that header's
# one-second resolution over five samples — the margin is for the machine that
# is not disciplined at all. Both directions cost something and the costs are
# not the same shape, so err upwards: too large holds beads a pull would have
# taken, which prints on stderr and a human undoes, and too small pulls beads a
# hold would have kept, which is the silent one. This was mirrored in
# .githooks/tests/bd-gh-sync-test.sh, which pinned both sides of the boundary;
# PR #1595 deleted that suite and nothing replaced it, so no test now holds
# SKEW_S in agreement with this paragraph (bd gqlc-u2nim).
SKEW_S = 60

# Both listings report RFC 3339 with an explicit zone (measured 2026-08-17 over
# the live corpus: 397 bead updated_at and 418 issue updatedAt values, every one
# `YYYY-MM-DDTHH:MM:SSZ`). Anything else — absent, blank, unparseable, or a wall
# clock with no zone attached to it — yields None rather than a guess, because
# the only thing downstream does with the answer is decide a pull.
def edited_at(s):
    if not isinstance(s, str):
        return None
    v = s.strip()
    if v.endswith("Z"):
        v = v[:-1] + "+00:00"
    try:
        t = datetime.datetime.fromisoformat(v)
    except ValueError:
        return None
    return t if t.tzinfo is not None else None

beads = load(sys.argv[1])
issues = load(sys.argv[2])

gh = {i["number"]: ((i.get("state") or "").lower(), norm(i.get("body")),
                    edited_at(i.get("updatedAt")))
      for i in issues}
pat = re.compile(r"/issues/(\d+)$")

# GitHub holds exactly these two. Every other bd status is unrepresentable
# there, so a pull reads back a value the mirror never carried.
REPRESENTABLE = {"open", "closed"}

mirrored = set()
out = []
for b in beads:
    m = pat.search(b.get("external_ref") or "")
    if not m:
        continue
    n = int(m.group(1))
    mirrored.add(n)
    bid = one_line(b["id"])
    status = (b.get("status") or "").lower()

    if n not in gh:
        out.append(f"HOLD {bid} {n} not-in-listing")
        continue
    gh_state, gh_body, gh_at = gh[n]
    desc = norm(b.get("description"))

    if status not in REPRESENTABLE:
        # `status == gh_state` is false by construction here, so these can
        # never reach the in-sync drop below and the notice would print on
        # every merge forever — seven of them against two actionable ones on
        # the live corpus. A ratio like that is how `2>/dev/null` comes back.
        # An identical body under an open mirror means GitHub is not behind bd
        # in any respect GitHub can express: nothing is withheld, nothing to
        # say. A *closed* mirror is a real disagreement and still reported.
        if desc == gh_body and gh_state == "open":
            continue
        # The two cases left here are not one case. An OPEN mirror is the only
        # state GitHub can hold for a bead it has no status for, so that is a
        # bead whose body is merely behind — ordinary, and 2 of the live corpus.
        # A CLOSED one is a disagreement no run of this script can resolve: the
        # pull cannot take it (the status is unrepresentable) and the push only
        # ever closes mirrors, never reopens them. gqlc-23e sat in that state
        # for a month.
        #
        # Measured 2026-08-22 (gqlc-x98l): the plan code was run on live inputs
        # with GH #171 flipped from CLOSED to OPEN and nothing else changed, and
        # the output was BYTE-IDENTICAL to the control — one reason string
        # covered both, so no reader downstream could separate them. The
        # separate name is the whole repair; the DRIFT record beside it is what
        # `drift` gates on.
        if gh_state == "closed":
            out.append(f"HOLD {bid} {n} status-{status}-with-mirror-closed-on-gh")
            out.append(f"DRIFT {bid} {n} status-{status}-with-mirror-closed-on-gh")
            continue
        out.append(f"HOLD {bid} {n} status-{status}-unrepresentable-on-gh")
        continue
    # Deliberately no DRIFT record beside this one, though gqlc-x98l names it
    # alongside the case above. The push path's second arm closes exactly these
    # mirrors, so the state lasts from a `bd close` to the next `git push` —
    # transient, and a gate on it fires on ordinary work rather than on a fault.
    # Its own censuses bear that out: 1 instance on 2026-08-22 and 0 on
    # 2026-08-23 with no repair between them. It keeps its distinct hold reason,
    # which is where it was already visible.
    if status == "closed" and gh_state == "open":
        out.append(f"HOLD {bid} {n} closed-locally-still-open-on-gh")
        continue

    # "GH ahead of bd" is the case --prefer-github exists to serve, and half of
    # the witness that GitHub is ahead is the GH body carrying the whole bead
    # description and then some. A set-subset test over stripped lines is not
    # that half: it admits deletion, re-indent, reorder and de-dup, three of
    # which add no content at all. Append-only, byte for byte.
    if not gh_body.startswith(desc):
        out.append(f"HOLD {bid} {n} bd-description-not-a-prefix-of-gh-body")
        continue

    # The other half. A trailing block cut in bd leaves the bodies in the same
    # relation as a block appended on GitHub, so which way the edit went is not
    # a thing the two bodies hold — they are one state each, and the direction
    # is between them. The edit times are the third input, and one direction of
    # the ordering costs more to get wrong than the other: hold unless GitHub is
    # the later side by more than SKEW_S. A time that is missing or will not
    # parse is not an ordering either, and reaches the same hold under its own
    # name, because a bead whose evidence is absent is exactly the bead the two
    # bodies were about to decide wrongly.
    if gh_body != desc:
        bd_at = edited_at(b.get("updated_at"))
        if bd_at is None or gh_at is None:
            out.append(f"HOLD {bid} {n} edit-time-unreadable")
            continue
        if (gh_at - bd_at).total_seconds() <= SKEW_S:
            out.append(f"HOLD {bid} {n} gh-not-newer-than-bd")
            continue

    # Naming a bead in --issues syncs it whether or not GitHub moved, so the
    # recency watermark that bounds an unscoped pull no longer applies. Without
    # this, every merge rewrites the whole mirrored corpus.
    if desc == gh_body and status == gh_state:
        continue

    # A pull that carries a closure destroys a status a citizen may be working,
    # and the summary counted it as one more bead pulled — the same +1 a body
    # edit makes. gqlc-kibh went closed that way under an open, unreviewed PR.
    # The post-pull check cannot cover this: it opens by skipping every bead the
    # run pulled, because a pull rewriting a bead it pulled is the pull working.
    # So the transition is named here, where both states are still in hand.
    # Reported, never held — GitHub closing a mirror is how every merge ends.
    if status == "open" and gh_state == "closed":
        out.append(f"CLOSING {bid}")
    out.append(f"ALLOW {bid}")

# An unscoped pull silently minted a bead for any unmirrored issue in its
# update window. Scoping stops that, so report them rather than create them.
for n, (state, _, _) in sorted(gh.items()):
    if n not in mirrored and state == "open":
        out.append(f"ORPHAN {n}")

# A listing that came back holding exactly what was asked for is a page, not a
# set: `gh issue list` truncates at --limit silently, so "there are this many"
# and "there are more than this many" arrive as the same bytes. The selection
# itself stands — every decision above fails closed on an issue it cannot see,
# holding the bead rather than pulling it — but the ORPHAN tally counted off a
# page reads as a tally of the repository, and that is a number nobody measured.
if len(issues) >= int(sys.argv[3]):
    out.append(f"TRUNCATED {len(issues)}")

# The same failure at the other end of the range, where the test above cannot
# reach it: zero is below every bound, so a listing that came back empty emits
# no TRUNCATED record. Nothing else downstream notices either — every mirrored
# bead lands on `not-in-listing`, which is a hold and not a disagreement.
#
# The bound is the discriminator, and the probe has already paid for it. It is
# GitHub's own newest ISSUE number (`gh issue list`, so a repository whose only
# numbers are pull requests still probes 1), which makes a bound above 1 and a
# listing of zero two claims about one repository that cannot both hold. A
# bound of exactly 1 is the `// 1` the probe substitutes for an empty
# repository, and that shape must keep passing: it is the bootstrap run that is
# about to create the very first mirror.
if not issues and int(sys.argv[3]) > 1:
    out.append(f"EMPTYLISTING {sys.argv[3]}")

# How many beads the selection actually walked. "Nothing was held back" and "the
# list this ran on was empty" emit the same zero HOLD records, and only the
# first is a measurement. The ORPHAN tally rides on the same list — an issue is
# unmirrored only relative to a set of beads — so an empty one turns every
# mirrored issue into an orphan besides.
out.append(f"COUNT {len(beads)}")

for line in out:
    print(line)
print("DONE")
PYEOF

  if [ "$_rc" -ne 0 ] || [ "$(tail -n 1 "$_tmp/plan.txt" 2>/dev/null)" != "DONE" ]; then
    # Detail first, verdict last. This is the one exit that produces no summary
    # line, so the refusal itself has to be what a `tail -1` caller keeps —
    # echoing the traceback below it handed .claude/settings.json a bare
    # JSONDecodeError and no hint that a pull had been refused at all.
    sed 's/^/bd-gh-sync:   /' "$_tmp/plan.err" >&2 2>/dev/null
    # Which of the two inputs would not answer, where either did not. The
    # traceback above names the file that would not parse and nothing about why
    # it was empty, and "wait for the bd database" and "GitHub or the token is
    # the problem" are not the same instruction.
    if [ "$_list_rc" -ne 0 ]; then
      echo "bd-gh-sync: 'bd list' exited ${_list_rc} — usually something else holds the bd database." >&2
    fi
    if [ "$_gh_rc" -ne 0 ]; then
      echo "bd-gh-sync: 'gh issue list' exited ${_gh_rc} — GitHub's state could not be read at all." >&2
    fi
    # A gate has no operation riding on it and nothing to protect by staying
    # quiet, so where the pull declares itself skipped and exits 0, the drift
    # check fails. A run that decided nothing must not read as a run that found
    # nothing.
    if [ "$_action" = "drift" ]; then
      echo "bd-gh-sync: selection exited ${_rc}, so no bead was classified at all." >&2
      echo "bd-gh-sync: DRIFT CHECK FAILED — could not read the two listings it compares." >&2
      exit 1
    fi
    echo "bd-gh-sync: selection exited ${_rc}; an unscoped pull would let GitHub" >&2
    echo "bd-gh-sync: overwrite local state it cannot represent. Refusing." >&2
    echo "bd-gh-sync: SKIPPING pull — could not decide which beads are safe to pull." >&2
    exit 0
  fi

  # The gate. Placed above the hold reporting rather than below it because it
  # answers one question and the lines below answer another: what a pull chose
  # not to do is advice to whoever ran `git pull`, and this is a verdict on the
  # corpus for whoever ran the check.
  if [ "$_action" = "drift" ]; then
    # `_count`, not `wc -l` over a grep: zero DRIFT records is the healthy
    # steady state and the answer this gate exists to give, and grep reports it
    # as exit 1 under a shell with errexit and an ERR trap.
    _drift_n=$(_count '^DRIFT ' "$_tmp/plan.txt")
    _seen=$(sed -n 's/^COUNT //p' "$_tmp/plan.txt")
    # "No drift" is a claim about a corpus, and an unenumerated corpus emits the
    # same zero records a clean one does. The pull withdraws its counts here;
    # a gate has no count to withdraw and only a verdict, so it fails instead.
    if [ "${_seen:-0}" -eq 0 ]; then
      echo "bd-gh-sync: the bead list came back empty, so nothing was compared against" >&2
      echo "bd-gh-sync: GitHub. A clean verdict here would be a claim about a corpus" >&2
      echo "bd-gh-sync: this run never read." >&2
      echo "bd-gh-sync: DRIFT CHECK FAILED — no beads were examined." >&2
      exit 1
    fi
    # The same reasoning one side over, and it was missing. The selection emits
    # TRUNCATED when its GitHub listing arrived at the cap, and until now the
    # only reader of that record was the pull's summary — which this gate exits
    # above, so drift was handed the fact by its own plan file and dropped it.
    # Measured 2026-08-30: it answered `no durable drift over 1151 bead(s)` and
    # exit 0 over a listing that never held 178 of them (bd gqlc-lgwjt). A bead
    # whose mirror fell outside the page is not compared, and an uncompared bead
    # cannot be found to disagree.
    if grep -q '^TRUNCATED ' "$_tmp/plan.txt"; then
      echo "bd-gh-sync: the GitHub listing came back at its bound, so it is one page of" >&2
      echo "bd-gh-sync: an unknown number and the beads whose mirrors fell outside it" >&2
      echo "bd-gh-sync: were never compared. A clean verdict here would be a claim about" >&2
      echo "bd-gh-sync: a corpus this run never read." >&2
      echo "bd-gh-sync: DRIFT CHECK FAILED — the GitHub listing was truncated." >&2
      exit 1
    fi
    # And the other end of that range, which the record above cannot carry
    # because zero is below every bound. Measured 2026-08-30 before this arm
    # existed: with the listing shimmed to answer as an empty repository and the
    # bound probe answering 1152, drift reported `no durable drift over 1167
    # bead(s)` and exit 0 — a clean verdict over a comparison that never
    # happened, which is the same failure the truncation arm above was written
    # for (bd gqlc-hm4qc).
    #
    # This arm is the gate's alone, and the record is emitted for it alone. The
    # pull must go on tolerating an empty listing: a bead it cannot find lands
    # on `HOLD ... not-in-listing` and is left exactly as it was, so reading
    # nothing costs a pull nothing. A gate has no hold to fall back on — its
    # exit status is the whole answer — so the two arms want opposite answers to
    # one record, and only the gate refuses.
    if grep -q '^EMPTYLISTING ' "$_tmp/plan.txt"; then
      echo "bd-gh-sync: GitHub says its newest issue number is ${_gh_limit_all}, and then listed" >&2
      echo "bd-gh-sync: no issues at all. Those cannot both be true of this repository, so" >&2
      echo "bd-gh-sync: the listing failed open rather than finding nothing, and every bead" >&2
      echo "bd-gh-sync: was compared against an empty set." >&2
      echo "bd-gh-sync: DRIFT CHECK FAILED — the GitHub listing came back empty." >&2
      exit 1
    fi
    if [ "$_drift_n" -eq 0 ]; then
      echo "bd-gh-sync: no durable drift over ${_seen} bead(s)." >&2
      exit 0
    fi
    # Named one per line here, where there is no `tail -1` caller to lose them
    # and the whole point of the run is the list. The remedy rides along because
    # it is not the obvious one: repairing the bead alone leaves the mirror
    # closed and the next pull sees the same disagreement, and there is no way
    # to reopen a GitHub issue from bd at all.
    # `sed -n /p` rather than grep, and in the parent shell rather than a
    # process substitution, for the two reasons the hold section below states:
    # no matches is an answer and not a failure, and a section that cannot be
    # read still has to reach the ERR trap.
    sed -n '/^DRIFT /p' "$_tmp/plan.txt" >"$_tmp/drift.txt"
    while read -r _ _did _dn _dreason; do
      echo "bd-gh-sync: ${_did} (GH #${_dn}) — ${_dreason}. Reopen GH #${_dn} first," >&2
      echo "bd-gh-sync: then set the bead's status; neither the pull nor the push repairs this." >&2
    done <"$_tmp/drift.txt"
    echo "bd-gh-sync: DRIFT CHECK FAILED — ${_drift_n} of ${_seen} bead(s) disagree with a" >&2
    echo "bd-gh-sync: GitHub mirror in a way no run of this script can resolve." >&2
    exit 1
  fi

  # Selected with `sed -n /p` into a file, for the same reason the allowlist
  # below is, and read back from that file rather than from `< <(...)`. Two
  # separate properties hold this shape (gqlc-07c6):
  #
  # Zero matches. A plan with no HOLD and no ORPHAN records is the healthy
  # steady state, and `grep` answers it with exit 1. `set -E` hands the ERR trap
  # to the process-substitution subshell, so an unguarded grep there fired
  # _abort *inside* that subshell: the whole PULL FAILED block printed, then the
  # run carried on in the parent and printed its ordinary summary underneath.
  # Observed on a real `git merge` on 2026-08-22 — "PULL FAILED — aborted at
  # line 814; the pull is incomplete." directly above "pulled 0 bead(s), held 7"
  # — and both cannot be true. `sed -n /p` reports no matches as exit 0, which
  # is the answer these two sections want.
  #
  # A section that cannot be read. sed still exits 2 on an unreadable file, and
  # running it here in the parent shell rather than in a subshell is what lets
  # that reach the ERR trap and stop the run. That is the half a blanket
  # `|| true` would have thrown away: a hold nobody could read would go
  # unreported and the summary would count it as absent.
  sed -n '/^HOLD /p' "$_tmp/plan.txt" >"$_tmp/holds.txt"
  sed -n '/^ORPHAN /p' "$_tmp/plan.txt" >"$_tmp/orphans.txt"
  sed -n '/^DRIFT /p' "$_tmp/plan.txt" >"$_tmp/drift.txt"
  # One line per distinct reason, not one per bead. Measured 2026-08-23 over 784
  # beads and 806 issues: 7 beads sit permanently on
  # bd-description-not-a-prefix-of-gh-body, every one of them bd AHEAD of GitHub,
  # so the pull is right to hold them and the push path never rewrites an
  # existing issue body — neither direction of this script can clear them. They
  # printed seven stderr lines on every merge, forever, which is how an operator
  # stops reading the output that also carries the two actionable notices. The
  # divergence is unchanged and is bd gqlc-myee; what changed is that it no
  # longer costs seven lines to say.
  #
  # A single-bead group keeps the old wording verbatim, because the common case
  # is one hold and "holding 1 beads" is a worse line than the one it replaces.
  # The enumeration is capped and declares its own elision: an unbounded list is
  # the same unreadability in one line instead of N. The count is never capped.
  awk -v cap=12 '
    { r = $4
      if (!(r in n)) { order[++k] = r; n[r] = 0 }
      n[r]++
      if (n[r] <= cap)
        ids[r] = ids[r] (n[r] > 1 ? ", " : "") $2 " (GH #" $3 ")" }
    END {
      for (i = 1; i <= k; i++) {
        r = order[i]
        if (n[r] == 1) {
          printf "bd-gh-sync: holding %s out of the pull — %s\n", ids[r], r
        } else {
          more = n[r] > cap ? sprintf(" and %d more", n[r] - cap) : ""
          printf "bd-gh-sync: holding %d beads out of the pull — %s: %s%s\n", \
            n[r], r, ids[r], more
        }
      }
    }' "$_tmp/holds.txt" >&2
  while read -r _ n; do
    echo "bd-gh-sync: GH #$n has no bead; not creating one. Adopt it with 'bd github pull $n'." >&2
  done <"$_tmp/orphans.txt"

  # Whole remainder of the line, not `cut -f2`: an id carrying a space would be
  # silently truncated to its first token and a *different* bead would be named
  # in --issues. Taking it whole lets the gate below see it and refuse it.
  # One `sed -n .../p` rather than `grep | sed`: under pipefail a grep that
  # matched nothing — the steady state here — fails the whole pipeline, and the
  # allowlist being empty is not an error.
  sed -n 's/^ALLOW //p' "$_tmp/plan.txt" >"$_tmp/allow.txt"
  _eligible=$(_count '^ALLOW ' "$_tmp/plan.txt")
  _batches=0
  _failed=0
  _pulled=0
  _unusable=0
  # The ids behind _pulled, kept rather than only counted: the postcondition
  # below exempts from its held-bead check exactly the beads a pull could have
  # rewritten, and this is that set. Created here, before any batch can append to
  # it, because the postcondition has no fallback for its absence: an empty file
  # is a run that pulled nothing, and no file at all is a run whose exemption set
  # was never established, which stops the check rather than emptying it.
  #
  # Its failure is taken explicitly rather than left to `set -e`. Aborting here
  # would lose the pull itself over a scratch file, and the pull is the
  # operation; the absence of this file is already the postcondition's own "the
  # exemption set was never established", which reaches the summary line. What
  # the options add is that the failure is now said out loud instead of being
  # inferred downstream.
  : >"$_tmp/pulled.txt" ||
    echo "bd-gh-sync: could not create ${_tmp}/pulled.txt, so which beads this run pulled cannot be recorded and the held-bead check will report itself as not run." >&2

  # Batched here rather than by `xargs -n`, because xargs parses quotes: a
  # single bead id containing an apostrophe aborted the whole construction with
  # "unmatched single quote", so zero batches ran, the error printed above the
  # summary where `tail -1` drops it, and the summary still reported the
  # allowlist length as beads pulled. _pulled counts only ids handed to a batch
  # that exited 0, which is the only evidence the summary has any right to.
  _run_batch() {
    _batches=$((_batches + 1))
    if GITHUB_TOKEN="$_token" bd github sync --pull-only --prefer-github \
      --issues "$1"; then
      _pulled=$((_pulled + $2))
      # Ids reach here only past the charset gate, which admits neither a comma
      # nor a newline, so the accumulator splits back into exactly the ids that
      # went into it and each lands on a line of its own.
      # Same reading as the file's creation above: a batch whose ids cannot be
      # recorded leaves the postcondition without an exemption set, which it
      # reports, rather than aborting a pull that has already happened.
      printf '%s\n' "$1" | tr ',' '\n' >>"$_tmp/pulled.txt" ||
        echo "bd-gh-sync: could not record batch ${_batches}'s ids in ${_tmp}/pulled.txt; the held-bead check will report itself as not run." >&2
    else
      _failed=$((_failed + 1))
      echo "bd-gh-sync: 'bd github sync' exited non-zero on batch ${_batches}; those beads may not have been pulled." >&2
    fi
  }

  _ids=""
  _n=0
  while IFS= read -r _bid; do
    # The id becomes a shell argument. bd mints ids like `gqlc-4np` and
    # `gqlc-35yu.8`, so this refuses corruption only — and corruption is worth
    # a line of its own rather than a silent drop, because a bead that cannot
    # be named cannot be pulled, ever. A leading dash is refused separately
    # from the charset: `--issues` is a legal-looking id that would arrive as
    # `--issues --issues`, which is the empty-scope pull this file exists to
    # make unreachable.
    case "$_bid" in
      "" | -* | *[!A-Za-z0-9._-]*)
        _unusable=$((_unusable + 1))
        echo "bd-gh-sync: bead id '${_bid}' is unusable — it cannot be passed to 'bd github sync', so it was not pulled." >&2
        continue
        ;;
    esac
    if [ -n "$_ids" ]; then _ids="${_ids},${_bid}"; else _ids="$_bid"; fi
    _n=$((_n + 1))
    if [ "$_n" -ge "$_batch" ]; then
      _run_batch "$_ids" "$_n"
      _ids=""
      _n=0
    fi
  done <"$_tmp/allow.txt"
  # An empty --issues would widen the pull back to everything, so a batch is
  # only ever issued from a non-empty accumulator.
  if [ -n "$_ids" ]; then
    _run_batch "$_ids" "$_n"
  fi

  if [ "$_eligible" -eq 0 ]; then
    echo "bd-gh-sync: no bead is eligible for a --prefer-github pull; no pull issued." >&2
  fi

  # A --prefer-github pull rewrites more than the body and the status: it takes
  # GitHub's title verbatim, and bd derives priority, issue_type and the whole
  # label set from GitHub's labels, and the assignee from GitHub's assignees.
  # Scope is the only lever this script has (see the header — `bd github sync`
  # offers no field-level exclusion), and it is per bead, so every ALLOWed pull
  # takes all five with it and the summary line above counts it as one more
  # bead pulled. Measured 2026-08-30
  # against bd 1.0.4 through this hook: a bead at P0/task/hayk-probe/[class:
  # warrior,probe-sentinel-label] came back P2/bug/unassigned/[class:warrior,
  # subject:kingdom/bin/km]. So the five are re-asserted here instead.
  #
  # The title is the one of the five with no gate anywhere in bd: read at
  # beads@ce242a879678 (the commit `bd version` reports for the 1.0.4 binary
  # deployed here), internal/tracker/engine.go's buildPullIssueUpdates writes
  # "title": remote.Title into every pulled bead unconditionally — no
  # append-only test like the one this script applies to the description, and
  # no recency test. Whether that reaches a bead is decided entirely by the
  # eligibility rule above, which reads the DESCRIPTION; the title rides along
  # on a gate that never looks at it.
  #
  # It is re-asserted rather than allowed because the live corpus says citizens
  # correct bd titles and do not touch GitHub's. Measured 2026-08-30 over 1245
  # mirrored beads: 6 titles disagree with their mirrors, and on 5 of the 6 the
  # GitHub issue has NO `renamed` timeline event at all — the mirror still
  # carries the title it was minted with, and bd's side is a later correction a
  # pull would revert. (The sixth, GH #933, was renamed once, and even there bd
  # holds the older, broader wording.) No such revert has landed yet: zero
  # title reversions across 933 beads in the 142 commits of .beads/issues.jsonl
  # history, because all 6 are held by the description gate today. That is the
  # bead's premise confirmed as latent, not fired — gqlc-wl57h.
  #
  # The closure transition is where this bites rather than some edge: bd open
  # with the mirror closed is an ALLOW, it is how every merge ends, and it nulls
  # the assignee of a bead somebody is holding — an unassigned bead in a
  # non-ready status routes to no dispatch pass at all. bd's assignee is a seat
  # name and GitHub's is a GitHub login, so GitHub has nothing to put back: of
  # all 800 issues on the mirror, one carries a GH assignee, and it is open
  # (measured 2026-08-30). Holding the pull instead was the
  # other candidate remedy and would have withheld the closure of very nearly
  # every bead a citizen was working.
  #
  # These writes move bd's edit time, which the eligibility rule reads. That
  # costs nothing in the steady state — a bead whose body now equals GitHub's
  # never reaches the time test — and where a GH append lands in the seconds
  # between the pull and this re-assert, it holds that append until GitHub next
  # moves. Holding is the direction this file errs in everywhere else.
  _restore_rc=0
  bd list --status all --limit 0 --json >"$_tmp/beads_pulled.json" 2>/dev/null \
    || { _restore_rc=$?; : >"$_tmp/beads_pulled.json"; }
  python3 - "$_tmp/beads.json" "$_tmp/beads_pulled.json" "$_tmp/pulled.txt" \
    "$_tmp/restore_status.txt" >&2 <<'PYEOF' || true
import json, subprocess, sys

def load(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return None

def status(text):
    with open(sys.argv[4], "w", encoding="utf-8") as fh:
        fh.write(text + "\n")

def one_line(s):
    return str(s).encode("unicode_escape").decode("ascii")

# Absent and empty are one value here. bd omits assignee and labels from its
# JSON when they are unset, so a comparison that asks whether the key is present
# reads "GitHub put an assignee on a bead that had none" as nothing to do —
# which is the direction that drops the field without saying so.
def fields(b):
    return {"title": b.get("title") or "",
            "priority": b.get("priority"),
            "issue_type": b.get("issue_type") or "",
            "assignee": b.get("assignee") or "",
            "labels": sorted(b.get("labels") or [])}

def index(rows):
    return {b["id"]: fields(b) for b in rows
            if isinstance(b, dict) and isinstance(b.get("id"), str)}

def current():
    r = subprocess.run(["bd", "list", "--status", "all", "--limit", "0", "--json"],
                       capture_output=True, check=False)
    if r.returncode != 0:
        return None
    rows = None
    try:
        rows = json.loads(r.stdout.decode("utf-8", "replace"))
    except Exception:
        return None
    return index(rows) if rows else None

before_rows = load(sys.argv[1])
after_rows = load(sys.argv[2])
if not before_rows:
    status("BLIND the pre-pull bead list was unreadable or empty")
    sys.exit(0)
if not after_rows:
    status("BLIND the post-pull bead list was unreadable or empty")
    sys.exit(0)
# No fallback: this file is created by the caller, so a read that fails means
# the set of beads a pull could have rewritten was never established. Restoring
# against an unknown set would re-assert onto beads nothing touched.
try:
    with open(sys.argv[3], encoding="utf-8") as fh:
        pulled = {ln.strip() for ln in fh if ln.strip()}
except Exception:
    status("BLIND which beads this run pulled was never recorded")
    sys.exit(0)

before, after = index(before_rows), index(after_rows)

planned = {}
for bid in sorted(pulled):
    was, now = before.get(bid), after.get(bid)
    if was is None or now is None:
        continue
    args, what = [], []
    if was["title"] and now["title"] != was["title"]:
        args += ["--title", was["title"]]
        what.append(f"title {one_line(now['title']) or '(none)'} -> "
                    f"{one_line(was['title'])}")
    if was["priority"] is not None and now["priority"] != was["priority"]:
        args += ["-p", str(was["priority"])]
        what.append(f"priority {now['priority']} -> {was['priority']}")
    if was["issue_type"] and now["issue_type"] != was["issue_type"]:
        args += ["-t", was["issue_type"]]
        what.append(f"type {now['issue_type'] or '(none)'} -> {was['issue_type']}")
    if now["assignee"] != was["assignee"]:
        args += ["-a", was["assignee"]]
        what.append(f"assignee {now['assignee'] or '(none)'} -> "
                    f"{was['assignee'] or '(none)'}")
    if now["labels"] != was["labels"]:
        # `--set-labels ""` is accepted and changes nothing (measured
        # 2026-08-30), so clearing the last label has to go through
        # --remove-label. Add and remove express both directions in one form,
        # which leaves no emptied-set special case to get wrong.
        for lab in sorted(set(now["labels"]) - set(was["labels"])):
            args += ["--remove-label", lab]
        for lab in sorted(set(was["labels"]) - set(now["labels"])):
            args += ["--add-label", lab]
        what.append(f"labels [{','.join(now['labels'])}] -> "
                    f"[{','.join(was['labels'])}]")
    if args:
        planned[bid] = (args, what)

if not planned:
    status("OK 0 0")
    sys.exit(0)

# One command per bead rather than one per field: bd discards a refused update
# whole, so splitting would let four fields land and the fifth vanish with
# only a non-zero status to say so. The read-back below is what decides whether
# any of it took — `bd update` prints its success line for a write that moved
# nothing.
for bid, (args, _) in planned.items():
    r = subprocess.run(["bd", "update", bid] + args, capture_output=True,
                       check=False)
    if r.returncode == 0:
        continue
    detail = r.stderr.decode("utf-8", "replace").strip().splitlines()
    print(f"bd-gh-sync: 'bd update' exited {r.returncode} re-asserting the "
          f"fields the pull overwrote on {one_line(bid)}."
          + (f" {detail[-1]}" if detail else ""), file=sys.stderr)

final = current()
if final is None:
    status(f"BLIND {len(planned)} bead(s) were re-asserted and none could be "
           f"read back")
    sys.exit(0)

restored, stuck = 0, 0
for bid, (_, what) in planned.items():
    was, now = before[bid], final.get(bid)
    if now is not None and all(now[k] == was[k] for k in was):
        restored += 1
        continue
    stuck += 1
    # Named rather than counted: nothing else in this run will say which bead
    # lost which field, and the pull that took it reported itself as a success.
    print(f"bd-gh-sync: WARNING {one_line(bid)} was pulled and the fields "
          f"GitHub overwrote did not come back ({'; '.join(what)}). Re-assert "
          f"them with 'bd update' before treating the bead as routable.",
          file=sys.stderr)
status(f"OK {restored} {stuck}")
PYEOF

  # As with the postcondition below: an absent status file is this stanza never
  # having run, which is a different finding from one that ran and could not see.
  _restored=0
  _stuck=0
  _restore_blind=""
  _restore_status=""
  [ -f "$_tmp/restore_status.txt" ] && _restore_status=$(cat "$_tmp/restore_status.txt")
  case "$_restore_status" in
    "OK "*)
      _restored=$(echo "$_restore_status" | cut -d' ' -f2)
      _stuck=$(echo "$_restore_status" | cut -d' ' -f3)
      ;;
    BLIND*) _restore_blind=${_restore_status#BLIND } ;;
    *) _restore_blind="the re-assert did not run at all" ;;
  esac
  if [ -n "$_restore_blind" ] && [ "$_restore_rc" -ne 0 ]; then
    _restore_blind="'bd list' exited ${_restore_rc}"
  fi
  if [ -n "$_restore_blind" ]; then
    echo "bd-gh-sync: could not re-assert the title, priority, type, assignee and labels" >&2
    echo "bd-gh-sync: that a --prefer-github pull takes from every bead it pulls" >&2
    echo "bd-gh-sync: (${_restore_blind}). Check the beads this run pulled with" >&2
    echo "bd-gh-sync: 'bd show' — an assignee nulled this way routes to nobody." >&2
  fi

  # Postcondition: a bead held out of scope must come back with the same status
  # and the same description — the two the stanza above does not cover, because
  # for a HELD bead no pull ran to overwrite anything.
  # Scoping is an argument about what --issues means, and this measures whether
  # the argument held. It catches a reverted claim whatever moved it, including
  # the JSONL replay in `bd hooks run post-merge` — that reverts in_progress to
  # open through a path this script never calls.
  #
  # Deliberately above no bail-out: an empty allowlist is the steady state (the
  # live corpus has nothing eligible on an ordinary merge), and none of the
  # things that revert a claim behind this script's back are conditional on
  # some other bead happening to be pullable. Arming the detector only when a
  # pull runs disarms it permanently.
  #
  # What it exempts is the ids a batch that exited 0 was handed, not the
  # allowlist. The allowlist is what this run intended to pull; the summary
  # above counts as pulled only what a batch that exited 0 carried, and the two
  # sets differ on exactly the beads whose handling went wrong — an id the
  # charset gate refused, a batch that died. Exempting those left the detector
  # blind where it is most needed, on a run that had already announced them as
  # unpulled. The summary and the detector now describe one run.
  #
  # The detector also has to report its own liveness. The second snapshot fails
  # exactly when something else holds the bd database — which is the same event
  # (`bd hooks run post-merge` replaying JSONL) the detector exists to catch —
  # so a swallowed failure here means the detector is disarmed by its own
  # trigger, and the run reads byte-for-byte like a healthy one. The status file
  # is only ever created by status() below, in a directory this run made, so its
  # absence is what says "the check did not run at all" — distinct from the
  # BLIND it writes for "the check ran and could not see".
  : >"$_tmp/moved.txt"
  _post_rc=0
  bd list --status all --limit 0 --json >"$_tmp/beads_post.json" 2>/dev/null \
    || { _post_rc=$?; : >"$_tmp/beads_post.json"; }
  python3 - "$_tmp/beads.json" "$_tmp/beads_post.json" "$_tmp/pulled.txt" \
    "$_tmp/moved.txt" "$_tmp/post_status.txt" >&2 <<'PYEOF' || true
import json, sys

# status *and* description: "held out of the pull" is a claim about the whole
# bead, and a --prefer-github pull that reaches a held bead overwrites its body.
# Watching only the status column would miss exactly the loss this scoping
# exists to prevent. Stripped, because trailing-whitespace churn is not a
# clobber and a check that cries wolf gets `2>/dev/null` bolted onto it.
def beads(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return {b["id"]: ((b.get("status") or ""),
                              (b.get("description") or "").strip())
                    for b in json.load(fh)}
    except Exception:
        return {}

def status(text):
    with open(sys.argv[5], "w", encoding="utf-8") as fh:
        fh.write(text + "\n")

# Ids here come off `bd list`, so unlike the two selections above they have not
# been past the charset gate: one carrying a newline splits its moved.txt record
# in two and the summary reports one bead as two, which is the count nobody
# measured that this path exists to refuse. Escaping leaves every id the gate
# would accept byte-for-byte alone.
def one_line(s):
    return str(s).encode("unicode_escape").decode("ascii")

before = beads(sys.argv[1])
after = beads(sys.argv[2])
if not before:
    # No baseline to compare against, so there is nothing this check could have
    # caught and nothing to warn about. Unreachable in practice: an unreadable
    # first snapshot already took the SKIPPING branch above.
    status("VACUOUS")
    sys.exit(0)
if not after:
    status("BLIND post-pull bead list unreadable")
    sys.exit(0)
# The ids a batch that exited 0 was handed — the beads a pull could have
# rewritten, and the same set the summary line counts as pulled. Not the
# allowlist: that is what the run intended to pull, and it still names an id the
# charset gate refused and an id whose batch died, both of which this run
# reported as unpulled on stderr. Exempting a bead the run says it did not pull
# takes the detector off duty exactly where the run already went wrong.
#
# Read without a fallback, and before the verdict is written. The caller creates
# this file, so a read that fails means the exemption set is unknown — and an
# unknown exemption set silently defaulted to empty is the detector reporting
# every pulled bead as held. Dying here leaves no status file, which is the
# script's existing "the check did not run" and reaches the summary line.
with open(sys.argv[3], encoding="utf-8") as fh:
    pulled = {ln.strip() for ln in fh if ln.strip()}
status("OK")

# The set this run actually held: every bead the first snapshot saw that no
# batch reported pulling. Stated as a set rather than left implicit in the loop
# below, because the finding turns on it. A bead absent from the second snapshot
# used to be skipped outright, which made deletion — the one change no re-assert
# undoes — the single transition the detector could not see. Absence is only
# ambiguous while "held" is inferred from the intersection of the two snapshots;
# against the held set it decides, because the run enumerated that set itself.
#
# The wholesale case is already gone above: an `after` that came back empty is
# BLIND and exits, so nothing here can mistake a snapshot nobody could read for
# a tracker somebody emptied. What reaches this point is a snapshot that loaded
# and still holds beads, and a held bead missing from it was deleted.
moved = []
for bid, was in sorted(before.items()):
    if bid in pulled:
        continue
    name = one_line(bid)
    if bid not in after:
        moved.append("GONE " + name)
        print(f"bd-gh-sync: WARNING {name} was held out of the pull but is gone "
              f"from the bead list afterwards — it was deleted while this run "
              f"was protecting it. No status can be re-asserted onto a bead that "
              f"is not there; recover it from bd's own history.")
        continue
    now = after[bid]
    if now == was:
        continue
    moved.append("MOVED " + name)
    what, how = [], []
    if now[0] != was[0]:
        what.append(f"{was[0]} -> {now[0]}")
        how.append(f"Re-assert the status with 'bd update {name} --status {was[0]}'.")
    if now[1] != was[1]:
        what.append("description")
        how.append("The pre-pull description survives only in bd's own history.")
    print(f"bd-gh-sync: WARNING {name} was held out of the pull but changed "
          f"{', '.join(what)}. " + " ".join(how))

# Read back by the summary line: a warning printed here is above the summary
# and a `tail -1` caller never sees it. Each record carries what happened as
# well as the id, because a deleted bead and a reverted one call for different
# responses and the summary has to be able to tell the reader which it has.
with open(sys.argv[4], "w", encoding="utf-8") as fh:
    for rec in moved:
        fh.write(rec + "\n")
PYEOF

  # A check that could not run is a finding in its own right: the operator is
  # owed the difference between "nothing moved" and "nobody looked". An empty
  # status file means the python itself never got far enough to write one.
  _blind=""
  # Read through a test rather than by letting `cat` fail: absence is the
  # script's own "the check did not run at all" signal, and under `set -e` a
  # failing `cat` in an assignment aborts before that signal is read.
  _post_status=""
  [ -f "$_tmp/post_status.txt" ] && _post_status=$(cat "$_tmp/post_status.txt")
  case "$_post_status" in
    OK | VACUOUS) ;;
    BLIND*) _blind="the post-pull bead list was unreadable" ;;
    *) _blind="the check itself did not run" ;;
  esac
  if [ -n "$_blind" ] && [ "$_post_rc" -ne 0 ]; then
    _blind="'bd list' exited ${_post_rc}"
  fi
  if [ -n "$_blind" ]; then
    echo "bd-gh-sync: could not re-read the bead list after the pull (${_blind})." >&2
    echo "bd-gh-sync: that usually means something else holds the bd database — which" >&2
    echo "bd-gh-sync: is also what reverts a claim behind this script's back. Re-run" >&2
    echo "bd-gh-sync: 'git pull' once it is free, or check claims with 'bd list'." >&2
  fi

  # Both numbers on the summary line are read off the bead listing: "held"
  # directly, and "unmirrored" because an issue has no bead only relative to a
  # set of beads. `bd list` answering `[]` with exit 0 is the ordinary shape of
  # the wrong workspace — the statuses above cannot see it — and it walks
  # straight to `held 0, left N unmirrored GH issue(s) alone`, two counts over a
  # set nobody enumerated, with every mirrored issue reported as an orphan
  # besides. Detail here, counts withdrawn from the summary below. Same ruling
  # as the push side's empty pre-push snapshot.
  #
  # Deliberately *not* the push side's other witness. There, N > 0 issues minted
  # and an empty open listing in the same run contradict each other on their
  # face. The pull-side analogue would be "beads carry external_refs, so the
  # all-state listing cannot be empty" — and that is no contradiction at all: a
  # ref is matched by /issues/(\d+)$ over any URL, so it legitimately names
  # another repository, and refusing that shape would fire on every merge
  # against a repo whose beads were imported from elsewhere. The GitHub listing
  # is witnessed by its exit status above and its --limit below; only the bead
  # listing's own cardinality is decided here, where no foreign ref can reach.
  _unwitnessed=""
  _beads_n=$(sed -n 's/^COUNT //p' "$_tmp/plan.txt")
  if [ "${_beads_n:-0}" -eq 0 ]; then
    _unwitnessed="the bead list came back empty"
    echo "bd-gh-sync: the bead list came back empty when this run chose what to" >&2
    echo "bd-gh-sync: pull, so which beads were held back — and which GH issues" >&2
    echo "bd-gh-sync: have no bead at all — was never established. An empty" >&2
    echo "bd-gh-sync: repository and a bd database nobody could read are the same" >&2
    echo "bd-gh-sync: bytes here. Re-run 'git pull' once the database is free." >&2
  fi

  # The selection saw its listing arrive at the bound, so how many issues GitHub
  # actually holds is not a thing this run established. Detail here, and the
  # count itself withdrawn from the summary below.
  #
  # The old remedy line said to raise the cap by hand, and that instruction is
  # what this bound replaces — there is no number here to raise. Reaching the
  # bound now means the newest issue's number is no larger than the count of
  # issues, which is why the line points at the derivation rather than at a
  # constant. `drift` refuses outright on this same record; the pull says it and
  # carries on, because it rides on `git pull` and has held rather than guessed.
  _capped=""
  if grep -q '^TRUNCATED ' "$_tmp/plan.txt"; then
    _capped="the GitHub listing came back at its bound of ${_gh_limit_all}"
    echo "bd-gh-sync: ${_capped}, so it is one page of an unknown number and" >&2
    echo "bd-gh-sync: how many GH issues have no bead was never established. Beads" >&2
    echo "bd-gh-sync: whose mirror fell outside the page were held, not pulled. That" >&2
    echo "bd-gh-sync: bound is GitHub's own newest issue number, so reaching it means" >&2
    echo "bd-gh-sync: the derivation at the top of this script no longer holds." >&2
  fi

  # Which of the closures the plan saw actually landed: a CLOSING record is what
  # GitHub showed, and the bead was only shut in fact if a batch that exited 0
  # carried it — the same evidence the pulled count rests on. Intent is not
  # outcome, as everywhere else on this line.
  #
  # pulled.txt is read by name rather than as the first of two awk operands.
  # `NR==FNR` means "still in the first file" only while that file is non-empty,
  # and an empty one is precisely the run that pulled nothing — so the idiom
  # takes the plan's first line for a pulled id on exactly the runs where no
  # closure may be claimed. It reached the right verdict there by accident,
  # which is worse than the wrong one: the guard against it read as green.
  awk -v pf="$_tmp/pulled.txt" '
    BEGIN { while ((getline _l < pf) > 0) pulled[_l] }
    /^CLOSING / { _n = substr($0, 9); if (_n in pulled) print _n }' \
    "$_tmp/plan.txt" >"$_tmp/closed.txt"

  # Last line, and the only line a `tail -1` caller keeps
  # (.claude/settings.json). It therefore has to report what happened rather
  # than what was intended: a failed `bd github sync` writes its own error
  # above this point, where the same tail discards it.
  #
  # The test is _pulled against _eligible, not _failed against zero. _failed is
  # only ever incremented inside the batch loop, so every way of losing beads
  # *before* the loop body runs — an id that cannot be passed, a batch list
  # that came out empty — left _failed at 0 and reported the allowlist length
  # as a success. Intent is not outcome; the gap between them is the finding.
  if [ "$_pulled" -lt "$_eligible" ]; then
    _summary="bd-gh-sync: PULL FAILED — ${_pulled} of ${_eligible} eligible bead(s) pulled"
    [ "$_failed" -gt 0 ] &&
      _summary="${_summary}; ${_failed} of ${_batches} 'bd github sync' batch(es) exited non-zero"
    [ "$_unusable" -gt 0 ] &&
      _summary="${_summary}; ${_unusable} bead id(s) unusable"
    [ "$_batches" -eq 0 ] &&
      _summary="${_summary}; no batch ran at all"
  else
    _summary="bd-gh-sync: pulled ${_pulled} bead(s)"
  fi
  # The held count is over the beads; the orphan count is over both sets, since
  # "unmirrored" is a claim about the GH listing measured against the bead one.
  # Each arm is therefore withdrawn by whatever left its set unwitnessed — an
  # unenumerated bead list takes both, a capped GitHub listing takes only the
  # orphan arm. Same rule as the push side's two arms: no number goes on the one
  # line the caller keeps unless the set behind it was witnessed.
  _held_arm="held $(_count '^HOLD ' "$_tmp/plan.txt")"
  _orphan_arm="left $(_count '^ORPHAN ' "$_tmp/plan.txt") unmirrored GH issue(s) alone"
  if [ -n "$_unwitnessed" ]; then
    _held_arm="held an unknown number of bead(s) (${_unwitnessed})"
    _orphan_arm="left an unknown number of unmirrored GH issue(s) alone (${_unwitnessed})"
  elif [ -n "$_capped" ]; then
    _orphan_arm="left an unknown number of unmirrored GH issue(s) alone (${_capped})"
  fi
  _summary="${_summary}, ${_held_arm}, ${_orphan_arm}."
  # Named, not merely counted, and named here rather than in a WARNING above:
  # `tail -1` keeps this line and drops those. A count that moved by one is what
  # the reader had before, and it does not distinguish an amended body from a
  # status somebody was working. The repair ordering rides along because this is
  # where a citizen meets the closure — repairing the bead alone looks like a fix
  # and is undone by the next pull, which reads GitHub as authoritative.
  if [ -s "$_tmp/closed.txt" ]; then
    _closed=$(wc -l <"$_tmp/closed.txt")
    _cnames=$(awk 'NR<=3 { printf "%s%s", sep, $0; sep=", " }' "$_tmp/closed.txt")
    [ "$_closed" -gt 3 ] && _cnames="${_cnames}, +$((_closed - 3)) more"
    _summary="${_summary} ${_closed} of them had been closed on GitHub while open here (${_cnames}); if that is wrong, re-open the GH issue FIRST and the bead second, or the next pull undoes it."
  fi
  # Silent when the pull moved none of the five, which is the steady state. The
  # two failing arms are on the line the caller keeps because both leave a bead
  # carrying GitHub's values for fields GitHub was never authoritative over —
  # and the nulled assignee among them is invisible to every dispatch pass.
  if [ -n "$_restore_blind" ]; then
    _summary="${_summary} Whether the pull also overwrote any bead's title, priority, type, assignee or labels was not established (${_restore_blind})."
  elif [ "$_stuck" -gt 0 ]; then
    _summary="${_summary} ${_restored} bead(s) had the title, priority, type, assignee and labels the pull overwrote put back, and ${_stuck} did NOT — see the WARNING line(s) above."
  elif [ "$_restored" -gt 0 ]; then
    _summary="${_summary} ${_restored} of them had the title, priority, type, assignee and labels the pull overwrote put back."
  fi
  if [ -s "$_tmp/moved.txt" ]; then
    _moved=$(wc -l <"$_tmp/moved.txt")
    # Deletion is called out on its own rather than folded into the count: the
    # remedy for a reverted status is the `bd update` the WARNING line above
    # prints, and there is no such line for a bead that is gone. A reader who
    # takes this one line and finds nothing to re-assert is a reader who
    # concludes the warning was noise.
    _gone=$(_count '^GONE ' "$_tmp/moved.txt")
    # The record tag comes off by field and the records are joined one by one: a
    # bead id is not guaranteed to be a single word here, and flattening the
    # three onto a line to separate them on every space renders one bead as two
    # names `bd show` does not answer to.
    _names=$(awk 'NR<=3 { sub(/^[^ ]* /, ""); printf "%s%s", sep, $0; sep=", " }' \
      "$_tmp/moved.txt")
    [ "$_moved" -gt 3 ] && _names="${_names}, +$((_moved - 3)) more"
    _what="changed anyway"
    [ "$_gone" -gt 0 ] && _what="${_what}, ${_gone} of them deleted outright"
    _summary="${_summary} WARNING: ${_moved} bead(s) held out of the pull ${_what} (${_names}); see the WARNING lines above for what moved and how to recover it."
  fi
  if [ -n "$_blind" ]; then
    _summary="${_summary} WARNING: the held-bead check did not run (${_blind}); a bead reverted behind this script's back would not have been reported."
  fi
  # gqlc-x98l. This class was already on stderr, under a hook that exits 0 and
  # a caller that keeps one line — which is the whole account of how the live
  # instance sat for a month unseen. Named here, on the line that survives, and
  # named rather than counted: the remedy is per bead and starts on GitHub.
  # The count is not withdrawn by an empty bead list the way the held and orphan
  # arms are, because it is not a count of a set — every id on it was seen.
  if [ -s "$_tmp/drift.txt" ]; then
    _drift_n=$(wc -l <"$_tmp/drift.txt")
    _dnames=$(awk 'NR<=3 { printf "%s%s (GH #%s)", sep, $2, $3; sep=", " }' "$_tmp/drift.txt")
    [ "$_drift_n" -gt 3 ] && _dnames="${_dnames}, +$((_drift_n - 3)) more"
    _summary="${_summary} WARNING: ${_drift_n} bead(s) sit in a status GitHub cannot represent under a CLOSED mirror (${_dnames}); no pull or push repairs that — reopen the GH issue first, then set the bead."
  fi
  echo "$_summary" >&2
  exit 0
fi

# push
_pushed=0
_batches=0
_failed=0
_unusable=0

# `bd github push` is what assigns external_ref, and which beads still lack one
# is read off the `bd list` below it. Unserialised, two runs both read before
# either wrote and both minted an issue for the same bead: the bead keeps
# whichever external_ref was written last, and no bead then points at the other
# number, so the close pass further down — which keys on external_ref — has no
# way to reach it and it stays open however the work ends. Counted on this
# repository 2026-08-18: 18 open issues with no bead pointing at them, 16 of
# them byte-identical to the issue their bead does point at, 17 created 1-6
# seconds before it (gqlc-mmej). The lock is taken above the read, so the run
# that waits chooses what to push from a ledger the run ahead of it has already
# written to.
#
# The git common directory holds the lock because it is one per clone, which is
# the granularity of what is being protected: a linked worktree's .beads/
# redirects to the main checkout's database (.beads/.gitignore names that
# redirect file), so sibling worktrees push one ledger to one GitHub repository,
# and that is the pair of sessions the measurement above came from. A lock
# keyed to the worktree gives each of them one of its own. It also lives under
# .git, which git neither tracks nor reports, so it is not a file anyone has to
# ignore.
#
# WHAT THAT GRANULARITY EXCLUDES, said here because the sentence above is the
# one a maintainer reads and a granularity stated without its limit is read as
# "the push pass is serialised, full stop".
# It does NOT serialise two separate clones of this repository: they have
# different common directories, so they take different lock files, neither
# waits, and both mint. Measured in the
# round-2 review of PR #1037 (C-V2+N1): two clones, `bd github push b-conc` ran
# 2 times. Two clones on one machine is not exotic — a second checkout for a
# long-running review is exactly it.
#
# That is a decision and not an oversight. A lock covering two clones would have
# to live at a path neither clone owns — a fixed location outside both work
# trees — and inventing one trades a bounded, self-cleaning lock for a global
# one that no `git clean` reaches and that a stale holder can wedge for every
# checkout on the machine. The measured incident was sibling worktrees of one
# clone (18 unreachable issues), which this covers. Cross-clone is out of scope
# until somebody measures it happening. .githooks/tests/bd-gh-sync-test.sh used
# to pin both halves — that two clones mint twice, and that this paragraph still
# said so — so that the limit could not be widened into a claim by editing
# either one alone. PR #1595 deleted that suite and nothing replaced it. Editing
# this paragraph alone now DOES widen the limit, and silently: read it as a
# statement of scope somebody must re-measure, not as a pinned one
# (bd gqlc-u2nim).
#
# fd 9 carries the lock for the rest of this process; closing that fd is what
# releases the lock, and the kernel closes it however the process ends. bash
# cannot mark an fd close-on-exec, so every `bd`, `gh` and `python3` below is
# given `9>&-`: a child that inherited fd 9 and outlived this script would hold
# the lock for as long as it ran, after this script had reported itself
# finished. Those three are the ones that reach the network or the bd database
# and so the ones that can outlive it; they are also the three the regression
# test probes for an open fd 9.
_lock_wait=120
_lock_dir=$(git rev-parse --git-common-dir 2>/dev/null) || _lock_dir=""
if [ -z "$_lock_dir" ] || [ ! -d "$_lock_dir" ]; then
  # Detail first, verdict last, as at every other refusal here.
  echo "bd-gh-sync: 'git rev-parse --git-common-dir' named no directory, so there is" >&2
  echo "bd-gh-sync: nowhere to take the lock that keeps two pushes from minting two" >&2
  echo "bd-gh-sync: GitHub issues for one bead. Nothing was read from bd or GitHub," >&2
  echo "bd-gh-sync: so no bead was mirrored and no GH mirror closed." >&2
  echo "bd-gh-sync: PUSH FAILED — no git directory to hold the push lock." >&2
  exit 1
fi
_lock="$_lock_dir/bd-gh-sync-push.lock"
if ! exec 9>"$_lock"; then
  echo "bd-gh-sync: ${_lock} could not be opened for writing, so the lock that keeps" >&2
  echo "bd-gh-sync: two pushes from minting two GitHub issues for one bead cannot be" >&2
  echo "bd-gh-sync: taken. Nothing was read from bd or GitHub, so no bead was mirrored" >&2
  echo "bd-gh-sync: and no GH mirror closed." >&2
  echo "bd-gh-sync: PUSH FAILED — the push lock file could not be opened." >&2
  exit 1
fi
# Status taken on the command, not from `$?` below it: under `set -e` a flock
# that could not be taken would abort before the refusal that names it.
_flock_rc=0
flock -w "$_lock_wait" 9 || _flock_rc=$?
if [ "$_flock_rc" -ne 0 ]; then
  # The status separates the two shapes: 127 is the shell not finding flock at
  # all, and the remedy for that is not "push again".
  echo "bd-gh-sync: 'flock -w ${_lock_wait}' exited ${_flock_rc} on ${_lock}, so this run" >&2
  echo "bd-gh-sync: never took the push lock and stopped before reading anything from bd" >&2
  echo "bd-gh-sync: or GitHub: no bead was mirrored and no GH mirror closed. A wait that" >&2
  echo "bd-gh-sync: ran out is a push still in flight — push again once it finishes. 127" >&2
  echo "bd-gh-sync: is flock not being runnable here at all." >&2
  echo "bd-gh-sync: PUSH FAILED — could not take the push lock." >&2
  exit 1
fi

_list_rc=0
bd list --status all --limit 0 --json >"$_tmp/beads.json" 9>&- 2>/dev/null \
  || { _list_rc=$?; : >"$_tmp/beads.json"; }

# GitHub's cap on a label name is measured and owned by the CI gate at
# .github/scripts/check-label-lengths.py (bd gqlc-89vw), which reddens a PR over
# the committed export. The selection below reads the cap and the remedy out of
# that file rather than writing either a third time: two spellings of one number
# disagree exactly when somebody raises one of them, and the whole point of
# refusing at filing time is that the citizen meets the same words here as in
# CI. Resolved beside this script first, because all three callers invoke it by
# path, and off the work tree only as a fallback.
_hooks_dir=$(cd "$(dirname "$0")" && pwd)
_label_gate="$_hooks_dir/../.github/scripts/check-label-lengths.py"
if [ ! -f "$_label_gate" ]; then
  _repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || _repo_root=""
  [ -n "$_repo_root" ] &&
    _label_gate="$_repo_root/.github/scripts/check-label-lengths.py"
fi

# The DONE sentinel serves the same purpose it serves on the pull side: a bead
# list that would not load used to become an empty selection, and an empty
# selection is byte-for-byte the steady state. "Nothing needs a mirror" and
# "which beads need a mirror is unknowable" are different runs.
_rc=0
python3 - "$_tmp/beads.json" "$_label_gate" \
  >"$_tmp/plan.txt" 9>&- 2>"$_tmp/plan.err" <<'PYEOF' || _rc=$?
import importlib.util, json, sys

# Importing the CI gate below compiles it, and python caches that compilation by
# writing .github/scripts/__pycache__/ into the work tree. That directory is not
# in .gitignore, so every push would leave an untracked directory behind in a
# lane this script does not own. Measured on the first run of this path.
sys.dont_write_bytecode = True

# Escaped for the reason the pull selection escapes: the records below are
# line-delimited, and an id carrying a newline splits into two the charset gate
# waves through.
def one_line(s):
    return str(s).encode("unicode_escape").decode("ascii")

# The cap and the prefix, read from the CI gate that owns them. Importing by
# file path because the filename carries hyphens; the module defines its work
# under `if __name__ == "__main__"`, so loading it runs nothing.
def label_rule(path):
    spec = importlib.util.spec_from_file_location("_check_label_lengths", path)
    if spec is None or spec.loader is None:
        raise ImportError("no loadable module at " + path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return int(mod.MAX_LABEL), str(mod.PREFIX), mod.remedy

# The remedy gqlc-89vw ratified — the deepest ancestor DIRECTORY that fits — is
# imported with the cap rather than reimplemented here. It used to be a local
# copy of the rule, which made three spellings of one instruction across the
# three gates that print it; the module owns it now (bd gqlc-uy7j).
cap = None
prefix = ""
remedy = lambda label, cap, prefix: ""  # noqa: E731 - unreachable while cap is None
try:
    cap, prefix, remedy = label_rule(sys.argv[2])
except Exception as exc:  # noqa: BLE001 - every failure here has one meaning
    # No number, so no screening and no claim that any bead's labels are
    # mirrorable. Reported rather than defaulted: a cap guessed at here is the
    # 422 this whole path exists to make unreachable, arriving under a summary
    # line that says the bead was pushed.
    print("CAPUNKNOWN " + one_line(sys.argv[2]) + ": " + one_line(exc))

with open(sys.argv[1], encoding="utf-8") as fh:
    beads = json.load(fh)
for b in beads:
    if b.get("external_ref"):
        continue
    bid = one_line(b["id"])
    over = [] if cap is None else [
        lab for lab in (b.get("labels") or []) if len(lab) > cap]
    if not over:
        print("NEW " + bid)
        continue
    # GitHub rejects the ISSUE, not the label, so a bead offered with one of
    # these comes back 422 and ends up with no mirror at all while the run
    # reports a push. Held here instead, where the citizen who chose the label
    # can still choose another one.
    print("UNMIRRORABLE " + bid)
    for lab in over:
        note = ("%s carries a label GitHub cannot hold: %r is %d characters and "
                "the cap is %d. The bead was NOT offered to GitHub, because the "
                "API refuses the whole issue over one label and the bead would "
                "have been left with no mirror."
                % (bid, one_line(lab), len(lab), cap))
        # one_line over the whole sentence, not just the label inside it: these
        # records are line-delimited, and the suggestion is derived from a label
        # that may carry a newline.
        advice = remedy(lab, cap, prefix)
        if advice:
            note += " " + one_line(advice)
        print("NOTE " + note)
# How many beads the selection actually walked. "No bead needs a mirror" and
# "the list this ran on was empty" both emit zero NEW records, and only the
# first of them is a measurement of anything.
print("COUNT " + str(len(beads)))
print("DONE")
PYEOF

if [ "$_rc" -ne 0 ] || [ "$(tail -n 1 "$_tmp/plan.txt" 2>/dev/null)" != "DONE" ]; then
  # Detail first, verdict last: this exit produces no summary line, so the
  # refusal itself has to be what a `tail -1` caller keeps.
  sed 's/^/bd-gh-sync:   /' "$_tmp/plan.err" >&2 2>/dev/null
  if [ "$_list_rc" -ne 0 ]; then
    echo "bd-gh-sync: 'bd list' exited ${_list_rc} — usually something else holds the bd database." >&2
  fi
  echo "bd-gh-sync: selection exited ${_rc}; which beads still need a GitHub" >&2
  echo "bd-gh-sync: mirror cannot be decided, and pushing an unknown set of" >&2
  echo "bd-gh-sync: beads creates issues nobody asked for. Refusing." >&2
  echo "bd-gh-sync: SKIPPING push — could not decide which beads to push." >&2
  exit 1
fi

# A bead whose label GitHub cannot hold still needs a mirror; what it does not
# get is an attempt. So it counts toward the denominator and never toward
# _pushed, which is what makes the summary read "0 of 1" rather than announcing
# a push that GitHub would have refused whole.
#
# This verdict was nearly demoted to a non-failing notice on 2026-08-23, on the
# argument that the condition is permanent and the citizen who sees the alarm is
# not the one who can clear it. Both halves were falsified the same night.
# gqlc-njqk, gqlc-a7we and gqlc-to7k did carry the 51-character
# `subject:kingdom/brain/playbooks/citizen-protocol.md`; they now carry
# `subject:kingdom/brain/playbooks`, 31 characters — the deepest ancestor
# directory that fits, which is verbatim the remedy the NOTE line below prints —
# and all three mirrored normally (GH #1358, #1359, #1360). Measured over the
# whole board the same day: zero beads carry an over-cap label. So the alarm is
# clearable, was cleared, and PUSH FAILED stays.
_unmirrorable=$(_count '^UNMIRRORABLE ' "$_tmp/plan.txt")
_pushable=$(_count '^NEW ' "$_tmp/plan.txt")
_new=$((_pushable + _unmirrorable))
_before_n=$(sed -n 's/^COUNT //p' "$_tmp/plan.txt")

# One line per refused label, naming the bead, the length, the cap and the
# shorter label to use. Printed above the summary, where the detail belongs; the
# summary carries the count, because a `tail -1` caller keeps only that.
while IFS= read -r _note; do
  echo "bd-gh-sync: ${_note}" >&2
done < <(sed -n 's/^NOTE //p' "$_tmp/plan.txt")

# No cap means no screening happened, and a run that screened nothing may not
# report that every bead's labels were mirrorable. Same rule as every other
# withdrawn count on this line.
_capunknown=""
if grep -q '^CAPUNKNOWN ' "$_tmp/plan.txt"; then
  _capunknown=$(sed -n 's/^CAPUNKNOWN //p' "$_tmp/plan.txt" | head -n 1)
  echo "bd-gh-sync: GitHub's label cap could not be read from ${_capunknown}" >&2
  echo "bd-gh-sync: so no bead was screened for a label GitHub will refuse. A bead" >&2
  echo "bd-gh-sync: offered with one comes back 422 and is left with no mirror at all." >&2
fi
# Whole remainder of the line, for the reason the pull path takes it whole: an
# id cut at its first token names a different, possibly real, bead. One `sed -n`
# rather than `grep | sed`, because under pipefail a grep that matched nothing —
# the steady state — would fail the pipeline.
sed -n 's/^NEW //p' "$_tmp/plan.txt" >"$_tmp/new.txt"

# Batched by hand rather than through `xargs -n`, because xargs parses quotes:
# one bead id carrying an apostrophe aborted the whole construction, so no batch
# ran at all, and `|| true` reported that as a clean push. _pushed counts only
# ids handed to a batch that exited 0.
_push_batch() {
  _batches=$((_batches + 1))
  # shellcheck disable=SC2086 # deliberate split: one bead id per argument, and
  # every id in $1 has cleared the gate below
  if GITHUB_TOKEN="$_token" bd github push $1 9>&-; then
    _pushed=$((_pushed + $2))
  else
    _failed=$((_failed + 1))
    echo "bd-gh-sync: 'bd github push' exited non-zero on batch ${_batches}; those beads may still have no GitHub mirror." >&2
  fi
}

_ids=""
_n=0
while IFS= read -r _bid; do
  # The id becomes a shell argument, so this is the pull path's gate verbatim,
  # for the same reasons: bd mints ids like `gqlc-4np`, so it refuses corruption
  # only; a leading dash is refused separately from the charset because an id
  # shaped like a flag arrives as one.
  case "$_bid" in
    "" | -* | *[!A-Za-z0-9._-]*)
      _unusable=$((_unusable + 1))
      echo "bd-gh-sync: bead id '${_bid}' is unusable — it cannot be passed to 'bd github push', so no GitHub mirror was created for it." >&2
      continue
      ;;
  esac
  _ids="${_ids:+${_ids} }${_bid}"
  _n=$((_n + 1))
  if [ "$_n" -ge "$_batch" ]; then
    _push_batch "$_ids" "$_n"
    _ids=""
    _n=0
  fi
done <"$_tmp/new.txt"
if [ -n "$_ids" ]; then
  _push_batch "$_ids" "$_n"
fi

# Re-read the beads: `bd github push` assigns external_ref to everything it
# mirrors, and the close pass keys on external_ref. Reusing the pre-push
# snapshot skips exactly the beads that were closed before their first push,
# leaving the mirror it just minted open forever.
_post_rc=0
bd list --status all --limit 0 --json >"$_tmp/beads_after.json" 9>&- 2>/dev/null \
  || { _post_rc=$?; : >"$_tmp/beads_after.json"; }

# _pushed is a count of intent: ids handed to a batch that exited 0. `bd github
# push` exits 0 even where the GitHub API refuses an individual bead — a rate
# limit, a transient 5xx, a field GitHub rejects — so a bead left with no mirror
# at all used to arrive underneath a summary line saying it was pushed. That is
# the shape this whole script is written against, and it was in the one number
# the caller keeps (gqlc-mprc).
#
# The evidence is the ledger: `bd github push` is what assigns external_ref, so
# a bead is mirrored iff it carries one after the push. Read off the same
# post-push snapshot the stale-mirror pass uses, so no third `bd list` is spent.
# Only ever run over beads this run actually offered — with nothing offered
# there is no claim to check and none to withdraw, which keeps a repository with
# nothing to push out of the failure path entirely.
_mirrored=$_pushed
_unverified=""
if [ "$_pushed" -gt 0 ]; then
  if [ "$_post_rc" -ne 0 ]; then
    _unverified="'bd list' exited ${_post_rc} after the push"
  else
    _vrc=0
    python3 - "$_tmp/new.txt" "$_tmp/beads_after.json" \
      >"$_tmp/verify.txt" 9>&- 2>/dev/null <<'PYEOF' || _vrc=$?
import json, sys

def one_line(s):
    return str(s).encode("unicode_escape").decode("ascii")

with open(sys.argv[1], encoding="utf-8") as fh:
    offered = [ln.rstrip("\n") for ln in fh if ln.strip()]
with open(sys.argv[2], encoding="utf-8") as fh:
    beads = json.load(fh)
# An empty post-push list is not "no bead gained a mirror": this run just minted
# issues, so it is a snapshot that was lost. Reported as such rather than as a
# count of zero, which would read as a measured shortfall.
if not beads:
    print("EMPTY")
    print("DONE")
    sys.exit(0)
have = {b.get("id"): bool(b.get("external_ref")) for b in beads}
n = 0
for bid in offered:
    if have.get(bid):
        n += 1
    else:
        print("MISSING " + one_line(bid))
print("MIRRORED %d" % n)
print("DONE")
PYEOF
    if [ "$_vrc" -ne 0 ] ||
       [ "$(tail -n 1 "$_tmp/verify.txt" 2>/dev/null)" != "DONE" ]; then
      _unverified="the post-push bead list could not be read"
    elif grep -q '^EMPTY$' "$_tmp/verify.txt"; then
      _unverified="the post-push bead list came back empty"
    else
      _mirrored=$(sed -n 's/^MIRRORED //p' "$_tmp/verify.txt")
      while IFS= read -r _lost; do
        echo "bd-gh-sync: ${_lost} was handed to 'bd github push' and came back with no GitHub mirror; 'bd github push ${_lost}' by hand, or check the API error above." >&2
      done < <(sed -n 's/^MISSING //p' "$_tmp/verify.txt")
    fi
  fi
  if [ -n "$_unverified" ]; then
    echo "bd-gh-sync: whether the ${_pushed} bead(s) offered to GitHub gained a mirror" >&2
    echo "bd-gh-sync: could not be checked (${_unverified}). 'bd github push' exits 0" >&2
    echo "bd-gh-sync: over a bead the API refused, so the offer is not the evidence." >&2
  fi
fi

# Close GH mirrors for beads that are closed locally but still open on GH.
# One bulk `gh issue list` + one `gh issue close` per mismatch. Idempotent:
# closing an already-closed GH issue is a no-op.
_gh_rc=0
GITHUB_TOKEN="$_token" gh issue list --state open --limit "$_gh_limit_open" \
  --json number >"$_tmp/open_gh.json" 9>&- 2>/dev/null \
  || { _gh_rc=$?; : >"$_tmp/open_gh.json"; }

# Either input failing yields an empty set, which reads as "nothing is stale"
# rather than "nobody looked" — and the beads it would have named are the ones
# whose mirror stays open forever. Both bead snapshots go in, because an input
# that *loads* and comes back `[]` walks the same fail-open one step further:
# the pass enumerates nothing, finds nothing stale, and "0 stale" is then a
# count of a set nobody looked at. `bd list` answering `[]` with exit 0 is the
# ordinary shape of the wrong workspace, so it is the reachable one. The status
# file is only ever created by status() below, so its absence is what says the
# pass did not get far enough to have a verdict.
GITHUB_TOKEN="$_token" python3 - "$_tmp/beads.json" "$_tmp/beads_after.json" \
  "$_tmp/open_gh.json" "$_tmp/close_status.txt" "$_gh_limit_open" "$_pushed" \
  9>&- >/dev/null <<'PYEOF' || true
import json, re, subprocess, sys

def load(path):
    with open(path, encoding="utf-8") as fh:
        return json.load(fh)

def status(text):
    with open(sys.argv[4], "w", encoding="utf-8") as fh:
        fh.write(text + "\n")

def one_line(s):
    return str(s).encode("unicode_escape").decode("ascii")

try:
    open_issues = load(sys.argv[3])
    open_nums = {i["number"] for i in open_issues}
except Exception:
    status("BLIND the open-issue listing was unreadable")
    sys.exit(0)

# `gh issue list` cuts at --limit without saying so, so a listing holding
# exactly the cap is one page of an unknown number. Every mirror past the cut
# is invisible to the comparison below, and "0 stale" over it is a count of the
# page rather than of the repository.
if len(open_issues) >= int(sys.argv[5]):
    status(f"BLIND the open-issue listing came back at its --limit of "
           f"{sys.argv[5]}, so it is a page rather than the whole set")
    sys.exit(0)

# An empty listing is an ordinary answer — until this same run minted issues.
# `bd github push` opens one issue per new bead, so N > 0 pushed and nothing
# open is not a repository with no open issues, it is a listing that lost the
# ones this run just created. That is the witness emptiness alone does not have.
if not open_issues and int(sys.argv[6]) > 0:
    status(f"BLIND this run pushed {sys.argv[6]} new bead(s) but the "
           f"open-issue listing came back empty")
    sys.exit(0)

try:
    beads = load(sys.argv[2])
except Exception:
    status("BLIND the post-push bead list was unreadable")
    sys.exit(0)
# Unreadable is already an exit above, via the selection's own refusal; -1 keeps
# "nobody could read it" from arriving downstream as the number 0.
try:
    before = load(sys.argv[1])
    before_n = len(before)
except Exception:
    before_n = -1

# This run pushed beads and deleted none, so a post-push list holding fewer than
# the pre-push one is a snapshot that was lost rather than a tracker that
# emptied. With both empty there is no witness either way, and "a repository
# with no beads" and "a bd database nobody could read" are the same bytes.
if not beads:
    if before_n > 0:
        status("BLIND the post-push bead list came back empty, and the pre-push "
               f"one held {before_n} bead(s)")
    else:
        status("BLIND both bead lists came back empty, which is what an empty "
               "repository and an unreadable bd database look like alike")
    sys.exit(0)

pat = re.compile(r"/issues/(\d+)$")
stale = []
for b in beads:
    if b.get("status") != "closed":
        continue
    m = pat.search(b.get("external_ref") or "")
    if m and int(m.group(1)) in open_nums:
        stale.append((int(m.group(1)), b))

closed = 0
for n, b in stale:
    tag = ((b.get("close_reason") or "").splitlines() or [""])[0].strip()
    if len(tag) > 300:
        tag = tag[:297] + "..."
    bid = one_line(b.get("id") or "")
    body = f"Auto-close: bead {bid} closed locally."
    if tag:
        body += f" {tag}"
    r = subprocess.run(["gh", "issue", "close", str(n), "--comment", body],
                       capture_output=True, check=False)
    if r.returncode == 0:
        closed += 1
        continue
    # The one outcome the operator has to act on by hand, and the one the
    # discarded return code could not express.
    detail = r.stderr.decode("utf-8", "replace").strip().splitlines()
    print(f"bd-gh-sync: could not close GH #{n} (bead {bid}); it stays open while "
          f"the bead is closed." + (f" {detail[-1]}" if detail else ""),
          file=sys.stderr)
status(f"OK {len(stale)} {closed}")
PYEOF

_stale=0
_closed=0
_blind=""
_uncounted=""
# Read through a test rather than by letting `cat` fail: the file's absence is
# the script's own "the pass did not run at all", and under `set -e` a failing
# `cat` in an assignment aborts before that signal is read.
_close_status=""
[ -f "$_tmp/close_status.txt" ] && _close_status=$(cat "$_tmp/close_status.txt")
case "$_close_status" in
  "OK "*)
    _stale=$(echo "$_close_status" | cut -d' ' -f2)
    _closed=$(echo "$_close_status" | cut -d' ' -f3)
    ;;
  "BLIND "*) _blind="${_close_status#BLIND }" ;;
  *) _blind="the stale-mirror pass did not run at all" ;;
esac
# A non-zero from either input is the more precise diagnosis, so it wins over
# the python's view that the file was merely unreadable.
[ -n "$_blind" ] && [ "$_post_rc" -ne 0 ] && _blind="'bd list' exited ${_post_rc}"
[ -n "$_blind" ] && [ "$_gh_rc" -ne 0 ] && _blind="'gh issue list' exited ${_gh_rc}"
if [ -n "$_blind" ]; then
  # One remedy for every reason above, so it has to hold for all of them, and
  # "wait for the bd database" holds only for the bd-list ones: a listing that
  # came back cut off at its cap, or missing the issues this run just made, is
  # not waiting on anything, and an operator sent to re-run it re-runs it
  # forever. Naming the wrong fix under the right reason sends the reader
  # somewhere useless just as surely as naming the wrong reason does. Precise on
  # the line above, generic here, rather than one instruction per reason drifting
  # away from the reason it belongs to.
  echo "bd-gh-sync: could not work out which GH mirrors are stale (${_blind})." >&2
  echo "bd-gh-sync: a bead closed locally may still show open on GitHub. Close it" >&2
  echo "bd-gh-sync: by hand, or fix what that line names and push again — any" >&2
  echo "bd-gh-sync: --limit it mentions is set in .githooks/bd-gh-sync." >&2
fi

# The same reading applied to the other count. _new is the denominator of "N of
# M new bead(s) mirrored", and it is counted off the pre-push snapshot: zero NEW
# records out of zero beads is not the measurement "nothing needed a mirror",
# it is the absence of one. Kept separate from _blind, and outside its guard,
# because it is a separate finding about a separate snapshot — the stale-mirror
# pass runs fine on a post-push list that came back populated.
if [ "$_before_n" -eq 0 ]; then
  _uncounted="the pre-push bead list came back empty"
  echo "bd-gh-sync: the bead list was empty when this run chose what to push, so" >&2
  echo "bd-gh-sync: how many beads needed a GitHub mirror was never established —" >&2
  echo "bd-gh-sync: an empty repository and an unreadable bd database read alike" >&2
  echo "bd-gh-sync: here. Re-run 'git push' once the database is free." >&2
fi

# Last line, and the only line a `tail -1` caller keeps. It reports what reached
# GitHub rather than what was intended: `bd github push` writes its own error
# above this point, where the same tail discards it.
#
# The exit status carries the same verdict for a caller that checks it instead.
# _failed is not the test, for the reason it is not the test on the pull side:
# every way of losing a bead before the batch body runs — an id that cannot be
# passed, a batch list that came out empty — leaves it at 0.
#
# Neither arm prints a number it did not measure. "0 of 0" off a snapshot that
# came back empty is the fail-open this whole guard exists to close, and writing
# it into the failure line would hand it back on the one line the caller keeps.
_rc=0
_new_arm="${_mirrored} of ${_new} new bead(s) mirrored"
[ -n "$_unverified" ] &&
  _new_arm="${_pushed} new bead(s) offered to GitHub, none of them checked for a mirror"
[ -n "$_uncounted" ] &&
  _new_arm="${_mirrored} new bead(s) mirrored out of a number that was never established"
_close_arm="${_closed} of ${_stale} stale GH mirror(s) closed"
[ -n "$_blind" ] &&
  _close_arm="an unknown number of stale GH mirror(s) left open"
if [ "$_mirrored" -lt "$_new" ] || [ "$_closed" -lt "$_stale" ] ||
   [ -n "$_blind" ] || [ -n "$_uncounted" ] || [ -n "$_capunknown" ] ||
   [ -n "$_unverified" ]; then
  _rc=1
  _summary="bd-gh-sync: PUSH FAILED — ${_new_arm}, ${_close_arm}"
  [ "$_failed" -gt 0 ] &&
    _summary="${_summary}; ${_failed} of ${_batches} 'bd github push' batch(es) exited non-zero"
  [ "$_unusable" -gt 0 ] &&
    _summary="${_summary}; ${_unusable} bead id(s) unusable"
  # Over the beads a batch could have carried, not over _new: a run whose only
  # unmirrored bead was refused for its label ran no batch on purpose, and
  # "no batch ran at all" there names a fault that is not there.
  [ "$_pushable" -gt 0 ] && [ "$_batches" -eq 0 ] &&
    _summary="${_summary}; no batch ran at all"
  [ "$_unmirrorable" -gt 0 ] &&
    _summary="${_summary}; ${_unmirrorable} bead(s) were not offered to GitHub at all, carrying a label longer than it accepts — see the line(s) above for the shorter label to use"
  [ -n "$_unverified" ] &&
    _summary="${_summary}; whether the bead(s) offered to GitHub gained a mirror could not be checked (${_unverified})"
  [ -n "$_capunknown" ] &&
    _summary="${_summary}; no bead was screened for an unmirrorable label (the cap could not be read from ${_capunknown})"
  [ -n "$_blind" ] &&
    _summary="${_summary}; the stale-mirror pass could not run (${_blind})"
  [ -n "$_uncounted" ] &&
    _summary="${_summary}; which beads needed a mirror could not be counted (${_uncounted})"
  _summary="${_summary}."
else
  _summary="bd-gh-sync: pushed ${_mirrored} new bead(s), closed ${_closed} stale GH mirror(s)."
fi
echo "$_summary" >&2
exit "$_rc"
