#!/usr/bin/env bash
# GH↔bd sync helper. Single sync surface shared by:
#   - .githooks/post-merge      (pull, on git pull/merge)
#   - .githooks/pre-push        (push, on git push)
#   - .claude/settings.json     (pull, on Claude Code session start)
#
# Args: pull | push
# Exits 0 on any error so the git/session operation continues; diagnostics go
# to stderr, so a caller that wants silence must redirect it explicitly.
#
# Design: human works through GitHub issues; agents work through bd.
#   - pull:  mirror GH state into bd for the beads where GitHub is capable of
#            holding the local value and is not behind it. `bd github sync`
#            offers no field-level exclusion, so scope is the only lever: the
#            eligible bead ids are passed as --issues and everything else is
#            left untouched. A bead is eligible only when
#              * it carries an external_ref present in the bulk GH listing,
#              * its status is open or closed — GitHub's issue state is a
#                two-value domain, so in_progress/blocked/deferred have no
#                representable counterpart and any pull reverts them,
#              * it is not closed locally while still open on GH, and
#              * the GH body extends the bead description verbatim, i.e.
#                gh_body.startswith(description) — append-only.
#            The last three conditions are one rule: never pull where GH is
#            behind bd. Only an append witnesses "GH ahead"; every other edit
#            (deletion, re-indent, reorder, de-dup) is bd-side work a pull
#            would revert, and a per-line set comparison sees none of them.
#            Selection failing for any reason yields an empty allowlist and no
#            pull at all.
#            Whatever the allowlist, the run ends by re-reading the bead list
#            and reporting any out-of-scope bead whose status moved — the
#            allowlist is empty in the steady state, so a postcondition
#            conditional on a pull would never run. The last stderr line
#            carries the outcome, warnings included, because the session-start
#            caller keeps only that line.
#   - push:  mirror bd-created beads that have no GH mirror yet, AND close
#            GH issues whose bead was closed locally.
#            Deliberately does NOT run `bd github sync --push-only` (which
#            takes ~30s scanning every bead) — its close propagation is also
#            unreliable (memory: bd-github-sync-quirks). Instead:
#              1. `bd github push <ids>` per new bead (no external_ref).
#              2. Bulk `gh issue list --state open` intersected with
#                 closed-bd beads bearing an external_ref; each mismatch
#                 gets `gh issue close`.
#
# Payloads reach python through temp files, never argv or the environment. The
# bead listing alone is ~1MB, and execve caps any single argument or
# environment string at 128KB (MAX_ARG_STRLEN) — a limit no ulimit raises.

_action="${1:-}"
case "$_action" in pull|push) ;; *)
  echo "usage: $0 pull|push" >&2
  exit 0
esac

command -v bd >/dev/null 2>&1 || exit 0
command -v gh >/dev/null 2>&1 || exit 0
command -v python3 >/dev/null 2>&1 || {
  echo "bd-gh-sync: python3 not found — skipping ${_action}." >&2
  exit 0
}
_token=$(gh auth token 2>/dev/null) || exit 0
[ -n "$_token" ] || exit 0

_tmp=$(mktemp -d) || exit 0
trap 'rm -rf "$_tmp"' EXIT

# `bd github sync --issues` takes its list on argv. Batch it so a growing
# corpus cannot walk into the same 128KB argument cap that this script already
# hit once by passing payloads through the environment.
_batch=100

if [ "$_action" = "pull" ]; then
  bd list --status all --limit 0 --json >"$_tmp/beads.json" 2>/dev/null \
    || : >"$_tmp/beads.json"
  GITHUB_TOKEN="$_token" gh issue list --state all --limit 1000 \
    --json number,state,body >"$_tmp/gh.json" 2>/dev/null \
    || : >"$_tmp/gh.json"

  # Emits ALLOW/HOLD/ORPHAN records terminated by DONE. That sentinel is what
  # separates "selection ran and chose nothing" from "selection did not run";
  # without it an empty result is indistinguishable from a crash, which is how
  # the previous guard fell through into an unscoped pull.
  python3 - "$_tmp/beads.json" "$_tmp/gh.json" \
    >"$_tmp/plan.txt" 2>"$_tmp/plan.err" <<'PYEOF'
import json, re, sys

def load(path):
    with open(path, encoding="utf-8") as fh:
        return json.load(fh)

beads = load(sys.argv[1])
issues = load(sys.argv[2])

gh = {i["number"]: ((i.get("state") or "").lower(), (i.get("body") or "").strip())
      for i in issues}
pat = re.compile(r"/issues/(\d+)$")

# GitHub holds exactly these two. Every other bd status is unrepresentable
# there, so a pull reads back a value the mirror never carried.
REPRESENTABLE = {"open", "closed"}

mirrored = set()
out = []
for b in beads:
    m = pat.search(b.get("external_ref") or "")
    if not m:
        continue
    n = int(m.group(1))
    mirrored.add(n)
    bid = b["id"]
    status = (b.get("status") or "").lower()

    if n not in gh:
        out.append(f"HOLD {bid} {n} not-in-listing")
        continue
    gh_state, gh_body = gh[n]
    desc = (b.get("description") or "").strip()

    if status not in REPRESENTABLE:
        # `status == gh_state` is false by construction here, so these can
        # never reach the in-sync drop below and the notice would print on
        # every merge forever — seven of them against two actionable ones on
        # the live corpus. A ratio like that is how `2>/dev/null` comes back.
        # An identical body under an open mirror means GitHub is not behind bd
        # in any respect GitHub can express: nothing is withheld, nothing to
        # say. A *closed* mirror is a real disagreement and still reported.
        if desc == gh_body and gh_state == "open":
            continue
        out.append(f"HOLD {bid} {n} status-{status}-unrepresentable-on-gh")
        continue
    if status == "closed" and gh_state == "open":
        out.append(f"HOLD {bid} {n} closed-locally-still-open-on-gh")
        continue

    # "GH ahead of bd" is the case --prefer-github exists to serve, and the
    # only witness that GitHub is ahead is the GH body carrying the whole bead
    # description and then some. Anything else is a bd-side edit that a pull
    # reverts. A set-subset test over stripped lines is not that witness: it
    # admits deletion, re-indent, reorder and de-dup, three of which add no
    # content at all. Append-only, byte for byte.
    if not gh_body.startswith(desc):
        out.append(f"HOLD {bid} {n} bd-description-not-a-prefix-of-gh-body")
        continue

    # Naming a bead in --issues syncs it whether or not GitHub moved, so the
    # recency watermark that bounds an unscoped pull no longer applies. Without
    # this, every merge rewrites the whole mirrored corpus.
    if desc == gh_body and status == gh_state:
        continue

    out.append(f"ALLOW {bid}")

# An unscoped pull silently minted a bead for any unmirrored issue in its
# update window. Scoping stops that, so report them rather than create them.
for n, (state, _) in sorted(gh.items()):
    if n not in mirrored and state == "open":
        out.append(f"ORPHAN {n}")

for line in out:
    print(line)
print("DONE")
PYEOF
  _rc=$?

  if [ "$_rc" -ne 0 ] || [ "$(tail -n 1 "$_tmp/plan.txt" 2>/dev/null)" != "DONE" ]; then
    echo "bd-gh-sync: SKIPPING pull — could not decide which beads are safe to pull." >&2
    echo "bd-gh-sync: selection exited ${_rc}; an unscoped pull would let GitHub" >&2
    echo "bd-gh-sync: overwrite local state it cannot represent. Refusing." >&2
    sed 's/^/bd-gh-sync:   /' "$_tmp/plan.err" >&2 2>/dev/null
    exit 0
  fi

  while read -r _ bid n reason; do
    echo "bd-gh-sync: holding $bid (GH #$n) out of the pull — $reason" >&2
  done < <(grep '^HOLD ' "$_tmp/plan.txt")
  while read -r _ n; do
    echo "bd-gh-sync: GH #$n has no bead; not creating one. Adopt it with 'bd github pull $n'." >&2
  done < <(grep '^ORPHAN ' "$_tmp/plan.txt")

  # Whole remainder of the line, not `cut -f2`: an id carrying a space would be
  # silently truncated to its first token and a *different* bead would be named
  # in --issues. Taking it whole lets the gate below see it and refuse it.
  grep '^ALLOW ' "$_tmp/plan.txt" | sed 's/^ALLOW //' >"$_tmp/allow.txt"
  _eligible=$(grep -c '^ALLOW ' "$_tmp/plan.txt")
  _batches=0
  _failed=0
  _pulled=0
  _unusable=0

  # Batched here rather than by `xargs -n`, because xargs parses quotes: a
  # single bead id containing an apostrophe aborted the whole construction with
  # "unmatched single quote", so zero batches ran, the error printed above the
  # summary where `tail -1` drops it, and the summary still reported the
  # allowlist length as beads pulled. _pulled counts only ids handed to a batch
  # that exited 0, which is the only evidence the summary has any right to.
  _run_batch() {
    _batches=$((_batches + 1))
    if GITHUB_TOKEN="$_token" bd github sync --pull-only --prefer-github \
      --issues "$1"; then
      _pulled=$((_pulled + $2))
    else
      _failed=$((_failed + 1))
      echo "bd-gh-sync: 'bd github sync' exited non-zero on batch ${_batches}; those beads may not have been pulled." >&2
    fi
  }

  _ids=""
  _n=0
  while IFS= read -r _bid; do
    # The id becomes a shell argument. bd mints ids like `gqlc-4np` and
    # `gqlc-35yu.8`, so this refuses corruption only — and corruption is worth
    # a line of its own rather than a silent drop, because a bead that cannot
    # be named cannot be pulled, ever.
    case "$_bid" in
      "" | *[!A-Za-z0-9._-]*)
        _unusable=$((_unusable + 1))
        echo "bd-gh-sync: bead id '${_bid}' is unusable — it cannot be passed to 'bd github sync', so it was not pulled." >&2
        continue
        ;;
    esac
    if [ -n "$_ids" ]; then _ids="${_ids},${_bid}"; else _ids="$_bid"; fi
    _n=$((_n + 1))
    if [ "$_n" -ge "$_batch" ]; then
      _run_batch "$_ids" "$_n"
      _ids=""
      _n=0
    fi
  done <"$_tmp/allow.txt"
  # An empty --issues would widen the pull back to everything, so a batch is
  # only ever issued from a non-empty accumulator.
  if [ -n "$_ids" ]; then
    _run_batch "$_ids" "$_n"
  fi

  if [ "$_eligible" -eq 0 ]; then
    echo "bd-gh-sync: no bead is eligible for a --prefer-github pull; no pull issued." >&2
  fi

  # Postcondition: a bead held out of scope must come back unchanged. Scoping
  # is an argument about what --issues means, and this measures whether the
  # argument held. It catches a reverted claim whatever moved it, including the
  # JSONL replay in `bd hooks run post-merge` — that reverts in_progress to
  # open through a path this script never calls.
  #
  # Deliberately above no bail-out: an empty allowlist is the steady state (the
  # live corpus has nothing eligible on an ordinary merge), and none of the
  # things that revert a claim behind this script's back are conditional on
  # some other bead happening to be pullable. Arming the detector only when a
  # pull runs disarms it permanently.
  #
  # The detector also has to report its own liveness. The second snapshot fails
  # exactly when something else holds the bd database — which is the same event
  # (`bd hooks run post-merge` replaying JSONL) the detector exists to catch —
  # so a swallowed failure here means the detector is disarmed by its own
  # trigger, and the run reads byte-for-byte like a healthy one. The status file
  # is written by the python below and starts empty, so "the check did not run
  # at all" is as visible as "the check ran and could not see".
  : >"$_tmp/moved.txt"
  : >"$_tmp/post_status.txt"
  _post_rc=0
  bd list --status all --limit 0 --json >"$_tmp/beads_post.json" 2>/dev/null \
    || { _post_rc=$?; : >"$_tmp/beads_post.json"; }
  python3 - "$_tmp/beads.json" "$_tmp/beads_post.json" "$_tmp/allow.txt" \
    "$_tmp/moved.txt" "$_tmp/post_status.txt" >&2 <<'PYEOF' || true
import json, sys

def statuses(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return {b["id"]: (b.get("status") or "") for b in json.load(fh)}
    except Exception:
        return {}

def status(text):
    with open(sys.argv[5], "w", encoding="utf-8") as fh:
        fh.write(text + "\n")

before = statuses(sys.argv[1])
after = statuses(sys.argv[2])
if not before:
    # No baseline to compare against, so there is nothing this check could have
    # caught and nothing to warn about. Unreachable in practice: an unreadable
    # first snapshot already took the SKIPPING branch above.
    status("VACUOUS")
    sys.exit(0)
if not after:
    status("BLIND post-pull bead list unreadable")
    sys.exit(0)
status("OK")
try:
    with open(sys.argv[3], encoding="utf-8") as fh:
        allowed = {ln.strip() for ln in fh if ln.strip()}
except Exception:
    allowed = set()

moved = []
for bid, was in sorted(before.items()):
    if bid in allowed or bid not in after:
        continue
    now = after[bid]
    if now != was:
        moved.append(bid)
        print(f"bd-gh-sync: WARNING {bid} was held out of the pull but changed "
              f"{was} -> {now}. Re-assert with "
              f"'bd update {bid} --status {was}'.")

# Read back by the summary line: a warning printed here is above the summary
# and a `tail -1` caller never sees it.
with open(sys.argv[4], "w", encoding="utf-8") as fh:
    for bid in moved:
        fh.write(bid + "\n")
PYEOF

  # A check that could not run is a finding in its own right: the operator is
  # owed the difference between "nothing moved" and "nobody looked". An empty
  # status file means the python itself never got far enough to write one.
  _blind=""
  case "$(cat "$_tmp/post_status.txt" 2>/dev/null)" in
    OK | VACUOUS) ;;
    BLIND*) _blind="the post-pull bead list was unreadable" ;;
    *) _blind="the check itself did not run" ;;
  esac
  if [ -n "$_blind" ] && [ "$_post_rc" -ne 0 ]; then
    _blind="'bd list' exited ${_post_rc}"
  fi
  if [ -n "$_blind" ]; then
    echo "bd-gh-sync: could not re-read the bead list after the pull (${_blind})." >&2
    echo "bd-gh-sync: that usually means something else holds the bd database — which" >&2
    echo "bd-gh-sync: is also what reverts a claim behind this script's back. Re-run" >&2
    echo "bd-gh-sync: 'git pull' once it is free, or check claims with 'bd list'." >&2
  fi

  # Last line, and the only line a `tail -1` caller keeps
  # (.claude/settings.json). It therefore has to report what happened rather
  # than what was intended: a failed `bd github sync` writes its own error
  # above this point, where the same tail discards it.
  #
  # The test is _pulled against _eligible, not _failed against zero. _failed is
  # only ever incremented inside the batch loop, so every way of losing beads
  # *before* the loop body runs — an id that cannot be passed, a batch list
  # that came out empty — left _failed at 0 and reported the allowlist length
  # as a success. Intent is not outcome; the gap between them is the finding.
  if [ "$_pulled" -lt "$_eligible" ]; then
    _summary="bd-gh-sync: PULL FAILED — ${_pulled} of ${_eligible} eligible bead(s) pulled"
    [ "$_failed" -gt 0 ] &&
      _summary="${_summary}; ${_failed} of ${_batches} 'bd github sync' batch(es) exited non-zero"
    [ "$_unusable" -gt 0 ] &&
      _summary="${_summary}; ${_unusable} bead id(s) unusable"
    [ "$_batches" -eq 0 ] &&
      _summary="${_summary}; no batch ran at all"
  else
    _summary="bd-gh-sync: pulled ${_pulled} bead(s)"
  fi
  _summary="${_summary}, held $(grep -c '^HOLD ' "$_tmp/plan.txt"), left $(grep -c '^ORPHAN ' "$_tmp/plan.txt") unmirrored GH issue(s) alone."
  if [ -s "$_tmp/moved.txt" ]; then
    _moved=$(wc -l <"$_tmp/moved.txt")
    _names=$(head -n 3 "$_tmp/moved.txt" | tr '\n' ' ' | sed 's/ $//;s/ /, /g')
    [ "$_moved" -gt 3 ] && _names="${_names}, +$((_moved - 3)) more"
    _summary="${_summary} WARNING: ${_moved} bead(s) held out of the pull changed anyway (${_names}); see the WARNING lines above for the command to re-assert them."
  fi
  if [ -n "$_blind" ]; then
    _summary="${_summary} WARNING: the held-bead check did not run (${_blind}); a bead reverted behind this script's back would not have been reported."
  fi
  echo "$_summary" >&2
  exit 0
fi

# push
bd list --status all --limit 0 --json >"$_tmp/beads.json" 2>/dev/null \
  || : >"$_tmp/beads.json"

python3 - "$_tmp/beads.json" >"$_tmp/new.txt" 2>/dev/null <<'PYEOF'
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        beads = json.load(fh)
except Exception:
    beads = []
for b in beads:
    if not b.get("external_ref"):
        print(b["id"])
PYEOF

if [ -s "$_tmp/new.txt" ]; then
  while IFS= read -r _ids; do
    [ -n "$_ids" ] || continue
    # shellcheck disable=SC2086 # deliberate split: one bead id per argument
    GITHUB_TOKEN="$_token" bd github push $_ids || true
  done < <(xargs -n "$_batch" <"$_tmp/new.txt")
fi

# Re-read the beads: `bd github push` assigns external_ref to everything it
# mirrors, and the close pass keys on external_ref. Reusing the pre-push
# snapshot skips exactly the beads that were closed before their first push,
# leaving the mirror it just minted open forever.
bd list --status all --limit 0 --json >"$_tmp/beads_after.json" 2>/dev/null \
  || : >"$_tmp/beads_after.json"

# Close GH mirrors for beads that are closed locally but still open on GH.
# One bulk `gh issue list` + one `gh issue close` per mismatch; skipped when
# there are none. Idempotent: closing an already-closed GH issue is a no-op.
GITHUB_TOKEN="$_token" gh issue list --state open --limit 500 --json number \
  >"$_tmp/open_gh.json" 2>/dev/null || : >"$_tmp/open_gh.json"

GITHUB_TOKEN="$_token" python3 - "$_tmp/beads_after.json" "$_tmp/open_gh.json" \
  <<'PYEOF' >/dev/null 2>&1 || true
import json, sys, re, subprocess

def load(path, fallback):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return fallback

open_nums = {i["number"] for i in load(sys.argv[2], [])}
if not open_nums:
    sys.exit(0)
beads = load(sys.argv[1], [])
pat = re.compile(r"/issues/(\d+)$")
for b in beads:
    if b.get("status") != "closed":
        continue
    m = pat.search(b.get("external_ref") or "")
    if not m:
        continue
    n = int(m.group(1))
    if n not in open_nums:
        continue
    tag = ((b.get("close_reason") or "").splitlines() or [""])[0].strip()
    if len(tag) > 300:
        tag = tag[:297] + "..."
    bid = b["id"]
    body = f"Auto-close: bead {bid} closed locally."
    if tag:
        body += f" {tag}"
    subprocess.run(
        ["gh", "issue", "close", str(n), "--comment", body],
        capture_output=True, check=False,
    )
PYEOF
exit 0
