#!/usr/bin/env bash
# Rows for .githooks/hooks-drift-tripwire, run by `just test-hooks-drift-tripwire`.
#
# $1 is the tripwire under test, so a mutation run can point these rows at a
# mutated copy. Each row builds a throwaway repository, installs that copy
# through the REAL installer, drifts core.hooksPath into one of the two observed
# shapes (bd gqlc-4thl, gqlc-pyk2), and drives a real git command.
set -uo pipefail

tripwire="${1:?usage: hooks-drift-tripwire.rows <path-to-tripwire>}"
[ -x "${tripwire}" ] || { echo "error: ${tripwire} is not executable" >&2; exit 1; }
tripwire="$(cd "$(dirname "${tripwire}")" && pwd)/$(basename "${tripwire}")"
installer="$(cd "$(dirname "$0")" && pwd)/install-hooks-drift-tripwire"

scratch="$(mktemp -d)"
trap 'rm -rf "${scratch}"' EXIT

# Isolated from the caller's own git: no global or system config, and no
# GIT_DIR / GIT_INDEX_FILE inherited from a hook that happens to be running us.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_CONFIG_PARAMETERS
export GIT_AUTHOR_NAME=rows GIT_AUTHOR_EMAIL=rows@example.invalid
export GIT_COMMITTER_NAME=rows GIT_COMMITTER_EMAIL=rows@example.invalid

fails=0
pass() { echo "ok   $1"; }
fail() {
    echo "FAIL $1: $2"
    fails=$((fails + 1))
}

# A repository whose .githooks/pre-commit records that it ran, armed with the
# tripwire exactly as `just init` arms one: the installer copies the file it
# sits beside, so a staged copy of both is installed rather than the real one.
fixture() {
    local repo="$1"
    git init -q "${repo}"
    mkdir -p "${repo}/.githooks" "${repo}/.stage"
    printf '#!/bin/sh\necho ran >>"%s/real-hook-ran"\n' "${repo}" >"${repo}/.githooks/pre-commit"
    printf '#!/bin/sh\necho ran >>"%s/real-push-ran"\n' "${repo}" >"${repo}/.githooks/pre-push"
    chmod +x "${repo}/.githooks/pre-commit" "${repo}/.githooks/pre-push"
    cp "${tripwire}" "${repo}/.stage/hooks-drift-tripwire"
    cp "${installer}" "${repo}/.stage/install-hooks-drift-tripwire"
    (cd "${repo}" && .stage/install-hooks-drift-tripwire >/dev/null 2>&1) || return 1
    rm -rf "${repo}/.stage"
    git -C "${repo}" config core.hooksPath .githooks
    echo x >"${repo}/f"
    git -C "${repo}" add f
}

hookspath() { git -C "$1" config --get core.hooksPath || true; }

drift() {
    if [ "$2" = unset ]; then
        git -C "$1" config --unset core.hooksPath
    else
        git -C "$1" config core.hooksPath "$(cd "$1/.git/hooks" && pwd)"
    fi
}

# Commit, under each drift shape: refused and repaired, then the retry lands
# through the real hook. The refusal here is held up by commit-msg as much as by
# pre-commit, because git keeps the drifted directory for the whole command; the
# pre-commit and push rows below pin each blocking arm on its own.
for shape in unset absolute; do
    repo="${scratch}/${shape}"
    fixture "${repo}" || { fail "${shape}" "fixture"; continue; }
    drift "${repo}" "${shape}"

    err="$(git -C "${repo}" commit -q -m one 2>&1 >/dev/null)"
    rc=$?
    if [ "${rc}" -eq 0 ]; then
        fail "${shape}: first commit" "landed under drift (rc 0)"
    elif ! grep -q 'REPAIRED' <<<"${err}"; then
        fail "${shape}: first commit" "refused but did not report a repair"
    else
        pass "${shape}: first commit refused and reported the repair"
    fi
    got="$(hookspath "${repo}")"
    if [ "${got}" = .githooks ]; then
        pass "${shape}: core.hooksPath repaired"
    else
        fail "${shape}: core.hooksPath repaired" "reads '${got}'"
    fi
    if [ -e "${repo}/real-hook-ran" ]; then
        fail "${shape}: real hook" "ran during the refused command"
    else
        pass "${shape}: real hook did not run during the refused command"
    fi

    if git -C "${repo}" commit -q -m one >/dev/null 2>&1 && [ -s "${repo}/real-hook-ran" ]; then
        pass "${shape}: retry lands through the real hook"
    else
        fail "${shape}: retry" "did not land through .githooks/pre-commit"
    fi
done

# pre-commit run on its own under drift: it refuses as well as repairing, so a
# commit's refusal does not rest on commit-msg alone.
for shape in unset absolute; do
    repo="${scratch}/pc-${shape}"
    fixture "${repo}" || { fail "pre-commit ${shape}" "fixture"; continue; }
    drift "${repo}" "${shape}"
    if (cd "${repo}" && .git/hooks/pre-commit >/dev/null 2>&1); then
        fail "pre-commit ${shape}" "exited 0 under drift"
    else
        pass "pre-commit ${shape}: refuses when run under drift"
    fi
    got="$(hookspath "${repo}")"
    if [ "${got}" = .githooks ]; then
        pass "pre-commit ${shape}: repaired"
    else
        fail "pre-commit ${shape}" "reads '${got}'"
    fi
done

# Push, under each drift shape, to a bare remote: refused with nothing landed,
# repaired, and the retry runs the real pre-push. A tripwire that let the
# repaired command continue would publish a push no real pre-push graded.
for shape in unset absolute; do
    repo="${scratch}/push-${shape}"
    remote="${scratch}/push-${shape}.git"
    fixture "${repo}" || { fail "push ${shape}" "fixture"; continue; }
    git -C "${repo}" commit -q -m base >/dev/null 2>&1
    git init -q --bare "${remote}"
    git -C "${repo}" remote add origin "${remote}"
    drift "${repo}" "${shape}"
    if git -C "${repo}" push -q origin HEAD:refs/heads/main >/dev/null 2>&1; then
        fail "push ${shape}" "push exited 0 under drift"
    else
        pass "push ${shape}: refused under drift"
    fi
    if git -C "${remote}" rev-parse -q --verify refs/heads/main >/dev/null; then
        fail "push ${shape}" "the ref landed on the remote"
    else
        pass "push ${shape}: nothing landed on the remote"
    fi
    got="$(hookspath "${repo}")"
    if [ "${got}" = .githooks ]; then
        pass "push ${shape}: repaired"
    else
        fail "push ${shape}" "reads '${got}'"
    fi
    if git -C "${repo}" push -q origin HEAD:refs/heads/main >/dev/null 2>&1 && [ -s "${repo}/real-push-ran" ]; then
        pass "push ${shape}: retry lands through the real pre-push"
    else
        fail "push ${shape}" "retry did not land through .githooks/pre-push"
    fi
done

# A write that fails must not be reported as a repair. config.lock held makes
# `git config` refuse.
repo="${scratch}/locked"
fixture "${repo}"
git -C "${repo}" config --unset core.hooksPath
: >"${repo}/.git/config.lock"
err="$(cd "${repo}" && .git/hooks/pre-commit 2>&1 >/dev/null)"
rm -f "${repo}/.git/config.lock"
if grep -q 'REPAIRED' <<<"${err}"; then
    fail "locked config" "reported REPAIRED over a write that failed"
else
    pass "locked config: no repair claimed when the write fails"
fi
if grep -q 'just init' <<<"${err}"; then
    pass "locked config: names just init instead"
else
    fail "locked config" "did not name the manual repair"
fi

# R3: post-checkout fires inside `git worktree add`, the spawn's own step, and
# must neither block nor repair.
repo="${scratch}/checkout"
fixture "${repo}" && git -C "${repo}" commit -q -m base >/dev/null 2>&1
git -C "${repo}" config --unset core.hooksPath
if git -C "${repo}" worktree add -q "${scratch}/checkout-wt" >/dev/null 2>&1; then
    pass "post-checkout: worktree add succeeds under drift"
else
    fail "post-checkout" "worktree add failed under drift"
fi
got="$(hookspath "${repo}")"
if [ -z "${got}" ]; then
    pass "post-checkout: left core.hooksPath alone"
else
    fail "post-checkout" "wrote core.hooksPath = '${got}'"
fi

# R4: post-merge cannot block, but does repair.
repo="${scratch}/merge"
fixture "${repo}" && git -C "${repo}" commit -q -m base >/dev/null 2>&1
git -C "${repo}" config --unset core.hooksPath
if (cd "${repo}" && .git/hooks/post-merge 0 >/dev/null 2>&1); then
    pass "post-merge: exits 0 under drift"
else
    fail "post-merge" "exited non-zero"
fi
got="$(hookspath "${repo}")"
if [ "${got}" = .githooks ]; then
    pass "post-merge: repaired core.hooksPath"
else
    fail "post-merge" "reads '${got}'"
fi

# R5: check-hooks' behavioural probe runs the installed copies directly under a
# HEALTHY value and needs the blocking ones to refuse. A copy that delegated or
# exited 0 there would certify a disarmed tripwire.
repo="${scratch}/healthy"
fixture "${repo}"
for name in pre-commit commit-msg pre-push; do
    if (cd "${repo}" && ".git/hooks/${name}" >/dev/null 2>&1); then
        fail "healthy: ${name}" "exited 0 when run directly"
    else
        pass "healthy: ${name} refuses when run directly"
    fi
done
got="$(hookspath "${repo}")"
if [ "${got}" = .githooks ]; then
    pass "healthy: value untouched"
else
    fail "healthy" "value now '${got}'"
fi

# R6: a third directory is not this tripwire's shape and is not rewritten.
repo="${scratch}/third"
fixture "${repo}"
mkdir -p "${repo}/elsewhere"
git -C "${repo}" config core.hooksPath "${repo}/elsewhere"
(cd "${repo}" && .git/hooks/pre-commit >/dev/null 2>&1)
got="$(hookspath "${repo}")"
if [ "${got}" = "${repo}/elsewhere" ]; then
    pass "third directory: value untouched"
else
    fail "third directory" "value now '${got}'"
fi

if [ "${fails}" -ne 0 ]; then
    echo "${fails} row(s) failed" >&2
    exit 1
fi
