#!/usr/bin/env bash
# Post-merge hook: pull GH issue state into bd so bd reflects human-side
# actions taken in the GH UI (closes, comments) for beads GitHub can represent.
# An issue with no bead is reported, not adopted — see bd-gh-sync.
# Activated by: git config core.hooksPath .githooks
# (run `just init` after cloning)
# Non-blocking — never fail the underlying `git pull`. Progress chatter is
# dropped, but stderr survives: a pull that declines to sync, or holds a bead
# back, has to be able to say so. Discarding it is what let a fail-open guard
# revert claimed beads on every merge without anyone seeing a line about it.
"$(dirname "$0")/bd-gh-sync" pull >/dev/null
exit 0
