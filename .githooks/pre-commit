#!/usr/bin/env bash
# Pre-commit hook: block direct commits to master/main, then gate formatting.
# Budget: sub-second — tests and full lint belong to pre-push and CI.
# Activated by: git config core.hooksPath .githooks
# (run `just init` after cloning)

# NOT what closes the gqlc-zxh4 hole, despite that bead's title: deleting this
# line leaves the suite green at 82/0, because the branch arms below handle
# their own failure inside `if` conditions, where -e is suspended. Kept for
# consistency with commit-msg, pre-push and the guard hooks, and for whatever
# is added below it later.
set -euo pipefail

# Allow test harness to override the branch name for testing
#
# Two commands, because neither answers in every state. Measured on git 2.55.0:
#
#   unborn HEAD on master   rev-parse rc=128 "HEAD"   symbolic-ref rc=0 "master"
#   detached HEAD           rev-parse rc=0   "HEAD"   symbolic-ref rc=128
#   outside a repository    rev-parse rc=128 ""       symbolic-ref rc=128
#
# Their order is not load-bearing — a failure falls through to the other either
# way — but both are needed. Drop symbolic-ref and the first commit into a fresh
# repository on master is not recognised as master; drop rev-parse and a
# detached HEAD resolves to nothing, so commits during a rebase are refused.
#
# The refusal arm is the fix for bd gqlc-zxh4. There was no refusal arm before:
# a failed rev-parse left BRANCH holding "HEAD" or "", neither of which is
# "master" or "main", so the guard below fell through and the commit proceeded.
if [ -n "${BRANCH_OVERRIDE:-}" ]; then
  BRANCH="$BRANCH_OVERRIDE"
elif ! BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null)" \
  && ! BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"; then
  echo "ERROR: could not determine the current branch, so the master/main commit guard did not run." >&2
  echo "       Refusing the commit rather than skipping the guard." >&2
  exit 1
fi

if [ "$BRANCH" = "master" ] || [ "$BRANCH" = "main" ]; then
  echo "ERROR: Direct commits to $BRANCH are blocked." >&2
  echo "Create a feature branch with: git switch -c <branch>" >&2
  exit 1
fi

# owning_module prints the NESTED module root a directory belongs to, and
# nothing at all when it belongs to the repository's own root module.
#
# The walk stops before `.`, so the root go.mod is never a hand-off: a
# directory reaching the top without meeting a go.mod is root-module, which is
# the common case and the one that must stay cheap. A `go.mod` in the directory
# itself counts — that is exactly test/data/codegen — and the nearest one wins,
# which is the same rule the go command applies.
#
# Pure path walking rather than `go list -m` or internal/tools/modscope: this
# runs on every commit and a `go run` costs a compile, where this costs a few
# stats. It agrees with them on what a module root is because a go.mod IS the
# definition.
owning_module() {
  local dir="$1"
  while [ "$dir" != "." ] && [ "$dir" != "/" ]; do
    if [ -f "$dir/go.mod" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 0
}

# Function-complexity gate (gocyclo + gocognit), scoped to the packages this
# commit touches. Called from the provisioning-success arm below, so it shares
# the one decision about whether the pinned linter is usable.
#
# ONE SOURCE WITH CI, and the sharing is the thresholds rather than the
# invocation: both linters sit in `.golangci.yml`'s enable list, so the
# merge-blocking `lint` job already runs them, and `just complexity` selects
# those two with `--enable-only` while still reading their min-complexity from
# that same file. `--enable-only` and not `--default none --enable`, which was
# measured NOT restricting anything — `--enable` adds to the config's list, so
# that spelling runs all 28 linters. There is no threshold written here, and
# none in ci.yml, so the hook cannot go soft while CI stays strict. What that
# buys is the round trip: a function over the line is refused at `git commit`
# instead of eight minutes into CI.
#
# WHY SCOPED, when the format check below is deliberately repo-wide: the full
# `golangci-lint run` is ~76 s warm over this tree (measured 2026-09-10), which
# a pre-commit hook cannot spend. Restricting to changed packages is exact
# rather than a sampling compromise — gocyclo and gocognit score a function from
# its own AST alone, so no edit can change the score of a function in a package
# it did not touch. A whole-tree run would re-measure ~1900 functions to find
# the same answer.
#
# `R` is in the diff-filter because rename detection is on by default, so a
# `git mv` reports as R and NOT as one of ACM. Without it, moving an
# over-complex file into a fresh package listed nothing and the gate exited 0
# in silence (measured 2026-09-10). `--name-only` reports the DESTINATION path
# for a rename, which is the package that needs measuring.
#
# It reads the WORKTREE, not the staged content, exactly as the format check
# below does. A partially staged file is therefore judged by what is on disk. The
# gate that cannot be sidestepped that way is CI's; this one is here to catch the
# ordinary case early, and `git commit --no-verify` is a shorter path anyway for
# anyone actually trying to get around it.
#
# NESTED MODULES ARE HANDED OFF, not skipped. `just complexity` runs the pinned
# linter from the repo root, and a root-module run cannot load a package in
# another module: golangci-lint reports `typechecking error: main module does
# not contain package ...` and exits 7 having found nothing. Passing such a
# directory therefore turns every commit that touches it into a hard failure
# with an empty report — measured 2026-09-10 against ./test/data/codegen, the
# first commit to stage a nested-module .go file since the gate landed the same
# day in #2756. The local gate regains parity in bd gqlc-i8j9, which is where
# the partition below is deleted again.
#
# Handing off rather than skipping, because `just test-codegen-fence` runs the
# FULL `.golangci.yml` from INSIDE each nested module (justfile ~:2567, and the
# upward config walk that makes it the same thresholds is recorded at ~:2440).
# gocyclo and gocognit are in that config's enable list, so those packages are
# graded by a required CI context, and what is lost here is the round trip on
# them rather than the grade. The handoff is PRINTED on every commit that has
# one: a scope this narrow is only honest if the narrowing is visible, and a
# gate that silently drops a directory is the shape bd gqlc-jq50 was about.
complexity_gate() {
  local complexity_dirs=() handed_off=() staged_go staged_dir complexity_out

  while IFS= read -r -d '' staged_go; do
    staged_dir="$(dirname "$staged_go")"
    # A file staged as added and then removed from the worktree leaves a
    # directory golangci-lint would refuse to load; skip rather than fail.
    [ -d "$staged_dir" ] || continue
    if [ -n "$(owning_module "$staged_dir")" ]; then
      handed_off+=("./$staged_dir")
      continue
    fi
    complexity_dirs+=("./$staged_dir")
  done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.go')

  if [ ${#handed_off[@]} -gt 0 ]; then
    readarray -t handed_off < <(printf '%s\n' "${handed_off[@]}" | sort -u)
    echo "NOTE: complexity gate skipped $(printf '%s ' "${handed_off[@]}")— each is in a nested" >&2
    echo "      module a root-module golangci-lint run cannot load. gocyclo/gocognit still" >&2
    echo "      grade them, from inside their own module: just test-codegen-fence." >&2
  fi

  [ ${#complexity_dirs[@]} -gt 0 ] || return 0

  # One package may own several staged files; lint it once.
  readarray -t complexity_dirs < <(printf '%s\n' "${complexity_dirs[@]}" | sort -u)
  if ! complexity_out="$(just complexity "${complexity_dirs[@]}" 2>&1)"; then
    echo "ERROR: function complexity over the gate in a package this commit touches." >&2
    echo "$complexity_out" >&2
    echo >&2
    echo "       Thresholds live in .golangci.yml (gocyclo, gocognit); CI enforces the same two." >&2
    echo "       Extract a helper — do not raise the threshold to land a change (see bd gqlc-5sfv)." >&2
    return 1
  fi
}

# Formatting gate (gofumpt + gci via the pinned golangci-lint). Repo-wide on
# purpose: simpler than staged-file plumbing, and `just fmt` fixes everything
# it complains about. ensure-golangci self-heals the pinned binary in .bin/
# (~30ms and no download when .bin/ already holds the pinned version).
#
# A provisioning failure BLOCKS the commit. Until bd gqlc-l45j this arm warned
# and continued, justified by the claim that a download only becomes impossible
# when you are offline. That is false, and was falsified here: on 2026-08-17
# GitHub returned HTTP 429 on the golangci-lint download while this repo had ~8
# PRs running CI, on a healthy network, and every commit in that window skipped
# the format check behind a WARN on stderr. Causes seen or reachable: no
# network; HTTP 429 or another rate limit from raw.githubusercontent.com or the
# release CDN; a proxy or firewall that blocks either host; a version bump
# pointing at a release that is not published yet; a corrupt or unwritable
# .bin/. That list is open by construction, which is the reason for blocking —
# an unenumerated cause must not be able to silently retire the gate.
#
# Escape hatch for a genuine outage: GQLC_ALLOW_MISSING_LINTER=1 skips the
# format check and says so. It is narrower than `git commit --no-verify`, which
# also drops the master-branch guard above and the AI-attribution guard in
# commit-msg. Note the download is only reached on a fresh worktree or after a
# version bump, so an offline developer with a warm .bin/ never sees this arm.
#
# BOTH LINTER-BACKED GATES HANG OFF THIS ONE PROVISIONING DECISION — the format
# check and complexity_gate above. The variable is read here and nowhere else,
# so it cannot retire the complexity gate while the linter is sitting healthy in
# .bin/, and the skip it does grant names both checks on stderr rather than
# dropping one of them in silence.
if just ensure-golangci >/dev/null 2>&1; then
  if ! just fmt-check >/dev/null 2>&1; then
    echo "ERROR: unformatted Go files. Run: just fmt" >&2
    exit 1
  fi
  complexity_gate || exit 1
elif [ "${GQLC_ALLOW_MISSING_LINTER:-}" = "1" ]; then
  echo "WARN: golangci-lint unavailable; format AND complexity checks SKIPPED by GQLC_ALLOW_MISSING_LINTER=1" >&2
else
  echo "ERROR: could not provision golangci-lint, so the format and complexity checks did not run." >&2
  echo "       Diagnose with: just ensure-golangci" >&2
  echo "       Commit anyway (skips both checks): GQLC_ALLOW_MISSING_LINTER=1 git commit ..." >&2
  exit 1
fi

exit 0
