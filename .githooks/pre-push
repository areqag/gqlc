#!/usr/bin/env bash
# Pre-push hook: run the full test suite (<1s — the TCK is vendored, no
# network), lint only the lines that differ from origin/master, and fence the
# nested modules. The full repo-wide lint is CI's job; this catches what the
# push is about to break. Of the seven required contexts it mirrors five —
# test, codegen-fence, actionlint, lint only in its --new-from-rev form and
# tidy only in its go.mod half; govulncheck and live-smoke still run nowhere
# but CI. bd gqlc-n54t named the gap; bd gqlc-wn4ns measured the four
# candidates and the two additions and two refusals are argued where each
# stands, below.
# Activated by: git config core.hooksPath .githooks
# (run `just init` after cloning)
set -euo pipefail

# FIRST, ahead of everything slow: a push that would land on master has to be
# refused before the suite runs, and the refusal has to be the last line on the
# terminal rather than a page above the tail of the test output. bd gqlc-tfh1 —
# see the header of guard-push-destination for what routes a feature branch onto
# master. gate-pushed-commits runs here for the same reason.
#
# git hands the hook's stdin — the push's ref list — exactly once, and there are
# now two consumers, so it is captured and replayed to each. Command substitution
# strips trailing newlines, which the replay restores; on an empty capture, which
# is git's "nothing to push", it replays nothing rather than a bare newline (a
# delete-only push still presents one line per deleted ref — bd gqlc-no9x).
# `set -o pipefail` above is what makes each pipeline report the consumer's
# status rather than the replay's.
_push_refs="$(cat)"
_replay_push_refs() {
  if [ -n "${_push_refs}" ]; then printf '%s\n' "${_push_refs}"; fi
}

# The ref lines that publish content. A delete spells its local side `(delete)`
# with an all-zero sha and publishes nothing, so the tree-reading gates below
# have nothing to grade on those refs — and grading the working tree instead is
# what made a branch undeletable whenever the local tree was red (bd gqlc-no9x).
# A line that parses as neither is kept: an unknown shape must run the gates
# rather than skip them. A mixed push keeps its updates, so this is a per-ref
# partition, not a whole-push early return.
_push_updates=""
if [ -n "${_push_refs}" ]; then
  while IFS= read -r _pp_line; do
    [ -n "${_pp_line}" ] || continue
    _pp_local_ref="" _pp_local_sha=""
    read -r _pp_local_ref _pp_local_sha _pp_discard <<<"${_pp_line}" || true
    if [ "${_pp_local_ref}" = "(delete)" ]; then continue; fi
    case "${_pp_local_sha}" in
      "" | *[!0]*) _push_updates="${_push_updates:+${_push_updates}$'\n'}${_pp_line}" ;;
    esac
  done <<<"${_push_refs}"
fi

# What the closing notice is entitled to claim. Each gate below appends its name
# once it has PASSED, and push-transport-notice prints the accumulation.
#
# COLLECTED, never restated as a sentence down there. A hardcoded coverage line
# is the same silent drift this repository has already measured one level down:
# with one, deleting the test-codegen-fence arm left `just gates` green and still
# claiming to cover codegen-fence (bd gqlc-jq50, and the argument is in the
# `gates` comment in the justfile). A list assembled here cannot outlive the arm
# that fills it — including on the GQLC_ALLOW_MISSING_LINTER path, where two of
# the three drop out and a fixed list would name them anyway.
_local_gates=""
_ran_gate() { _local_gates="${_local_gates:+${_local_gates}, }$1"; }

_replay_push_refs | "$(dirname "$0")/guard-push-destination" "$@"

# Re-screens every commit this push would publish against .githooks/commit-msg.
# commit-msg is a one-shot per-commit gate and core.hooksPath drift disarms it
# silently; this is what covers the commits made inside a drift window that has
# since closed. Its own header argues the position and states its limits.
#
# Guarded on a non-empty ref list rather than called unconditionally: an empty
# stdin is git's "nothing to push", which publishes no commit and so has nothing
# to screen. Skipping there is not a hole — the gate's own loop would iterate
# zero times — and it keeps a hook sandbox that feeds an empty ref list from
# having to own a copy of every sibling this file grows.
if [ -n "${_push_refs}" ]; then
  _replay_push_refs | "$(dirname "$0")/gate-pushed-commits" "$@"
fi

# Wrapped so that a suite which damages the repository it runs in gets SAID —
# on 2026-08-22 a test suite flipped core.bare on the shared config, force-moved
# another worktree's branch, and left a fixture identity in user.email, all
# found by hand days later (bd gqlc-ed2u, gqlc-lekg). The guard shipped in #1225
# and nothing called it until this line (bd gqlc-06y9).
#
# ADVISORY OR STRICT IS THE GUARD'S OWN CALL, not this line's. It was pinned
# advisory here (gqlc-06y9) because the sibling worktrees this repository is
# worked from are linked worktrees of ONE repository: a neighbour committing in
# their own tree during this window moves refs the guard watches and is
# indistinguishable from damage by this run — measured, on this hook, against
# three other worktrees. A standalone clone has no such neighbour, so no single
# pinned verdict fits both shapes. Hence the guard derives it per repository:
# sharers -> report, sole worktree -> refuse. Pinned here, a checkout that
# changed shape would keep the old verdict forever.
#
# Only the purity verdict is at stake; `just test`'s own exit code is passed
# through and still blocks the push. Deliberately not `|| true` here — that could
# not tell a purity complaint from a failing suite, and would disarm the suite.
# Skipped on a delete-only push: nothing is published, so there is nothing to
# grade, and the suite would read the working tree instead (bd gqlc-no9x). The
# destination guard above still saw the full ref list, so deleting master is
# refused there; the commit screen and the bead advisory skip delete lines on
# their own. The lint arm below carries the same skip; the notice is printed
# once, here.
if [ -n "${_push_refs}" ] && [ -z "${_push_updates}" ]; then
  echo "pre-push: delete-only push — nothing published, skipping test/lint gates." >&2
else
  "$(dirname "$0")/repo-purity" just test
  # `set -e` is what makes this line a record of a PASS rather than of an attempt:
  # a failing suite exits above and never reaches it. Same at each _ran_gate below.
  _ran_gate test
fi

# ensure-golangci self-heals the pinned binary in .bin/; a provisioning failure
# BLOCKS the push. Until bd gqlc-l45j this arm warned and continued, justified
# by the claim that a download only becomes impossible when you are offline.
# Falsified on 2026-08-17: GitHub returned HTTP 429 on the golangci-lint
# download under this repo's own CI concurrency, on a healthy network, and the
# lint was skipped silently. Causes seen or reachable: no network; HTTP 429 or
# another rate limit from raw.githubusercontent.com or the release CDN; a proxy
# or firewall blocking either host; a pinned version whose release is not
# published; a corrupt or unwritable .bin/. The list is open, which is why an
# unrecognised cause blocks instead of passing.
#
# GQLC_ALLOW_MISSING_LINTER=1 skips the lint and says so — narrower than
# `git push --no-verify`, which drops the test run above with it. The download
# is only reached on a fresh worktree or after a version bump, so an offline
# developer with a warm .bin/ never reaches this arm.
#
# Every cause listed above is a PROVISIONING cause, and for a long time that
# reading was the whole of this arm: the linter was either there or it was not.
# It has a third state (bd gqlc-m9ca): provisioned perfectly — same pinned
# version, same checksum, ensure-golangci exits 0 — and then failing having
# graded nothing. The hatch below is unreachable there, because the hatch is
# guarded by provisioning having FAILED, so anyone who hits it has no move
# left that is not `git push --no-verify`.
#
# The instance that surfaced it is CLOSED and is not what keeps this arm here.
# v2.12.2 was built against go1.26 and could not read the stdlib of this
# machine's default go1.27.0-X, so it emitted typecheck diagnostics about
# /usr/lib/go/src and exited 1; #1071 bumped the pin to v2.13.1, built against
# go1.27.0, and `just lint-new` at master is green under that default again —
# measured 2026-08-22. What recurs is the shape, and it reaches this arm from
# more than the toolchain: `--config` on a file it will not load exits 3, also
# measured 2026-08-22 on v2.13.1.
#
# The hatch is not widened to cover any of it, deliberately. golangci-lint
# exits 1 both for "I found issues" and for those typecheck diagnostics, so a
# hatch opening on that failure would open on every real finding in the repo.
# What is missing is not a way past the gate but a way to make the gate RUN.
#
# So the classification below decides only WHAT IS PRINTED. Every branch exits
# non-zero. A misread failure costs a wrong sentence and cannot cost a skipped
# gate, which is the property that made this shape preferable to routing one
# class to the hatch.
# The lint arm carries the same delete-only skip as the suite above: its gates
# read the working tree, which a delete does not publish (bd gqlc-no9x).
if [ -n "${_push_refs}" ] && [ -z "${_push_updates}" ]; then
  :
else
if just ensure-golangci >/dev/null 2>&1; then
  lint_log="$(mktemp)"
  trap 'rm -f "${lint_log}"' EXIT
  # THE BOUNDED WAIT ON A NEIGHBOUR'S LINT LOCK IS NO LONGER HERE. It moved
  # into .githooks/lint-lock.sh, which the `lint`, `lint-new`,
  # `check-golangci-formatters-report` and `test-codegen-fence` recipes all run
  # their `golangci-lint run` under, so this hook now INHERITS it by calling
  # those recipes (bd gqlc-49pc). Read that script for the lock's mechanics and
  # for why the retry is narrowed to the lock's own sentence AND an exit code
  # that is not 1.
  #
  # It had to move rather than be copied. A hand-run `just lint` is the FIRST
  # place anyone meets the lock — CLAUDE.md's session-completion workflow puts
  # the quality gates before the push — and the hook was the second, so the
  # only path with the fix was the one you reach after the path without it has
  # already told you your branch is broken.
  #
  # It also had to move rather than be duplicated HERE AND THERE: a wait in
  # both places would nest, and the default budget would be squared. At the
  # thirty retries lint-lock.sh derives today that is thirty of thirty, which is
  # hours of a hook that looks hung (bd gqlc-6ypo).
  #
  # What remains is the plain run. Sets ${lint_rc}; the run's merged output is
  # in ${lint_log}. It returns 0 on every path, lock exhaustion included: the
  # verdict is ${lint_rc}, and each caller decides what its own failure means.
  #
  # tee, not capture-then-echo: these recipes stream, and a developer watching a
  # slow lint should not be given a blank terminal so that this hook can grep
  # the output afterwards. `set -o pipefail` at the top is what makes this read
  # the recipe's status rather than tee's.
  run_under_lint_lock() {
    local recipe="$1"
    lint_rc=0
    just "${recipe}" 2>&1 | tee "${lint_log}" || lint_rc=$?
    return 0
  }

  run_under_lint_lock lint-new
  if [ "${lint_rc}" -ne 0 ]; then
    # TWO TELLS, because the same cause has two presentations. Both were
    # produced on this repo on 2026-08-22 by the same command, minutes apart,
    # differing only in build-cache state — so a hook that knew one of them
    # would go quiet exactly half the time.
    #
    # 1. EXIT CODE. `golangci-lint run --help` gives `--issues-exit-code int
    #    (default 1)`, and neither the justfile nor .golangci.yml overrides it.
    #    So 1 is the ONLY code that means "I graded the code and found issues";
    #    every other non-zero code is the linter failing. The panic shape exits
    #    2, which is why the code alone settles that presentation.
    # 2. OUT-OF-REPO TYPECHECK DIAGNOSTICS, for the presentation that exits 1
    #    and so is indistinguishable by code from a real finding. golangci-lint
    #    prints repo-relative paths for its own findings, so a leading `/` or
    #    `../` means it is complaining about the toolchain's sources rather than
    #    about the push. The `* typecheck: N` summary line is NOT usable on its
    #    own: a tree that genuinely does not compile reports typecheck too,
    #    in-repo, and that one must keep reading as a finding.
    #
    # The lock exhaustion above is excluded here even though it exits 3: it has
    # already said what happened, and this block's remedy is GOTOOLCHAIN, which
    # cannot move a lock. Two diagnoses for one failure, the second of them
    # wrong, is worse than one.
    if { [ "${lint_rc}" -ne 1 ] \
      || grep -qE '^(/|\.\./)[^:]*:[0-9]+:[0-9]+:.*\(typecheck\)$' "${lint_log}"; } \
      && ! grep -qF 'parallel golangci-lint is running' "${lint_log}"; then
      want_go="$(awk '$1 == "go" { print $2; exit }' go.mod 2>/dev/null || true)"
      if [ -n "${want_go}" ]; then
        remedy="GOTOOLCHAIN=go${want_go} git push ..."
      else
        remedy="GOTOOLCHAIN=<a released toolchain> git push ..."
      fi
      echo "ERROR: golangci-lint ran but could not form an opinion on this repo." >&2
      echo "       Nothing here graded your changes, so the push is refused unverified." >&2
      # The two branches differ in what they are ENTITLED to claim, which is why
      # the remedy is printed inside them rather than once below. The typecheck
      # branch has read the diagnostics and knows the toolchain is the cause, so
      # it prescribes. The exit-code branch knows only that the run was not a
      # verdict: the code says nothing about why, and the causes do not share a
      # fix. A config the linter will not load exits 3 — measured on the pinned
      # v2.13.1, 2026-08-22 — and no GOTOOLCHAIN moves it. So this branch offers
      # the toolchain remedy conditioned on what the output above shows instead
      # of asserting it, because a confident wrong diagnosis of a real failure
      # costs more than an unhelpful one.
      if [ "${lint_rc}" -ne 1 ]; then
        echo "       It exited ${lint_rc}; its --issues-exit-code is 1, so this is not a" >&2
        echo "       findings verdict — the linter failed rather than graded." >&2
        echo "       WHY it failed is in its own output above; the exit code does not say." >&2
        echo "       If that output shows it could not read the Go toolchain, this makes" >&2
        echo "       the gate run for real:  ${remedy}" >&2
        echo "       If it shows something else, GOTOOLCHAIN will not move it." >&2
      else
        echo "       Every diagnostic above is a typecheck error against a file OUTSIDE" >&2
        echo "       this repository: the linter could not read the standard library of" >&2
        echo "       the Go toolchain it was handed." >&2
        echo "       Re-run the push under the toolchain go.mod names, which makes the" >&2
        echo "       gate actually run:  ${remedy}" >&2
      fi
      echo "       This machine's default toolchain: $(go env GOVERSION 2>/dev/null || echo unknown)" >&2
      echo "       GQLC_ALLOW_MISSING_LINTER does not apply: the linter is present, and" >&2
      echo "       one of these two presentations shares its exit code with a real" >&2
      echo "       finding (bd gqlc-m9ca)." >&2
    fi
    exit "${lint_rc}"
  fi
  # Qualified, because `lint-new` is `--new-from-rev` only and the required
  # context is not. A finding on a line this push did not touch is CI's to find,
  # so a bare `lint` here would be the overclaim in miniature.
  _ran_gate "lint (changed lines only)"

  # THE NESTED MODULES, which nothing above this line reads. `just test` is
  # `go build ./... && go test ./...` and `just lint-new` is a golangci run:
  # all three stop at the root module, and test/data/codegen is a module of its
  # own. Until this call, CI's codegen-fence — one of the seven required
  # contexts — had no local counterpart at all, so it was discovered the only
  # way a gate with no local counterpart can be: by pushing and waiting. On PR
  # #1633 fmt-check, lint and test were green, this hook printed "every gate
  # PASSED", and codegen-fence then reddened on two ireturn findings that had
  # been in the tree throughout (bd gqlc-s9bx).
  #
  # The whole recipe, not just its golangci run: the fenced module's build, vet
  # and `go mod tidy -diff` are unreached by the root gates for the same reason
  # its lint is, and CI runs the recipe entire. Measured warm on 2026-08-29 at
  # 2.1s, which is what makes running it unconditionally the cheaper answer than
  # deciding from the diff which pushes could redden it — that set is the module
  # plus .golangci.yml plus internal/tools/modscope plus the recipe itself, and
  # a conditional gate that omits is silent about having omitted.
  #
  # After lint-new rather than before it, and under the same wait: golangci-lint
  # holds one lock per machine, so these two cannot overlap, and a fence that
  # lost a race with a neighbour would refuse the push for a reason that is not
  # this branch's.
  run_under_lint_lock test-codegen-fence
  if [ "${lint_rc}" -ne 0 ]; then
    echo "ERROR: the nested-module fence failed, so CI's codegen-fence would redden." >&2
    echo "       That is a required context, and this is the only local gate that reads" >&2
    echo "       a module other than the root one — 'just test', 'just lint' and" >&2
    echo "       'just lint-new' all stop at the repository root (bd gqlc-s9bx)." >&2
    echo "       The findings are above. Re-run on their own with:  just test-codegen-fence" >&2
    exit "${lint_rc}"
  fi
  _ran_gate codegen-fence
elif [ "${GQLC_ALLOW_MISSING_LINTER:-}" = "1" ]; then
  echo "WARN: golangci-lint unavailable; lint and the nested-module fence SKIPPED by" >&2
  echo "      GQLC_ALLOW_MISSING_LINTER=1" >&2
else
  echo "ERROR: could not provision golangci-lint, so neither lint-new nor" >&2
  echo "       test-codegen-fence ran." >&2
  echo "       Diagnose with: just ensure-golangci" >&2
  echo "       Push anyway (skips the lint): GQLC_ALLOW_MISSING_LINTER=1 git push ..." >&2
  exit 1
fi
fi

# TWO MORE OF THE FOUR CONTEXTS THAT RAN NOWHERE BUT CI. bd gqlc-n54t left the
# four unpriced on purpose; bd gqlc-wn4ns priced them on this machine and
# against this repository's CI history, and they did not come out the same way.
# Every number below was measured 2026-09-11 — seconds on this box, catches over
# the 144 FAILED ci.yml runs between 2026-07-11 and 2026-09-10 read step by step
# from the Actions API, so a `tidy` failure is attributed to the step inside it
# that actually failed rather than to the job:
#
#   check         cold     warm        offline      caught         verdict
#   tidy-check    0.034s   0.03-0.05s  0.045s ok    0 in 2 months  ADD, blocking
#   actionlint    1.70s    1.51-1.56s  rc=1, 0.03s  1 in 2 months  ADD, advisory
#   govulncheck   12.5s    16.5-18.2s  rc=1, 2.0s   17, none local REFUSED
#   live-smoke    needs Docker, ~30s (bd gqlc-tez0)                REFUSED
#
# THE TWO REFUSALS, because a bead that only records what was added gets the
# same question asked again next quarter:
#
#   govulncheck is the expensive one and it does not get cheaper on a second
#   run — it re-reads the advisory database over the network every time, which
#   is also why it is the only candidate here whose verdict can change without
#   the tree changing. That is what disqualifies it rather than the seconds: of
#   its 17 CI failures, 7 fell on 2026-08-17 across 7 unrelated branches inside
#   ten hours, and the rest cluster the same way by date. A red shared by every
#   branch at once is an advisory arriving, not something the push did, so a
#   local arm could not have pre-empted one of them — it would have reported
#   the same red a few minutes earlier, for 12-18s on every push by every agent.
#   The recipe's own header says the same thing from the other side: a red that
#   clears on a re-run has been a real called vulnerability arriving mid-scan.
#
#   live-smoke needs Docker, which this fleet's machine does not always have,
#   and ~30s when it does. Unchanged from bd gqlc-n54t's reading.
#
# `just gates` still runs all four, and that is the point of the split rather
# than a duplication: gates is what an agent runs deliberately before opening a
# PR, this is the backstop for the push where nobody did.
#
# Same delete-only skip as the two blocks above: both arms read the working
# tree, which a delete does not publish (bd gqlc-no9x).
if [ -n "${_push_refs}" ] && [ -z "${_push_updates}" ]; then
  :
else
  # BLOCKING, and the case for it is the absence of cost rather than the
  # presence of evidence. `go mod tidy -diff` reads the tree and the module
  # cache and issues no request — 0.045s with the network denied via `unshare
  # -rn`, indistinguishable from its 0.03-0.05s online — so it is the only
  # candidate here with no flake surface at all and nothing to misattribute: it
  # cannot fail for a reason that is not go.mod's. It has also caught nothing.
  # 0 of the 144 failed ci.yml runs in two months failed on this step, which is
  # unsurprising at go.mod/go.sum's rate of change (5 commits in the last 1000,
  # 0 in the last 400). Both halves of that are why it blocks: a gate this cheap
  # does not need to earn its place, and one that never fires cannot cost a
  # false refusal.
  #
  # QUALIFIED in the notice, because CI's `tidy` context is ten steps and this
  # is one of them. Three of the other nine cannot run here at all — they read
  # a PR body, a PR's commit list and the Actions API, none of which exist
  # before the push. An unqualified "tidy" here would be the overclaim bd
  # gqlc-n54t was filed about, one context further on.
  if ! just tidy-check; then
    echo "ERROR: go.mod or go.sum is not tidy, so CI's tidy context would redden." >&2
    echo "       Fix with:  go mod tidy" >&2
    exit 1
  fi
  _ran_gate "tidy (go.mod only)"

  # ADVISORY, NEVER BLOCKING, and that follows from what it NEEDS rather than
  # from what it finds. Two things it needs are outside this machine:
  #   - `go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.7` resolves
  #     through proxy.golang.org on every invocation, even with that exact
  #     version already unpacked in the local module cache. Measured under
  #     `unshare -rn`: exit 1 in 0.03s on `dial tcp: lookup proxy.golang.org`.
  #   - the recipe depends on ensure-shellcheck, whose third-party release URL
  #     answered HTTP 504 six times running on 2026-08-29 and reddened three
  #     required contexts on a PR whose head had not moved (bd gqlc-bmmf).
  # A blocking arm would refuse pushes for both, on an offline laptop and on
  # somebody else's outage. What an agent refused a push reaches for is
  # `git push --no-verify`, which drops the suite and the fence with it, so a
  # refusal here does not cost one gate — it costs all of them.
  #
  # So a failure is reported and the push continues, and the arm is NOT
  # recorded as passed. That is the whole mechanism: there is no classifying of
  # the failure into "found something" versus "could not run", because both
  # answers are the same here and a misread would only cost a wrong sentence.
  #
  # UNCONDITIONAL, rather than gated on the push touching .github/workflows,
  # on the ground the test-codegen-fence call above states in its own terms:
  # 1.5-1.7s warm is under the 2.1s that argued for running that one
  # unconditionally, and a conditional gate that omits is silent about having
  # omitted. The saving would be real — 11 of the last 400 commits touch a
  # workflow — and it is declined anyway, because the trigger set is wider than
  # the workflow directory (the actionlint pin and .bin/shellcheck are both in
  # it) and a wrong trigger set fails the quiet way.
  if just actionlint; then
    _ran_gate actionlint
  else
    echo "WARN: 'just actionlint' did not pass. NOT refusing the push — this arm is" >&2
    echo "      advisory because it needs proxy.golang.org and a third-party shellcheck" >&2
    echo "      release, and neither failure is the branch's (bd gqlc-wn4ns)." >&2
    echo "      Findings, if that is what they are, are above. actionlint IS a required" >&2
    echo "      context, so read them: re-run on their own with:  just actionlint" >&2
  fi
fi

# LAST, deliberately: an advisory about a branch name is only worth reading on a
# push that is actually going to happen, and every refusal above exits before
# reaching here. It is not placed beside guard-push-destination at the top,
# because the top is where a REFUSAL belongs — so it is the last line on the
# terminal rather than a page above the tail of the test output — and this is
# not a refusal. It exits 0 on every path; see its header for why a gate here
# would be wrong. bd gqlc-uz3c.
#
# Guarded on a non-empty ref list for the reason gate-pushed-commits is: an
# empty stdin publishes no commit, so there is no branch about to acquire a PR.
if [ -n "${_push_refs}" ]; then
  _replay_push_refs | "$(dirname "$0")/warn-missing-bead-id" "$@" || true
fi

# GH↔bd sync: push locally-created beads to GH.
# Non-blocking — never fail the underlying `git push`. Progress chatter is
# dropped, but stderr survives: the sync ends by reporting what reached GitHub
# and what did not, and discarding that is what let a push that mirrored nothing
# read exactly like one with nothing to mirror.
"$(dirname "$0")/bd-gh-sync" push >/dev/null || true

# LAST of all, after every gate and every advisory: the transport handoff
# notice. It says the gates are DONE, so it is only true once nothing left in
# this file can refuse — and it has to be the last thing on the terminal,
# because what it is about is the failure that follows it. Its own header argues
# why a push dying there reads as a gate failure and what that has cost.
# Non-blocking, like every advisory here. bd gqlc-ehgg.
#
# Unguarded on the ref list, unlike the two advisories above. Those describe a
# branch about to acquire a PR; this describes the transport, which git opened
# before this hook started whatever the ref list holds.
#
# ${SECONDS} is bash's, counting from the top of this hook, so it measures how
# long the connection has been held idle — the quantity the notice is about.
GQLC_PREPUSH_ELAPSED="${SECONDS}" GQLC_PREPUSH_GATES="${_local_gates}" \
  "$(dirname "$0")/push-transport-notice" "$@" || true
