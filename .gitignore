# rapid writes per-failure reproduction files under testdata/rapid; they are
# time/seed-specific and regenerated on demand, so they are never committed.
**/testdata/rapid/

# project-local tool binaries, self-provisioned by just recipes (ensure-golangci)
.bin/

# internal Go tools built at the repo root leave a same-named binary here
# (e.g. `go build ./internal/tools/bdguard` produces ./bdguard). Runtime uses
# `go run`, so no committed binary is ever needed.
/bdguard

# Discovery witnesses: `just vuln`, test-codegen-fence and
# check-codegen-external-tests each mktemp a throwaway module under test/data to
# prove the module set they compare is read off the tree rather than remembered.
# The EXIT traps remove them, but a run killed by an untrapped signal leaves one
# behind, and a leaked probe is a go.mod nobody wrote sitting where an unwary
# `git add` would commit it.
/test/data/vulnprobe.*/
/test/data/fenceprobe.*/
/test/data/xtestprobe.*/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Python
__pycache__/
*.pyc

# Claude Code runtime state, written by the ScheduleWakeup mechanism in any seat
# that schedules one. settings.json and skills/ under the same directory are
# TRACKED, so this is the one path rather than the whole directory.
/.claude/scheduled_tasks.lock
