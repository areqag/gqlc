#!/usr/bin/env bash
# Rows for .github/scripts/goldens-unused-scratch.sh, run by `just
# test-goldens-unused-scratch` (bd gqlc-7hyt).
#
# What is under test: the sweep removes the scratch copy a killed `just
# check-goldens-unused` left behind, and removes nothing else — above all not
# the copy a live run is linting. The last rows are the whole failure end to
# end: the real recipe, SIGKILLed, and the next run reaping it.
#
# $1 is the script under test and $2 the justfile whose check-goldens-unused the
# last rows run. They are parameters so that a mutation run can point these rows
# at a mutated copy of the tree.
#
# NOTHING HERE TOUCHES THE HOST'S /tmp BY NAME. Every root swept is a directory
# under this file's own mktemp, and the recipe is run with scratch_root pointed
# at one.
#
# Every fixture is made by the script's own `new`, so these rows spell neither
# the copy's name nor its record's. "The record" is, to them, whatever regular
# file `new` left at the top of the copy; ageing a copy means back-dating that.
# What they do know is its shape, `<pid> <tick>` on one line, because the rows
# about a record the script could not have written have to write one.
#
# A row that cannot run here says SKIP and is counted in the last line, and
# never reads as a pass. There is one: a removal that fails needs a user rm can
# be refused to. The rows about a host with no /proc were two more until bd
# gqlc-qbah, because they masked /proc with `unshare -rm`, and CI's runner —
# the one place a merge is gated — does not allow that. They now hand the
# script a directory to read instead of /proc, which runs anywhere.
set -uo pipefail

tool_arg="${1:?usage: goldens-unused-scratch.rows <script> <justfile>}"
justfile_arg="${2:?usage: goldens-unused-scratch.rows <script> <justfile>}"
[ -f "${tool_arg}" ] || { echo "error: ${tool_arg} is not a file" >&2; exit 1; }
[ -f "${justfile_arg}" ] || { echo "error: ${justfile_arg} is not a file" >&2; exit 1; }
tool="$(cd "$(dirname "${tool_arg}")" && pwd)/$(basename "${tool_arg}")"
tree="$(cd "$(dirname "${justfile_arg}")" && pwd)"
justfile="${tree}/$(basename "${justfile_arg}")"

scratch="$(mktemp -d)"
owners=()
recipe_pgid=""
cleanup() {
    [ -z "${recipe_pgid}" ] || kill -9 -- "-${recipe_pgid}" 2>/dev/null
    [ "${#owners[@]}" -eq 0 ] || kill -9 "${owners[@]}" 2>/dev/null
    rm -rf "${scratch}"
}
trap cleanup EXIT
# just writes each shebang recipe body to a temp file before running it.
export TMPDIR="${scratch}/tmp"
mkdir -p "${TMPDIR}"

pass=0
fail=0
skip=0
row() {
    local name="$1" verdict="$2" detail="$3"
    if [ "${verdict}" = PASS ]; then
        pass=$((pass + 1))
        printf '  PASS  %-40s %s\n' "${name}" "${detail}"
    elif [ "${verdict}" = SKIP ]; then
        skip=$((skip + 1))
        printf '  SKIP  %-40s %s\n' "${name}" "${detail}"
    else
        fail=$((fail + 1))
        printf '  FAIL  %-40s %s\n' "${name}" "${detail}" >&2
    fi
}

# A fresh root per row, so a row's verdict is about its own fixture.
root=""
new_root() { root="${scratch}/root.${1}"; mkdir -p "${root}"; }

# A process these rows own, to stand as a copy's owner. `live_owner` leaves it
# running until cleanup; `kill_owner` kills AND REAPS it, because a zombie still
# has its /proc entry and the script reads one as alive.
owner=""
live_owner() { sleep 600 >/dev/null 2>&1 & owner=$!; owners+=("${owner}"); }
kill_owner() { kill -9 "${1}" 2>/dev/null; wait "${1}" 2>/dev/null; }

# A copy under ${root} owned by ${owner}, holding three entries besides its
# record: five inodes with the directory itself. Leaves its path in copy.
copy=""
new_copy() {
    copy="$("${tool}" new "${root}" "${owner}")" || copy=""
    [ -n "${copy}" ] && mkdir "${copy}/sub" && : >"${copy}/sub/a" && : >"${copy}/sub/b"
}
age() { find "${1}" -maxdepth 1 -type f -exec touch -d "${2}" {} +; }
# Rewrites the record of ${copy} with a sed expression.
rewrite() { find "${copy}" -maxdepth 1 -type f -exec sed -i -E "${1}" {} +; }

rc=0; out=""
sweep() { out="$("${tool}" sweep "${root}" 2>"${scratch}/err")"; rc=$?; }

# kept NAME: the copy is whole and the sweep was silent. removed NAME N INODES:
# the copy is gone and the ONE line says so, whole.
kept() {
    if [ "${rc}" -eq 0 ] && [ -z "${out}" ] && [ -f "${copy}/sub/a" ] && [ -f "${copy}/sub/b" ]; then
        row "${1}" PASS "kept, and the sweep said nothing"
    else
        row "${1}" FAIL "rc=${rc}, expected 0, silence and the copy whole; stdout: ${out}; stderr: $(cat "${scratch}/err"); left: $(ls -A "${root}")"
    fi
}
removed() {
    local expect="goldens-unused scratch: removed ${2} stale copies a killed run left under ${root}, freeing ${3} inodes (bd gqlc-7hyt)"
    if [ "${rc}" -eq 0 ] && [ "${out}" = "${expect}" ] && [ ! -e "${copy}" ]; then
        row "${1}" PASS "${out#goldens-unused scratch: }"
    else
        row "${1}" FAIL "rc=${rc}, expected 0 and '${expect}'; stdout: ${out}; stderr: $(cat "${scratch}/err"); left: $(ls -A "${root}")"
    fi
}

# --- the script alone -----------------------------------------------------
new_root empty
sweep
if [ "${rc}" -eq 0 ] && [ -z "${out}" ]; then
    row empty-root-is-silent PASS "rc=0"
else
    row empty-root-is-silent FAIL "rc=${rc}, expected 0 and silence; stdout: ${out}; stderr: $(cat "${scratch}/err")"
fi

# The positive: old, and its owner gone. A live run's young copy sits beside it
# and must still be there, so the line's count is a count and not a glob's.
new_root stale
live_owner; new_copy; beside="${copy}"
live_owner; new_copy; kill_owner "${owner}"; age "${copy}" '3 hours ago'
sweep
if [ -f "${beside}/sub/a" ]; then
    removed stale-and-dead-is-removed 1 5
else
    row stale-and-dead-is-removed FAIL "the live young copy beside it went too; stdout: ${out}"
fi

new_root two
live_owner; new_copy; kill_owner "${owner}"; age "${copy}" '3 hours ago'; first="${copy}"
live_owner; new_copy; kill_owner "${owner}"; age "${copy}" '3 hours ago'
sweep
if [ ! -e "${first}" ]; then
    removed two-stale-are-counted-once-each 2 10
else
    row two-stale-are-counted-once-each FAIL "the first copy is still there; stdout: ${out}"
fi

# The row this file exists for: however old, a copy whose owner runs is a gate
# in progress. A lock wait alone can hold one for most of an hour.
new_root alive
live_owner; new_copy; age "${copy}" '3 hours ago'
sweep
kept old-but-owner-alive-is-kept

# Age on its own account: the owner test reads this host's process table, so an
# owner it cannot see reads as dead, and age is all that protects that copy.
new_root young
live_owner; new_copy; kill_owner "${owner}"
sweep
kept young-but-owner-dead-is-kept

# The threshold is held above the four lock waits a live run can spend (50
# minutes), not merely above zero.
new_root hour
live_owner; new_copy; kill_owner "${owner}"; age "${copy}" '60 minutes ago'
sweep
kept an-hour-old-and-owner-dead-is-kept

# A pid is reused; the start tick is what says the process holding it is not
# the owner. Old, the pid alive, the tick another's.
new_root reused
live_owner; new_copy
find "${copy}" -maxdepth 1 -type f -exec sed -i -E 's/ [0-9]+$/ 1/' {} +
age "${copy}" '3 hours ago'
sweep
removed reused-pid-is-not-the-owner 1 5

# A record the script could not have written says nothing about a death. Every
# one of these is old and is KEPT; each but the first names a LIVE owner, so
# that the copy a wrong answer deletes is a live run's. `-` for the tick is what
# `new` itself writes where it cannot read /proc.
unwritable_record() {
    new_root "${1}"
    live_owner; new_copy
    rewrite "${2}"
    age "${copy}" '3 hours ago'
    sweep
    kept "${1}"
}
new_root unparsed
live_owner; new_copy; kill_owner "${owner}"
find "${copy}" -maxdepth 1 -type f -exec truncate -s 0 {} +
age "${copy}" '3 hours ago'
sweep
kept unparsed-record-is-kept
unwritable_record empty-tick-is-kept 's/ [0-9]+$/ /'
unwritable_record garbled-tick-is-kept 's/ [0-9]+$/ -/'
unwritable_record leading-zero-tick-is-kept 's/ ([0-9]+)$/ 0\1/'
unwritable_record overlong-tick-is-kept 's/ [0-9]+$/ 111111111111111111111/'
unwritable_record garbled-pid-is-kept 's/^[0-9]+/-/'
unwritable_record pid-zero-is-kept 's/^[0-9]+/0/'
unwritable_record leading-zero-pid-right-tick-is-kept 's/^/0/'
# The same clause from a pid short enough that the length rule is not what
# answers: on this host a live pid has seven digits, and eight are too many
# whatever they begin with.
unwritable_record short-leading-zero-pid-is-kept 's/^[0-9]+/01/'
unwritable_record overlong-pid-is-kept 's/^[0-9]+/11111111111111111111111/'

# And `new` does not write one: a pid it would not read back is refused, with
# nothing made.
new_root badpid
live_owner
bad=""
for pid in "" 0 01 "0${owner}" 11111111111111111111111 -; do
    out="$("${tool}" new "${root}" "${pid}" 2>"${scratch}/err")"; rc=$?
    if [ "${rc}" -ne 2 ] || [ -n "${out}" ] || [ -n "$(ls -A "${root}")" ]; then
        bad="${bad} '${pid}' (rc=${rc}, stdout: ${out}, left: $(ls -A "${root}"))"
    fi
done
if [ -z "${bad}" ]; then
    row new-refuses-a-pid-it-would-not-read PASS "rc=2 and nothing made, six shapes"
else
    row new-refuses-a-pid-it-would-not-read FAIL "expected rc=2, empty stdout and an empty root for each; got:${bad}"
fi

# Somebody else's directory under this name: old, no record.
new_root unmarked
live_owner; new_copy; kill_owner "${owner}"
find "${copy}" -maxdepth 1 -type f -delete
touch -d '3 hours ago' "${copy}"
sweep
kept unmarked-directory-is-kept

# A symlink under this name, to a copy that is stale by every other rule. The
# link stays and the sweep does not reach through it.
new_root elsewhere; elsewhere="${root}"
live_owner; new_copy; kill_owner "${owner}"; age "${copy}" '3 hours ago'
new_root symlink
ln -s "${copy}" "${root}/$(basename "${copy}")"
sweep
if [ -L "${root}/$(basename "${copy}")" ]; then
    kept symlink-is-not-followed
else
    row symlink-is-not-followed FAIL "the link itself was removed; stdout: ${out}"
fi
# The control for the row above: the same target IS stale where it really is.
root="${elsewhere}"
sweep
removed symlink-target-was-stale-in-place 1 5

# A directory that is stale by every rule but its NAME, which is not the
# template's.
new_root othername
live_owner; new_copy; kill_owner "${owner}"; age "${copy}" '3 hours ago'
mv "${copy}" "${root}/somebody-elses"; copy="${root}/somebody-elses"
sweep
kept name-outside-the-template-is-kept

# A root that is not absolute is refused by both halves, loudly, and what is
# under it stays. `-rel` is the shape that mattered: find reads it as an option.
new_root relative
root="${root}/-rel"; mkdir "${root}"
live_owner; new_copy; kill_owner "${owner}"; age "${copy}" '3 hours ago'
out="$(cd "${root}/.." && "${tool}" sweep -rel 2>"${scratch}/err")"; rc=$?
if [ "${rc}" -eq 2 ] && [ -z "${out}" ] && [ -f "${copy}/sub/a" ] && command grep -Fq -- "'-rel' is not an absolute path" "${scratch}/err"; then
    row relative-root-is-refused-by-sweep PASS "rc=2, and the reason names it"
else
    row relative-root-is-refused-by-sweep FAIL "rc=${rc}, expected 2, silence on stdout, the copy whole and a reason naming '-rel'; stdout: ${out}; stderr: $(cat "${scratch}/err")"
fi
bad=""
for r in -rel ""; do
    before="$(find "${root}/.." | wc -l)"
    out="$(cd "${root}/.." && "${tool}" new "${r}" "${owners[0]}" 2>"${scratch}/err")"; rc=$?
    if [ "${rc}" -ne 2 ] || [ -n "${out}" ] || [ "$(find "${root}/.." | wc -l)" -ne "${before}" ]; then
        bad="${bad} '${r}' (rc=${rc}, stdout: ${out})"
    fi
    out="$(cd "${root}/.." && "${tool}" sweep "${r}" 2>"${scratch}/err")"; rc=$?
    [ "${rc}" -eq 2 ] || bad="${bad} sweep '${r}' (rc=${rc})"
done
if [ -z "${bad}" ]; then
    row relative-or-empty-root-is-refused PASS "rc=2 and nothing made"
else
    row relative-or-empty-root-is-refused FAIL "expected rc=2, empty stdout and nothing made; got:${bad}"
fi

# --- one sweeper per copy, and a removal cut short -------------------------
# Three sweepers at once over five copies big enough that a removal takes a
# while. Each copy must be reported by exactly one of them, so the lines SUM to
# what was there. Before the claim each of three reported all five (measured by
# the reviewer of PR #2963, 3 trials of 3).
new_root race
for _ in 1 2 3 4 5; do
    live_owner; new_copy; kill_owner "${owner}"
    (cd "${copy}/sub" && seq 1 400 | xargs touch)
    age "${copy}" '3 hours ago'
done
there="$(find "${root}" -mindepth 1 | wc -l)"
for n in 1 2 3; do
    "${tool}" sweep "${root}" >"${scratch}/race.${n}" 2>&1 &
    racers[n]=$!
done
wait "${racers[@]}"
copies=0; inodes=0
while read -r c i; do
    copies=$((copies + c)); inodes=$((inodes + i))
done < <(sed -n -E 's/^goldens-unused scratch: removed ([0-9]+) stale copies .* freeing ([0-9]+) inodes .*/\1 \2/p' "${scratch}"/race.[123])
if [ "${copies}" -eq 5 ] && [ "${inodes}" -eq "${there}" ] && [ -z "$(ls -A "${root}")" ]; then
    row racing-sweepers-sum-to-the-truth PASS "three sweepers reported 5 copies and ${there} inodes between them"
else
    row racing-sweepers-sum-to-the-truth FAIL "three sweepers reported ${copies} copies and ${inodes} inodes between them, over 5 and ${there}; left: $(ls -A "${root}"); said: $(cat "${scratch}"/race.[123])"
fi

# A removal that fails part-way — here rm is refused inside a read-only
# directory — must leave something a LATER sweep can still take: inside the
# template, and with its record. The sweeper that failed says nothing. What it
# leaves is young, which is what stops a second sweeper claiming a copy the
# first is still removing, so a sweep straight afterwards keeps it and only one
# after it has aged again removes it.
if [ "$(id -u)" -eq 0 ]; then
    row failed-removal-is-finished-later SKIP "running as root, which rm is not refused to"
else
    new_root remnant
    live_owner; new_copy; kill_owner "${owner}"; age "${copy}" '3 hours ago'
    chmod 555 "${copy}/sub"
    sweep
    first_rc="${rc}"; first_out="${out}"
    remnant="$(find "${root}" -mindepth 1 -maxdepth 1)"
    chmod -R u+w "${root}"
    sweep
    if [ "${first_rc}" -ne 0 ] || [ -n "${first_out}" ] || [ -z "${remnant}" ] || [ ! -f "${remnant}/sub/a" ]; then
        row failed-removal-is-finished-later FAIL "the refused sweep: rc=${first_rc}, expected 0, silence and a remnant holding sub/a; stdout: ${first_out}; left: $(ls -A "${root}")"
    elif [ "${rc}" -ne 0 ] || [ -n "${out}" ]; then
        row failed-removal-is-finished-later FAIL "the sweep straight after took the claimed remnant, which a second sweeper would do to a copy still being removed; rc=${rc}; stdout: ${out}"
    else
        age "${remnant}" '3 hours ago'
        copy="${remnant}"
        sweep
        removed failed-removal-is-finished-later 1 5
    fi
fi

# --- a claim that finds its name taken ------------------------------------
# The sweeper claims a copy by renaming it to a name ending in its own pid. A
# NON-EMPTY directory already under that name is somebody's, and a rename that
# moved the copy INTO it would go on to empty it. The shell that plants it execs
# the script, so the pid it spelled is the sweeper's.
new_root taken
live_owner; new_copy; kill_owner "${owner}"; age "${copy}" '3 hours ago'
# shellcheck disable=SC2016 # expanded by the inner shell, whose $$ is the point
out="$(bash -c 'mkdir "${1}.reap$$" && : >"${1}.reap$$/precious" && exec "${2}" sweep "${3}"' \
    bash "${copy}" "${tool}" "${root}" 2>"${scratch}/err")"; rc=$?
precious="$(find "${root}" -mindepth 2 -maxdepth 2 -name precious)"
if [ -z "${precious}" ]; then
    row claim-name-taken-is-left-alone FAIL "the file in the directory that held the claim's name is gone; rc=${rc}; stdout: ${out}; left: $(ls -A "${root}")"
elif [ -e "$(dirname "${precious}")/$(basename "${copy}")" ]; then
    row claim-name-taken-is-left-alone FAIL "the copy was moved inside the directory that held the claim's name; left there: $(ls -A "$(dirname "${precious}")")"
else
    kept claim-name-taken-is-left-alone
fi

# --- a proc root that is not /proc ------------------------------------------
# `--test-proc-root <dir>` has the script read <dir>/<pid>/stat. It says so on
# stderr each time, in one line, and `noticed` is that line and nothing else.
fake=""
new_fake() { fake="${scratch}/proc.${1}"; mkdir -p "${fake}"; }
noticed() {
    [ "$(cat "${scratch}/err")" = "goldens-unused scratch: TEST ONLY: process start ticks are read from ${fake} and not from /proc (bd gqlc-qbah)" ]
}

# A host with no /proc is an empty one. `new` must write a tick that reads as
# alive — and the row checks that it is not a number, or a proc root that was
# not read would pass it — and `sweep` must remove nothing, over a copy the
# sweep that reads /proc then does remove.
new_root noprocnew; new_fake empty
live_owner
copy="$("${tool}" --test-proc-root "${fake}" new "${root}" "${owner}" 2>"${scratch}/err")" || copy=""
tick="$([ -z "${copy}" ] || find "${copy}" -maxdepth 1 -type f -exec awk '{print $2}' {} +)"
case "${tick}" in
    "" | *[0-9]*) row no-proc-new-writes-no-tick FAIL "the tick written was '${tick}', expected something that is there and is not a number; stderr: $(cat "${scratch}/err")" ;;
    *)  if ! noticed; then
            row no-proc-new-writes-no-tick FAIL "expected the one TEST ONLY line on stderr, got: $(cat "${scratch}/err")"
        else
            mkdir "${copy}/sub" && : >"${copy}/sub/a" && : >"${copy}/sub/b"
            age "${copy}" '3 hours ago'
            sweep
            kept no-proc-new-writes-no-tick
        fi ;;
esac

new_root noprocsweep
live_owner; new_copy; kill_owner "${owner}"; age "${copy}" '3 hours ago'
out="$("${tool}" --test-proc-root "${fake}" sweep "${root}" 2>"${scratch}/err")"; rc=$?
if noticed; then
    kept no-proc-sweep-removes-nothing
else
    row no-proc-sweep-removes-nothing FAIL "expected the one TEST ONLY line on stderr, got: $(cat "${scratch}/err")"
fi
sweep
removed no-proc-control-real-proc-removes 1 5

# A stat line as the kernel writes one: the pid, the command name in
# parentheses, then fields 3 to 52, the tick being field 22. Every other field
# is a number of its own, so a count begun in the wrong place reads a wrong tick
# and never the right one by luck.
stat_line() {
    local n fields=""
    for n in $(seq 3 52); do
        if [ "${n}" -eq 22 ]; then fields="${fields} ${3}"; else fields="${fields} $((1000 + n))"; fi
    done
    printf '%s (%s)%s\n' "${1}" "${2}" "${fields}"
}
# Sweeps ${root} reading ${fake}. A sweeper that cannot read its OWN tick judges
# nothing, so its stat has to be there, under a pid nobody knows yet: the shell
# that writes it execs the script.
fake_sweep() {
    # shellcheck disable=SC2016 # expanded by the inner shell, whose $$ is the point
    out="$(bash -c 'mkdir "${1}/$$" && printf "%s\n" "${2}" >"${1}/$$/stat" && exec "${3}" --test-proc-root "${1}" sweep "${4}"' \
        bash "${fake}" "$(stat_line 1 sweeper 5)" "${tool}" "${root}" 2>"${scratch}/err")"; rc=$?
}
# fake_owner NAME STAT: an old copy whose record says `<owner> 777777`, the owner
# a LIVE process whose real tick is another, swept against a proc root holding
# STAT for it. What is kept here was kept on the word of the directory.
fake_owner() {
    new_root "${1}"; new_fake "${1}"
    live_owner; new_copy
    rewrite 's/ [0-9]+$/ 777777/'
    age "${copy}" '3 hours ago'
    mkdir "${fake}/${owner}"
    printf '%s' "${2}" >"${fake}/${owner}/stat"
    fake_sweep
}
fake_owner fakeright "$(stat_line 1 sleep 777777)"
kept fake-proc-right-tick-is-kept
# The control for every `kept` in this section: the same sweep DOES remove, so
# none of them was a sweeper stopped at its own tick.
fake_owner fakewrong "$(stat_line 1 sleep 777778)"
removed fake-proc-wrong-tick-is-removed 1 5
# A command name is whatever its process set, parentheses and spaces included.
fake_owner fakecomm "$(stat_line 1 'a) 1 2 3 (b' 777777)"
kept comm-holding-parentheses-is-read-past
# A stat file that is there and holds no tick says a process has the pid and
# nothing about which one.
fake_owner fakeempty ""
kept empty-stat-is-kept
fake_owner fakeshort "1 (sleep) S 1 2"
kept truncated-stat-is-kept
fake_owner fakegarbled "$(stat_line 1 sleep -)"
kept garbled-stat-tick-is-kept

# A proc root that is not an absolute path to a directory is refused by both
# halves, with nothing swept and nothing made. `rel` IS a directory, and empty:
# honoured, it is a host with no /proc.
new_root badproc
live_owner; new_copy; kill_owner "${owner}"; age "${copy}" '3 hours ago'
mkdir "${scratch}/rel"; : >"${scratch}/file"
bad=""
for d in "" rel "${scratch}/absent" "${scratch}/file"; do
    before="$(find "${root}" | wc -l)"
    out="$(cd "${scratch}" && "${tool}" --test-proc-root "${d}" sweep "${root}" 2>"${scratch}/err")"; rc=$?
    if [ "${rc}" -ne 2 ] || [ -n "${out}" ] || ! command grep -Fq -- "--test-proc-root '${d}' is not an absolute path to a directory" "${scratch}/err"; then
        bad="${bad} sweep '${d}' (rc=${rc}, stdout: ${out}, stderr: $(cat "${scratch}/err"))"
    fi
    out="$(cd "${scratch}" && "${tool}" --test-proc-root "${d}" new "${root}" "${owners[0]}" 2>"${scratch}/err")"; rc=$?
    if [ "${rc}" -ne 2 ] || [ -n "${out}" ] || [ "$(find "${root}" | wc -l)" -ne "${before}" ]; then
        bad="${bad} new '${d}' (rc=${rc}, stdout: ${out})"
    fi
done
out="$("${tool}" --test-proc-root 2>"${scratch}/err")"; rc=$?
[ "${rc}" -eq 2 ] || bad="${bad} no directory at all (rc=${rc})"
if [ -z "${bad}" ] && [ -f "${copy}/sub/a" ]; then
    row bad-proc-root-is-refused PASS "rc=2, nothing swept and nothing made, four shapes and none"
else
    row bad-proc-root-is-refused FAIL "expected rc=2, empty stdout, the reason, and the root as it was; got:${bad}; left: $(ls -A "${root}")"
fi

# --- the real recipe, SIGKILLed -------------------------------------------
# The defect as filed. The recipe runs in a session of its own so that the
# whole process group can be killed the way a watchdog kills one, and is killed
# once the module copy has started landing. Its copy must still be there —
# otherwise this row measured nothing — and the NEXT run of the recipe must
# remove it, say so, pass, and leave the root empty behind itself. That second
# run is the recipe and not the script, because what ties the two together is a
# line in the recipe's body that nothing else holds: the sweep being called at
# all, and `new` being what makes the directory.
#
# That second run is also the one run of the script these rows do not start
# themselves, so it is where a proc root arriving by the ENVIRONMENT is tried:
# exported at an empty directory, under the name a shortcut would give it,
# beside an old copy whose owner is alive. The script takes a proc root as an
# argument and reads none from the environment, so the killed copy is reaped all
# the same — an empty proc root reaps nothing — and the live one is whole.
real_just="$(command -v just)" || real_just=""
if [ -z "${real_just}" ] || ! command -v setsid >/dev/null 2>&1; then
    row killed-run-is-reaped-by-the-next FAIL "no just or no setsid on PATH, so the recipe cannot be run and killed"
else
    new_root recipe
    recipe=("${real_just}" --justfile "${justfile}" --tempdir "${TMPDIR}"
        scratch_root="${root}" check-goldens-unused)
    # One subshell and an exec, so that $! is the session leader's own pid.
    (cd "${tree}" && exec setsid "${recipe[@]}") >"${scratch}/killed.log" 2>&1 &
    recipe_pgid=$!
    landed=0
    for _ in $(seq 1 3600); do
        kill -0 "${recipe_pgid}" 2>/dev/null || break
        landed="$(find "${root}" -mindepth 1 2>/dev/null | wc -l)"
        [ "${landed}" -lt 100 ] || break
        sleep 0.05
    done
    killed=no
    ! kill -9 -- "-${recipe_pgid}" 2>/dev/null || killed=yes
    wait "${recipe_pgid}" 2>/dev/null
    recipe_pgid=""
    left="$(find "${root}" -mindepth 1 | wc -l)"
    copy="$(find "${root}" -mindepth 1 -maxdepth 1 -type d)"
    if [ "${killed}" = no ]; then
        row killed-run-leaves-its-copy FAIL "there was no process group to SIGKILL, so the recipe ended on its own and this row measured nothing; its output: $(tail -n 5 "${scratch}/killed.log")"
    elif [ "${left}" -lt 100 ] || [ "$(printf '%s\n' "${copy}" | wc -l)" -ne 1 ]; then
        row killed-run-leaves-its-copy FAIL "the killed run left ${left} entries under its root, expected one copy of 100 or more, so there is nothing for the next run to reap; its output: $(tail -n 5 "${scratch}/killed.log")"
    else
        row killed-run-leaves-its-copy PASS "${left} inodes survived the SIGKILL"
        age "${copy}" '3 hours ago'
        killed_copy="${copy}"
        live_owner; new_copy; age "${copy}" '3 hours ago'
        new_fake inherited
        out="$(cd "${tree}" && env GQLC_GOLDENS_UNUSED_PROC_ROOT="${fake}" "${recipe[@]}" 2>"${scratch}/err")"
        rc=$?
        expect="goldens-unused scratch: removed 1 stale copies a killed run left under ${root}, freeing ${left} inodes (bd gqlc-7hyt)"
        reaped=no
        ! printf '%s\n' "${out}" | command grep -Fxq -- "${expect}" || reaped=yes
        if [ "${rc}" -eq 0 ] && [ "${reaped}" = yes ] && [ ! -e "${killed_copy}" ] \
            && [ "$(ls -A "${root}")" = "$(basename "${copy}")" ]; then
            row killed-run-is-reaped-by-the-next PASS "the next run passed, left only the live run's copy, and said: ${expect#goldens-unused scratch: }"
        else
            row killed-run-is-reaped-by-the-next FAIL "rc=${rc}, expected 0, a root holding the live run's copy alone and the line '${expect}'; stdout: ${out}; stderr: $(tail -n 5 "${scratch}/err"); left: $(ls -A "${root}")"
        fi
        if [ "${reaped}" = yes ] && [ -f "${copy}/sub/a" ] && [ -f "${copy}/sub/b" ] \
            && ! command grep -Fq -- "TEST ONLY" "${scratch}/err"; then
            row exported-proc-root-is-not-read PASS "the recipe read /proc: the dead owner's copy reaped, the live owner's whole"
        else
            row exported-proc-root-is-not-read FAIL "with GQLC_GOLDENS_UNUSED_PROC_ROOT exported at an empty directory, expected the killed copy reaped, the live owner's copy whole and no TEST ONLY line; reaped: ${reaped}; stderr: $(command grep -F -- "TEST ONLY" "${scratch}/err"); left: $(ls -A "${root}")"
        fi
    fi
fi

echo "goldens-unused-scratch: ${pass} passed, ${fail} failed, ${skip} skipped"
[ "${fail}" -eq 0 ]
