#!/usr/bin/env bash
# Liveness rows for FuzzProcsigDecode (internal/procsig), run by `just
# fuzz-liveness FuzzProcsigDecode`: each row plants one defect with sed, in a
# scratch copy of HEAD, and asks whether the harness reports it. The protocol
# and the verdicts are driver.sh's; the recorded run, with every row's diff, is
# docs/mutation/fuzz-liveness-FuzzProcsigDecode.md.
#
# R2's condition — a signature name ending in "." — is one no committed seed
# meets (the driver re-checks that on the mutant before it fuzzes) and one a
# single replaced byte at the end of any canonical name does.
set -euo pipefail

# SC1091: `just lint-hooks` runs shellcheck without -x, so it cannot follow the
# source; driver.sh is linted in its own right by the same sweep.
# shellcheck source=driver.sh disable=SC1091
. "$(dirname "${BASH_SOURCE[0]}")/driver.sh"

file=internal/procsig/file.go
sig_fn='s/^func (ws wireSignature) toSignature(src string) (Signature, error) {$/&\n\tif ws.Name != "" \&\& ws.Name[len(ws.Name)-1] == '"'.'"' {\n\t\t'
seeds="go test -count=1 -run '^FuzzProcsigDecode\$' ./internal/procsig"
# Expanded by driver.sh's `bash -c` in the copy, not here.
# shellcheck disable=SC2016
fuzz='just fuzz FuzzProcsigDecode "$LIVENESS_BUDGET"'

liveness_begin FuzzProcsigDecode internal/procsig

liveness_control C1 "$seeds"
liveness_control C2 "$fuzz"

# R1 seed-reach: every canonical signature is lifted off the wire.
liveness_row R1 "$file" \
    's/^func (ws wireSignature) toSignature(src string) (Signature, error) {$/&\n\tpanic("planted: R1")/' \
    'panic: planted: R1' seeds "$seeds"

# R2 mutation-reach.
liveness_row R2 "$file" \
    "${sig_fn}"'panic("planted: R2")\n\t}/' \
    'panic: planted: R2' fuzz "$fuzz"

# R3 slow call: R2's condition, sleeping 1.5 s. The target decodes twice under
# one Guard, so one such signature costs 3 s: past the 2 s limit and short of
# the 10 s watchdog.
liveness_row R3 "$file" \
    's/^\t"slices"$/&\n\t"time"/
'"${sig_fn}"'time.Sleep(1500 * time.Millisecond)\n\t}/' \
    'fuzzkit\.Guard: slow input' fuzz "$fuzz"

# R3b hang: R2's condition, never returning. Guard's watchdog ends the worker.
liveness_row R3b "$file" \
    "${sig_fn}"'for {\n\t\t}\n\t}/' \
    'hung or terminated unexpectedly|fuzzkit\.Guard: watchdog' fuzz "$fuzz"

# R4 property: the wire token FLOAT lowers to STRING. No panic follows and the
# result still validates; the agreement property, reading the token by the
# format's own table, reports it. The canonical seed declares a FLOAT, so the
# seed pass does.
liveness_row R4 "$file" \
    '/^\tcase "FLOAT":$/{n;s/^\t\treturn TokenFloat, nil$/\t\treturn TokenString, nil/}' \
    'property agreement' property "$fuzz"

liveness_end
