#!/usr/bin/env bash
# Liveness rows for FuzzGenerate (internal/codegen/conformance), run by `just
# fuzz-liveness FuzzGenerate`: each row plants one defect with sed, in a
# scratch copy of HEAD, and asks whether the harness reports it. The protocol
# and the verdicts are driver.sh's; the recorded run, with every row's diff, is
# docs/mutation/fuzz-liveness-FuzzGenerate.md.
#
# The planted sites are in internal/codegen, which every backend calls:
# Prepare (each backend's shared front half) and Finalise (the shared tail).
# R2's condition is a query whose name holds one of J X Y j q z. No committed
# seed's query name carries any of them (the generated arm names its query Q;
# the driver re-checks that on the mutant before it fuzzes), and one replaced
# byte inside any fixture's `// name:` annotation does. Six letters rather than
# one because the first run's R3b, on X alone, went 5 minutes without the
# engine writing one.
set -euo pipefail

# SC1091: `just lint-hooks` runs shellcheck without -x, so it cannot follow the
# source; driver.sh is linted in its own right by the same sweep.
# shellcheck source=driver.sh disable=SC1091
. "$(dirname "${BASH_SOURCE[0]}")/driver.sh"

pkg=internal/codegen/conformance
prepare=internal/codegen/prepare.go
emit=internal/codegen/emit.go
# R2's condition with PLANT standing for its body. Each body is a variable of
# its own because the replacement half of ${named/PLANT/...} undergoes quote
# removal, which would eat a literal \n.
named='s/^func Prepare(in Input, tm TypeMap, packageName string) (Prepared, error) {$/&\n\tfor _, q := range in.Queries {\n\t\tif strings.ContainsAny(q.Name, "JXYjqz") {\n\t\t\tPLANT\n\t\t}\n\t}/'
plant_panic='panic("planted: R2")'
plant_sleep='time.Sleep(1500 * time.Millisecond)'
plant_hang='for {\n\t\t\t}'
seeds="go test -count=1 -run '^FuzzGenerate\$' ./$pkg"
# -parallel 4: the host is shared. Expanded by driver.sh's `bash -c` in the
# copy, not here.
# shellcheck disable=SC2016
fuzz='just fuzz FuzzGenerate "$LIVENESS_BUDGET" 4'

liveness_begin FuzzGenerate "$pkg"

liveness_control C1 "$seeds"
liveness_control C2 "$fuzz"

# R1 seed-reach: every input the front end admits reaches Prepare through
# both neo4j majors.
liveness_row R1 "$prepare" \
    's/^func Prepare(in Input, tm TypeMap, packageName string) (Prepared, error) {$/&\n\tpanic("planted: R1")/' \
    'panic: planted: R1' seeds "$seeds"

# R2 mutation-reach.
liveness_row R2 "$prepare" \
    "${named/PLANT/$plant_panic}" \
    'panic: planted: R2' fuzz "$fuzz"

# R3 slow call: R2's condition, sleeping 1.5 s per Prepare. One guarded call
# runs every backend, and two or three of them reach Prepare (AGE refuses some
# batches before it), so the call takes 3 to 4.5 s: past Guard's 2 s limit and
# short of its 10 s watchdog.
liveness_row R3 "$prepare" \
    's/^\t"strings"$/&\n\t"time"/
'"${named/PLANT/$plant_sleep}" \
    'fuzzkit\.Guard: slow input' fuzz "$fuzz"

# R3b hang: R2's condition, never returning. Guard's watchdog ends the worker
# and the engine reports a worker that terminated unexpectedly.
liveness_row R3b "$prepare" \
    "${named/PLANT/$plant_hang}" \
    'hung or terminated unexpectedly|fuzzkit\.Guard: watchdog' fuzz "$fuzz"

# The property rows. Each breaks one property without a panic, on a shape the
# committed seeds already carry, so the seed pass reports it: they show the
# property is checked, and name the property that fired.

# R4a path order: Finalise sorts the files descending.
liveness_row R4a "$emit" \
    's/return cmp\.Compare(a\.Path, b\.Path)/return cmp.Compare(b.Path, a.Path)/' \
    'property path-order' property "$fuzz"

# R4b gofmt: Finalise keeps go/format's output and adds one blank line, which
# still parses.
liveness_row R4b "$emit" \
    's/^\t\tfiles\[i\]\.Contents = formatted$/\t\tfiles[i].Contents = append(formatted, '"'"'\\n'"'"')/' \
    'property gofmt' property "$fuzz"

# R4c determinism: Header numbers the files it has headed so far in the
# generated-code line, so the same Input never gets the same bytes twice. The
# header goes through go/format with the rest of the file, so nothing but
# determinism sees it.
liveness_row R4c "$emit" \
    's/^func Header() string {$/var plantedHeaders int\n\n&\n\tplantedHeaders++/
s/^\treturn fmt\.Sprintf("\/\/ Code generated by gqlc %s\. DO NOT EDIT\.\\n\\n", version\.Version)$/\treturn fmt.Sprintf("\/\/ Code generated by gqlc %s (%d). DO NOT EDIT.\\n\\n", version.Version, plantedHeaders)/' \
    'property determinism' property "$fuzz"

# R4d cross-backend: AGE names its connection hook file graphs.go, so the
# files it shares with neo4j no longer match.
liveness_row R4d internal/codegen/age/generate.go \
    's/{Path: "graph\.go", Contents: renderGraph(pkg)}/{Path: "graphs.go", Contents: renderGraph(pkg)}/' \
    'property age-neo4j' property "$fuzz"

liveness_end
